# Public configuration for the Astro build, NOT secret API credentials.
# Stripe Payment Links are enabled by default in production.
PUBLIC_CARE_CHECKOUT_ENABLED=true
PUBLIC_CARE_STRIPE_MODE=live
PUBLIC_STRIPE_CARE_BASIC_URL=https://buy.stripe.com/9B614pfk1exq0xh3b1cZa00
PUBLIC_STRIPE_CARE_PRO_URL=https://buy.stripe.com/6oU9AVfk1cpieo7fXNcZa01
PUBLIC_STRIPE_CARE_ENTERPRISE_URL=https://buy.stripe.com/eVqeVf8VD1KE4NxaDtcZa02
PUBLIC_STRIPE_CARE_PORTAL_URL=

# Legacy variable names are also supported as fallback:
# PUBLIC_CARE_BASIC_PAYMENT_LINK=https://buy.stripe.com/9B614pfk1exq0xh3b1cZa00
# PUBLIC_CARE_PRO_PAYMENT_LINK=https://buy.stripe.com/6oU9AVfk1cpieo7fXNcZa01
# PUBLIC_CARE_ENTERPRISE_PAYMENT_LINK=https://buy.stripe.com/eVqeVf8VD1KE4NxaDtcZa02
# PUBLIC_CARE_CUSTOMER_PORTAL_URL=

# For sandbox checks use test links, mode=test and VERCEL_ENV=preview.
# Vercel supplies VERCEL_ENV automatically. Do not override it in production.
# Changing these values requires a new Astro build/deployment.

