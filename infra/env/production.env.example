# ==============================================================================
# GRUPO CASTILLO — VARIABLES DE ENTORNO DE PRODUCCIÓN (TEMPLATE)
# ==============================================================================
# Este archivo sirve como plantilla segura.
# Copiar a /etc/castillo/commercial.env en el servidor de producción (chmod 600).
# NO incluir credenciales reales en este repositorio.

NODE_ENV=production
PORT=4321
DB_PATH=/var/www/servicios-castillo/.castle/commercial.sqlite

# ------------------------------------------------------------------------------
# SEGURIDAD Y SESIONES
# ------------------------------------------------------------------------------
# Semilla criptográfica para firma de sesiones (mínimo 64 caracteres aleatorios)
SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_HEX_SECRET_MIN_64_CHARS

# Origen permitido para CORS (Frontend Astro en Vercel)
CORS_ORIGIN=https://www.grupocastillo.mx

# ------------------------------------------------------------------------------
# PASARELAS DE PAGO — STRIPE (SANDBOX / LIVE)
# ------------------------------------------------------------------------------
# Clave secreta para validación de firma HMAC de webhooks (whsec_...)
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET
# Clave privada de API de Stripe (sk_live_... / sk_test_...)
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY

# ------------------------------------------------------------------------------
# PASARELAS DE PAGO — MERCADO PAGO (SANDBOX / LIVE)
# ------------------------------------------------------------------------------
# Clave secreta para validación de x-signature HMAC SHA-256
MP_WEBHOOK_SECRET=REPLACE_WITH_MP_WEBHOOK_SECRET
# Token de acceso privado de Mercado Pago (APP_USR-...)
MP_ACCESS_TOKEN=REPLACE_WITH_MP_ACCESS_TOKEN

# ------------------------------------------------------------------------------
# CORREO TRANSACCIONAL (OTP Y ALERTAS)
# ------------------------------------------------------------------------------
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
MAIL_FROM="Grupo Castillo <no-reply@grupocastillo.mx>"
