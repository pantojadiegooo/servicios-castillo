{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(favicon-32.png|favicon.svg|favicon.ico|apple-touch-icon.png|site.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://formspree.io https://api.grupocastillo.mx; form-action 'self' https://formspree.io; frame-ancestors 'none'; object-src 'none'; base-uri 'self';"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/auditoria.html", "destination": "/servicios/audit", "permanent": true },
    { "source": "/auditoria",      "destination": "/servicios/audit", "permanent": true },
    { "source": "/cuidado.html",   "destination": "/servicios/care",  "permanent": true },
    { "source": "/cuidado",        "destination": "/servicios/care",  "permanent": true },
    { "source": "/intervencion.html", "destination": "/servicios/rescue", "permanent": true },
    { "source": "/intervencion",      "destination": "/servicios/rescue", "permanent": true },
    { "source": "/transformacion.html", "destination": "/servicios", "permanent": true },
    { "source": "/transformacion",      "destination": "/servicios", "permanent": true },
    { "source": "/seguridad-calidad.html", "destination": "/castle-gate", "permanent": true },
    { "source": "/seguridad-calidad",      "destination": "/castle-gate", "permanent": true },
    { "source": "/soluciones.html", "destination": "/servicios", "permanent": true },
    { "source": "/soluciones",      "destination": "/servicios", "permanent": true }
  ]
}

