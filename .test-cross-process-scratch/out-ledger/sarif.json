{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Castle Gate Assurance Engine",
          "version": "1.0.0-candidate",
          "informationUri": "https://grupocastillo.com/castle-gate",
          "rules": [
            {
              "id": "MISSING_IMAGE_DIMENSIONS",
              "name": "MISSING_IMAGE_DIMENSIONS",
              "shortDescription": {
                "text": "Image tag missing explicit width/height attribute to prevent layout shift."
              },
              "fullDescription": {
                "text": "Detected by CastleMaintainabilityProbe (Associated CQS Control: N/A)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "quality",
                  "governance",
                  "castle-gate"
                ],
                "precision": "high"
              }
            }
          ]
        }
      },
      "automationDetails": {
        "id": "EVAL-cccccccccccccccc"
      },
      "results": [
        {
          "ruleId": "MISSING_IMAGE_DIMENSIONS",
          "level": "warning",
          "message": {
            "text": "Image tag missing explicit width/height attribute to prevent layout shift."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "index.html",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "MEDIUM",
            "cqs_control_id": null,
            "details": {}
          }
        }
      ]
    }
  ]
}