---
/**
 * GRUPO CASTILLO — Deliverables Showcase Component
 * Presenta demostraciones visuales de alta fidelidad de los entregables por paquete.
 */

export interface DeliverableDemo {
  id: string;
  tierName: string;
  tierPrice: string;
  tierAccent: string;
  tierBorderColor: string;
  projectName: string;
  industry: string;
  description: string;
  capabilities: string[];
  image: string;
  imageAlt: string;
  demoUrl?: string;
  isAvailable: boolean;
}

/**
 * Catálogo de entregables preparado para los 6 paquetes de Grupo Castillo.
 * Los paquetes Platinum y Diamond quedan configurados con isAvailable: false
 * para ser activados posteriormente cuando sus demostraciones completas estén listas.
 */
