---
interface Props {
  type: 
    | 'iron' | 'bronze' | 'silver' | 'gold' | 'platinum' | 'diamond'
    | 'checkup' | 'audit' | 'rescue' | 'emergency' | 'care'
    | 'contacto' | 'diagnostico' | 'terminos'
    | 'soluciones' | 'proceso' | 'seguridad-calidad' | 'proyectos'
    | 'nosotros' | 'paquetes' | 'auditoria' | 'intervencion' | 'transformacion' | 'cuidado';
}

const { type } = Astro.props;
---

<div class="inner-hero-visual-wrapper" data-type={type} aria-hidden="true">
  <div class={`inner-hero-fallback-bg theme-${type}`}></div>
  <canvas class="inner-hero-canvas"></canvas>
  <div class="inner-hero-contrast-mask"></div>
</div>

<style>
  .inner-hero-visual-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    background: #06080C;
  }

  .inner-hero-fallback-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(circle at 50% 50%, rgba(0, 210, 255, 0.12) 0%, rgba(6, 8, 12, 0.8) 55%, #06080C 90%);
  }

  .inner-hero-fallback-bg.theme-iron {
    background: radial-gradient(circle at 50% 50%, rgba(148, 163, 184, 0.15) 0%, rgba(6, 8, 12, 0.82) 55%, #06080C 90%);
  }
  .inner-hero-fallback-bg.theme-bronze {
    background: radial-gradient(circle at 50% 50%, rgba(205, 127, 50, 0.16) 0%, rgba(6, 8, 12, 0.82) 55%, #06080C 90%);
  }
  .inner-hero-fallback-bg.theme-silver {
    background: radial-gradient(circle at 50% 50%, rgba(226, 232, 240, 0.14) 0%, rgba(6, 8, 12, 0.82) 55%, #06080C 90%);
  }
  .inner-hero-fallback-bg.theme-gold {
    background: radial-gradient(circle at 50% 50%, rgba(255, 215, 0, 0.16) 0%, rgba(6, 8, 12, 0.82) 55%, #06080C 90%);
  }
  .inner-hero-fallback-bg.theme-platinum {
    background: radial-gradient(circle at 50% 50%, rgba(224, 231, 255, 0.15) 0%, rgba(6, 8, 12, 0.82) 55%, #06080C 90%);
  }
  .inner-hero-fallback-bg.theme-diamond {
    background: radial-gradient(circle at 50% 50%, rgba(0, 229, 255, 0.18) 0%, rgba(6, 8, 12, 0.8) 55%, #06080C 90%);
  }
  .inner-hero-fallback-bg.theme-checkup,
  .inner-hero-fallback-bg.theme-emergency,
  .inner-hero-fallback-bg.theme-care,
  .inner-hero-fallback-bg.theme-audit,
  .inner-hero-fallback-bg.theme-terminos {
    background: radial-gradient(circle at 50% 50%, rgba(0, 229, 153, 0.14) 0%, rgba(6, 8, 12, 0.82) 55%, #06080C 90%);
  }

  .inner-hero-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    z-index: 2;
  }

  .inner-hero-contrast-mask {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: radial-gradient(
      ellipse 75% 65% at 50% 50%,
      rgba(6, 8, 12, 0.82) 0%,
      rgba(6, 8, 12, 0.55) 50%,
      rgba(6, 8, 12, 0.15) 80%,
      rgba(6, 8, 12, 0.92) 100%
    );
  }
</style>

<script is:inline>
  class FlagshipInnerHeroEngine {
    constructor(element) {
      this.wrapper = element;
      this.type = element.getAttribute('data-type') || 'soluciones';
      this.canvas = element.querySelector('.inner-hero-canvas');
      if (!this.canvas) return;
      this.ctx = this.canvas.getContext('2d');
      if (!this.ctx) return;
      
      this.width = 0;
      this.height = 0;
      this.dpi = Math.min(window.devicePixelRatio || 1, 2);
      this.time = 0;
      this.frameId = null;
      this.isVisible = false;
      this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Parallax smooth interpolation
      this.mouse = { x: 0, y: 0, targetX: 0, targetY: 0 };
      this.scrollY = 0;

      // Ambient background particles & telemetry
      this.ambientParticles = [];
      this.floorGridStep = 60;

      this.init();
    }

    init() {
      this.resize();
      window.addEventListener('resize', () => this.resize(), { passive: true });

      const heroSection = this.wrapper.closest('.page-hero') || this.wrapper.closest('section');
      if (heroSection) {
        heroSection.addEventListener('mousemove', (e) => {
          const rect = heroSection.getBoundingClientRect();
          const normX = (e.clientX - rect.left) / rect.width - 0.5;
          const normY = (e.clientY - rect.top) / rect.height - 0.5;
          this.mouse.targetX = normX * 28;
          this.mouse.targetY = normY * 18;
        }, { passive: true });

        heroSection.addEventListener('mouseleave', () => {
          this.mouse.targetX = 0;
          this.mouse.targetY = 0;
        }, { passive: true });
      }

      window.addEventListener('scroll', () => {
        this.scrollY = window.scrollY || 0;
      }, { passive: true });

      this.setupScene();

      this.observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          this.isVisible = entry.isIntersecting;
          if (this.isVisible) {
            if (this.reducedMotion) {
              this.draw();
            } else if (!this.frameId) {
              this.loop();
            }
          } else {
            if (this.frameId) {
              cancelAnimationFrame(this.frameId);
              this.frameId = null;
            }
          }
        });
      }, { threshold: 0.05 });

      this.observer.observe(this.wrapper);
    }

    resize() {
      this.width = this.wrapper.clientWidth || window.innerWidth;
      this.height = this.wrapper.clientHeight || 520;
      
      this.canvas.width = Math.floor(this.width * this.dpi);
      this.canvas.height = Math.floor(this.height * this.dpi);
      
      this.ctx.setTransform(this.dpi, 0, 0, this.dpi, 0, 0);
      this.setupScene();

      if (this.reducedMotion || !this.isVisible) {
        this.draw();
      }
    }

    setupScene() {
      const isMobile = this.width < 768;
      const cx = this.width * 0.5;
      const cy = this.height * 0.5;

      // Ambient background particles for all scenes
      this.ambientParticles = [];
      const particleCount = isMobile ? 12 : 24;
      for (let i = 0; i < particleCount; i++) {
        this.ambientParticles.push({
          x: Math.random() * this.width,
          y: Math.random() * this.height,
          size: Math.random() * 1.5 + 0.8,
          speedY: -(Math.random() * 0.2 + 0.08),
          speedX: (Math.random() - 0.5) * 0.15,
          alpha: Math.random() * 0.4 + 0.1,
          phase: Math.random() * Math.PI * 2
        });
      }

      // ==========================================
      // 1. IRON: Metallic Precision Diamond-Truss
      // ==========================================
      if (this.type === 'iron') {
        this.ironTrusses = [];
        const spanW = isMobile ? this.width * 0.9 : Math.min(this.width * 0.8, 1000);
        const startX = (this.width - spanW) / 2;
        const topY = cy - (isMobile ? 100 : 130);
        const botY = cy + (isMobile ? 100 : 130);
        const segments = isMobile ? 6 : 10;
        const segW = spanW / segments;

        // Structural Nodes & Chords
        for (let i = 0; i <= segments; i++) {
          const x = startX + i * segW;
          this.ironTrusses.push({
            top: { x, y: topY },
            bot: { x, y: botY },
            weldPulse: (i * 0.2) % 1.0,
            speed: 0.008 + (i % 3) * 0.004
          });
        }
      }

      // ==========================================
      // 2. BRONZE: Tech-Copper Inbound Funnel Vortex
      // ==========================================
      else if (this.type === 'bronze') {
        this.bronzeSpirals = [];
        const pCount = isMobile ? 18 : 34;
        for (let i = 0; i < pCount; i++) {
          this.bronzeSpirals.push({
            angle: Math.random() * Math.PI * 2,
            distance: Math.random() * (isMobile ? 150 : 280) + 30,
            speed: Math.random() * 0.012 + 0.006,
            radialSpeed: Math.random() * 0.4 + 0.25,
            size: Math.random() * 2.2 + 1.2,
            alpha: Math.random() * 0.7 + 0.3
          });
        }
        this.bronzeRings = [
          { r: isMobile ? 50 : 85, speed: 0.008 },
          { r: isMobile ? 100 : 165, speed: -0.005 },
          { r: isMobile ? 150 : 245, speed: 0.003 }
        ];
      }

      // ==========================================
      // 3. SILVER: Modular Crystal Matrix Blueprint
      // ==========================================
      else if (this.type === 'silver') {
        this.silverPanels = [];
        const cols = isMobile ? 4 : 7;
        const rows = isMobile ? 3 : 4;
        const cellW = isMobile ? 65 : 85;
        const cellH = isMobile ? 65 : 80;
        const startX = cx - (cols * cellW) / 2;
        const startY = cy - (rows * cellH) / 2;

        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            this.silverPanels.push({
              x: startX + c * cellW,
              y: startY + r * cellH,
              w: cellW - 10,
              h: cellH - 10,
              phase: (r * cols + c) * 0.3,
              activePulse: 0
            });
          }
        }
      }

      // ==========================================
      // 4. GOLD: Expanding Solar Harmonic Dynamo
      // ==========================================
      else if (this.type === 'gold') {
        this.goldRays = [];
        const rayCount = isMobile ? 12 : 20;
        for (let i = 0; i < rayCount; i++) {
          this.goldRays.push({
            angle: (i / rayCount) * Math.PI * 2,
            length: isMobile ? 140 : 250,
            pulseOffset: i * 0.3
          });
        }
        this.goldPhotons = [];
        const photonCount = isMobile ? 8 : 16;
        for (let p = 0; p < photonCount; p++) {
          this.goldPhotons.push({
            orbit: (p % 4) + 1,
            ang: (p / photonCount) * Math.PI * 2,
            speed: (0.012 - (p % 4) * 0.002) * (p % 2 === 0 ? 1 : -1)
          });
        }
      }

      // ==========================================
      // 5. PLATINUM: Enterprise Multi-Bus Architecture
      // ==========================================
      else if (this.type === 'platinum') {
        this.platHighways = [];
        const busCount = isMobile ? 4 : 6;
        const totalH = isMobile ? 220 : 300;
        const startY = cy - totalH / 2;
        const spacing = totalH / (busCount - 1);

        for (let b = 0; b < busCount; b++) {
          const packets = [];
          const pCount = isMobile ? 2 : 4;
          for (let k = 0; k < pCount; k++) {
            packets.push({
              pos: Math.random(),
              speed: (Math.random() * 0.006 + 0.004) * (b % 2 === 0 ? 1 : -1),
              isData: Math.random() > 0.4
            });
          }
          this.platHighways.push({
            y: startY + b * spacing,
            packets,
            busIndex: b
          });
        }
      }

      // ==========================================
      // 6. DIAMOND: 3D Faceted Hyper-Polytope
      // ==========================================
      else if (this.type === 'diamond') {
        this.polytopeVertices = [];
        const radius = isMobile ? 110 : 180;
        // 12 vertices of an icosahedron
        const phi = (1 + Math.sqrt(5)) / 2;
        const rawCoords = [
          [-1, phi, 0], [1, phi, 0], [-1, -phi, 0], [1, -phi, 0],
          [0, -1, phi], [0, 1, phi], [0, -1, -phi], [0, 1, -phi],
          [phi, 0, -1], [phi, 0, 1], [-phi, 0, -1], [-phi, 0, 1]
        ];
        this.polytopeVertices = rawCoords.map(([x, y, z]) => {
          const len = Math.hypot(x, y, z);
          return {
            x: (x / len) * radius,
            y: (y / len) * radius,
            z: (z / len) * radius
          };
        });
      }

      // ==========================================
      // 7. CHECKUP: 360° Tactical Diagnostic Radar
      // ==========================================
      else if (this.type === 'checkup' || this.type === 'auditoria') {
        this.radarTargets = [];
        const targetCount = isMobile ? 12 : 22;
        const maxR = isMobile ? 120 : 210;
        for (let i = 0; i < targetCount; i++) {
          const ang = Math.random() * Math.PI * 2;
          const dist = Math.random() * (maxR - 25) + 25;
          this.radarTargets.push({
            ang,
            dist,
            label: i % 3 === 0 ? 'SYS:OK' : (i % 3 === 1 ? 'PERF:99' : 'GATE:PASS'),
            activePing: 0
          });
        }
      }

      // ==========================================
      // 8. AUDIT: Forensic Stack & Code Registers
      // ==========================================
      else if (this.type === 'audit') {
        this.auditRegisters = [];
        const regCount = isMobile ? 4 : 5;
        const stackW = isMobile ? this.width * 0.85 : Math.min(this.width * 0.75, 820);
        const startX = (this.width - stackW) / 2;
        const startY = cy - (isMobile ? 110 : 130);
        const rowH = isMobile ? 45 : 55;

        for (let r = 0; r < regCount; r++) {
          this.auditRegisters.push({
            x: startX,
            y: startY + r * rowH,
            w: stackW,
            h: rowH - 10,
            scanX: Math.random(),
            scanSpeed: 0.005 + (r % 3) * 0.003,
            hexTag: `0x${(r * 256 + 128).toString(16).toUpperCase()}`
          });
        }
      }

      // ==========================================
      // 9. RESCUE: Dual-Phase Laminar Remediation
      // ==========================================
      else if (this.type === 'rescue' || this.type === 'intervencion') {
        this.rescueWaves = [];
        const waveCount = isMobile ? 4 : 6;
        for (let w = 0; w < waveCount; w++) {
          this.rescueWaves.push({
            baseY: cy - (isMobile ? 90 : 120) + w * (isMobile ? 45 : 50),
            amplitude: 25 - w * 2.5,
            freq: 0.015 + w * 0.003,
            speed: 0.03 + w * 0.005,
            phase: w * 0.8
          });
        }
      }

      // ==========================================
      // 10. EMERGENCY: Spherical Containment Forcefield
      // ==========================================
      else if (this.type === 'emergency') {
        this.forcefieldRings = [];
        const ringCount = isMobile ? 3 : 5;
        const maxR = isMobile ? 120 : 200;
        for (let r = 1; r <= ringCount; r++) {
          this.forcefieldRings.push({
            radius: (r / ringCount) * maxR,
            pulseSpeed: 0.015 + r * 0.004,
            segments: 8 + r * 2
          });
        }
      }

      // ==========================================
      // 11. CARE: 24/7 Telemetry Health ECG Waveform
      // ==========================================
      else if (this.type === 'care' || this.type === 'cuidado') {
        this.ecgHead = 0;
        this.ecgPoints = [];
        const totalPoints = 120;
        for (let i = 0; i < totalPoints; i++) {
          this.ecgPoints.push(0);
        }
      }

      // ==========================================
      // 12. CONTACTO: Intake Convergence Portal
      // ==========================================
      else if (this.type === 'contacto') {
        this.portalConduits = [];
        const cCount = isMobile ? 12 : 20;
        for (let i = 0; i < cCount; i++) {
          this.portalConduits.push({
            ang: (i / cCount) * Math.PI * 2,
            distance: isMobile ? 140 : 260,
            pulsePos: (i * 0.15) % 1.0
          });
        }
        this.portalRings = [0.2, 0.45, 0.7, 0.95];
      }

      // ==========================================
      // 13. DIAGNOSTICO: Topological Decision Tree
      // ==========================================
      else if (this.type === 'diagnostico') {
        this.decisionNodes = [];
        const spreadX = isMobile ? 120 : 220;
        const spreadY = isMobile ? 80 : 110;

        // Root Intake Node
        this.decisionNodes.push({ x: cx - spreadX, y: cy, label: "IN", type: "root" });
        // Branch Tier 1
        this.decisionNodes.push({ x: cx, y: cy - spreadY * 0.7, label: "BUILD", type: "branch" });
        this.decisionNodes.push({ x: cx, y: cy + spreadY * 0.7, label: "RESCUE", type: "branch" });
        // Branch Tier 2
        this.decisionNodes.push({ x: cx + spreadX, y: cy - spreadY, label: "GATE", type: "leaf" });
        this.decisionNodes.push({ x: cx + spreadX, y: cy, label: "AUDIT", type: "leaf" });
        this.decisionNodes.push({ x: cx + spreadX, y: cy + spreadY, label: "CARE", type: "leaf" });
      }

      // ==========================================
      // 14. TERMINOS: Cryptographic Ledger & Seal
      // ==========================================
      else if (this.type === 'terminos' || this.type === 'nosotros') {
        this.ledgerLines = [];
        const lineCount = isMobile ? 6 : 9;
        const docW = isMobile ? this.width * 0.8 : Math.min(this.width * 0.7, 720);
        const startX = (this.width - docW) / 2;
        const startY = cy - (isMobile ? 95 : 120);

        for (let i = 0; i < lineCount; i++) {
          this.ledgerLines.push({
            x: startX,
            y: startY + i * (isMobile ? 32 : 30),
            len: docW * (0.65 + (i % 3) * 0.15),
            verified: i % 2 === 0
          });
        }
      }

      // Backwards compatibility fallbacks
      else if (this.type === 'soluciones') {
        this.solOrbits = [
          { r: isMobile ? 75 : 120, speed: 0.01, nodes: 4 },
          { r: isMobile ? 130 : 210, speed: -0.006, nodes: 6 }
        ];
      }
      else if (this.type === 'proceso') {
        this.pipeStages = 9;
      }
      else if (this.type === 'seguridad-calidad') {
        this.shieldAngles = [0, Math.PI / 4, Math.PI / 2, (3 * Math.PI) / 4, Math.PI, (5 * Math.PI) / 4, (3 * Math.PI) / 2, (7 * Math.PI) / 4];
      }
      else if (this.type === 'proyectos') {
        this.constellationNodes = [];
        const count = isMobile ? 12 : 24;
        for (let i = 0; i < count; i++) {
          this.constellationNodes.push({
            x: Math.random() * this.width,
            y: Math.random() * this.height,
            vx: (Math.random() - 0.5) * 0.25,
            vy: (Math.random() - 0.5) * 0.25,
            size: Math.random() * 2.2 + 1.2
          });
        }
      }
    }

    draw() {
      if (!this.ctx) return;
      this.ctx.clearRect(0, 0, this.width, this.height);

      const isMobile = this.width < 768;
      // Centered anchor with smooth mouse parallax
      const cx = this.width * 0.5 + this.mouse.x;
      const cy = this.height * 0.5 + this.mouse.y - (this.scrollY * 0.05);

      // ==========================================
      // GLOBAL DEPTH LAYER 1: Perspective Grid Floor & Horizon
      // ==========================================
      this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.035)';
      this.ctx.lineWidth = 0.6;
      const step = isMobile ? 75 : 55;

      for (let x = 0; x <= this.width; x += step) {
        this.ctx.beginPath();
        this.ctx.moveTo(x, 0);
        this.ctx.lineTo(x, this.height);
        this.ctx.stroke();
      }

      for (let y = 0; y <= this.height; y += step) {
        this.ctx.beginPath();
        this.ctx.moveTo(0, y);
        this.ctx.lineTo(this.width, y);
        this.ctx.stroke();
      }

      // ==========================================
      // GLOBAL DEPTH LAYER 2: Ambient Floating Micro-Particles
      // ==========================================
      this.ambientParticles.forEach((p) => {
        if (!this.reducedMotion) {
          p.y += p.speedY;
          p.x += p.speedX;
          if (p.y < 0) p.y = this.height;
          if (p.x < 0) p.x = this.width;
          if (p.x > this.width) p.x = 0;
        }

        const twinkle = Math.sin(this.time * 2 + p.phase) * 0.5 + 0.5;
        this.ctx.beginPath();
        this.ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        this.ctx.fillStyle = `rgba(0, 210, 255, ${p.alpha * (0.3 + twinkle * 0.7)})`;
        this.ctx.fill();
      });

      // ==========================================
      // SCENE 1: IRON (Metallic Cold Steel Diamond-Truss)
      // ==========================================
      if (this.type === 'iron') {
        const topY = cy - (isMobile ? 100 : 130);
        const botY = cy + (isMobile ? 100 : 130);

        // Main Horizontal Chords
        this.ctx.beginPath();
        this.ctx.moveTo(this.ironTrusses[0].top.x, topY);
        this.ctx.lineTo(this.ironTrusses[this.ironTrusses.length - 1].top.x, topY);
        this.ctx.moveTo(this.ironTrusses[0].bot.x, botY);
        this.ctx.lineTo(this.ironTrusses[this.ironTrusses.length - 1].bot.x, botY);
        this.ctx.strokeStyle = 'rgba(148, 163, 184, 0.35)';
        this.ctx.lineWidth = 2.0;
        this.ctx.stroke();

        // Diagonal Web Members & Weld Laser Pulses
        for (let i = 0; i < this.ironTrusses.length - 1; i++) {
          const t1 = this.ironTrusses[i];
          const t2 = this.ironTrusses[i + 1];

          // Cross-diagonal beams
          this.ctx.beginPath();
          this.ctx.moveTo(t1.top.x, t1.top.y);
          this.ctx.lineTo(t2.bot.x, t2.bot.y);
          this.ctx.moveTo(t1.bot.x, t1.bot.y);
          this.ctx.lineTo(t2.top.x, t2.top.y);
          this.ctx.strokeStyle = 'rgba(148, 163, 184, 0.18)';
          this.ctx.lineWidth = 1.2;
          this.ctx.stroke();

          // Vertical Stiffeners
          this.ctx.beginPath();
          this.ctx.moveTo(t1.top.x, t1.top.y);
          this.ctx.lineTo(t1.bot.x, t1.bot.y);
          this.ctx.strokeStyle = 'rgba(148, 163, 184, 0.25)';
          this.ctx.lineWidth = 1.4;
          this.ctx.stroke();

          if (!this.reducedMotion) {
            t1.weldPulse += t1.speed;
            if (t1.weldPulse > 1) t1.weldPulse = 0;
          }

          // Laser Weld Travel Nodes (Diamond Energy Pulses)
          const px1 = t1.top.x + (t2.bot.x - t1.top.x) * t1.weldPulse;
          const py1 = t1.top.y + (t2.bot.y - t1.top.y) * t1.weldPulse;
          this.ctx.beginPath();
          this.ctx.arc(px1, py1, 3.5, 0, Math.PI * 2);
          this.ctx.fillStyle = '#F1F5F9';
          this.ctx.shadowColor = '#00D2FF';
          this.ctx.shadowBlur = 8;
          this.ctx.fill();
          this.ctx.shadowBlur = 0;
        }

        // Structural Caliper Crosshairs
        this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.4)';
        this.ctx.lineWidth = 1.0;
        this.ctx.strokeRect(cx - 30, cy - 30, 60, 60);
        this.ctx.beginPath();
        this.ctx.moveTo(cx - 40, cy); this.ctx.lineTo(cx + 40, cy);
        this.ctx.moveTo(cx, cy - 40); this.ctx.lineTo(cx, cy + 40);
        this.ctx.stroke();
      }

      // ==========================================
      // SCENE 2: BRONZE (Tech-Copper Inbound Capture Vortex)
      // ==========================================
      else if (this.type === 'bronze') {
        // Concentric Segmented Copper Flux Rings
        this.bronzeRings.forEach((ring, idx) => {
          this.ctx.beginPath();
          this.ctx.arc(cx, cy, ring.radius, 0, Math.PI * 2);
          this.ctx.strokeStyle = `rgba(205, 127, 50, ${0.15 + idx * 0.08})`;
          this.ctx.lineWidth = 1.5;
          this.ctx.setLineDash([12, 8]);
          this.ctx.stroke();
          this.ctx.setLineDash([]);
        });

        // Inbound Spiral Particles converging toward central core
        this.bronzeSpirals.forEach((p) => {
          if (!this.reducedMotion) {
            p.angle += p.speed;
            p.distance -= p.radialSpeed;
            if (p.distance < 12) {
              p.distance = isMobile ? 150 : 280;
            }
          }

          const px = cx + Math.cos(p.angle) * p.distance;
          const py = cy + Math.sin(p.angle) * p.distance;

          // Inbound trajectory tensor lines
          this.ctx.beginPath();
          this.ctx.moveTo(px, py);
          this.ctx.lineTo(cx, cy);
          this.ctx.strokeStyle = `rgba(205, 127, 50, ${0.06 * p.alpha})`;
          this.ctx.lineWidth = 0.8;
          this.ctx.stroke();

          // Particle node
          this.ctx.beginPath();
          this.ctx.arc(px, py, p.size, 0, Math.PI * 2);
          this.ctx.fillStyle = '#FFA726';
          this.ctx.fill();
        });

        // Glowing Copper Central Plasma Core
        const corePulse = Math.sin(this.time * 2) * 0.2 + 0.8;
        this.ctx.beginPath();
        this.ctx.arc(cx, cy, (isMobile ? 16 : 24) * corePulse, 0, Math.PI * 2);
        this.ctx.fillStyle = 'rgba(205, 127, 50, 0.4)';
        this.ctx.shadowColor = '#FFB74D';
        this.ctx.shadowBlur = 20;
        this.ctx.fill();
        this.ctx.shadowBlur = 0;

        this.ctx.beginPath();
        this.ctx.arc(cx, cy, 6, 0, Math.PI * 2);
        this.ctx.fillStyle = '#FFF3E0';
        this.ctx.fill();
      }

      // ==========================================
      // SCENE 3: SILVER (Modular Crystal Matrix Blueprint)
      // ==========================================
      else if (this.type === 'silver') {
        this.silverPanels.forEach((panel) => {
          const osc = Math.sin(this.time * 2.2 + panel.phase) * 0.5 + 0.5;

          // Panel Glass Background
          this.ctx.fillStyle = 'rgba(15, 23, 42, 0.82)';
          this.ctx.fillRect(panel.x, panel.y, panel.w, panel.h);

          // Silver High-Contrast Bezel
          this.ctx.strokeStyle = `rgba(226, 232, 240, ${0.2 + osc * 0.5})`;
          this.ctx.lineWidth = 1.2;
          this.ctx.strokeRect(panel.x, panel.y, panel.w, panel.h);

          // Micro-logic registration pin
          this.ctx.fillStyle = `rgba(226, 232, 240, ${0.4 + osc * 0.6})`;
          this.ctx.fillRect(panel.x + 5, panel.y + 5, 4, 4);

          // Diagonal holographic circuit trace
          this.ctx.beginPath();
          this.ctx.moveTo(panel.x + 12, panel.y + panel.h - 8);
          this.ctx.lineTo(panel.x + panel.w - 8, panel.y + 12);
          this.ctx.strokeStyle = `rgba(56, 189, 248, ${0.15 + osc * 0.35})`;
          this.ctx.lineWidth = 0.8;
          this.ctx.stroke();
        });

        // Global Matrix Horizontal Scanning Alignment Line
        const scanY = cy - 100 + ((this.time * 60) % 200);
        this.ctx.beginPath();
        this.ctx.moveTo(cx - 300, scanY);
        this.ctx.lineTo(cx + 300, scanY);
        this.ctx.strokeStyle = 'rgba(226, 232, 240, 0.45)';
        this.ctx.lineWidth = 1.4;
        this.ctx.stroke();
      }

      // ==========================================
      // SCENE 4: GOLD (Expanding Solar Harmonic Dynamo)
      // ==========================================
      else if (this.type === 'gold') {
        // Multi-ring Counter-rotating Golden Dynamo
        const r1 = isMobile ? 55 : 90;
        const r2 = isMobile ? 105 : 170;
        const r3 = isMobile ? 155 : 240;

        [r1, r2, r3].forEach((radius, idx) => {
          const rot = this.time * (0.4 - idx * 0.15) * (idx % 2 === 0 ? 1 : -1);
          this.ctx.beginPath();
          this.ctx.arc(cx, cy, radius, 0, Math.PI * 2);
          this.ctx.strokeStyle = `rgba(255, 215, 0, ${0.2 + idx * 0.1})`;
          this.ctx.lineWidth = idx === 1 ? 2.0 : 1.2;
          this.ctx.stroke();

          // Gear notch markings
          const notches = 12 + idx * 4;
          for (let n = 0; n < notches; n++) {
            const ang = (n / notches) * Math.PI * 2 + rot;
            const nx1 = cx + Math.cos(ang) * (radius - 5);
            const ny1 = cy + Math.sin(ang) * (radius - 5);
            const nx2 = cx + Math.cos(ang) * (radius + 5);
            const ny2 = cy + Math.sin(ang) * (radius + 5);
            this.ctx.beginPath();
            this.ctx.moveTo(nx1, ny1);
            this.ctx.lineTo(nx2, ny2);
            this.ctx.strokeStyle = 'rgba(255, 215, 0, 0.4)';
            this.ctx.lineWidth = 1.5;
            this.ctx.stroke();
          }
        });

        // Orbiting Gold Photons
        this.goldPhotons.forEach((p) => {
          if (!this.reducedMotion) {
            p.ang += p.speed;
          }
          const radius = p.orbit * (isMobile ? 35 : 55);
          const px = cx + Math.cos(p.ang) * radius;
          const py = cy + Math.sin(p.ang) * radius;

          this.ctx.beginPath();
          this.ctx.arc(px, py, 3.5, 0, Math.PI * 2);
          this.ctx.fillStyle = '#FFFBEB';
          this.ctx.shadowColor = '#FFD700';
          this.ctx.shadowBlur = 12;
          this.ctx.fill();
          this.ctx.shadowBlur = 0;
        });

        // Center Golden Fusion Core
        this.ctx.beginPath();
        this.ctx.arc(cx, cy, 14, 0, Math.PI * 2);
        this.ctx.fillStyle = '#FFD700';
        this.ctx.shadowColor = '#F59E0B';
        this.ctx.shadowBlur = 24;
        this.ctx.fill();
        this.ctx.shadowBlur = 0;
      }

      // ==========================================
      // SCENE 5: PLATINUM (Enterprise Multi-Bus Architecture)
      // ==========================================
      else if (this.type === 'platinum') {
        const startX = cx - (isMobile ? this.width * 0.42 : Math.min(this.width * 0.4, 460));
        const endX = cx + (isMobile ? this.width * 0.42 : Math.min(this.width * 0.4, 460));

        // High-Speed Data Highway Traces
        this.platHighways.forEach((bus) => {
          this.ctx.beginPath();
          this.ctx.moveTo(startX, bus.y);
          this.ctx.lineTo(endX, bus.y);
          this.ctx.strokeStyle = 'rgba(224, 231, 255, 0.25)';
          this.ctx.lineWidth = 1.8;
          this.ctx.stroke();

          // Bus Routing Junction Pins
          for (let j = 0; j < 5; j++) {
            const jx = startX + (j / 4) * (endX - startX);
            this.ctx.beginPath();
            this.ctx.arc(jx, bus.y, 3, 0, Math.PI * 2);
            this.ctx.fillStyle = 'rgba(224, 231, 255, 0.6)';
            this.ctx.fill();

            // Vertical Bus Bridging Line
            if (bus.busIndex < this.platHighways.length - 1) {
              const nextBusY = this.platHighways[bus.busIndex + 1].y;
              this.ctx.beginPath();
              this.ctx.moveTo(jx, bus.y);
              this.ctx.lineTo(jx, nextBusY);
              this.ctx.strokeStyle = 'rgba(129, 140, 248, 0.12)';
              this.ctx.lineWidth = 0.8;
              this.ctx.stroke();
            }
          }

          // Quantum Packets Navigating Highways
          bus.packets.forEach((pkt) => {
            if (!this.reducedMotion) {
              pkt.pos += pkt.speed;
              if (pkt.pos > 1) pkt.pos = 0;
              if (pkt.pos < 0) pkt.pos = 1;
            }
            const px = startX + (endX - startX) * pkt.pos;
            this.ctx.beginPath();
            this.ctx.arc(px, bus.y, 4, 0, Math.PI * 2);
            this.ctx.fillStyle = pkt.isData ? '#38BDF8' : '#FFFFFF';
            this.ctx.shadowColor = '#818CF8';
            this.ctx.shadowBlur = 8;
            this.ctx.fill();
            this.ctx.shadowBlur = 0;
          });
        });
      }

      // ==========================================
      // SCENE 6: DIAMOND (3D Faceted Hyper-Polytope Lattice)
      // ==========================================
      else if (this.type === 'diamond') {
        const rotX = this.time * 0.4 + this.mouse.y * 0.01;
        const rotY = this.time * 0.5 + this.mouse.x * 0.01;

        // 3D Matrix Projection
        const projVertices = this.polytopeVertices.map((v) => {
          // Rotate Y
          let x1 = v.x * Math.cos(rotY) + v.z * Math.sin(rotY);
          let z1 = -v.x * Math.sin(rotY) + v.z * Math.cos(rotY);
          // Rotate X
          let y2 = v.y * Math.cos(rotX) - z1 * Math.sin(rotX);
          let z2 = v.y * Math.sin(rotX) + z1 * Math.cos(rotX);
          // Perspective scale
          const fov = 380;
          const scale = fov / (fov + z2);
          return {
            x: cx + x1 * scale,
            y: cy + y2 * scale,
            z: z2,
            scale
          };
        });

        // Polytope Facet Interconnects
        this.ctx.beginPath();
        for (let i = 0; i < projVertices.length; i++) {
          for (let j = i + 1; j < projVertices.length; j++) {
            const v1 = projVertices[i];
            const v2 = projVertices[j];
            const dist = Math.hypot(v1.x - v2.x, v1.y - v2.y);
            if (dist < (isMobile ? 120 : 190)) {
              this.ctx.moveTo(v1.x, v1.y);
              this.ctx.lineTo(v2.x, v2.y);
            }
          }
        }
        this.ctx.strokeStyle = 'rgba(0, 229, 255, 0.35)';
        this.ctx.lineWidth = 1.2;
        this.ctx.stroke();

        // Facet Vertices & Caustic Starbursts
        projVertices.forEach((v) => {
          this.ctx.beginPath();
          this.ctx.arc(v.x, v.y, 3.5 * v.scale, 0, Math.PI * 2);
          this.ctx.fillStyle = '#FFFFFF';
          this.ctx.shadowColor = '#00E5FF';
          this.ctx.shadowBlur = 10;
          this.ctx.fill();
          this.ctx.shadowBlur = 0;
        });
      }

      // ==========================================
      // SCENE 7: CHECKUP (360° Tactical Agile Diagnostic Radar)
      // ==========================================
      else if (this.type === 'checkup' || this.type === 'auditoria') {
        const radarR = isMobile ? 120 : 210;

        // Polar Radar Rings
        [0.35, 0.65, 1.0].forEach((ratio) => {
          this.ctx.beginPath();
          this.ctx.arc(cx, cy, radarR * ratio, 0, Math.PI * 2);
          this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.25)';
          this.ctx.lineWidth = 1.2;
          this.ctx.stroke();
        });

        // Cardinal Radar Axes
        this.ctx.beginPath();
        this.ctx.moveTo(cx - radarR, cy); this.ctx.lineTo(cx + radarR, cy);
        this.ctx.moveTo(cx, cy - radarR); this.ctx.lineTo(cx, cy + radarR);
        this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.2)';
        this.ctx.lineWidth = 1.0;
        this.ctx.stroke();

        // 360° Phosphor Sweep Cone
        const sweepAng = (this.time * 1.8) % (Math.PI * 2);
        this.ctx.beginPath();
        this.ctx.moveTo(cx, cy);
        this.ctx.arc(cx, cy, radarR, sweepAng - 0.45, sweepAng);
        this.ctx.closePath();
        this.ctx.fillStyle = 'rgba(0, 210, 255, 0.16)';
        this.ctx.fill();

        // Sweep Lead Line
        this.ctx.beginPath();
        this.ctx.moveTo(cx, cy);
        this.ctx.lineTo(cx + Math.cos(sweepAng) * radarR, cy + Math.sin(sweepAng) * radarR);
        this.ctx.strokeStyle = '#00E599';
        this.ctx.lineWidth = 2.0;
        this.ctx.stroke();

        // Radar Target Nodes
        this.radarTargets.forEach((tgt) => {
          const tx = cx + Math.cos(tgt.ang) * tgt.dist;
          const ty = cy + Math.sin(tgt.ang) * tgt.dist;
          const angDiff = Math.abs((sweepAng % (Math.PI * 2)) - (tgt.ang % (Math.PI * 2)));
          const isScanned = angDiff < 0.35;

          this.ctx.beginPath();
          this.ctx.arc(tx, ty, isScanned ? 4.5 : 2.5, 0, Math.PI * 2);
          this.ctx.fillStyle = isScanned ? '#00E599' : 'rgba(0, 210, 255, 0.4)';
          this.ctx.fill();

          if (isScanned) {
            this.ctx.beginPath();
            this.ctx.arc(tx, ty, 10, 0, Math.PI * 2);
            this.ctx.strokeStyle = 'rgba(0, 229, 153, 0.5)';
            this.ctx.stroke();
          }
        });
      }

      // ==========================================
      // SCENE 8: AUDIT (Forensic Stack & Code Registers)
      // ==========================================
      else if (this.type === 'audit') {
        this.auditRegisters.forEach((reg) => {
          if (!this.reducedMotion) {
            reg.scanX += reg.scanSpeed;
            if (reg.scanX > 1) reg.scanX = 0;
          }

          // Register Glass Panel
          this.ctx.fillStyle = 'rgba(15, 23, 42, 0.78)';
          this.ctx.fillRect(reg.x, reg.y, reg.w, reg.h);
          this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.3)';
          this.ctx.lineWidth = 1.2;
          this.ctx.strokeRect(reg.x, reg.y, reg.w, reg.h);

          // Forensic Disassembly Tag
          this.ctx.font = '9px "JetBrains Mono", monospace';
          this.ctx.fillStyle = '#94A3B8';
          this.ctx.fillText(reg.hexTag, reg.x + 8, reg.y + reg.h / 2 + 3);

          // Moving Forensic Laser Caliper
          const scanPos = reg.x + 80 + reg.scanX * (reg.w - 100);
          this.ctx.beginPath();
          this.ctx.moveTo(scanPos, reg.y - 4);
          this.ctx.lineTo(scanPos, reg.y + reg.h + 4);
          this.ctx.strokeStyle = '#00E599';
          this.ctx.lineWidth = 2.0;
          this.ctx.shadowColor = '#00E599';
          this.ctx.shadowBlur = 8;
          this.ctx.stroke();
          this.ctx.shadowBlur = 0;
        });
      }

      // ==========================================
      // SCENE 9: RESCUE (Dual-Phase Laminar Remediation)
      // ==========================================
      else if (this.type === 'rescue' || this.type === 'intervencion') {
        const startX = cx - (isMobile ? this.width * 0.44 : Math.min(this.width * 0.42, 480));
        const totalW = (isMobile ? this.width * 0.88 : Math.min(this.width * 0.84, 960));

        this.rescueWaves.forEach((wave) => {
          this.ctx.beginPath();
          for (let x = 0; x <= totalW; x += 8) {
            const normX = x / totalW;
            const isTurbulent = normX < 0.5;
            // Left is chaotic turbulence, right is smooth laminar stability
            const chaosFactor = isTurbulent ? (1 - normX * 2) * 1.8 : 0.15;
            const noise = Math.sin(this.time * 4 + x * 0.1) * (isTurbulent ? 8 * chaosFactor : 0);
            const waveY = wave.baseY + Math.sin(this.time * wave.speed * 40 + normX * 8 + wave.phase) * wave.amplitude * (1 - normX * 0.6) + noise;

            if (x === 0) this.ctx.moveTo(startX + x, waveY);
            else this.ctx.lineTo(startX + x, waveY);
          }
          this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.45)';
          this.ctx.lineWidth = 1.6;
          this.ctx.stroke();
        });

        // Central Remediation Threshold Line
        this.ctx.beginPath();
        this.ctx.moveTo(cx, cy - 130);
        this.ctx.lineTo(cx, cy + 130);
        this.ctx.strokeStyle = '#00E599';
        this.ctx.lineWidth = 2.0;
        this.ctx.setLineDash([8, 6]);
        this.ctx.stroke();
        this.ctx.setLineDash([]);
      }

      // ==========================================
      // SCENE 10: EMERGENCY (Spherical Containment Forcefield)
      // ==========================================
      else if (this.type === 'emergency') {
        this.forcefieldRings.forEach((ring, idx) => {
          const pulse = Math.sin(this.time * ring.pulseSpeed * 40 + idx * 0.8) * 0.5 + 0.5;
          this.ctx.beginPath();
          this.ctx.arc(cx, cy, ring.radius, 0, Math.PI * 2);
          this.ctx.strokeStyle = `rgba(0, 210, 255, ${0.18 + pulse * 0.32})`;
          this.ctx.lineWidth = 1.5;
          this.ctx.stroke();

          // Perimeter Defensive Cardinal Pylons
          if (idx === this.forcefieldRings.length - 1) {
            for (let a = 0; a < 4; a++) {
              const ang = (a * Math.PI) / 2;
              const tx1 = cx + Math.cos(ang) * (ring.radius - 8);
              const ty1 = cy + Math.sin(ang) * (ring.radius - 8);
              const tx2 = cx + Math.cos(ang) * (ring.radius + 8);
              const ty2 = cy + Math.sin(ang) * (ring.radius + 8);
              this.ctx.beginPath();
              this.ctx.moveTo(tx1, ty1);
              this.ctx.lineTo(tx2, ty2);
              this.ctx.strokeStyle = '#00E599';
              this.ctx.lineWidth = 2.0;
              this.ctx.stroke();
            }
          }
        });

        // Steady Central Command Emerald Beacon (Harmonic breathing)
        const beaconPulse = Math.sin(this.time * 2.0) * 0.25 + 0.75;
        this.ctx.beginPath();
        this.ctx.arc(cx, cy, 7, 0, Math.PI * 2);
        this.ctx.fillStyle = `rgba(0, 229, 153, ${beaconPulse})`;
        this.ctx.shadowColor = '#00E599';
        this.ctx.shadowBlur = 16;
        this.ctx.fill();
        this.ctx.shadowBlur = 0;
      }

      // ==========================================
      // SCENE 11: CARE (24/7 Enterprise Telemetry ECG Waveform)
      // ==========================================
      else if (this.type === 'care' || this.type === 'cuidado') {
        const startX = cx - (isMobile ? this.width * 0.44 : Math.min(this.width * 0.42, 460));
        const totalW = (isMobile ? this.width * 0.88 : Math.min(this.width * 0.84, 920));
        const midY = cy;

        // Baseline Oscilloscope Reference Line
        this.ctx.beginPath();
        this.ctx.moveTo(startX, midY);
        this.ctx.lineTo(startX + totalW, midY);
        this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.15)';
        this.ctx.lineWidth = 1.0;
        this.ctx.stroke();

        // Medical-Grade Continuous ECG Heartbeat Wave
        this.ctx.beginPath();
        const ptCount = 90;
        for (let i = 0; i < ptCount; i++) {
          const norm = i / ptCount;
          const x = startX + norm * totalW;
          const phase = (this.time * 1.8 + norm * 3) % 1.0;
          let dy = 0;
          if (phase > 0.42 && phase < 0.58) {
            if (phase < 0.46) dy = 12; // P wave
            else if (phase < 0.49) dy = -8; // Q dip
            else if (phase < 0.52) dy = -42; // R spike
            else if (phase < 0.55) dy = 18; // S dip
            else dy = -16; // T wave
          }

          if (i === 0) this.ctx.moveTo(x, midY + dy);
          else this.ctx.lineTo(x, midY + dy);
        }
        this.ctx.strokeStyle = '#00E599';
        this.ctx.lineWidth = 2.0;
        this.ctx.shadowColor = '#00E599';
        this.ctx.shadowBlur = 10;
        this.ctx.stroke();
        this.ctx.shadowBlur = 0;
      }

      // ==========================================
      // SCENE 12: CONTACTO (Intake Convergence Portal)
      // ==========================================
      else if (this.type === 'contacto') {
        const maxR = isMobile ? 110 : 190;

        // Inward Contracting Portal Rings
        this.portalRings.forEach((_, idx) => {
          if (!this.reducedMotion) {
            this.portalRings[idx] -= 0.005;
            if (this.portalRings[idx] < 0.05) this.portalRings[idx] = 1.0;
          }
          const radius = this.portalRings[idx] * maxR;
          this.ctx.beginPath();
          this.ctx.arc(cx, cy, radius, 0, Math.PI * 2);
          this.ctx.strokeStyle = `rgba(0, 210, 255, ${0.12 + (1 - this.portalRings[idx]) * 0.45})`;
          this.ctx.lineWidth = 1.5;
          this.ctx.stroke();
        });

        // Inbound Convergence Conduits
        this.portalConduits.forEach((c) => {
          const px1 = cx + Math.cos(c.ang) * c.distance;
          const py1 = cy + Math.sin(c.ang) * c.distance;
          this.ctx.beginPath();
          this.ctx.moveTo(px1, py1);
          this.ctx.lineTo(cx, cy);
          this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.12)';
          this.ctx.lineWidth = 0.8;
          this.ctx.stroke();

          // Traveling Intake Payload Token
          if (!this.reducedMotion) {
            c.pulsePos += 0.008;
            if (c.pulsePos > 1) c.pulsePos = 0;
          }
          const tokenX = px1 + (cx - px1) * c.pulsePos;
          const tokenY = py1 + (cy - py1) * c.pulsePos;
          this.ctx.beginPath();
          this.ctx.arc(tokenX, tokenY, 3, 0, Math.PI * 2);
          this.ctx.fillStyle = '#00E599';
          this.ctx.fill();
        });

        // Center Connection Nexus
        this.ctx.beginPath();
        this.ctx.arc(cx, cy, 10, 0, Math.PI * 2);
        this.ctx.fillStyle = '#00D2FF';
        this.ctx.shadowColor = '#00D2FF';
        this.ctx.shadowBlur = 16;
        this.ctx.fill();
        this.ctx.shadowBlur = 0;
      }

      // ==========================================
      // SCENE 13: DIAGNOSTICO (Topological Decision Tree)
      // ==========================================
      else if (this.type === 'diagnostico') {
        const root = this.decisionNodes[0];

        // Routing Conduits
        for (let i = 1; i < this.decisionNodes.length; i++) {
          const target = this.decisionNodes[i];
          this.ctx.beginPath();
          this.ctx.moveTo(root.x, root.y);
          this.ctx.lineTo(target.x, target.y);
          this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.28)';
          this.ctx.lineWidth = 1.4;
          this.ctx.stroke();

          // Traveling Decision Tokens
          const prog = (this.time * 0.7 + i * 0.22) % 1.0;
          const px = root.x + (target.x - root.x) * prog;
          const py = root.y + (target.y - root.y) * prog;
          this.ctx.beginPath();
          this.ctx.arc(px, py, 3.5, 0, Math.PI * 2);
          this.ctx.fillStyle = '#00E599';
          this.ctx.shadowColor = '#00E599';
          this.ctx.shadowBlur = 8;
          this.ctx.fill();
          this.ctx.shadowBlur = 0;
        }

        // Decision Category Nodes
        this.decisionNodes.forEach((node) => {
          this.ctx.beginPath();
          this.ctx.arc(node.x, node.y, node.type === 'root' ? 8 : 6, 0, Math.PI * 2);
          this.ctx.fillStyle = node.type === 'root' ? '#00E599' : '#00D2FF';
          this.ctx.fill();

          this.ctx.font = '8px "JetBrains Mono", monospace';
          this.ctx.fillStyle = '#94A3B8';
          this.ctx.fillText(node.label, node.x - 12, node.y - 10);
        });
      }

      // ==========================================
      // SCENE 14: TERMINOS (Cryptographic Consensus Ledger & Seal)
      // ==========================================
      else if (this.type === 'terminos' || this.type === 'nosotros') {
        const scanIdx = Math.floor((this.time * 0.75) % this.ledgerLines.length);

        this.ledgerLines.forEach((line, idx) => {
          const isScanning = idx === scanIdx;
          this.ctx.beginPath();
          this.ctx.moveTo(line.x, line.y);
          this.ctx.lineTo(line.x + line.len, line.y);
          this.ctx.strokeStyle = isScanning 
            ? 'rgba(0, 229, 153, 0.75)' 
            : 'rgba(148, 163, 184, 0.22)';
          this.ctx.lineWidth = isScanning ? 2.0 : 1.2;
          this.ctx.stroke();

          // Verified Clause Marker
          if (line.verified) {
            this.ctx.beginPath();
            this.ctx.arc(line.x - 8, line.y, 2.5, 0, Math.PI * 2);
            this.ctx.fillStyle = isScanning ? '#00E599' : 'rgba(0, 210, 255, 0.4)';
            this.ctx.fill();
          }
        });

        // SHA-256 Symmetrical Cryptographic Seal (Centered Right)
        const sealX = cx + (isMobile ? 100 : 220);
        const sealY = cy;
        const sealBreath = Math.sin(this.time * 1.5) * 0.2 + 0.8;

        this.ctx.strokeStyle = `rgba(0, 229, 153, ${sealBreath})`;
        this.ctx.lineWidth = 1.5;
        this.ctx.strokeRect(sealX - 28, sealY - 28, 56, 56);

        // Corner registration brackets
        this.ctx.strokeStyle = '#00D2FF';
        this.ctx.lineWidth = 2.0;
        this.ctx.strokeRect(sealX - 31, sealY - 31, 7, 7);
        this.ctx.strokeRect(sealX + 24, sealY + 24, 7, 7);

        this.ctx.font = '8px "JetBrains Mono", monospace';
        this.ctx.fillStyle = `rgba(0, 229, 153, ${sealBreath})`;
        this.ctx.fillText("SHA256", sealX - 17, sealY + 3);
      }

      // Backwards Compatibility Fallbacks
      else if (this.type === 'soluciones') {
        this.solOrbits.forEach((orbit) => {
          this.ctx.beginPath();
          this.ctx.arc(cx, cy, orbit.r, 0, Math.PI * 2);
          this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.15)';
          this.ctx.stroke();

          for (let i = 0; i < orbit.nodes; i++) {
            const angle = (i / orbit.nodes) * Math.PI * 2 + (this.time * orbit.speed);
            const nx = cx + Math.cos(angle) * orbit.r;
            const ny = cy + Math.sin(angle) * orbit.r;
            this.ctx.beginPath();
            this.ctx.arc(nx, ny, 3.5, 0, Math.PI * 2);
            this.ctx.fillStyle = '#00D2FF';
            this.ctx.fill();
          }
        });
      }
      else if (this.type === 'proceso') {
        const startX = cx - (isMobile ? 140 : 260);
        const endX = cx + (isMobile ? 140 : 260);
        this.ctx.beginPath();
        this.ctx.moveTo(startX, cy);
        this.ctx.lineTo(endX, cy);
        this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.25)';
        this.ctx.lineWidth = 1.5;
        this.ctx.stroke();

        for (let s = 0; s < 9; s++) {
          const sx = startX + (s / 8) * (endX - startX);
          this.ctx.beginPath();
          this.ctx.arc(sx, cy, 3.5, 0, Math.PI * 2);
          this.ctx.fillStyle = s === Math.floor(this.time * 2) % 9 ? '#00E599' : 'rgba(0, 210, 255, 0.5)';
          this.ctx.fill();
        }
      }
      else if (this.type === 'seguridad-calidad') {
        const shieldR = isMobile ? 80 : 130;
        this.ctx.beginPath();
        for (let i = 0; i < this.shieldAngles.length; i++) {
          const ang = this.shieldAngles[i] + this.time * 0.2;
          const sx = cx + Math.cos(ang) * shieldR;
          const sy = cy + Math.sin(ang) * (shieldR * 0.6);
          if (i === 0) this.ctx.moveTo(sx, sy);
          else this.ctx.lineTo(sx, sy);
        }
        this.ctx.closePath();
        this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.45)';
        this.ctx.lineWidth = 1.5;
        this.ctx.stroke();
      }
      else if (this.type === 'proyectos') {
        this.constellationNodes.forEach((node) => {
          if (!this.reducedMotion) {
            node.x += node.vx;
            node.y += node.vy;
            if (node.x < 0) node.x = this.width;
            if (node.x > this.width) node.x = 0;
            if (node.y < 0) node.y = this.height;
            if (node.y > this.height) node.y = 0;
          }
          this.ctx.beginPath();
          this.ctx.arc(node.x, node.y, node.size, 0, Math.PI * 2);
          this.ctx.fillStyle = 'rgba(0, 210, 255, 0.65)';
          this.ctx.fill();
        });
      }
    }

    loop() {
      this.time += 0.016;
      this.draw();

      if (this.isVisible && !this.reducedMotion) {
        this.frameId = requestAnimationFrame(() => this.loop());
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.inner-hero-visual-wrapper').forEach((el) => {
      new FlagshipInnerHeroEngine(el);
    });
  });
</script>
