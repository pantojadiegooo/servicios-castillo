---
interface Props {
  type: 
    | 'iron' | 'bronze' | 'silver' | 'gold' | 'platinum' | 'diamond'
    | 'checkup' | 'audit' | 'rescue' | 'emergency' | 'care'
    | 'contacto' | 'diagnostico' | 'terminos'
    | 'soluciones' | 'proceso' | 'seguridad-calidad' | 'proyectos'
    | 'nosotros' | 'paquetes' | 'auditoria' | 'intervencion' | 'transformacion' | 'cuidado'; // Backwards compatibility
}

const { type } = Astro.props;
---

<div class="inner-hero-visual-wrapper" data-type={type} aria-hidden="true">
  <div class="inner-hero-fallback-bg"></div>
  <canvas class="inner-hero-canvas"></canvas>
  <div class="inner-hero-contrast-mask"></div>
</div>

<style>
  .inner-hero-visual-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    background: #06080c;
  }

  .inner-hero-fallback-bg {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse 70% 60% at 50% 50%, rgba(0, 210, 255, 0.12) 0%, rgba(6, 8, 12, 0.75) 55%, #06080c 90%),
      linear-gradient(180deg, rgba(6, 8, 12, 0.3) 0%, rgba(6, 8, 12, 0.95) 100%);
    pointer-events: none;
    z-index: 1;
  }

  .inner-hero-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    z-index: 2;
  }

  .inner-hero-contrast-mask {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: radial-gradient(
      ellipse 80% 70% at 50% 50%,
      rgba(6, 8, 12, 0.86) 0%,
      rgba(6, 8, 12, 0.52) 55%,
      rgba(6, 8, 12, 0.12) 85%,
      rgba(6, 8, 12, 0.92) 100%
    );
  }
</style>

<script is:inline>
  class PrecisionInnerHeroVisual {
    constructor(element) {
      this.wrapper = element;
      this.type = element.getAttribute('data-type') || 'soluciones';
      this.canvas = element.querySelector('.inner-hero-canvas');
      if (!this.canvas) return;
      this.ctx = this.canvas.getContext('2d');
      if (!this.ctx) return;
      
      this.width = 0;
      this.height = 0;
      this.dpi = Math.min(window.devicePixelRatio || 1, 2);
      this.time = 0;
      this.frameId = null;
      this.isVisible = false;
      this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Parallax state
      this.mouse = { x: 0, y: 0, targetX: 0, targetY: 0 };
      this.scrollY = 0;

      this.init();
    }

    init() {
      this.resize();
      window.addEventListener('resize', () => this.resize(), { passive: true });

      const heroSection = this.wrapper.closest('.page-hero') || this.wrapper.closest('section');
      if (heroSection) {
        heroSection.addEventListener('mousemove', (e) => {
          const rect = heroSection.getBoundingClientRect();
          const normX = (e.clientX - rect.left) / rect.width - 0.5;
          const normY = (e.clientY - rect.top) / rect.height - 0.5;
          this.mouse.targetX = normX * 32;
          this.mouse.targetY = normY * 20;
        }, { passive: true });

        heroSection.addEventListener('mouseleave', () => {
          this.mouse.targetX = 0;
          this.mouse.targetY = 0;
        }, { passive: true });
      }

      window.addEventListener('scroll', () => {
        this.scrollY = window.scrollY || 0;
      }, { passive: true });

      this.setupScene();

      this.observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          this.isVisible = entry.isIntersecting;
          if (this.isVisible) {
            if (this.reducedMotion) {
              this.draw();
            } else if (!this.frameId) {
              this.loop();
            }
          } else {
            if (this.frameId) {
              cancelAnimationFrame(this.frameId);
              this.frameId = null;
            }
          }
        });
      }, { threshold: 0.05 });

      this.observer.observe(this.wrapper);
    }

    resize() {
      this.width = this.wrapper.clientWidth || window.innerWidth;
      this.height = this.wrapper.clientHeight || 440;
      
      this.canvas.width = Math.floor(this.width * this.dpi);
      this.canvas.height = Math.floor(this.height * this.dpi);
      
      this.ctx.setTransform(this.dpi, 0, 0, this.dpi, 0, 0);
      this.setupScene();

      if (this.reducedMotion || !this.isVisible) {
        this.draw();
      }
    }

    setupScene() {
      const isMobile = this.width < 768;

      // 1. IRON: Minimalist metallic structural trusses
      if (this.type === 'iron') {
        this.ironBeams = [];
        const beamCount = isMobile ? 4 : 8;
        for (let i = 0; i < beamCount; i++) {
          this.ironBeams.push({
            x1: (i / beamCount) * this.width,
            y1: (i % 2 === 0) ? 40 : this.height - 40,
            x2: ((i + 1) / beamCount) * this.width,
            y2: (i % 2 === 0) ? this.height - 40 : 40,
            pulsePos: Math.random(),
            speed: 0.008 + (i % 3) * 0.003
          });
        }
      }

      // 2. BRONZE: Inbound capture network
      else if (this.type === 'bronze') {
        this.bronzeNodes = [];
        const nodeCount = isMobile ? 5 : 9;
        const cx = this.width * 0.72;
        const cy = this.height * 0.5;
        for (let i = 0; i < nodeCount; i++) {
          const ang = (i / nodeCount) * Math.PI * 2;
          const dist = isMobile ? 70 + (i % 3) * 30 : 120 + (i % 3) * 45;
          this.bronzeNodes.push({
            x: cx + Math.cos(ang) * dist,
            y: cy + Math.sin(ang) * dist,
            cx, cy,
            progress: Math.random(),
            speed: 0.006 + Math.random() * 0.005,
            size: Math.random() * 2.5 + 2
          });
        }
      }

      // 3. SILVER: Structured corporate architecture grid
      else if (this.type === 'silver') {
        this.silverGrid = [];
        const rows = isMobile ? 3 : 4;
        const cols = isMobile ? 4 : 7;
        const startX = this.width * 0.55;
        const startY = 60;
        const cellW = isMobile ? 45 : 55;
        const cellH = isMobile ? 50 : 65;

        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            this.silverGrid.push({
              x: startX + c * cellW,
              y: startY + r * cellH,
              w: cellW - 8,
              h: cellH - 10,
              activePhase: (r * cols + c) * 0.35
            });
          }
        }
      }

      // 4. GOLD: Radial expansion circuits
      else if (this.type === 'gold') {
        this.goldRings = [];
        const ringCount = isMobile ? 4 : 7;
        const cx = this.width * 0.75;
        const cy = this.height * 0.5;
        for (let r = 1; r <= ringCount; r++) {
          this.goldRings.push({
            cx, cy,
            radius: r * (isMobile ? 22 : 32),
            speed: (0.008 + r * 0.002) * (r % 2 === 0 ? 1 : -1),
            sparks: []
          });
        }
      }

      // 5. PLATINUM: Multi-tier inter-system bus
      else if (this.type === 'platinum') {
        this.platBuses = [];
        const busCount = isMobile ? 3 : 5;
        for (let b = 0; b < busCount; b++) {
          const y = 80 + b * (isMobile ? 50 : 55);
          this.platBuses.push({
            y,
            speed: 0.005 + b * 0.002,
            packets: [
              { pos: 0.1, val: false },
              { pos: 0.55, val: true },
              { pos: 0.85, val: false }
            ]
          });
        }
      }

      // 6. DIAMOND: Crystalline multifaceted polytope
      else if (this.type === 'diamond') {
        this.diamondVertices = [];
        const facetCount = isMobile ? 6 : 10;
        const cx = this.width * 0.75;
        const cy = this.height * 0.5;
        const radius = isMobile ? 75 : 125;

        for (let i = 0; i < facetCount; i++) {
          const ang = (i / facetCount) * Math.PI * 2;
          this.diamondVertices.push({
            x: cx + Math.cos(ang) * radius,
            y: cy + Math.sin(ang) * radius * 0.65,
            z: Math.sin(ang) * 40,
            ang,
            speed: 0.008 + (i % 3) * 0.002
          });
        }
      }

      // 7. CHECKUP: 72h Agile Diagnosis Radar
      else if (this.type === 'checkup' || this.type === 'auditoria') {
        this.checkupPoints = [];
        const cx = this.width * 0.74;
        const cy = this.height * 0.5;
        const ptCount = isMobile ? 12 : 24;
        for (let i = 0; i < ptCount; i++) {
          const ang = Math.random() * Math.PI * 2;
          const dist = Math.random() * (isMobile ? 80 : 130) + 15;
          this.checkupPoints.push({
            x: cx + Math.cos(ang) * dist,
            y: cy + Math.sin(ang) * dist,
            ang,
            dist,
            status: Math.random() > 0.3 ? 'ok' : 'scan',
            pulse: 0
          });
        }
      }

      // 8. AUDIT: Deep forensic code inspection layers
      else if (this.type === 'audit') {
        this.auditLayers = [];
        const layerCount = isMobile ? 3 : 5;
        for (let l = 0; l < layerCount; l++) {
          this.auditLayers.push({
            y: 70 + l * (isMobile ? 55 : 60),
            depth: l,
            scanPos: Math.random(),
            speed: 0.004 + l * 0.0015
          });
        }
      }

      // 9. RESCUE: Stabilization & remediation wave
      else if (this.type === 'rescue' || this.type === 'intervencion') {
        this.rescueLines = [];
        const lineCount = isMobile ? 4 : 7;
        for (let i = 0; i < lineCount; i++) {
          this.rescueLines.push({
            baseY: 90 + i * (isMobile ? 45 : 42),
            amplitude: 18 - i * 2,
            speed: 0.03 + i * 0.005,
            phase: i * 0.8
          });
        }
      }

      // 10. EMERGENCY: Priority containment forcefield
      else if (this.type === 'emergency') {
        this.emergencyRings = [];
        const cx = this.width * 0.74;
        const cy = this.height * 0.5;
        for (let r = 0; r < 4; r++) {
          this.emergencyRings.push({
            cx, cy,
            radius: 20 + r * (isMobile ? 24 : 36),
            pulseSpeed: 0.025 + r * 0.005
          });
        }
      }

      // 11. CARE: Heartbeat continuity waveform
      else if (this.type === 'care' || this.type === 'cuidado') {
        this.heartbeatData = [];
        const pts = 80;
        for (let i = 0; i < pts; i++) {
          this.heartbeatData.push(0);
        }
      }

      // 12. CONTACTO: Intake portal
      else if (this.type === 'contacto') {
        this.portalRings = [0.2, 0.45, 0.7, 0.95];
      }

      // 13. DIAGNOSTICO: Decision branching tree
      else if (this.type === 'diagnostico') {
        this.diagNodes = [];
        const cx = this.width * 0.72;
        const cy = this.height * 0.5;
        // Root node + 4 branches
        this.diagNodes.push({ x: cx - 110, y: cy, label: "IN" });
        this.diagNodes.push({ x: cx, y: cy - 60, label: "BUILD" });
        this.diagNodes.push({ x: cx, y: cy + 60, label: "RESCUE" });
        this.diagNodes.push({ x: cx + 110, y: cy - 60, label: "GATE" });
        this.diagNodes.push({ x: cx + 110, y: cy + 60, label: "CARE" });
      }

      // 14. TERMINOS: Document legal precision grid & seal
      else if (this.type === 'terminos' || this.type === 'nosotros') {
        this.docLines = [];
        const lineCount = isMobile ? 5 : 8;
        const startX = this.width * 0.62;
        for (let i = 0; i < lineCount; i++) {
          this.docLines.push({
            x: startX,
            y: 80 + i * (isMobile ? 32 : 30),
            len: isMobile ? 120 : (160 + (i % 3) * 35),
            verified: i % 2 === 0
          });
        }
      }

      // 15. SOLUCIONES: Multi-domain hexagonal network
      else if (this.type === 'soluciones') {
        this.solOrbits = [
          { r: isMobile ? 65 : 105, speed: 0.012, nodes: 3 },
          { r: isMobile ? 110 : 175, speed: -0.007, nodes: 4 }
        ];
      }

      // 16. PROCESO: 9-stage delivery pipeline
      else if (this.type === 'proceso') {
        this.pipelineStages = 9;
        this.activePulse = 0;
      }

      // 17. SEGURIDAD-CALIDAD: 3D rotating shield
      else if (this.type === 'seguridad-calidad') {
        this.shieldAngles = [0, Math.PI / 4, Math.PI / 2, (3 * Math.PI) / 4, Math.PI, (5 * Math.PI) / 4, (3 * Math.PI) / 2, (7 * Math.PI) / 4];
      }

      // 18. PROYECTOS: Deployed constellation
      else if (this.type === 'proyectos') {
        this.constellationNodes = [];
        const count = isMobile ? 10 : 20;
        const offset = this.width * 0.58;
        for (let i = 0; i < count; i++) {
          this.constellationNodes.push({
            x: offset + Math.random() * (isMobile ? 140 : 260),
            y: Math.random() * (this.height - 80) + 40,
            vx: (Math.random() - 0.5) * 0.2,
            vy: (Math.random() - 0.5) * 0.2,
            size: Math.random() * 2.2 + 1.2
          });
        }
      }
    }

    draw() {
      if (!this.ctx) return;
      this.ctx.clearRect(0, 0, this.width, this.height);

      const isMobile = this.width < 768;
      const cx = this.width * 0.74 + this.mouse.x * 0.35;
      const cy = this.height * 0.5 + this.mouse.y * 0.35 - (this.scrollY * 0.08);

      // BASE PERSPECTIVE GRID (COMMON TECH-NOIR GROUND)
      this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.025)';
      this.ctx.lineWidth = 0.5;
      const step = 55;
      for (let x = 0; x < this.width; x += step) {
        this.ctx.beginPath();
        this.ctx.moveTo(x, 0);
        this.ctx.lineTo(x, this.height);
        this.ctx.stroke();
      }

      // ==========================================
      // 1. IRON: Cold Steel Trusses & Micro-Assembly
      // ==========================================
      if (this.type === 'iron') {
        this.ironBeams.forEach((b) => {
          this.ctx.beginPath();
          this.ctx.moveTo(b.x1, b.y1);
          this.ctx.lineTo(b.x2, b.y2);
          this.ctx.strokeStyle = 'rgba(148, 163, 184, 0.15)';
          this.ctx.lineWidth = 1.2;
          this.ctx.stroke();

          if (!this.reducedMotion) {
            b.pulsePos += b.speed;
            if (b.pulsePos > 1) b.pulsePos = 0;
          }

          const px = b.x1 + (b.x2 - b.x1) * b.pulsePos;
          const py = b.y1 + (b.y2 - b.y1) * b.pulsePos;
          this.ctx.beginPath();
          this.ctx.arc(px, py, 3, 0, Math.PI * 2);
          this.ctx.fillStyle = '#F1F5F9';
          this.ctx.fill();
        });
      }

      // ==========================================
      // 2. BRONZE: Tech Copper Inbound Funnel
      // ==========================================
      else if (this.type === 'bronze') {
        this.bronzeNodes.forEach((n) => {
          this.ctx.beginPath();
          this.ctx.moveTo(n.x, n.y);
          this.ctx.lineTo(cx, cy);
          this.ctx.strokeStyle = 'rgba(205, 127, 50, 0.18)';
          this.ctx.lineWidth = 1.0;
          this.ctx.stroke();

          if (!this.reducedMotion) {
            n.progress += n.speed;
            if (n.progress > 1) n.progress = 0;
          }

          const px = n.x + (cx - n.x) * n.progress;
          const py = n.y + (cy - n.y) * n.progress;
          this.ctx.beginPath();
          this.ctx.arc(px, py, n.size, 0, Math.PI * 2);
          this.ctx.fillStyle = '#E5A855';
          this.ctx.fill();

          // Node origin
          this.ctx.beginPath();
          this.ctx.arc(n.x, n.y, 2.5, 0, Math.PI * 2);
          this.ctx.fillStyle = 'rgba(205, 127, 50, 0.6)';
          this.ctx.fill();
        });

        // Central Bronze Intake Nexus
        this.ctx.beginPath();
        this.ctx.arc(cx, cy, 14, 0, Math.PI * 2);
        this.ctx.strokeStyle = '#CD7F32';
        this.ctx.lineWidth = 2;
        this.ctx.stroke();
      }

      // ==========================================
      // 3. SILVER: Structured Corporate Matrix
      // ==========================================
      else if (this.type === 'silver') {
        this.silverGrid.forEach((cell) => {
          const osc = Math.sin(this.time * 2 + cell.activePhase) * 0.5 + 0.5;
          this.ctx.fillStyle = `rgba(15, 23, 42, 0.85)`;
          this.ctx.fillRect(cell.x, cell.y, cell.w, cell.h);
          this.ctx.strokeStyle = `rgba(226, 232, 240, ${0.15 + osc * 0.4})`;
          this.ctx.lineWidth = 1.0;
          this.ctx.strokeRect(cell.x, cell.y, cell.w, cell.h);

          // Sub-alignment trace
          this.ctx.fillStyle = `rgba(226, 232, 240, ${0.4 + osc * 0.5})`;
          this.ctx.fillRect(cell.x + 4, cell.y + 4, 3, 3);
        });
      }

      // ==========================================
      // 4. GOLD: Expanding Radial Circuits
      // ==========================================
      else if (this.type === 'gold') {
        this.goldRings.forEach((ring, idx) => {
          const pulse = Math.sin(this.time * 2 + idx * 0.6) * 0.5 + 0.5;
          this.ctx.beginPath();
          this.ctx.arc(cx, cy, ring.radius, 0, Math.PI * 2);
          this.ctx.strokeStyle = `rgba(255, 215, 0, ${0.15 + pulse * 0.25})`;
          this.ctx.lineWidth = idx % 2 === 0 ? 1.4 : 0.8;
          this.ctx.stroke();

          // Gold orbiting sparks
          const ang = this.time * ring.speed * 2 + idx;
          const sx = cx + Math.cos(ang) * ring.radius;
          const sy = cy + Math.sin(ang) * ring.radius;
          this.ctx.beginPath();
          this.ctx.arc(sx, sy, 3, 0, Math.PI * 2);
          this.ctx.fillStyle = '#FFD700';
          this.ctx.fill();
        });
      }

      // ==========================================
      // 5. PLATINUM: High-Tech Multi-System Bus
      // ==========================================
      else if (this.type === 'platinum') {
        this.platBuses.forEach((bus) => {
          const startX = this.width * 0.54;
          const endX = this.width - 20;

          this.ctx.beginPath();
          this.ctx.moveTo(startX, bus.y);
          this.ctx.lineTo(endX, bus.y);
          this.ctx.strokeStyle = `rgba(224, 231, 255, 0.2)`;
          this.ctx.lineWidth = 1.5;
          this.ctx.stroke();

          bus.packets.forEach((pkt) => {
            if (!this.reducedMotion) {
              pkt.pos += bus.speed;
              if (pkt.pos > 1) pkt.pos = 0;
            }
            const px = startX + (endX - startX) * pkt.pos;
            this.ctx.beginPath();
            this.ctx.arc(px, bus.y, 3.2, 0, Math.PI * 2);
            this.ctx.fillStyle = pkt.val ? '#38BDF8' : '#FFFFFF';
            this.ctx.fill();
          });
        });
      }

      // ==========================================
      // 6. DIAMOND: Crystalline Facet Polytope
      // ==========================================
      else if (this.type === 'diamond') {
        this.ctx.beginPath();
        for (let i = 0; i < this.diamondVertices.length; i++) {
          const v = this.diamondVertices[i];
          const ang = v.ang + this.time * v.speed;
          const radius = isMobile ? 75 : 125;
          const vx = cx + Math.cos(ang) * radius;
          const vy = cy + Math.sin(ang) * (radius * 0.6);
          if (i === 0) this.ctx.moveTo(vx, vy);
          else this.ctx.lineTo(vx, vy);

          // Center cross-facets
          this.ctx.moveTo(cx, cy);
          this.ctx.lineTo(vx, vy);
          this.ctx.moveTo(vx, vy);
        }
        this.ctx.closePath();
        this.ctx.strokeStyle = 'rgba(0, 229, 255, 0.45)';
        this.ctx.lineWidth = 1.2;
        this.ctx.stroke();

        // Facet vertices
        this.diamondVertices.forEach((v) => {
          const ang = v.ang + this.time * v.speed;
          const radius = isMobile ? 75 : 125;
          const vx = cx + Math.cos(ang) * radius;
          const vy = cy + Math.sin(ang) * (radius * 0.6);
          this.ctx.beginPath();
          this.ctx.arc(vx, vy, 3, 0, Math.PI * 2);
          this.ctx.fillStyle = '#FFFFFF';
          this.ctx.fill();
        });
      }

      // ==========================================
      // 7. CHECKUP: 72h Radar Sweep & Checkpoints
      // ==========================================
      else if (this.type === 'checkup' || this.type === 'auditoria') {
        const radarR = isMobile ? 95 : 145;
        // Radar ring
        this.ctx.beginPath();
        this.ctx.arc(cx, cy, radarR, 0, Math.PI * 2);
        this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.35)';
        this.ctx.lineWidth = 1.4;
        this.ctx.stroke();

        // Sweeping beam
        const sweepAng = this.time * 1.8;
        this.ctx.beginPath();
        this.ctx.moveTo(cx, cy);
        this.ctx.arc(cx, cy, radarR, sweepAng - 0.4, sweepAng);
        this.ctx.closePath();
        this.ctx.fillStyle = 'rgba(0, 210, 255, 0.15)';
        this.ctx.fill();

        // Checkpoints
        this.checkupPoints.forEach((pt) => {
          const isSweepNear = Math.abs((sweepAng % (Math.PI * 2)) - (pt.ang % (Math.PI * 2))) < 0.35;
          const color = isSweepNear ? '#00E599' : (pt.status === 'ok' ? 'rgba(0, 210, 255, 0.5)' : 'rgba(148, 163, 184, 0.3)');
          this.ctx.beginPath();
          this.ctx.arc(pt.x, pt.y, isSweepNear ? 4 : 2.5, 0, Math.PI * 2);
          this.ctx.fillStyle = color;
          this.ctx.fill();
        });
      }

      // ==========================================
      // 8. AUDIT: Forensic Layers & Inspection
      // ==========================================
      else if (this.type === 'audit') {
        const startX = this.width * 0.54;
        const endX = this.width - 25;
        this.auditLayers.forEach((layer) => {
          if (!this.reducedMotion) {
            layer.scanPos += layer.speed;
            if (layer.scanPos > 1) layer.scanPos = 0;
          }

          this.ctx.fillStyle = 'rgba(15, 23, 42, 0.7)';
          this.ctx.fillRect(startX, layer.y - 12, endX - startX, 24);
          this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.25)';
          this.ctx.strokeRect(startX, layer.y - 12, endX - startX, 24);

          // Forensic crosshair
          const scanX = startX + (endX - startX) * layer.scanPos;
          this.ctx.beginPath();
          this.ctx.moveTo(scanX, layer.y - 14);
          this.ctx.lineTo(scanX, layer.y + 14);
          this.ctx.strokeStyle = '#00E599';
          this.ctx.lineWidth = 2;
          this.ctx.stroke();
        });
      }

      // ==========================================
      // 9. RESCUE: Stabilization Waveform
      // ==========================================
      else if (this.type === 'rescue' || this.type === 'intervencion') {
        const startX = this.width * 0.52;
        const width = this.width * 0.44;

        this.rescueLines.forEach((line) => {
          this.ctx.beginPath();
          for (let x = 0; x < width; x += 10) {
            const normX = x / width;
            // Wave stabilizes from left turbulence to smooth laminar on right
            const amp = line.amplitude * (1 - normX * 0.85);
            const y = line.baseY + Math.sin(this.time * 2 + normX * 6 + line.phase) * amp;
            if (x === 0) this.ctx.moveTo(startX + x, y);
            else this.ctx.lineTo(startX + x, y);
          }
          this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.4)';
          this.ctx.lineWidth = 1.4;
          this.ctx.stroke();
        });
      }

      // ==========================================
      // 10. EMERGENCY: Priority Containment Forcefield
      // ==========================================
      else if (this.type === 'emergency') {
        this.emergencyRings.forEach((ring, idx) => {
          const pulse = Math.sin(this.time * 1.4 + idx * 0.7) * 0.5 + 0.5;
          this.ctx.beginPath();
          this.ctx.arc(cx, cy, ring.radius, 0, Math.PI * 2);
          this.ctx.strokeStyle = `rgba(0, 210, 255, ${0.18 + pulse * 0.32})`;
          this.ctx.lineWidth = 1.5;
          this.ctx.stroke();

          // Cardinal perimeter alignment ticks on outer ring
          if (idx === this.emergencyRings.length - 1) {
            for (let a = 0; a < 4; a++) {
              const ang = (a * Math.PI) / 2;
              const tx1 = cx + Math.cos(ang) * (ring.radius - 6);
              const ty1 = cy + Math.sin(ang) * (ring.radius - 6);
              const tx2 = cx + Math.cos(ang) * (ring.radius + 6);
              const ty2 = cy + Math.sin(ang) * (ring.radius + 6);
              this.ctx.beginPath();
              this.ctx.moveTo(tx1, ty1);
              this.ctx.lineTo(tx2, ty2);
              this.ctx.strokeStyle = 'rgba(0, 229, 153, 0.6)';
              this.ctx.lineWidth = 1.5;
              this.ctx.stroke();
            }
          }
        });

        // Center Priority Steady Beacon (Harmonic breathing)
        const beaconPulse = Math.sin(this.time * 2.0) * 0.3 + 0.7;
        this.ctx.beginPath();
        this.ctx.arc(cx, cy, 6, 0, Math.PI * 2);
        this.ctx.fillStyle = `rgba(0, 229, 153, ${beaconPulse})`;
        this.ctx.fill();

        this.ctx.beginPath();
        this.ctx.arc(cx, cy, 12, 0, Math.PI * 2);
        this.ctx.strokeStyle = `rgba(0, 229, 153, ${beaconPulse * 0.4})`;
        this.ctx.lineWidth = 1.0;
        this.ctx.stroke();
      }

      // ==========================================
      // 11. CARE: Heartbeat ECG Monitor Waveform
      // ==========================================
      else if (this.type === 'care' || this.type === 'cuidado') {
        const startX = this.width * 0.52;
        const w = this.width * 0.44;
        const midY = this.height * 0.5;

        this.ctx.beginPath();
        for (let i = 0; i < 60; i++) {
          const norm = i / 60;
          const x = startX + norm * w;
          const phase = (this.time * 2 + norm * 4) % 1;
          let dy = 0;
          if (phase > 0.45 && phase < 0.55) {
            dy = (phase === 0.5 ? -35 : (phase < 0.5 ? 15 : -15));
          }
          if (i === 0) this.ctx.moveTo(x, midY + dy);
          else this.ctx.lineTo(x, midY + dy);
        }
        this.ctx.strokeStyle = '#00E599';
        this.ctx.lineWidth = 1.8;
        this.ctx.stroke();
      }

      // ==========================================
      // 12. CONTACTO: Intake Portal
      // ==========================================
      else if (this.type === 'contacto') {
        const maxR = isMobile ? 80 : 130;
        this.portalRings.forEach((_, idx) => {
          if (!this.reducedMotion) {
            this.portalRings[idx] -= 0.005;
            if (this.portalRings[idx] < 0.05) this.portalRings[idx] = 1.0;
          }
          const radius = this.portalRings[idx] * maxR;
          this.ctx.beginPath();
          this.ctx.arc(cx, cy, radius, 0, Math.PI * 2);
          this.ctx.strokeStyle = `rgba(0, 210, 255, ${0.1 + (1 - this.portalRings[idx]) * 0.4})`;
          this.ctx.lineWidth = 1.2;
          this.ctx.stroke();
        });
      }

      // ==========================================
      // 13. DIAGNOSTICO: Classification Matrix
      // ==========================================
      else if (this.type === 'diagnostico') {
        const root = this.diagNodes[0];
        for (let i = 1; i < this.diagNodes.length; i++) {
          const target = this.diagNodes[i];
          this.ctx.beginPath();
          this.ctx.moveTo(root.x, root.y);
          this.ctx.lineTo(target.x, target.y);
          this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.25)';
          this.ctx.lineWidth = 1.2;
          this.ctx.stroke();

          // Traveling decision token
          const prog = (this.time * 0.8 + i * 0.25) % 1.0;
          const px = root.x + (target.x - root.x) * prog;
          const py = root.y + (target.y - root.y) * prog;
          this.ctx.beginPath();
          this.ctx.arc(px, py, 3, 0, Math.PI * 2);
          this.ctx.fillStyle = '#00E599';
          this.ctx.fill();
        }

        this.diagNodes.forEach((node) => {
          this.ctx.beginPath();
          this.ctx.arc(node.x, node.y, 6, 0, Math.PI * 2);
          this.ctx.fillStyle = '#00D2FF';
          this.ctx.fill();
        });
      }

      // ==========================================
      // 14. TERMINOS: Legal Cryptographic Seal & Scan
      // ==========================================
      else if (this.type === 'terminos' || this.type === 'nosotros') {
        const scanIndex = Math.floor((this.time * 0.75) % this.docLines.length);

        this.docLines.forEach((line, idx) => {
          const isScanning = idx === scanIndex;
          this.ctx.beginPath();
          this.ctx.moveTo(line.x, line.y);
          this.ctx.lineTo(line.x + line.len, line.y);
          this.ctx.strokeStyle = isScanning 
            ? 'rgba(0, 229, 153, 0.7)' 
            : 'rgba(148, 163, 184, 0.22)';
          this.ctx.lineWidth = isScanning ? 1.8 : 1.2;
          this.ctx.stroke();

          // Clause verification tag
          if (line.verified) {
            this.ctx.beginPath();
            this.ctx.arc(line.x - 8, line.y, 2, 0, Math.PI * 2);
            this.ctx.fillStyle = isScanning ? '#00E599' : 'rgba(0, 210, 255, 0.4)';
            this.ctx.fill();
          }
        });

        // SHA-256 Seal with subtle cryptographic breathing
        const sealX = this.width * 0.82;
        const sealY = this.height * 0.5;
        const sealBreath = Math.sin(this.time * 1.5) * 0.25 + 0.75;

        this.ctx.strokeStyle = `rgba(0, 229, 153, ${sealBreath})`;
        this.ctx.lineWidth = 1.4;
        this.ctx.strokeRect(sealX - 25, sealY - 25, 50, 50);

        // Corner tick accents
        this.ctx.strokeStyle = '#00D2FF';
        this.ctx.lineWidth = 2.0;
        this.ctx.strokeRect(sealX - 27, sealY - 27, 6, 6);
        this.ctx.strokeRect(sealX + 21, sealY + 21, 6, 6);

        this.ctx.font = '8px "JetBrains Mono", monospace';
        this.ctx.fillStyle = `rgba(0, 229, 153, ${sealBreath})`;
        this.ctx.fillText("SHA256", sealX - 18, sealY + 3);
      }

      // ==========================================
      // 15. SOLUCIONES: Orbits & Nodes
      // ==========================================
      else if (this.type === 'soluciones') {
        this.solOrbits.forEach((orbit) => {
          this.ctx.beginPath();
          this.ctx.arc(cx, cy, orbit.r, 0, Math.PI * 2);
          this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.15)';
          this.ctx.stroke();

          for (let i = 0; i < orbit.nodes; i++) {
            const angle = (i / orbit.nodes) * Math.PI * 2 + (this.time * orbit.speed);
            const nx = cx + Math.cos(angle) * orbit.r;
            const ny = cy + Math.sin(angle) * orbit.r;
            this.ctx.beginPath();
            this.ctx.arc(nx, ny, 3.5, 0, Math.PI * 2);
            this.ctx.fillStyle = '#00D2FF';
            this.ctx.fill();
          }
        });
      }

      // ==========================================
      // 16. PROCESO: 9-Stage Pipeline
      // ==========================================
      else if (this.type === 'proceso') {
        const startX = this.width * 0.52;
        const endX = this.width - 25;
        const lineY = this.height * 0.5;

        this.ctx.beginPath();
        this.ctx.moveTo(startX, lineY);
        this.ctx.lineTo(endX, lineY);
        this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.2)';
        this.ctx.lineWidth = 1.5;
        this.ctx.stroke();

        const stageCount = 9;
        for (let s = 0; s < stageCount; s++) {
          const sx = startX + (s / (stageCount - 1)) * (endX - startX);
          this.ctx.beginPath();
          this.ctx.arc(sx, lineY, 3.5, 0, Math.PI * 2);
          this.ctx.fillStyle = s === Math.floor(this.time * 2) % 9 ? '#00E599' : 'rgba(0, 210, 255, 0.5)';
          this.ctx.fill();
        }
      }

      // ==========================================
      // 17. SEGURIDAD-CALIDAD: 3D Shield
      // ==========================================
      else if (this.type === 'seguridad-calidad') {
        const shieldR = isMobile ? 65 : 100;
        this.ctx.beginPath();
        for (let i = 0; i < this.shieldAngles.length; i++) {
          const ang = this.shieldAngles[i] + this.time * 0.2;
          const sx = cx + Math.cos(ang) * shieldR;
          const sy = cy + Math.sin(ang) * (shieldR * 0.6);
          if (i === 0) this.ctx.moveTo(sx, sy);
          else this.ctx.lineTo(sx, sy);
        }
        this.ctx.closePath();
        this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.45)';
        this.ctx.lineWidth = 1.4;
        this.ctx.stroke();
      }

      // ==========================================
      // 18. PROYECTOS: Constellation
      // ==========================================
      else if (this.type === 'proyectos') {
        this.constellationNodes.forEach((node) => {
          if (!this.reducedMotion) {
            node.x += node.vx;
            node.y += node.vy;
          }
          this.ctx.beginPath();
          this.ctx.arc(node.x, node.y, node.size, 0, Math.PI * 2);
          this.ctx.fillStyle = 'rgba(0, 210, 255, 0.65)';
          this.ctx.fill();
        });
      }
    }

    loop() {
      this.time += 0.016;
      this.draw();

      if (this.isVisible && !this.reducedMotion) {
        this.frameId = requestAnimationFrame(() => this.loop());
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.inner-hero-visual-wrapper').forEach((el) => {
      new PrecisionInnerHeroVisual(el);
    });
  });
</script>
