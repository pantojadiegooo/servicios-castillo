---
const navLinks = [
  { href: "index.html",             label: "Inicio" },
  { href: "soluciones.html",        label: "Soluciones" },
  { href: "paquetes.html",          label: "Castle Packages" },
  { href: "seguridad-calidad.html", label: "Security & Quality" },
  { href: "proceso.html",           label: "Proceso" },
  { href: "proyectos.html",         label: "Proyectos" },
  { href: "nosotros.html",          label: "Nosotros" },
];

const pathname = Astro.url.pathname.split("/").pop() || "index.html";
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="index.html">
      <span class="brand-name">Servicios Castillo</span>
      <span class="brand-sub">Grupo Castillo · Soluciones digitales</span>
    </a>
    <button class="nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="main-nav">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
    <nav class="main-nav" id="main-nav" aria-label="Principal">
      <ul>
      {navLinks.map(({ href, label }) => (
        <li><a href={href} aria-current={pathname === href ? "page" : undefined}>{label}</a></li>
      ))}
      <li><a class="nav-cta" href="contacto.html">Iniciar proyecto</a></li>
      </ul>
    </nav>
  </div>
</header>
