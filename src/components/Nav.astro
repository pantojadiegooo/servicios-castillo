---
const navLinks = [
  { href: "/index.html",             label: "Inicio",                  match: "index" },
  { href: "/paquetes.html",          label: "Paquetes",                match: "paquetes" },
  { href: "/servicios.html",         label: "Servicios",               match: "servicios" },
  { href: "/castle-gate.html",       label: "Security & Quality Gate", match: "castle-gate" },
  { href: "/nosotros.html",          label: "Nosotros",                match: "nosotros" },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/index.html">
      <span class="brand-name">Grupo Castillo</span>
      <span class="brand-sub">Ingeniería &amp; Gobernanza Digital</span>
    </a>
    <button class="nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="main-nav">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
    <nav class="main-nav" id="main-nav" aria-label="Principal">
      <ul>
      {navLinks.map(({ href, label, match }) => {
        const isCurrent = currentPath.includes(match) || (match === 'index' && (currentPath === '/' || currentPath === '/index.html'));
        return (
          <li><a href={href} aria-current={isCurrent ? "page" : undefined}>{label}</a></li>
        );
      })}
      <li><a class="nav-cta" href="/contacto.html">Iniciar Proyecto</a></li>
      </ul>
    </nav>
  </div>
</header>
