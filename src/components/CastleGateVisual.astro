---
---
<div class="gate-visual-wrapper" id="gate-visual-wrapper">
  <canvas id="gate-interactive-canvas" class="gate-interactive-canvas" aria-label="Simulación interactiva 3D del portal de control de calidad Castillo Quality Gate"></canvas>
</div>

<style>
  .gate-visual-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
    background: transparent;
    pointer-events: none;
  }

  .gate-interactive-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
</style>

<script is:inline>
  class CastleGateVisual {
    constructor() {
      this.canvas = document.getElementById('gate-interactive-canvas');
      this.wrapper = document.getElementById('gate-visual-wrapper');
      if (!this.canvas || !this.wrapper) return;
      this.ctx = this.canvas.getContext('2d');
      
      this.width = 0;
      this.height = 0;
      this.dpi = window.devicePixelRatio || 1;
      
      this.rotationX = 0.45;
      this.rotationY = -0.45;
      this.targetRotationX = 0.45;
      this.targetRotationY = -0.45;
      
      this.mouse = { x: 0, y: 0, active: false };
      this.time = 0;
      this.frameId = null;
      
      this.nodesCount = 9;
      this.nodeLabels = ["DISCOVER", "DESIGN", "BUILD", "TEST", "AUDIT", "GATE", "LAUNCH", "VERIFY", "EVOLVE"];
      this.nodeCodes = ["0x8A12", "QC_OK", "NODE_03", "PASS_7", "AUD_V", "GATE_ON", "LNC_OK", "VER_20", "EVO_S"];
      this.nodes = [];
      
      this.gridFlashes = [];
      this.particles = [];
      
      this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      
      // Obtener colores del tema CSS de forma segura
      const style = getComputedStyle(document.documentElement);
      this.colors = {
        cyan: style.getPropertyValue('--cyan').trim() || '#00D2FF',
        paper: style.getPropertyValue('--paper').trim() || '#F8F7F4',
        steelSoft: style.getPropertyValue('--steel-soft').trim() || '#8A94A6',
        steelLight: style.getPropertyValue('--steel-light').trim() || '#CBD5E1'
      };
      
      this.init();
    }

    init() {
      this.resize();
      window.addEventListener('resize', () => this.resize());
      
      const heroSection = this.wrapper.closest('.hero') || document.body;
      heroSection.addEventListener('mousemove', (e) => {
        const rect = heroSection.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        this.mouse.x = (e.clientX - centerX) / (rect.width / 2);
        this.mouse.y = (e.clientY - centerY) / (rect.height / 2);
        this.mouse.active = true;
      });
      
      heroSection.addEventListener('mouseleave', () => {
        this.mouse.active = false;
      });

      this.setupNodes();
      this.setupParticles();
      
      if (this.reducedMotion) {
        this.drawStatic();
      } else {
        this.loop();
      }
    }

    resize() {
      this.width = this.wrapper.clientWidth;
      this.height = this.wrapper.clientHeight;
      
      this.canvas.width = this.width * this.dpi;
      this.canvas.height = this.height * this.dpi;
      
      this.ctx.setTransform(this.dpi, 0, 0, this.dpi, 0, 0);
    }

    setupNodes() {
      for (let i = 0; i < this.nodesCount; i++) {
        const angle = (i / this.nodesCount) * Math.PI * 2;
        const isGate = i === 5;
        this.nodes.push({
          angle,
          label: this.nodeLabels[i],
          code: this.nodeCodes[i],
          isGate
        });
      }
    }

    setupParticles() {
      const symbols = ['.', '[]', '{}', '::', '>>', '0x82', 'QC'];
      for (let i = 0; i < 24; i++) {
        this.particles.push({
          x: Math.random() * 200 - 100,
          y: Math.random() * 200 - 100,
          z: Math.random() * 200 - 100,
          vy: -0.2 - Math.random() * 0.4,
          symbol: symbols[Math.floor(Math.random() * symbols.length)],
          size: Math.random() * 5 + 4,
          alpha: Math.random() * 0.15 + 0.04
        });
      }
    }

    rotate3D(x, y, z, rotX, rotY) {
      let cosX = Math.cos(rotX);
      let sinX = Math.sin(rotX);
      let y1 = y * cosX - z * sinX;
      let z1 = y * sinX + z * cosX;
      
      let cosY = Math.cos(rotY);
      let sinY = Math.sin(rotY);
      let x2 = x * cosY + z1 * sinY;
      let z2 = -x * sinY + z1 * cosY;
      
      return { x: x2, y: y1, z: z2 };
    }

    project(point, focalLength, centerX, centerY) {
      const scale = focalLength / (focalLength + point.z);
      const projX = point.x * scale + centerX;
      const projY = point.y * scale + centerY;
      return { x: projX, y: projY, scale };
    }

    drawStatic() {
      this.ctx.clearRect(0, 0, this.width, this.height);
      this.drawGrid();
      
      const isDesktop = this.width >= 880;
      const gateX = isDesktop ? this.width * 0.73 : this.width / 2;
      const gateY = isDesktop ? this.height / 2 : this.height * 0.55;
      
      this.drawPortal(0.45, -0.45, 0, gateX, gateY);
    }

    drawGrid() {
      const cellSize = 56;
      this.ctx.strokeStyle = 'rgba(255, 255, 255, 0.015)';
      this.ctx.lineWidth = 0.5;
      
      // Vertical lines
      for (let x = 0; x < this.width; x += cellSize) {
        this.ctx.beginPath();
        this.ctx.moveTo(x, 0);
        this.ctx.lineTo(x, this.height);
        this.ctx.stroke();
      }
      
      // Horizontal lines
      for (let y = 0; y < this.height; y += cellSize) {
        this.ctx.beginPath();
        this.ctx.moveTo(0, y);
        this.ctx.lineTo(this.width, y);
        this.ctx.stroke();
      }

      // Draw active grid flashes
      this.gridFlashes.forEach((flash) => {
        this.ctx.strokeStyle = `rgba(0, 210, 255, ${flash.opacity * 0.06})`;
        this.ctx.lineWidth = 0.8;
        this.ctx.beginPath();
        if (flash.type === 'v') {
          this.ctx.moveTo(flash.pos, 0);
          this.ctx.lineTo(flash.pos, this.height);
        } else {
          this.ctx.moveTo(0, flash.pos);
          this.ctx.lineTo(this.width, flash.pos);
        }
        this.ctx.stroke();
      });
    }

    drawPortal(rotX, rotY, time, gateX, gateY) {
      const focalLength = 350;
      
      // Set sizes dynamically for responsive design
      const isMobile = this.width < 880;
      const radiusOuter = isMobile ? 80 : 160;
      const radiusInner = isMobile ? 55 : 110;
      
      const opacityFactor = isMobile ? 0.28 : 0.85;
      
      // Draw breathing volumetric radial background aura (Subtle Cyan / Titanium)
      const breathing = 0.82 + Math.sin(time * 1.8) * 0.08;
      const auraRadius = radiusOuter * 2.8 * breathing;
      
      const auraGrad = this.ctx.createRadialGradient(
        gateX, gateY, 0,
        gateX, gateY, auraRadius
      );
      auraGrad.addColorStop(0, `rgba(0, 210, 255, ${0.12 * opacityFactor})`);
      auraGrad.addColorStop(0.35, `rgba(0, 210, 255, ${0.03 * opacityFactor})`);
      auraGrad.addColorStop(0.7, `rgba(203, 213, 225, ${0.01 * opacityFactor})`);
      auraGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
      
      this.ctx.fillStyle = auraGrad;
      this.ctx.beginPath();
      this.ctx.arc(gateX, gateY, auraRadius, 0, Math.PI * 2);
      this.ctx.fill();

      // Outer structural ring
      this.ctx.beginPath();
      this.ctx.strokeStyle = `rgba(138, 148, 166, ${0.18 * opacityFactor})`;
      this.ctx.lineWidth = 1;
      
      const ringSteps = 96;
      for (let i = 0; i <= ringSteps; i++) {
        const angle = (i / ringSteps) * Math.PI * 2;
        const x = Math.cos(angle) * radiusOuter;
        const z = Math.sin(angle) * radiusOuter;
        const rotated = this.rotate3D(x, 0, z, rotX, rotY);
        const projected = this.project(rotated, focalLength, gateX, gateY);
        
        if (i === 0) {
          this.ctx.moveTo(projected.x, projected.y);
        } else {
          this.ctx.lineTo(projected.x, projected.y);
        }
      }
      this.ctx.stroke();

      // Inner validation orbit
      this.ctx.beginPath();
      this.ctx.strokeStyle = `rgba(0, 210, 255, ${0.22 * opacityFactor})`;
      this.ctx.lineWidth = 1.2;
      for (let i = 0; i <= ringSteps; i++) {
        const angle = (i / ringSteps) * Math.PI * 2;
        const x = Math.cos(angle) * radiusInner;
        const z = Math.sin(angle) * radiusInner;
        const rotated = this.rotate3D(x, 0, z, rotX, rotY);
        const projected = this.project(rotated, focalLength, gateX, gateY);
        
        if (i === 0) {
          this.ctx.moveTo(projected.x, projected.y);
        } else {
          this.ctx.lineTo(projected.x, projected.y);
        }
      }
      this.ctx.stroke();

      // Central core glows
      const coreRotated = this.rotate3D(0, 0, 0, rotX, rotY);
      const coreProjected = this.project(coreRotated, focalLength, gateX, gateY);
      
      const coreGrad = this.ctx.createRadialGradient(
        coreProjected.x, coreProjected.y, 1,
        coreProjected.x, coreProjected.y, 55 * coreProjected.scale
      );
      coreGrad.addColorStop(0, `rgba(0, 210, 255, ${0.25 * opacityFactor})`);
      coreGrad.addColorStop(0.3, `rgba(0, 210, 255, ${0.08 * opacityFactor})`);
      coreGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
      
      this.ctx.beginPath();
      this.ctx.fillStyle = coreGrad;
      this.ctx.arc(coreProjected.x, coreProjected.y, 55 * coreProjected.scale, 0, Math.PI * 2);
      this.ctx.fill();

      // Particles drawing
      this.particles.forEach((part) => {
        if (!this.reducedMotion) {
          part.y += part.vy;
          if (part.y < -radiusOuter * 1.5) {
            part.y = radiusOuter * 1.5;
            part.x = Math.random() * 200 - 100;
          }
        }
        
        const rotated = this.rotate3D(part.x, part.y, part.z, rotX, rotY);
        const projected = this.project(rotated, focalLength, gateX, gateY);
        
        if (projected.scale > 0.4) {
          this.ctx.fillStyle = `rgba(203, 213, 225, ${part.alpha * projected.scale * opacityFactor})`;
          if (part.symbol === '.') {
            this.ctx.beginPath();
            this.ctx.arc(projected.x, projected.y, 1.2 * projected.scale, 0, Math.PI * 2);
            this.ctx.fill();
          } else {
            this.ctx.font = `${part.size * projected.scale}px "JetBrains Mono", "SF Mono", monospace`;
            this.ctx.fillText(part.symbol, projected.x, projected.y);
          }
        }
      });

      // Nodes processing
      const projectedNodes = this.nodes.map((node) => {
        const nodeAngle = node.angle + (this.reducedMotion ? 0 : time * 0.04);
        const x = Math.cos(nodeAngle) * radiusOuter;
        const z = Math.sin(nodeAngle) * radiusOuter;
        const wave = this.reducedMotion ? 0 : Math.sin(time * 1.6 + node.angle * 3) * 8;
        
        const rotated = this.rotate3D(x, wave, z, rotX, rotY);
        const projected = this.project(rotated, focalLength, gateX, gateY);
        return { node, projected, z: rotated.z };
      });

      projectedNodes.sort((a, b) => b.z - a.z);

      projectedNodes.forEach(({ node, projected }) => {
        const rSize = (node.isGate ? 8 : 4.5) * projected.scale;
        
        // Link lines
        this.ctx.beginPath();
        this.ctx.strokeStyle = node.isGate ? `rgba(0, 210, 255, ${0.25 * opacityFactor})` : `rgba(138, 148, 166, ${0.10 * opacityFactor})`;
        this.ctx.lineWidth = node.isGate ? 1.2 : 0.6;
        this.ctx.moveTo(coreProjected.x, coreProjected.y);
        this.ctx.lineTo(projected.x, projected.y);
        this.ctx.stroke();

        // Node highlight emissions
        if (node.isGate) {
          const glowGrad = this.ctx.createRadialGradient(
            projected.x, projected.y, 1,
            projected.x, projected.y, rSize * 3.5
          );
          glowGrad.addColorStop(0, `rgba(0, 210, 255, ${0.35 * opacityFactor})`);
          glowGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
          this.ctx.beginPath();
          this.ctx.fillStyle = glowGrad;
          this.ctx.arc(projected.x, projected.y, rSize * 3.5, 0, Math.PI * 2);
          this.ctx.fill();
        }

        // Draw node
        this.ctx.beginPath();
        this.ctx.fillStyle = node.isGate ? this.colors.cyan : this.colors.steelSoft;
        this.ctx.arc(projected.x, projected.y, rSize, 0, Math.PI * 2);
        this.ctx.fill();

        // Node outer ring
        this.ctx.beginPath();
        this.ctx.strokeStyle = node.isGate ? '#ffffff' : `rgba(255,255,255,${0.18 * opacityFactor})`;
        this.ctx.lineWidth = 1;
        this.ctx.arc(projected.x, projected.y, rSize + 2, 0, Math.PI * 2);
        this.ctx.stroke();

        // Active node technical data labels
        const isFocus = node.isGate || (this.mouse.active && projected.scale > 0.95);
        if (isFocus) {
          this.ctx.textAlign = 'center';
          
          this.ctx.font = `700 ${Math.max(8, 9 * projected.scale)}px "JetBrains Mono", "SF Mono", monospace`;
          this.ctx.fillStyle = node.isGate ? '#ffffff' : this.colors.steelLight;
          this.ctx.fillText(node.label, projected.x, projected.y - rSize - 12);
          
          this.ctx.font = `500 ${Math.max(6.5, 7.5 * projected.scale)}px "JetBrains Mono", "SF Mono", monospace`;
          this.ctx.fillStyle = `rgba(0, 210, 255, ${0.7 * opacityFactor})`;
          this.ctx.fillText(node.code, projected.x, projected.y - rSize - 4);
        }
      });
    }

    loop() {
      this.time += 0.008;
      
      if (Math.random() < 0.035) {
        const type = Math.random() > 0.5 ? 'h' : 'v';
        const cellSize = 56;
        const limit = type === 'h' ? this.height : this.width;
        const pos = Math.floor(Math.random() * (limit / cellSize)) * cellSize;
        
        this.gridFlashes.push({
          type,
          pos,
          opacity: 1.0
        });
      }
      
      this.gridFlashes.forEach((flash) => {
        flash.opacity -= 0.018;
      });
      this.gridFlashes = this.gridFlashes.filter(f => f.opacity > 0);

      if (this.mouse.active) {
        this.targetRotationY = -0.45 + this.mouse.x * 0.55;
        this.targetRotationX = 0.45 + this.mouse.y * 0.42;
      } else {
        this.targetRotationY = -0.45 + Math.sin(this.time * 0.35) * 0.06;
        this.targetRotationX = 0.45 + Math.cos(this.time * 0.25) * 0.05;
      }

      this.rotationX += (this.targetRotationX - this.rotationX) * 0.08;
      this.rotationY += (this.targetRotationY - this.rotationY) * 0.08;

      this.ctx.clearRect(0, 0, this.width, this.height);

      this.drawGrid();

      const isDesktop = this.width >= 880;
      const gateX = isDesktop ? this.width * 0.73 : this.width / 2;
      const gateY = isDesktop ? this.height / 2 : this.height * 0.55;

      this.drawPortal(this.rotationX, this.rotationY, this.time, gateX, gateY);

      this.frameId = requestAnimationFrame(() => this.loop());
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new CastleGateVisual();
  });
</script>
