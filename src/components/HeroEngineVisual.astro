---
export interface Props {
  variant?: 'blue' | 'green';
  className?: string;
}

const { variant = "blue", className = "" } = Astro.props;
---

<div class={`hero-engine-visual-wrapper ${variant === 'green' ? 'variant-green' : ''} ${className}`} data-variant={variant} aria-hidden="true">
  <!-- Dynamic Three.js WebGL Container -->
  <div class="hero-three-canvas-container"></div>
  <!-- Optical contrast mask to ensure AAA typography readability over 3D lighting -->
  <div class="hero-engine-contrast-mask"></div>
</div>

<style>
  .hero-engine-visual-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    background: #060a17;
  }

  .hero-engine-visual-wrapper.variant-green {
    background: #04160e !important;
  }

  .hero-three-canvas-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 1;
    pointer-events: none;
  }

  .hero-three-canvas-container canvas {
    width: 100% !important;
    height: 100% !important;
    display: block;
    pointer-events: none;
  }

  .hero-engine-contrast-mask {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: radial-gradient(
      ellipse 85% 75% at 50% 50%,
      rgba(6, 10, 23, 0.72) 0%,
      rgba(6, 10, 23, 0.44) 50%,
      rgba(6, 10, 23, 0.10) 80%,
      rgba(6, 10, 23, 0.90) 100%
    );
  }

  .hero-engine-visual-wrapper.variant-green .hero-engine-contrast-mask {
    background: radial-gradient(
      ellipse 85% 75% at 50% 50%,
      rgba(4, 22, 14, 0.72) 0%,
      rgba(4, 22, 14, 0.44) 50%,
      rgba(4, 22, 14, 0.10) 80%,
      rgba(4, 22, 14, 0.90) 100%
    ) !important;
  }
</style>

<script>
  import * as THREE from 'three';

  function initThreeHero() {
    const wrappers = document.querySelectorAll('.hero-engine-visual-wrapper');
    if (!wrappers || wrappers.length === 0) return;

    wrappers.forEach((wrapperEl) => {
      const wrapper = wrapperEl as HTMLElement;
      // Prevent duplicate initializations on the same DOM element
      if (wrapper.dataset.threeInitialized === 'true') return;
      wrapper.dataset.threeInitialized = 'true';

      const container = wrapper.querySelector('.hero-three-canvas-container') as HTMLElement;
      if (!container) return;

      while (container.firstChild) {
        container.removeChild(container.firstChild);
      }

      // Synchronize actual sticky navbar height dynamically to root CSS variable
      function syncHeaderHeight() {
        const header = document.querySelector('.site-header');
        if (header) {
          const h = header.getBoundingClientRect().height;
          if (h > 0) {
            document.documentElement.style.setProperty('--header-height', `${h}px`);
          }
        }
      }
      syncHeaderHeight();

      const isGreen = wrapper.getAttribute('data-variant') === 'green' || wrapper.classList.contains('variant-green');

      const bgHex = isGreen ? 0x04160e : 0x060a17;
      const scene = new THREE.Scene();
      scene.background = new THREE.Color(bgHex);
      scene.fog = new THREE.FogExp2(bgHex, 0.016);

      const initialRect = wrapper.getBoundingClientRect();
      let width = initialRect.width || wrapper.clientWidth || window.innerWidth;
      let height = initialRect.height || wrapper.clientHeight || (window.innerHeight - 65);

      const camera = new THREE.PerspectiveCamera(50, width / height, 0.1, 200);
      camera.position.set(0, 42, 0.001);
      camera.lookAt(0, 0, 0);

      const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.setSize(width, height);
      container.appendChild(renderer.domElement);

      // ---------------------------------------------------------------
      // Lighting: several animated colored lights sweeping the field,
      // all inside the brand palette so the sweep reads as one coherent light show.
      // ---------------------------------------------------------------
      const ambient = new THREE.AmbientLight(isGreen ? 0x0a3820 : 0x1b2550, 1.6);
      scene.add(ambient);

      // 4 PointLights — Exact same intensities, radii, speeds, heights, phases
      // Blue (standard) or Green (Castle Impact official tokens: #00E599, #34D399, #059669, #6EE7B7)
      const lightDefs = isGreen
        ? [
            { color: 0x00e599, intensity: 7, radius: 16, speed: 0.22, height: 12, phase: 0.0 },
            { color: 0x34d399, intensity: 5, radius: 20, speed: -0.17, height: 9, phase: 2.1 },
            { color: 0x059669, intensity: 6, radius: 12, speed: 0.31, height: 14, phase: 4.2 },
            { color: 0x6ee7b7, intensity: 4, radius: 24, speed: -0.12, height: 8, phase: 1.1 },
          ]
        : [
            { color: 0x346bf1, intensity: 7, radius: 16, speed: 0.22, height: 12, phase: 0.0 },
            { color: 0x6f9bff, intensity: 5, radius: 20, speed: -0.17, height: 9, phase: 2.1 },
            { color: 0x2a4fc4, intensity: 6, radius: 12, speed: 0.31, height: 14, phase: 4.2 },
            { color: 0x8ecbff, intensity: 4, radius: 24, speed: -0.12, height: 8, phase: 1.1 },
          ];

      const lights = lightDefs.map((def) => {
        const l = new THREE.PointLight(def.color, def.intensity, 55, 2);
        scene.add(l);
        return { ...def, light: l };
      });

      const rim = new THREE.DirectionalLight(isGreen ? 0x00e599 : 0x4f74ff, 0.5);
      rim.position.set(-10, 20, -10);
      scene.add(rim);

      // ---------------------------------------------------------------
      // Instanced grid of extruded bars — Exact reference parameters
      // ---------------------------------------------------------------
      const GRID = 170;
      const SPACING = 0.62;
      const COUNT = GRID * GRID;

      const geometry = new THREE.BoxGeometry(0.34, 1, 0.34);
      geometry.translate(0, 0.5, 0);

      const material = new THREE.MeshStandardMaterial({
        color: isGreen ? 0x0e7846 : 0x2b4fb0,
        roughness: 0.38,
        metalness: 0.4,
        emissive: isGreen ? 0x04301c : 0x0a1230,
        emissiveIntensity: 0.5,
      });

      const mesh = new THREE.InstancedMesh(geometry, material, COUNT);
      mesh.instanceColor = new THREE.InstancedBufferAttribute(new Float32Array(COUNT * 3), 3);
      scene.add(mesh);

      const dummy = new THREE.Object3D();
      const baseColor = new THREE.Color(isGreen ? 0x0d6a3d : 0x24397e);
      const highlightColor = new THREE.Color(isGreen ? 0x00e599 : 0x5f8bff);
      const hotColor = new THREE.Color(isGreen ? 0x80ffc8 : 0xbfe0ff);
      const darkColor = new THREE.Color(bgHex);

      const positions: { x: number; z: number; idx: number }[] = [];
      let idx = 0;
      for (let ix = 0; ix < GRID; ix++) {
        for (let iz = 0; iz < GRID; iz++) {
          const x = (ix - GRID / 2) * SPACING;
          const z = (iz - GRID / 2) * SPACING;
          positions.push({ x, z, idx });
          idx++;
        }
      }

      // Simple 2D value noise, exact reference code
      function hash(x: number, y: number) {
        const s = Math.sin(x * 127.1 + y * 311.7) * 43758.5453123;
        return s - Math.floor(s);
      }

      function noise2D(x: number, y: number) {
        const xi = Math.floor(x), yi = Math.floor(y);
        const xf = x - xi, yf = y - yi;
        const u = xf * xf * (3 - 2 * xf);
        const v = yf * yf * (3 - 2 * yf);
        const a = hash(xi, yi), b = hash(xi + 1, yi);
        const c = hash(xi, yi + 1), d = hash(xi + 1, yi + 1);
        return (a * (1 - u) + b * u) * (1 - v) + (c * (1 - u) + d * u) * v;
      }

      const clock = new THREE.Clock();
      const tmpColor = new THREE.Color();

      function updateInstances(t: number) {
        const lp = lights.map((L) => {
          const a = t * L.speed + L.phase;
          return {
            x: Math.cos(a) * L.radius,
            z: Math.sin(a) * L.radius,
            color: L.light.color,
            strength: L.intensity * 0.02,
          };
        });

        for (let i = 0; i < positions.length; i++) {
          const { x, z, idx: itemIdx } = positions[i];
          const r = Math.sqrt(x * x + z * z);
          const angle = Math.atan2(z, x);
          const swirl1 = Math.sin(angle * 3 - r * 0.35 + t * 0.6) * 0.5 + 0.5;
          const n = noise2D(x * 0.14 + t * 0.12, z * 0.14 - t * 0.09);
          const n2 = noise2D(x * 0.05 - t * 0.05, z * 0.05 + t * 0.07);
          const height = 0.25 + swirl1 * 1.4 * n2 + n * 1.1;
          const clampedHeight = Math.max(0.12, height);
          const tiltX = Math.sin(z * 0.2 + t * 0.4) * 0.25 * n;
          const tiltZ = Math.cos(x * 0.2 - t * 0.4) * 0.25 * n;

          dummy.position.set(x, 0, z);
          dummy.rotation.set(tiltX, angle * 0.15, tiltZ);
          dummy.scale.set(1, clampedHeight * 3.2, 1);
          dummy.updateMatrix();
          mesh.setMatrixAt(itemIdx, dummy.matrix);

          const heat = Math.max(0, (n2 * swirl1 - 0.22)) * 2.6 + Math.max(0, n - 0.65) * 1.8;
          if (heat > 0.75) {
            tmpColor.copy(baseColor).lerp(hotColor, Math.min(1, heat - 0.6));
          } else if (heat > 0.18) {
            tmpColor.copy(baseColor).lerp(highlightColor, Math.min(1, heat));
          } else {
            tmpColor.copy(baseColor).lerp(darkColor, Math.max(0, 0.3 - heat));
          }

          for (let li = 0; li < lp.length; li++) {
            const L = lp[li];
            const dx = x - L.x, dz = z - L.z;
            const d2 = dx * dx + dz * dz;
            const g = L.strength * Math.exp(-d2 / 40.0);
            if (g > 0.001) {
              tmpColor.r += L.color.r * g;
              tmpColor.g += L.color.g * g;
              tmpColor.b += L.color.b * g;
            }
          }
          mesh.setColorAt(itemIdx, tmpColor);
        }

        mesh.instanceMatrix.needsUpdate = true;
        if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;
      }

      let frameId: number | null = null;
      let isVisible = false;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      updateInstances(0);
      renderer.render(scene, camera);

      function animate() {
        if (!isVisible || reducedMotion) return;
        frameId = requestAnimationFrame(animate);

        const t = clock.getElapsedTime();
        updateInstances(t * 0.5);

        lights.forEach((L) => {
          const a = t * L.speed + L.phase;
          L.light.position.set(
            Math.cos(a) * L.radius,
            L.height + Math.sin(t * 0.3 + L.phase) * 2.0,
            Math.sin(a) * L.radius
          );
          L.light.intensity = L.intensity * (0.75 + 0.35 * Math.sin(t * 0.8 + L.phase * 2.0));
        });

        camera.position.x = Math.sin(t * 0.05) * 2.5;
        camera.position.z = Math.cos(t * 0.05) * 2.5;
        camera.lookAt(0, 0, 0);

        renderer.render(scene, camera);
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            isVisible = entry.isIntersecting;
            if (isVisible) {
              if (reducedMotion) {
                updateInstances(0);
                renderer.render(scene, camera);
              } else if (!frameId) {
                frameId = requestAnimationFrame(animate);
              }
            } else {
              if (frameId) {
                cancelAnimationFrame(frameId);
                frameId = null;
              }
            }
          });
        },
        { threshold: 0.02 }
      );
      observer.observe(wrapper);

      function handleResize(newWidth?: number, newHeight?: number) {
        const rect = wrapper.getBoundingClientRect();
        width = newWidth || rect.width || wrapper.clientWidth || window.innerWidth;
        height = newHeight || rect.height || wrapper.clientHeight || (window.innerHeight - 65);

        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        renderer.setSize(width, height);

        if (reducedMotion || !isVisible) {
          renderer.render(scene, camera);
        }
      }

      const resizeObserver = new ResizeObserver((entries) => {
        for (const entry of entries) {
          const cr = entry.contentRect;
          if (cr.width > 0 && cr.height > 0) {
            handleResize(cr.width, cr.height);
          }
        }
      });
      resizeObserver.observe(wrapper);

      window.addEventListener('resize', () => handleResize(), { passive: true });

      document.addEventListener(
        'astro:before-swap',
        () => {
          if (frameId) cancelAnimationFrame(frameId);
          observer.disconnect();
          resizeObserver.disconnect();
          window.removeEventListener('resize', () => handleResize());
          geometry.dispose();
          material.dispose();
          renderer.dispose();
        },
        { once: true }
      );
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThreeHero);
  } else {
    initThreeHero();
  }
</script>
