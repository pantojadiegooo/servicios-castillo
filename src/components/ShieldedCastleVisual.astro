---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`shielded-castle-wrapper ${className}`} id="shielded-castle-wrapper" aria-hidden="true">
  <!-- Fallback CSS background with tech-noir depth -->
  <div class="shielded-castle-fallback"></div>
  <canvas id="shielded-castle-canvas" class="shielded-castle-canvas"></canvas>
  <!-- Optical contrast shield for perfect text legibility -->
  <div class="shielded-castle-contrast-mask"></div>
</div>

<style>
  .shielded-castle-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    background: #06080c;
  }

  .shielded-castle-fallback {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(circle at 50% 46%, rgba(0, 210, 255, 0.14) 0%, rgba(6, 8, 12, 0.75) 48%, #06080c 85%),
      linear-gradient(180deg, rgba(6, 8, 12, 0.25) 0%, rgba(6, 8, 12, 0.95) 100%);
    z-index: 1;
    pointer-events: none;
  }

  .shielded-castle-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 2;
    pointer-events: none;
  }

  .shielded-castle-contrast-mask {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: radial-gradient(
      ellipse 80% 70% at 50% 46%,
      rgba(6, 8, 12, 0.86) 0%,
      rgba(6, 8, 12, 0.54) 55%,
      rgba(6, 8, 12, 0.14) 85%,
      rgba(6, 8, 12, 0.92) 100%
    );
  }
</style>

<script is:inline>
  class ShieldedCastleHero {
    constructor() {
      this.wrapper = document.getElementById('shielded-castle-wrapper');
      this.canvas = document.getElementById('shielded-castle-canvas');
      if (!this.wrapper || !this.canvas) return;

      this.ctx = this.canvas.getContext('2d');
      if (!this.ctx) return;

      this.width = 0;
      this.height = 0;
      this.dpi = Math.min(window.devicePixelRatio || 1, 2);
      this.time = 0;
      this.frameId = null;
      this.isVisible = false;
      this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Parallax smooth interpolation
      this.mouse = { x: 0, y: 0, targetX: 0, targetY: 0 };
      this.scrollY = 0;

      // Fortress components, drones, telemetry
      this.drones = [];
      this.dataStreams = [];
      this.ambientParticles = [];

      this.telemetryWords = [
        "TITULARIDAD_100%", "RIGOR_TECNICO", "CERO_LOCK_IN", "SHA256:SIGN",
        "CODIGO_AUDITADO", "GATE_PROTOCOL", "TRANSPARENCIA", "LOCAL_MEMORY",
        "WCAG_2.2_AA", "SECURITY_STRICT", "PROPIEDAD_CLIENTE", "SYS_STABLE"
      ];

      this.init();
    }

    init() {
      this.resize();
      window.addEventListener('resize', () => this.resize(), { passive: true });

      // Mouse tracking over hero section
      const heroSection = this.wrapper.closest('.page-hero') || this.wrapper.closest('section');
      if (heroSection) {
        heroSection.addEventListener('mousemove', (e) => {
          const rect = heroSection.getBoundingClientRect();
          const normX = (e.clientX - rect.left) / rect.width - 0.5;
          const normY = (e.clientY - rect.top) / rect.height - 0.5;
          this.mouse.targetX = normX * 38;
          this.mouse.targetY = normY * 26;
        }, { passive: true });

        heroSection.addEventListener('mouseleave', () => {
          this.mouse.targetX = 0;
          this.mouse.targetY = 0;
        }, { passive: true });
      }

      // Scroll tracking
      window.addEventListener('scroll', () => {
        this.scrollY = window.scrollY || 0;
      }, { passive: true });

      // IntersectionObserver for performance
      this.observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          this.isVisible = entry.isIntersecting;
          if (this.isVisible) {
            if (this.reducedMotion) {
              this.draw();
            } else if (!this.frameId) {
              this.loop();
            }
          } else {
            if (this.frameId) {
              cancelAnimationFrame(this.frameId);
              this.frameId = null;
            }
          }
        });
      }, { threshold: 0.02 });

      this.observer.observe(this.wrapper);
      this.setupScene();
    }

    resize() {
      this.width = this.wrapper.clientWidth || window.innerWidth;
      this.height = this.wrapper.clientHeight || 560;

      this.canvas.width = Math.floor(this.width * this.dpi);
      this.canvas.height = Math.floor(this.height * this.dpi);

      this.ctx.setTransform(this.dpi, 0, 0, this.dpi, 0, 0);
      this.setupScene();

      if (this.reducedMotion || !this.isVisible) {
        this.draw();
      }
    }

    setupScene() {
      const isMobile = this.width < 768;
      const isTablet = this.width >= 768 && this.width < 1080;
      const cx = this.width / 2;
      const cy = this.height * 0.44;

      // Fortress dimensions
      this.castleScale = isMobile ? 0.65 : (isTablet ? 0.85 : 1.0);
      this.hexRadius = isMobile ? 120 : (isTablet ? 175 : 215);

      // 1. SETUP SURVEILLANCE DRONES (3 TO 4 DRONES WITH INDEPENDENT PATROLS)
      this.drones = [];
      const droneSpecs = [
        { relX: -0.32, relY: -0.28, patrolRangeX: 18, patrolRangeY: 10, speed: 0.9, phase: 0.0, scanAngle: 0.35, depth: 1.15 },
        { relX: 0.34,  relY: -0.24, patrolRangeX: 22, patrolRangeY: 14, speed: 1.2, phase: 1.7, scanAngle: -0.3, depth: 1.05 },
        { relX: -0.38, relY: 0.14,  patrolRangeX: 14, patrolRangeY: 16, speed: 0.7, phase: 3.4, scanAngle: 0.2,  depth: 0.95 },
        { relX: 0.36,  relY: 0.18,  patrolRangeX: 16, patrolRangeY: 12, speed: 1.1, phase: 4.8, scanAngle: -0.25, depth: 1.10 }
      ];

      const droneCount = isMobile ? 2 : droneSpecs.length;
      for (let d = 0; d < droneCount; d++) {
        const spec = droneSpecs[d];
        this.drones.push({
          baseX: cx + spec.relX * this.width * (isMobile ? 0.85 : 1.0),
          baseY: cy + spec.relY * this.height * (isMobile ? 0.75 : 1.0),
          patrolRangeX: spec.patrolRangeX,
          patrolRangeY: spec.patrolRangeY,
          speed: spec.speed,
          phase: spec.phase,
          scanAngle: spec.scanAngle,
          depth: spec.depth,
          w: isMobile ? 20 : 28,
          h: isMobile ? 10 : 14
        });
      }

      // 2. SETUP VERTICAL TELEMETRY DATA STREAMS
      this.dataStreams = [];
      const streamCount = isMobile ? 6 : 14;
      for (let s = 0; s < streamCount; s++) {
        const isLeft = s % 2 === 0;
        const x = isLeft 
          ? (Math.random() * (this.width * 0.22) + 15)
          : (this.width - Math.random() * (this.width * 0.22) - 15);
        const y = Math.random() * this.height;
        const speed = 0.4 + Math.random() * 0.5;
        const text = this.telemetryWords[s % this.telemetryWords.length];

        this.dataStreams.push({
          x, y, speed, text,
          alpha: 0.18 + Math.random() * 0.14
        });
      }

      // 3. SETUP AMBIENT DATA PARTICLES
      this.ambientParticles = [];
      const particleCount = isMobile ? 12 : 28;
      for (let p = 0; p < particleCount; p++) {
        this.ambientParticles.push({
          x: Math.random() * this.width,
          y: Math.random() * this.height,
          vx: (Math.random() - 0.5) * 0.2,
          vy: -Math.random() * 0.3 - 0.08,
          size: Math.random() * 2.0 + 0.8,
          alpha: Math.random() * 0.3 + 0.1,
          phase: Math.random() * Math.PI * 2
        });
      }
    }

    drawHexagonalPerimeter(cx, cy, radius, time) {
      const ctx = this.ctx;
      const pulse = Math.sin(time * 1.3) * 0.5 + 0.5;

      ctx.save();
      ctx.translate(cx, cy);

      // Outer breathing glow
      const hexGrad = ctx.createRadialGradient(0, 0, radius * 0.4, 0, 0, radius * 1.4);
      hexGrad.addColorStop(0, `rgba(0, 210, 255, ${0.14 + pulse * 0.06})`);
      hexGrad.addColorStop(0.5, `rgba(0, 210, 255, ${0.04 + pulse * 0.02})`);
      hexGrad.addColorStop(1, 'transparent');
      ctx.fillStyle = hexGrad;
      ctx.beginPath();
      ctx.arc(0, 0, radius * 1.4, 0, Math.PI * 2);
      ctx.fill();

      // Main Hexagon Outline
      ctx.beginPath();
      for (let i = 0; i < 6; i++) {
        const ang = (i / 6) * Math.PI * 2 - Math.PI / 6;
        const hx = Math.cos(ang) * radius;
        const hy = Math.sin(ang) * radius;
        if (i === 0) ctx.moveTo(hx, hy);
        else ctx.lineTo(hx, hy);
      }
      ctx.closePath();
      ctx.strokeStyle = `rgba(0, 210, 255, ${0.45 + pulse * 0.35})`;
      ctx.lineWidth = 1.6;
      ctx.stroke();

      // Inner Concentric Hexagon Shield
      const innerR = radius * 0.92;
      ctx.beginPath();
      for (let i = 0; i < 6; i++) {
        const ang = (i / 6) * Math.PI * 2 - Math.PI / 6;
        const hx = Math.cos(ang) * innerR;
        const hy = Math.sin(ang) * innerR;
        if (i === 0) ctx.moveTo(hx, hy);
        else ctx.lineTo(hx, hy);
      }
      ctx.closePath();
      ctx.strokeStyle = `rgba(0, 210, 255, ${0.18 + pulse * 0.15})`;
      ctx.setLineDash([8, 12]);
      ctx.lineWidth = 1.0;
      ctx.stroke();
      ctx.setLineDash([]);

      // 6 Corner Precision Target Nodes
      for (let i = 0; i < 6; i++) {
        const ang = (i / 6) * Math.PI * 2 - Math.PI / 6;
        const hx = Math.cos(ang) * radius;
        const hy = Math.sin(ang) * radius;

        // Corner bracket halo
        ctx.beginPath();
        ctx.arc(hx, hy, 4.5, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(0, 210, 255, ${0.7 + pulse * 0.3})`;
        ctx.fill();

        ctx.beginPath();
        ctx.arc(hx, hy, 2, 0, Math.PI * 2);
        ctx.fillStyle = '#FFFFFF';
        ctx.fill();
      }

      ctx.restore();
    }

    drawHolographicDefenseRings(cx, cy, baseRadius, time) {
      const ctx = this.ctx;
      const pulse = Math.sin(time * 1.5) * 0.5 + 0.5;

      ctx.save();
      ctx.translate(cx, cy);

      // Ring 1 (Outer): Segmented tick ring rotating clockwise
      ctx.save();
      ctx.rotate(time * 0.05);
      const r1 = baseRadius * 1.15;
      ctx.strokeStyle = `rgba(0, 210, 255, ${0.22 + pulse * 0.15})`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(0, 0, r1, 0, Math.PI * 2);
      ctx.stroke();

      const notchCount = 36;
      for (let n = 0; n < notchCount; n++) {
        const ang = (n / notchCount) * Math.PI * 2;
        const isMajor = n % 6 === 0;
        const len = isMajor ? 9 : 4;
        ctx.beginPath();
        ctx.moveTo(Math.cos(ang) * r1, Math.sin(ang) * r1);
        ctx.lineTo(Math.cos(ang) * (r1 - len), Math.sin(ang) * (r1 - len));
        ctx.strokeStyle = isMajor 
          ? `rgba(0, 210, 255, ${0.65 + pulse * 0.25})`
          : `rgba(255, 255, 255, 0.2)`;
        ctx.stroke();
      }
      ctx.restore();

      // Ring 2 (Middle): Dashed counter-clockwise radar sweep
      ctx.save();
      ctx.rotate(-time * 0.08);
      const r2 = baseRadius * 0.95;
      ctx.strokeStyle = `rgba(0, 210, 255, ${0.35 + pulse * 0.2})`;
      ctx.lineWidth = 1.2;
      ctx.setLineDash([10, 14]);
      ctx.beginPath();
      ctx.arc(0, 0, r2, 0, Math.PI * 2);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.restore();

      // Ring 3 (Inner): Continuous neon glow ring
      const r3 = baseRadius * 0.75;
      ctx.beginPath();
      ctx.arc(0, 0, r3, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(0, 210, 255, ${0.45 + pulse * 0.3})`;
      ctx.lineWidth = 1.8;
      ctx.stroke();

      ctx.restore();
    }

    drawDigitalFortress(cx, cy, s, time) {
      const ctx = this.ctx;
      const pulse = Math.sin(time * 1.6) * 0.5 + 0.5;

      ctx.save();
      ctx.translate(cx, cy);

      // BASE REINFORCED CURTAIN WALL / PLATFORM
      const baseW = 190 * s;
      const baseH = 50 * s;
      ctx.fillStyle = 'rgba(10, 14, 22, 0.96)';
      ctx.beginPath();
      ctx.rect(-baseW / 2, 35 * s, baseW, baseH);
      ctx.fill();
      ctx.strokeStyle = `rgba(0, 210, 255, ${0.3 + pulse * 0.3})`;
      ctx.lineWidth = 1.2;
      ctx.stroke();

      // Stepped Battlement Plates on Base
      for (let b = -3; b <= 3; b++) {
        const bx = b * (24 * s);
        ctx.fillStyle = 'rgba(18, 26, 40, 0.95)';
        ctx.fillRect(bx - 8 * s, 30 * s, 16 * s, 8 * s);
        ctx.strokeStyle = 'rgba(0, 210, 255, 0.4)';
        ctx.strokeRect(bx - 8 * s, 30 * s, 16 * s, 8 * s);
      }

      // LEFT BASTION TOWER
      const towerW = 55 * s;
      const towerH = 110 * s;
      const leftTowerX = -75 * s;
      ctx.fillStyle = 'rgba(12, 16, 26, 0.96)';
      ctx.beginPath();
      ctx.rect(leftTowerX - towerW / 2, -35 * s, towerW, towerH);
      ctx.fill();
      ctx.strokeStyle = `rgba(0, 210, 255, ${0.35 + pulse * 0.25})`;
      ctx.lineWidth = 1.2;
      ctx.stroke();

      // Left Tower Crown Battlements
      ctx.fillStyle = 'rgba(22, 30, 46, 0.98)';
      ctx.fillRect(leftTowerX - towerW / 2 - 4 * s, -45 * s, towerW + 8 * s, 12 * s);
      ctx.strokeStyle = '#00D2FF';
      ctx.strokeRect(leftTowerX - towerW / 2 - 4 * s, -45 * s, towerW + 8 * s, 12 * s);

      // Left Vertical Energy Conduit
      ctx.beginPath();
      ctx.moveTo(leftTowerX, -30 * s);
      ctx.lineTo(leftTowerX, 60 * s);
      ctx.strokeStyle = `rgba(0, 210, 255, ${0.55 + pulse * 0.4})`;
      ctx.lineWidth = 2.0;
      ctx.stroke();

      // RIGHT BASTION TOWER
      const rightTowerX = 75 * s;
      ctx.fillStyle = 'rgba(12, 16, 26, 0.96)';
      ctx.beginPath();
      ctx.rect(rightTowerX - towerW / 2, -35 * s, towerW, towerH);
      ctx.fill();
      ctx.strokeStyle = `rgba(0, 210, 255, ${0.35 + pulse * 0.25})`;
      ctx.lineWidth = 1.2;
      ctx.stroke();

      // Right Tower Crown Battlements
      ctx.fillStyle = 'rgba(22, 30, 46, 0.98)';
      ctx.fillRect(rightTowerX - towerW / 2 - 4 * s, -45 * s, towerW + 8 * s, 12 * s);
      ctx.strokeStyle = '#00D2FF';
      ctx.strokeRect(rightTowerX - towerW / 2 - 4 * s, -45 * s, towerW + 8 * s, 12 * s);

      // Right Vertical Energy Conduit
      ctx.beginPath();
      ctx.moveTo(rightTowerX, -30 * s);
      ctx.lineTo(rightTowerX, 60 * s);
      ctx.strokeStyle = `rgba(0, 210, 255, ${0.55 + pulse * 0.4})`;
      ctx.lineWidth = 2.0;
      ctx.stroke();

      // CENTRAL KEEP / TORRE PRINCIPAL (TALL FORTIFIED BASTION)
      const keepW = 85 * s;
      const keepH = 145 * s;
      ctx.fillStyle = 'rgba(8, 12, 20, 0.98)';
      ctx.beginPath();
      ctx.rect(-keepW / 2, -75 * s, keepW, keepH);
      ctx.fill();
      ctx.strokeStyle = `rgba(0, 210, 255, ${0.5 + pulse * 0.35})`;
      ctx.lineWidth = 1.4;
      ctx.stroke();

      // Central Keep Crown
      ctx.fillStyle = 'rgba(24, 34, 52, 0.98)';
      ctx.fillRect(-keepW / 2 - 6 * s, -90 * s, keepW + 12 * s, 16 * s);
      ctx.strokeStyle = '#00D2FF';
      ctx.strokeRect(-keepW / 2 - 6 * s, -90 * s, keepW + 12 * s, 16 * s);

      // Central Vertical Power Bus
      ctx.beginPath();
      ctx.moveTo(0, -70 * s);
      ctx.lineTo(0, 55 * s);
      ctx.strokeStyle = `rgba(0, 210, 255, ${0.7 + pulse * 0.3})`;
      ctx.lineWidth = 2.5;
      ctx.stroke();

      // FORTIFIED PORTCULLIS GATE (CENTRAL COMPUERTA BLINDADA)
      const gateW = 36 * s;
      const gateH = 45 * s;
      ctx.fillStyle = 'rgba(6, 8, 14, 0.98)';
      ctx.fillRect(-gateW / 2, 40 * s, gateW, gateH);
      ctx.strokeStyle = `rgba(0, 229, 153, ${0.7 + pulse * 0.3})`;
      ctx.lineWidth = 1.5;
      ctx.strokeRect(-gateW / 2, 40 * s, gateW, gateH);

      // Gate security grid bars
      for (let g = 1; g <= 3; g++) {
        const gx = -gateW / 2 + g * (gateW / 4);
        ctx.beginPath();
        ctx.moveTo(gx, 40 * s);
        ctx.lineTo(gx, 85 * s);
        ctx.strokeStyle = 'rgba(0, 229, 153, 0.6)';
        ctx.stroke();
      }

      ctx.restore();
    }

    drawCentralProtectionShield(cx, cy, s, time) {
      const ctx = this.ctx;
      const pulse = Math.sin(time * 1.8) * 0.5 + 0.5;

      ctx.save();
      ctx.translate(cx, cy - 15 * s);

      // Outer Shield Radiant Energy Flare
      const sGrad = ctx.createRadialGradient(0, 0, 10 * s, 0, 0, 65 * s);
      sGrad.addColorStop(0, `rgba(0, 210, 255, ${0.35 + pulse * 0.15})`);
      sGrad.addColorStop(0.4, `rgba(0, 210, 255, ${0.12 + pulse * 0.05})`);
      sGrad.addColorStop(1, 'transparent');
      ctx.fillStyle = sGrad;
      ctx.beginPath();
      ctx.arc(0, 0, 65 * s, 0, Math.PI * 2);
      ctx.fill();

      // SHIELD CREST GEOMETRY
      const sw = 42 * s;
      const sh = 52 * s;

      ctx.beginPath();
      ctx.moveTo(0, -sh / 2);
      ctx.lineTo(sw / 2, -sh * 0.35);
      ctx.lineTo(sw / 2, sh * 0.15);
      ctx.lineTo(0, sh / 2);
      ctx.lineTo(-sw / 2, sh * 0.15);
      ctx.lineTo(-sw / 2, -sh * 0.35);
      ctx.closePath();

      ctx.fillStyle = 'rgba(10, 16, 26, 0.94)';
      ctx.fill();
      ctx.strokeStyle = `rgba(0, 210, 255, ${0.8 + pulse * 0.2})`;
      ctx.lineWidth = 2.2;
      ctx.stroke();

      // INNER SHIELD EMBLEM (CASTLE FORTIFIED MONOGRAM)
      const isw = sw * 0.7;
      const ish = sh * 0.7;
      ctx.beginPath();
      ctx.moveTo(0, -ish / 2);
      ctx.lineTo(isw / 2, -ish * 0.35);
      ctx.lineTo(isw / 2, ish * 0.15);
      ctx.lineTo(0, ish / 2);
      ctx.lineTo(-isw / 2, ish * 0.15);
      ctx.lineTo(-isw / 2, -ish * 0.35);
      ctx.closePath();
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.85)';
      ctx.lineWidth = 1.2;
      ctx.stroke();

      // Core Security Emblem Dot
      ctx.beginPath();
      ctx.arc(0, 0, 4 * s, 0, Math.PI * 2);
      ctx.fillStyle = '#00E599';
      ctx.fill();
      ctx.strokeStyle = '#FFFFFF';
      ctx.lineWidth = 1.0;
      ctx.stroke();

      ctx.restore();
    }

    drawSurveillanceDrone(d, time) {
      const ctx = this.ctx;
      const hoverX = Math.sin(time * d.speed + d.phase) * d.patrolRangeX;
      const hoverY = Math.cos(time * (d.speed * 1.1) + d.phase) * d.patrolRangeY;
      const tilt = Math.sin(time * d.speed + d.phase) * 0.08;

      const px = d.baseX + hoverX + this.mouse.x * d.depth;
      const py = d.baseY + hoverY + this.mouse.y * d.depth - (this.scrollY * 0.08);

      ctx.save();
      ctx.translate(px, py);
      ctx.rotate(tilt);

      // DOWNWARD CONE SEARCHLIGHT SCANNER
      const beamL = 45;
      const beamW = 22;
      const beamGrad = ctx.createRadialGradient(0, 0, 2, 0, beamL * 0.7, beamL);
      beamGrad.addColorStop(0, 'rgba(0, 210, 255, 0.35)');
      beamGrad.addColorStop(0.6, 'rgba(0, 210, 255, 0.08)');
      beamGrad.addColorStop(1, 'transparent');

      ctx.save();
      ctx.rotate(d.scanAngle);
      ctx.beginPath();
      ctx.moveTo(0, 4);
      ctx.lineTo(-beamW / 2, beamL);
      ctx.lineTo(beamW / 2, beamL);
      ctx.closePath();
      ctx.fillStyle = beamGrad;
      ctx.fill();
      ctx.restore();

      // DRONE OBSIDIAN FUSELAGE
      ctx.beginPath();
      ctx.moveTo(0, -d.h / 2);
      ctx.lineTo(d.w / 2, 0);
      ctx.lineTo(0, d.h / 2);
      ctx.lineTo(-d.w / 2, 0);
      ctx.closePath();
      ctx.fillStyle = '#0a0e17';
      ctx.fill();
      ctx.strokeStyle = 'rgba(0, 210, 255, 0.75)';
      ctx.lineWidth = 1.0;
      ctx.stroke();

      // ROTOR WINGTIPS WITH GLOWING LEDS
      const rSize = 3;
      const rotorPositions = [
        { x: -d.w / 2 - 2, y: 0 },
        { x: d.w / 2 + 2, y: 0 },
        { x: 0, y: -d.h / 2 - 2 }
      ];

      rotorPositions.forEach((r, idx) => {
        ctx.beginPath();
        ctx.arc(r.x, r.y, rSize, 0, Math.PI * 2);
        ctx.fillStyle = idx === 2 ? '#00E599' : '#00D2FF';
        ctx.fill();
      });

      ctx.restore();
    }

    draw() {
      if (!this.ctx) return;
      this.ctx.clearRect(0, 0, this.width, this.height);

      const isMobile = this.width < 768;
      const cx = this.width / 2 + this.mouse.x * 0.35;
      const cy = this.height * 0.44 + this.mouse.y * 0.35 - (this.scrollY * 0.12);

      // A. BACKGROUND PERSPECTIVE CIRCUIT FLOOR
      const gridCount = isMobile ? 8 : 16;
      this.ctx.lineWidth = 0.5;
      for (let g = 0; g <= gridCount; g++) {
        const ratio = g / gridCount;
        const xBottom = ratio * this.width;
        this.ctx.beginPath();
        this.ctx.moveTo(cx, cy);
        this.ctx.lineTo(xBottom, this.height);
        this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.04)';
        this.ctx.stroke();
      }

      // B. VERTICAL TELEMETRY STREAMS
      this.ctx.font = '7.5px "JetBrains Mono", monospace';
      this.dataStreams.forEach((stream) => {
        if (!this.reducedMotion) {
          stream.y += stream.speed;
          if (stream.y > this.height + 20) {
            stream.y = -20;
          }
        }
        this.ctx.fillStyle = `rgba(0, 210, 255, ${stream.alpha})`;
        this.ctx.fillText(stream.text, stream.x + this.mouse.x * 0.5, stream.y);
      });

      // C. HOLOGRAPHIC DEFENSE RINGS AT BASE
      this.drawHolographicDefenseRings(cx, cy + 50 * this.castleScale, this.hexRadius * 0.85, this.time);

      // D. HEXAGONAL SECURITY PERIMETER SHIELD
      this.drawHexagonalPerimeter(cx, cy, this.hexRadius, this.time);

      // E. DIGITAL FORTIFIED CASTLE
      this.drawDigitalFortress(cx, cy, this.castleScale, this.time);

      // F. CENTRAL PROTECTION SHIELD
      this.drawCentralProtectionShield(cx, cy, this.castleScale, this.time);

      // G. ACTIVE SURVEILLANCE DRONES
      this.drones.forEach((drone) => {
        this.drawSurveillanceDrone(drone, this.time);
      });

      // H. AMBIENT PARTICLES
      this.ambientParticles.forEach((p) => {
        if (!this.reducedMotion) {
          p.x += p.vx;
          p.y += p.vy;
          if (p.y < -10) {
            p.y = this.height + 10;
            p.x = Math.random() * this.width;
          }
          if (p.x < -10) p.x = this.width + 10;
          if (p.x > this.width + 10) p.x = -10;
        }

        const pulse = Math.sin(this.time * 2 + p.phase) * 0.5 + 0.5;
        this.ctx.beginPath();
        this.ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        this.ctx.fillStyle = `rgba(0, 210, 255, ${p.alpha + pulse * 0.25})`;
        this.ctx.fill();
      });
    }

    loop() {
      // Smooth mouse interpolation
      this.mouse.x += (this.mouse.targetX - this.mouse.x) * 0.055;
      this.mouse.y += (this.mouse.targetY - this.mouse.y) * 0.055;

      this.time += 0.016;
      this.draw();

      if (this.isVisible && !this.reducedMotion) {
        this.frameId = requestAnimationFrame(() => this.loop());
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new ShieldedCastleHero();
  });
</script>
