---
import CastleGateBadge from './CastleGateBadge.astro';
import TechIcon from './TechIcon.astro';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div style="display: inline-flex; align-items: center; gap: 0.65rem; margin-bottom: 0.25rem;">
          <svg viewBox="40 18 122 166" width="20" height="28" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
            <path d="M60.20,27.54 L43.77,27.54 L43.77,177.54 L114.79,177.54 L60.20,27.54 Z" fill="#3E7C93"/>
            <path d="M123.25,174.46 L158.23,174.46 L158.23,24.46 L68.66,24.46 L123.25,174.46 Z" fill="#E8EAEC"/>
          </svg>
          <span class="brand-name" style="font-family:var(--f-display); margin-bottom: 0;">Grupo Castillo</span>
        </div>
        <p style="margin-top:.75rem; max-width:34ch;">Firma de ingeniería de software y gobernanza tecnológica. Desarrollo web de alto rendimiento, auditoría de código y gobernanza determinista de releases.</p>
        <div style="margin-top: 1rem;">
          <a href="/diagnostico" class="btn btn-outline" style="padding: 0.45rem 1rem; font-size: 0.78rem;">¿Qué necesitas? Iniciar Diagnóstico →</a>
        </div>
        <div class="footer-social-strip" style="display: flex; gap: 0.75rem; align-items: center; margin-top: 1.25rem;">
          <a href="https://www.instagram.com/grupocastillooo/" target="_blank" rel="noopener noreferrer" title="Instagram oficial de Grupo Castillo" aria-label="Instagram de Grupo Castillo" style="color: var(--steel-soft); display: inline-flex; align-items: center; transition: color var(--transition-fast);">
            <TechIcon name="instagram" size={17} />
          </a>
          <a href="https://www.facebook.com/profile.php?id=61593987536435" target="_blank" rel="noopener noreferrer" title="Facebook oficial de Grupo Castillo" aria-label="Facebook de Grupo Castillo" style="color: var(--steel-soft); display: inline-flex; align-items: center; transition: color var(--transition-fast);">
            <TechIcon name="facebook" size={17} />
          </a>
          <a href="https://wa.me/529518096110" target="_blank" rel="noopener noreferrer" title="WhatsApp Business de Grupo Castillo (+52 951 809 6110)" aria-label="WhatsApp de Grupo Castillo" style="color: var(--steel-soft); display: inline-flex; align-items: center; transition: color var(--transition-fast);">
            <TechIcon name="whatsapp" size={17} />
          </a>
          <a href="mailto:contacto@grupocastillo.lat" title="Correo corporativo: contacto@grupocastillo.lat" aria-label="Correo de Grupo Castillo" style="color: var(--steel-soft); display: inline-flex; align-items: center; transition: color var(--transition-fast);">
            <TechIcon name="mail" size={17} />
          </a>
        </div>
      </div>
      <div>
        <h3>Sitios Web</h3>
        <ul>
          <li><a href="/paquetes">Catálogo de Paquetes</a></li>
          <li><a href="/paquetes/iron">Castle Iron</a></li>
          <li><a href="/paquetes/bronze">Castle Bronze</a></li>
          <li><a href="/paquetes/silver">Castle Silver</a></li>
          <li><a href="/paquetes/gold">Castle Gold</a></li>
          <li><a href="/paquetes/platinum">Castle Platinum</a></li>
          <li><a href="/paquetes/diamond">Castle Diamond</a></li>
        </ul>
      </div>
      <div>
        <h3>Servicios de Ingeniería</h3>
        <ul>
          <li><a href="/servicios">Todos los Servicios</a></li>
          <li><a href="/servicios/checkup">Castle Checkup (72h)</a></li>
          <li><a href="/servicios/audit">Castle Audit (Due Diligence)</a></li>
          <li><a href="/servicios/rescue">Castle Rescue (Intervención)</a></li>
          <li><a href="/servicios/emergency">Castle Emergency (Urgencias)</a></li>
          <li><a href="/servicios/care">Castle Care (Suscripción)</a></li>
        </ul>
      </div>
      <div>
        <h3>Tecnología</h3>
        <ul>
          <li><a href="/castle-gate">Castle Gate CLI</a></li>
          <li><a href="/castle-gate#validacion">Gobernanza CQS v1.1</a></li>
          <li><a href="/diagnostico">Diagnóstico Guiado</a></li>
        </ul>
      </div>
      <div>
        <h3>Grupo Castillo</h3>
        <ul>
          <li><a href="/portal" style="color: var(--cyan); font-weight: 600;">Portal del Cliente</a></li>
          <li><a href="/cotizacion">Cotización Oficial</a></li>
          <li><a href="/porque-elegirnos">¿Por qué Elegirnos?</a></li>
          <li><a href="/castle-impact" style="color: var(--cyan); font-weight: 600;">Castle Impact (Pro Bono)</a></li>
          <li><a href="/acuerdo-impact">Acuerdo Castle Impact</a></li>
          <li><a href="/nosotros">Nosotros &amp; Filosofía</a></li>
          <li><a href="/proceso">Metodología de 9 Etapas</a></li>
          <li><a href="/proyectos">Casos de Referencia</a></li>
          <li><a href="/contacto">Contacto &amp; Cotización</a></li>
          <li><a href="mailto:contacto@grupocastillo.lat">contacto@grupocastillo.lat</a></li>
          <li><a href="https://wa.me/529518096110" target="_blank" rel="noopener noreferrer">WhatsApp (+52 951 809 6110)</a></li>
          <li><a href="https://www.instagram.com/grupocastillooo/" target="_blank" rel="noopener noreferrer">Instagram Oficial</a></li>
          <li><a href="https://www.facebook.com/profile.php?id=61593987536435" target="_blank" rel="noopener noreferrer">Facebook Oficial</a></li>
          <li><a href="/aviso-de-privacidad">Aviso de Privacidad</a></li>
          <li><a href="/terminos">Términos y Condiciones</a></li>
          <li><button type="button" id="btn-reopen-consent" style="background: none; border: none; padding: 0; color: var(--steel-soft); font-size: inherit; font-family: inherit; cursor: pointer; text-decoration: underline; text-underline-offset: 3px;">Configurar Cookies</button></li>
        </ul>
      </div>
    </div>

    <div class="footer-legal">
      <div class="footer-legal-left">
        <span>© 2026 Grupo Castillo · Servicios de Ingeniería de Software · Todos los derechos reservados.</span>
      </div>
      <div class="footer-legal-right">
        <CastleGateBadge variant="compact" validationId="CG-2026-68D04F" releaseSha="3d61237" isSelfValidation={true} />
      </div>
    </div>
  </div>
</footer>
