---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`castle-gate-engine-wrapper ${className}`} id="castle-gate-engine-wrapper" aria-hidden="true">
  <!-- Fallback CSS background with tech-noir depth -->
  <div class="castle-gate-fallback"></div>
  <canvas id="castle-gate-canvas" class="castle-gate-canvas"></canvas>
  <!-- Optical contrast shield for perfect text legibility -->
  <div class="castle-gate-contrast-mask"></div>
</div>

<style>
  .castle-gate-engine-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    background: #06080c;
  }

  .castle-gate-fallback {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(circle at 50% 45%, rgba(52, 107, 241, 0.16) 0%, rgba(6, 8, 12, 0.75) 48%, #06080c 85%),
      linear-gradient(180deg, rgba(6, 8, 12, 0.25) 0%, rgba(6, 8, 12, 0.95) 100%);
    z-index: 1;
    pointer-events: none;
  }

  .castle-gate-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 2;
    pointer-events: none;
  }

  .castle-gate-contrast-mask {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: radial-gradient(
      ellipse 82% 72% at 50% 46%,
      rgba(6, 8, 12, 0.86) 0%,
      rgba(6, 8, 12, 0.54) 55%,
      rgba(6, 8, 12, 0.14) 85%,
      rgba(6, 8, 12, 0.92) 100%
    );
  }
</style>

<script is:inline>
  class CastleGateHolographicOrb {
    constructor() {
      this.wrapper = document.getElementById('castle-gate-engine-wrapper');
      this.canvas = document.getElementById('castle-gate-canvas');
      if (!this.wrapper || !this.canvas) return;

      this.ctx = this.canvas.getContext('2d');
      if (!this.ctx) return;

      this.width = 0;
      this.height = 0;
      this.dpi = Math.min(window.devicePixelRatio || 1, 2);
      this.time = 0;
      this.frameId = null;
      this.isVisible = false;
      this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Parallax smooth interpolation
      this.mouse = { x: 0, y: 0, targetX: 0, targetY: 0 };
      this.scrollY = 0;

      // 3D Sphere geometry & code panels
      this.geodesicVertices = [];
      this.geodesicEdges = [];
      this.codePanels = [];
      this.orbitingPhotons = [];
      this.fiberConduits = [];
      this.sideMonoliths = [];

      this.telemetrySnippets = [
        "CQS_v1.1", "SHA256:8f4a", "SAST:0_VULN", "GATE:PASSED",
        "WCAG_2.2_AA", "LCP:0.7s", "INP:38ms", "SEC_STRICT",
        "DOMAINS:07", "RULES:65", "EXIT_CODE:0", "LOCKFILE_OK",
        "MEM_SCAN:OK", "SIGN_AUTH", "ENFORCE:TRUE", "NO_LEAKS"
      ];

      this.init();
    }

    init() {
      this.resize();
      window.addEventListener('resize', () => this.resize(), { passive: true });

      // Mouse tracking over hero section
      const heroSection = this.wrapper.closest('.page-hero') || this.wrapper.closest('section');
      if (heroSection) {
        heroSection.addEventListener('mousemove', (e) => {
          const rect = heroSection.getBoundingClientRect();
          const normX = (e.clientX - rect.left) / rect.width - 0.5;
          const normY = (e.clientY - rect.top) / rect.height - 0.5;
          this.mouse.targetX = normX * 42;
          this.mouse.targetY = normY * 28;
        }, { passive: true });

        heroSection.addEventListener('mouseleave', () => {
          this.mouse.targetX = 0;
          this.mouse.targetY = 0;
        }, { passive: true });
      }

      // Scroll listener
      window.addEventListener('scroll', () => {
        this.scrollY = window.scrollY || 0;
      }, { passive: true });

      // IntersectionObserver for GPU/CPU preservation
      this.observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          this.isVisible = entry.isIntersecting;
          if (this.isVisible) {
            if (this.reducedMotion) {
              this.draw();
            } else if (!this.frameId) {
              this.loop();
            }
          } else {
            if (this.frameId) {
              cancelAnimationFrame(this.frameId);
              this.frameId = null;
            }
          }
        });
      }, { threshold: 0.02 });

      this.observer.observe(this.wrapper);
      this.setupScene();
    }

    resize() {
      this.width = this.wrapper.clientWidth || window.innerWidth;
      this.height = this.wrapper.clientHeight || 580;

      this.canvas.width = Math.floor(this.width * this.dpi);
      this.canvas.height = Math.floor(this.height * this.dpi);

      this.ctx.setTransform(this.dpi, 0, 0, this.dpi, 0, 0);
      this.setupScene();

      if (this.reducedMotion || !this.isVisible) {
        this.draw();
      }
    }

    setupScene() {
      const isMobile = this.width < 768;
      const isTablet = this.width >= 768 && this.width < 1080;
      const cx = this.width / 2;
      const cy = this.height * 0.48;

      // Base radius of the 3D Holographic Orb
      this.orbRadius = isMobile ? 105 : (isTablet ? 150 : 185);

      // 1. SETUP 3D GEODESIC ICOSAHEDRAL / SPHERICAL MESH
      this.geodesicVertices = [];
      this.geodesicEdges = [];

      // Golden ratio for icosahedron vertices
      const phi = (1 + Math.sqrt(5)) / 2;
      const baseVertices = [
        [-1,  phi,  0], [ 1,  phi,  0], [-1, -phi,  0], [ 1, -phi,  0],
        [ 0, -1,  phi], [ 0,  1,  phi], [ 0, -1, -phi], [ 0,  1, -phi],
        [ phi,  0, -1], [ phi,  0,  1], [-phi,  0, -1], [-phi,  0,  1]
      ];

      // Normalize to orbRadius
      baseVertices.forEach((v) => {
        const len = Math.hypot(v[0], v[1], v[2]);
        this.geodesicVertices.push({
          x: (v[0] / len) * this.orbRadius,
          y: (v[1] / len) * this.orbRadius,
          z: (v[2] / len) * this.orbRadius
        });
      });

      // Subdivide geodesic rings for additional latitude chords
      const latRings = isMobile ? 4 : 7;
      const lonRings = isMobile ? 8 : 14;

      for (let i = 1; i < latRings; i++) {
        const lat = (i / latRings) * Math.PI - Math.PI / 2;
        const ringR = Math.cos(lat) * this.orbRadius;
        const ringY = Math.sin(lat) * this.orbRadius;

        for (let j = 0; j < lonRings; j++) {
          const lon = (j / lonRings) * Math.PI * 2;
          this.geodesicVertices.push({
            x: Math.cos(lon) * ringR,
            y: ringY,
            z: Math.sin(lon) * ringR
          });
        }
      }

      // Build edge connections
      for (let i = 0; i < this.geodesicVertices.length; i++) {
        for (let j = i + 1; j < this.geodesicVertices.length; j++) {
          const v1 = this.geodesicVertices[i];
          const v2 = this.geodesicVertices[j];
          const dist = Math.hypot(v1.x - v2.x, v1.y - v2.y, v1.z - v2.z);
          // Connect vertices that are proximate on the geodesic hull
          if (dist > this.orbRadius * 0.35 && dist < this.orbRadius * 0.72) {
            this.geodesicEdges.push({ i, j });
          }
        }
      }

      // 2. SETUP CURVED 3D HOLOGRAPHIC CODE WAFERS ON THE ORB SURFACE
      this.codePanels = [];
      const panelCount = isMobile ? 6 : 14;

      for (let p = 0; p < panelCount; p++) {
        const theta = (p / panelCount) * Math.PI * 2 + (Math.random() * 0.3);
        const phiAngle = (Math.random() * 0.6 + 0.2) * Math.PI; // Between equator and poles
        const r = this.orbRadius * 1.04; // Floating slightly above wireframe

        const snippet1 = this.telemetrySnippets[p % this.telemetrySnippets.length];
        const snippet2 = this.telemetrySnippets[(p + 3) % this.telemetrySnippets.length];

        this.codePanels.push({
          theta,
          phi: phiAngle,
          r,
          w: isMobile ? 48 : 68,
          h: isMobile ? 26 : 34,
          lines: [snippet1, snippet2],
          rotSpeed: 0.005 + (p % 3) * 0.002,
          pulsePhase: p * 0.8
        });
      }

      // 3. SETUP MULTI-LANE FIBER CONDUITS (CONVERGING HORIZONTALLY INTO ORB)
      this.fiberConduits = [];
      const conduitCount = isMobile ? 6 : 12;

      for (let c = 0; c < conduitCount; c++) {
        const isLeft = c % 2 === 0;
        const startX = isLeft ? -10 : this.width + 10;
        const startY = (c / conduitCount) * (this.height * 0.85) + 35;

        // Converge toward the orb center with 3D entry point
        const targetAng = isLeft 
          ? Math.PI * 0.85 + ((c / conduitCount) - 0.5) * 0.8
          : -Math.PI * 0.15 + ((c / conduitCount) - 0.5) * 0.8;
        
        const targetX = cx + Math.cos(targetAng) * (this.orbRadius * 0.55);
        const targetY = cy + Math.sin(targetAng) * (this.orbRadius * 0.55);

        // Control points
        const cp1x = isLeft ? startX + (cx - startX) * 0.45 : startX - (startX - cx) * 0.45;
        const cp1y = startY + ((c % 2 === 0) ? -40 : 40);
        const cp2x = isLeft ? cx - (cx - startX) * 0.25 : cx + (startX - cx) * 0.25;
        const cp2y = cy + ((c % 2 === 0) ? 30 : -30);

        // Packets on this fiber conduit
        const packets = [];
        const packetCount = isMobile ? 1 : 2;
        for (let k = 0; k < packetCount; k++) {
          packets.push({
            progress: (k / packetCount) + (c * 0.14) % 1.0,
            speed: 0.004 + (c % 3) * 0.001,
            size: isMobile ? 2.2 : 3.0,
            validated: false
          });
        }

        this.fiberConduits.push({
          startX, startY,
          cp1x, cp1y,
          cp2x, cp2y,
          targetX, targetY,
          packets,
          alpha: 0.25 + (c % 3) * 0.08,
          lanes: isMobile ? 1 : 2
        });
      }

      // 4. SETUP ORBITING VALIDATION PHOTONS (3D ELLIPTICAL ORBITS)
      this.orbitingPhotons = [];
      const photonCount = isMobile ? 14 : 32;

      for (let i = 0; i < photonCount; i++) {
        const orbitRadius = this.orbRadius * (0.85 + Math.random() * 0.45);
        const inclination = (i % 2 === 0 ? 1 : -1) * (0.4 + Math.random() * 0.35);
        const speed = 0.012 + Math.random() * 0.008;

        this.orbitingPhotons.push({
          orbitRadius,
          angle: (i / photonCount) * Math.PI * 2,
          inclination,
          speed,
          size: Math.random() * 2.2 + 1.2,
          isValidated: false,
          trail: []
        });
      }

      // 5. SETUP SILHOUETTE SERVER INFRASTRUCTURE MONOLITHS (LEFT & RIGHT)
      this.sideMonoliths = [];
      if (!isMobile) {
        // Left monolithic silhouettes
        this.sideMonoliths.push(
          { x: 20, y: 50, w: 95, h: 260, depth: 35, side: 'left' },
          { x: 80, y: 220, w: 110, h: 320, depth: 40, side: 'left' }
        );
        // Right monolithic silhouettes
        this.sideMonoliths.push(
          { x: this.width - 120, y: 60, w: 100, h: 250, depth: 35, side: 'right' },
          { x: this.width - 190, y: 240, w: 115, h: 310, depth: 40, side: 'right' }
        );
      }
    }

    // 3D Rotation helper (Yaw around Y-axis, Pitch around X-axis)
    rotate3D(x, y, z, yaw, pitch) {
      // 1. Yaw around Y
      const cosY = Math.cos(yaw);
      const sinY = Math.sin(yaw);
      const x1 = x * cosY + z * sinY;
      const z1 = -x * sinY + z * cosY;

      // 2. Pitch around X
      const cosX = Math.cos(pitch);
      const sinX = Math.sin(pitch);
      const y2 = y * cosX - z1 * sinX;
      const z2 = y * sinX + z1 * cosX;

      return { x: x1, y: y2, z: z2 };
    }

    project3D(p, cx, cy) {
      const focalLength = 480;
      const scale = focalLength / (focalLength + p.z + this.orbRadius * 1.5);
      return {
        x: cx + p.x * scale,
        y: cy + p.y * scale,
        scale,
        z: p.z
      };
    }

    getBezierPoint(t, p0, p1, p2, p3) {
      const u = 1 - t;
      const tt = t * t;
      const uu = u * u;
      const uuu = uu * u;
      const ttt = tt * t;

      return {
        x: uuu * p0.x + 3 * uu * t * p1.x + 3 * u * tt * p2.x + ttt * p3.x,
        y: uuu * p0.y + 3 * uu * t * p1.y + 3 * u * tt * p2.y + ttt * p3.y
      };
    }

    drawCastleGateCore(cx, cy, time) {
      const ctx = this.ctx;
      const isMobile = this.width < 768;
      const baseR = isMobile ? 55 : 95;
      const pulse = Math.sin(time * 1.8) * 0.5 + 0.5;

      ctx.save();
      ctx.translate(cx, cy);

      // 1. RADIANT CORE FLARE (DEEP ATMOSPHERIC CYCLOTRON)
      const gradBg = ctx.createRadialGradient(0, 0, baseR * 0.1, 0, 0, baseR * 2.8);
      gradBg.addColorStop(0, `rgba(52, 107, 241, ${0.3 + pulse * 0.12})`);
      gradBg.addColorStop(0.3, `rgba(52, 107, 241, ${0.1 + pulse * 0.05})`);
      gradBg.addColorStop(0.65, 'rgba(6, 8, 12, 0.5)');
      gradBg.addColorStop(1, 'transparent');
      ctx.fillStyle = gradBg;
      ctx.beginPath();
      ctx.arc(0, 0, baseR * 2.8, 0, Math.PI * 2);
      ctx.fill();

      // 2. OUTER RETICLE GEAR WITH NOTCHES (CLOCKWISE)
      ctx.save();
      ctx.rotate(time * 0.08);
      ctx.strokeStyle = `rgba(52, 107, 241, ${0.35 + pulse * 0.2})`;
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.arc(0, 0, baseR * 1.25, 0, Math.PI * 2);
      ctx.stroke();

      const notchCount = 36;
      for (let n = 0; n < notchCount; n++) {
        const ang = (n / notchCount) * Math.PI * 2;
        const isMajor = n % 6 === 0;
        const len = isMajor ? 12 : 5;
        const r1 = baseR * 1.25;
        const r2 = r1 - len;
        ctx.beginPath();
        ctx.moveTo(Math.cos(ang) * r1, Math.sin(ang) * r1);
        ctx.lineTo(Math.cos(ang) * r2, Math.sin(ang) * r2);
        ctx.strokeStyle = isMajor 
          ? `rgba(52, 107, 241, ${0.75 + pulse * 0.25})`
          : `rgba(255, 255, 255, 0.25)`;
        ctx.lineWidth = isMajor ? 1.5 : 0.8;
        ctx.stroke();
      }
      ctx.restore();

      // 3. SEGMENTED APERTURE GATES (COUNTER-CLOCKWISE)
      ctx.save();
      ctx.rotate(-time * 0.05);
      const segments = 6;
      for (let s = 0; s < segments; s++) {
        const startAng = (s / segments) * Math.PI * 2;
        const endAng = startAng + (Math.PI * 2 / segments) * 0.65;
        ctx.beginPath();
        ctx.arc(0, 0, baseR * 1.05, startAng, endAng);
        ctx.strokeStyle = `rgba(52, 107, 241, ${0.6 + pulse * 0.3})`;
        ctx.lineWidth = 2.6;
        ctx.stroke();

        // Terminal vertex node
        const vx = Math.cos(startAng) * baseR * 1.05;
        const vy = Math.sin(startAng) * baseR * 1.05;
        ctx.beginPath();
        ctx.arc(vx, vy, 3.2, 0, Math.PI * 2);
        ctx.fillStyle = '#346BF1';
        ctx.fill();
        ctx.strokeStyle = '#FFFFFF';
        ctx.lineWidth = 0.8;
        ctx.stroke();
      }
      ctx.restore();

      // 4. MAIN NEON VALIDATION REACTOR RING
      ctx.beginPath();
      ctx.arc(0, 0, baseR * 0.85, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(52, 107, 241, ${0.7 + pulse * 0.3})`;
      ctx.lineWidth = 2.4;
      ctx.stroke();

      // Neon halo glow
      ctx.beginPath();
      ctx.arc(0, 0, baseR * 0.85, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(52, 107, 241, ${0.2 + pulse * 0.15})`;
      ctx.lineWidth = 12;
      ctx.stroke();

      // 5. CASTLE GATE CORE IRIS (EMERALD VALIDATION LOCK)
      const coreGrad = ctx.createRadialGradient(0, 0, 0, 0, 0, baseR * 0.5);
      coreGrad.addColorStop(0, `rgba(255, 255, 255, ${0.95 + pulse * 0.05})`);
      coreGrad.addColorStop(0.25, `rgba(52, 107, 241, ${0.85 + pulse * 0.15})`);
      coreGrad.addColorStop(0.65, `rgba(0, 229, 153, ${0.35 + pulse * 0.25})`);
      coreGrad.addColorStop(1, 'transparent');

      ctx.fillStyle = coreGrad;
      ctx.beginPath();
      ctx.arc(0, 0, baseR * 0.5, 0, Math.PI * 2);
      ctx.fill();

      // Central Shield Cryptographic Indicator
      ctx.strokeStyle = '#FFFFFF';
      ctx.lineWidth = 1.5;
      ctx.strokeRect(-7, -7, 14, 14);

      ctx.beginPath();
      ctx.arc(0, 0, 3.5, 0, Math.PI * 2);
      ctx.fillStyle = '#00E599';
      ctx.fill();

      ctx.restore();
    }

    draw() {
      if (!this.ctx) return;
      this.ctx.clearRect(0, 0, this.width, this.height);

      const isMobile = this.width < 768;
      const cx = this.width / 2 + this.mouse.x * 0.35;
      const cy = this.height * 0.44 + this.mouse.y * 0.35 - (this.scrollY * 0.12);

      // Rotation angles for 3D sphere
      const yaw = this.time * 0.15;
      const pitch = Math.sin(this.time * 0.1) * 0.18;

      // A. BACKGROUND PERSPECTIVE GRID
      const gridCount = isMobile ? 8 : 16;
      this.ctx.lineWidth = 0.5;
      for (let g = 0; g <= gridCount; g++) {
        const ratio = g / gridCount;
        const xBottom = ratio * this.width;
        this.ctx.beginPath();
        this.ctx.moveTo(cx, cy);
        this.ctx.lineTo(xBottom, this.height);
        this.ctx.strokeStyle = 'rgba(52, 107, 241, 0.04)';
        this.ctx.stroke();
      }

      // B. SIDE MONOLITH SILHOUETTES
      this.sideMonoliths.forEach((m) => {
        const isLeft = m.side === 'left';
        const posX = m.x + (isLeft ? this.mouse.x * 0.7 : this.mouse.x * 0.7);
        const posY = m.y + this.mouse.y * 0.7;

        this.ctx.fillStyle = '#0a0e17';
        this.ctx.fillRect(posX, posY, m.w, m.h);
        this.ctx.strokeStyle = 'rgba(255, 255, 255, 0.06)';
        this.ctx.lineWidth = 0.8;
        this.ctx.strokeRect(posX, posY, m.w, m.h);

        // Status beacon on top
        this.ctx.fillStyle = '#346BF1';
        this.ctx.fillRect(posX + m.w / 2 - 4, posY - 4, 8, 4);
      });

      // C. MULTI-LANE FIBER CONDUITS & TRAVELING PHOTONS
      this.fiberConduits.forEach((c) => {
        const p0 = { x: c.startX + this.mouse.x * 0.8, y: c.startY + this.mouse.y * 0.8 };
        const p1 = { x: c.cp1x + this.mouse.x * 0.45, y: c.cp1y + this.mouse.y * 0.45 };
        const p2 = { x: c.cp2x + this.mouse.x * 0.3, y: c.cp2y + this.mouse.y * 0.3 };
        const p3 = { x: c.targetX + this.mouse.x * 0.35, y: c.targetY + this.mouse.y * 0.35 };

        // Draw conduit line
        this.ctx.beginPath();
        this.ctx.moveTo(p0.x, p0.y);
        this.ctx.bezierCurveTo(p1.x, p1.y, p2.x, p2.y, p3.x, p3.y);
        this.ctx.strokeStyle = `rgba(52, 107, 241, ${c.alpha})`;
        this.ctx.lineWidth = isMobile ? 1.0 : 1.4;
        this.ctx.stroke();

        // Traveling packets
        c.packets.forEach((pkt) => {
          if (!this.reducedMotion) {
            pkt.progress += pkt.speed;
            if (pkt.progress > 1) {
              pkt.progress = 0;
              pkt.validated = !pkt.validated;
            }
          }

          const pt = this.getBezierPoint(pkt.progress, p0, p1, p2, p3);
          const isVal = pkt.validated && pkt.progress > 0.45;
          const pktColor = isVal ? '#00E599' : '#346BF1';

          // Photon Halo
          this.ctx.beginPath();
          this.ctx.arc(pt.x, pt.y, pkt.size * 2.5, 0, Math.PI * 2);
          this.ctx.fillStyle = isVal ? 'rgba(0, 229, 153, 0.4)' : 'rgba(52, 107, 241, 0.4)';
          this.ctx.fill();

          // Photon Core
          this.ctx.beginPath();
          this.ctx.arc(pt.x, pt.y, pkt.size, 0, Math.PI * 2);
          this.ctx.fillStyle = pktColor;
          this.ctx.fill();
        });
      });

      // D. PROJECT 3D GEODESIC VERTICES
      const projectedVerts = this.geodesicVertices.map((v) => {
        const rotated = this.rotate3D(v.x, v.y, v.z, yaw, pitch);
        return this.project3D(rotated, cx, cy);
      });

      // E. DRAW 3D GEODESIC WIREFRAME EDGES (DEPTH SORTED)
      this.geodesicEdges.forEach((edge) => {
        const v1 = projectedVerts[edge.i];
        const v2 = projectedVerts[edge.j];
        if (!v1 || !v2) return;

        const avgZ = (v1.z + v2.z) / 2;
        const isFront = avgZ > -20;
        const alpha = isFront ? 0.35 + (avgZ / this.orbRadius) * 0.45 : 0.08;

        this.ctx.beginPath();
        this.ctx.moveTo(v1.x, v1.y);
        this.ctx.lineTo(v2.x, v2.y);
        this.ctx.strokeStyle = `rgba(52, 107, 241, ${Math.max(0.04, alpha)})`;
        this.ctx.lineWidth = isFront ? 1.0 : 0.6;
        this.ctx.stroke();
      });

      // F. DRAW 3D HOLOGRAPHIC CODE WAFERS (CURVED PANELS)
      this.codePanels.forEach((panel) => {
        // Compute 3D position from spherical coordinates
        const curTheta = panel.theta + this.time * panel.rotSpeed;
        const curPhi = panel.phi;
        
        const px = panel.r * Math.sin(curPhi) * Math.cos(curTheta);
        const py = panel.r * Math.cos(curPhi);
        const pz = panel.r * Math.sin(curPhi) * Math.sin(curTheta);

        const rotated = this.rotate3D(px, py, pz, yaw, pitch);
        const proj = this.project3D(rotated, cx, cy);

        // Only draw if in front hemisphere
        if (proj.z > -this.orbRadius * 0.3) {
          const pulse = Math.sin(this.time * 2 + panel.pulsePhase) * 0.5 + 0.5;
          const pw = panel.w * proj.scale;
          const ph = panel.h * proj.scale;

          this.ctx.save();
          this.ctx.translate(proj.x, proj.y);

          // Panel Glass Background
          this.ctx.beginPath();
          this.ctx.rect(-pw / 2, -ph / 2, pw, ph);
          this.ctx.fillStyle = `rgba(10, 16, 26, ${0.85 * proj.scale})`;
          this.ctx.fill();

          // Panel Glowing Wireframe Border
          this.ctx.strokeStyle = `rgba(52, 107, 241, ${0.45 + pulse * 0.4})`;
          this.ctx.lineWidth = 1.0;
          this.ctx.stroke();

          // Corner Vertex LEDs
          this.ctx.fillStyle = '#346BF1';
          this.ctx.fillRect(-pw / 2 - 1, -ph / 2 - 1, 2.5, 2.5);
          this.ctx.fillRect(pw / 2 - 1, -ph / 2 - 1, 2.5, 2.5);

          // Telemetry Lines inside panel
          this.ctx.font = `${Math.max(6, Math.floor(7.5 * proj.scale))}px "JetBrains Mono", monospace`;
          this.ctx.fillStyle = `rgba(52, 107, 241, ${0.75 + pulse * 0.25})`;
          this.ctx.fillText(panel.lines[0], -pw / 2 + 5, -ph / 2 + 10 * proj.scale);

          this.ctx.fillStyle = `rgba(136, 148, 166, ${0.65 * proj.scale})`;
          this.ctx.fillText(panel.lines[1], -pw / 2 + 5, -ph / 2 + 20 * proj.scale);

          this.ctx.restore();
        }
      });

      // G. DRAW CENTRAL CASTLE GATE CORE (REACTOR NUCLEUS)
      this.drawCastleGateCore(cx, cy, this.time);

      // H. DRAW 3D ORBITING VALIDATION PHOTONS
      this.orbitingPhotons.forEach((p) => {
        if (!this.reducedMotion) {
          p.angle += p.speed;
        }

        // Elliptical 3D orbit
        const ox = Math.cos(p.angle) * p.orbitRadius;
        const oy = Math.sin(p.angle) * Math.sin(p.inclination) * p.orbitRadius;
        const oz = Math.sin(p.angle) * Math.cos(p.inclination) * p.orbitRadius;

        const rotated = this.rotate3D(ox, oy, oz, yaw, pitch);
        const proj = this.project3D(rotated, cx, cy);

        // Validation cycle check
        if (Math.abs(proj.z) < 30 && Math.hypot(proj.x - cx, proj.y - cy) < 60) {
          p.isValidated = true;
        }
        if (proj.z < -this.orbRadius * 0.7) {
          p.isValidated = false;
        }

        const photonColor = p.isValidated ? '#00E599' : '#346BF1';
        const haloColor = p.isValidated ? 'rgba(0, 229, 153, 0.45)' : 'rgba(52, 107, 241, 0.45)';

        // Draw Photon Halo
        this.ctx.beginPath();
        this.ctx.arc(proj.x, proj.y, p.size * proj.scale * 2.2, 0, Math.PI * 2);
        this.ctx.fillStyle = haloColor;
        this.ctx.fill();

        // Draw Photon Core
        this.ctx.beginPath();
        this.ctx.arc(proj.x, proj.y, p.size * proj.scale, 0, Math.PI * 2);
        this.ctx.fillStyle = photonColor;
        this.ctx.fill();
      });
    }

    loop() {
      // Smooth mouse interpolation
      this.mouse.x += (this.mouse.targetX - this.mouse.x) * 0.055;
      this.mouse.y += (this.mouse.targetY - this.mouse.y) * 0.055;

      this.time += 0.016;
      this.draw();

      if (this.isVisible && !this.reducedMotion) {
        this.frameId = requestAnimationFrame(() => this.loop());
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new CastleGateHolographicOrb();
  });
</script>
