---
import HeroEngineVisual from './HeroEngineVisual.astro';

interface Props {
  title?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  accent?: "cyan" | "green";
}

const {
  title = "",
  description = "",
  ctaLabel = "Iniciar Proyecto",
  ctaHref = "/contacto",
  accent = "cyan"
} = Astro.props;

type TitlePart = {
  text: string;
  accent?: "cyan" | "success";
};

// CTABand titles are plain text with one optional, controlled color accent.
const titleParts: TitlePart[] = [];
const accentPattern = /<span\s+style=(["'])color:\s*var\(--(cyan|success)\);?\1>([\s\S]*?)<\/span>/gi;
let titleCursor = 0;
let titleMatch: RegExpExecArray | null;

while ((titleMatch = accentPattern.exec(title)) !== null) {
  if (titleMatch.index > titleCursor) {
    titleParts.push({ text: title.slice(titleCursor, titleMatch.index) });
  }

  titleParts.push({
    text: titleMatch[3],
    accent: titleMatch[2].toLowerCase() as "cyan" | "success"
  });
  titleCursor = titleMatch.index + titleMatch[0].length;
}

if (titleCursor < title.length) {
  titleParts.push({ text: title.slice(titleCursor) });
}
---

<section class={`cta-band ${accent === 'green' ? 'cta-band-green' : ''}`}>
  <!-- Three.js Approved Background Engine (Isolated multi-instance) -->
  <HeroEngineVisual variant={accent === 'green' ? 'green' : 'blue'} />

  <div class="container cta-content-container">
    {title && (
      <h2 class={!description ? "cta-title-standalone" : ""}>
        {titleParts.map((part) => part.accent
          ? <span style={`color: var(--${part.accent});`}>{part.text}</span>
          : part.text
        )}
      </h2>
    )}
    {description && <p>{description}</p>}
    <div class="cta-action-wrapper">
      <a class={`btn btn-cta-crystal ${accent === 'green' ? 'btn-cta-crystal-green' : ''}`} href={ctaHref} id="cta-crystal-btn">
        {ctaLabel} <span class="cta-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: #060a17;
    color: var(--paper);
    padding-block: clamp(4.5rem, 7vw, 6.25rem);
    text-align: center;
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgba(52, 107, 241, 0.22);
    border-bottom: 1px solid rgba(52, 107, 241, 0.15);
    box-sizing: border-box;
  }

  .cta-band.cta-band-green {
    background: #04160e !important;
    border-top: 1px solid rgba(0, 229, 153, 0.25);
    border-bottom: 1px solid rgba(0, 229, 153, 0.15);
  }

  .cta-content-container {
    position: relative;
    z-index: 3;
    max-width: 820px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .cta-band h2 {
    font-family: var(--f-display, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    font-size: clamp(1.85rem, 3.2vw, 2.6rem);
    color: var(--paper);
    margin-bottom: 0.85rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.16;
    text-wrap: balance;
  }

  .cta-band h2.cta-title-standalone {
    font-family: var(--f-display, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    font-size: clamp(1.4rem, 2.1vw, 1.85rem);
    line-height: 1.25;
    font-weight: 800;
    letter-spacing: -0.025em;
    margin-bottom: 2rem;
    max-width: 780px;
    margin-inline: auto;
  }

  .cta-band p {
    max-width: 62ch;
    margin-inline: auto;
    color: var(--steel-light);
    font-size: 1.08rem;
    line-height: 1.65;
    margin-bottom: 2.25rem;
  }

  .cta-action-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  /* Normalized Primary Action CTA Button: Dark/Transparent + Fine Blue Border + White Text */
  .cta-band .btn-cta-crystal {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-align: center !important;
    gap: 0.65rem;
    width: 260px !important;
    min-width: 260px !important;
    max-width: 260px !important;
    min-height: 56px !important;
    padding: 16px 32px !important;
    box-sizing: border-box !important;
    font-family: var(--f-body, sans-serif) !important;
    font-size: 16px !important;
    font-weight: 700 !important;
    line-height: 1.2 !important;
    letter-spacing: 0.01em !important;
    color: #ffffff !important;
    background: rgba(6, 10, 23, 0.65) !important;
    border: 1px solid rgba(52, 107, 241, 0.65) !important;
    border-radius: var(--radius, 8px) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    text-decoration: none !important;
    cursor: pointer !important;
    box-shadow: 0 0 16px rgba(52, 107, 241, 0.20), inset 0 1px 0 rgba(255, 255, 255, 0.12) !important;
    transition: 
      border-color 0.2s ease, 
      box-shadow 0.2s ease, 
      background 0.2s ease,
      filter 0.15s ease !important;
    position: relative !important;
    z-index: 5 !important;
    transform: none !important;
  }

  .cta-band .btn-cta-crystal .cta-arrow {
    color: #ffffff !important;
    font-size: 1.1em;
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .cta-band .btn-cta-crystal:hover {
    border-color: #346bf1 !important;
    background: rgba(10, 18, 36, 0.85) !important;
    box-shadow: 0 0 24px rgba(52, 107, 241, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.25) !important;
    color: #ffffff !important;
  }

  .cta-band .btn-cta-crystal:hover .cta-arrow {
    transform: translateX(4px);
  }

  .cta-band .btn-cta-crystal:active {
    background: rgba(4, 8, 18, 0.95) !important;
    box-shadow: 0 0 12px rgba(52, 107, 241, 0.30) !important;
  }

  /* Castle Impact Green Variant */
  .cta-band.cta-band-green .btn-cta-crystal,
  .cta-band .btn-cta-crystal.btn-cta-crystal-green {
    background: rgba(4, 16, 10, 0.65) !important;
    border: 1px solid rgba(0, 229, 153, 0.65) !important;
    box-shadow: 0 0 16px rgba(0, 229, 153, 0.20), inset 0 1px 0 rgba(255, 255, 255, 0.12) !important;
    color: #ffffff !important;
  }

  .cta-band.cta-band-green .btn-cta-crystal:hover,
  .cta-band .btn-cta-crystal.btn-cta-crystal-green:hover {
    border-color: #00e599 !important;
    background: rgba(6, 26, 16, 0.85) !important;
    box-shadow: 0 0 24px rgba(0, 229, 153, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.25) !important;
    color: #ffffff !important;
  }

  @media (max-width: 640px) {
    .cta-band {
      padding-block: 3.75rem;
    }

    .cta-band h2 {
      font-size: clamp(1.45rem, 5.4vw, 1.95rem);
      line-height: 1.2;
    }

    .cta-band p {
      font-size: 0.94rem;
      line-height: 1.6;
      max-width: 40ch;
    }

    .cta-band .btn-cta-crystal {
      width: 100% !important;
      max-width: 260px !important;
      min-width: 0 !important;
      min-height: 56px !important;
      padding: 16px 32px !important;
      font-size: 16px !important;
      font-weight: 700 !important;
      line-height: 1.2 !important;
      box-sizing: border-box !important;
      margin-inline: auto !important;
    }
  }
</style>
