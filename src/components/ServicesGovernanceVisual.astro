---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`services-governance-wrapper ${className}`} id="services-governance-wrapper" aria-hidden="true">
  <!-- Fallback CSS background with tech-noir architectural depth -->
  <div class="services-governance-fallback"></div>
  <canvas id="services-governance-canvas" class="services-governance-canvas"></canvas>
  <!-- Optical contrast shield for perfect text legibility -->
  <div class="services-governance-contrast-mask"></div>
</div>

<style>
  .services-governance-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    background: #06080c;
  }

  .services-governance-fallback {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(circle at 50% 44%, rgba(0, 210, 255, 0.14) 0%, rgba(6, 8, 12, 0.75) 48%, #06080c 85%),
      linear-gradient(180deg, rgba(6, 8, 12, 0.25) 0%, rgba(6, 8, 12, 0.95) 100%);
    z-index: 1;
    pointer-events: none;
  }

  .services-governance-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 2;
    pointer-events: none;
  }

  .services-governance-contrast-mask {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: radial-gradient(
      ellipse 80% 70% at 50% 46%,
      rgba(6, 8, 12, 0.85) 0%,
      rgba(6, 8, 12, 0.52) 55%,
      rgba(6, 8, 12, 0.12) 85%,
      rgba(6, 8, 12, 0.92) 100%
    );
  }
</style>

<script is:inline>
  class ServicesGovernanceMosaic {
    constructor() {
      this.wrapper = document.getElementById('services-governance-wrapper');
      this.canvas = document.getElementById('services-governance-canvas');
      if (!this.wrapper || !this.canvas) return;

      this.ctx = this.canvas.getContext('2d');
      if (!this.ctx) return;

      this.width = 0;
      this.height = 0;
      this.dpi = Math.min(window.devicePixelRatio || 1, 2);
      this.time = 0;
      this.frameId = null;
      this.isVisible = false;
      this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Parallax smooth interpolation
      this.mouse = { x: 0, y: 0, targetX: 0, targetY: 0 };
      this.scrollY = 0;

      // Governance nodes, data highways & validation pulses
      this.governanceNodes = [];
      this.circuitHighways = [];
      this.validationPulses = [];
      this.ambientPhotons = [];

      this.init();
    }

    init() {
      this.resize();
      window.addEventListener('resize', () => this.resize(), { passive: true });

      // Mouse tracking over hero
      const heroSection = this.wrapper.closest('.page-hero') || this.wrapper.closest('section');
      if (heroSection) {
        heroSection.addEventListener('mousemove', (e) => {
          const rect = heroSection.getBoundingClientRect();
          const normX = (e.clientX - rect.left) / rect.width - 0.5;
          const normY = (e.clientY - rect.top) / rect.height - 0.5;
          this.mouse.targetX = normX * 36;
          this.mouse.targetY = normY * 24;
        }, { passive: true });

        heroSection.addEventListener('mouseleave', () => {
          this.mouse.targetX = 0;
          this.mouse.targetY = 0;
        }, { passive: true });
      }

      // Scroll tracking
      window.addEventListener('scroll', () => {
        this.scrollY = window.scrollY || 0;
      }, { passive: true });

      // IntersectionObserver for performance
      this.observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          this.isVisible = entry.isIntersecting;
          if (this.isVisible) {
            if (this.reducedMotion) {
              this.draw();
            } else if (!this.frameId) {
              this.loop();
            }
          } else {
            if (this.frameId) {
              cancelAnimationFrame(this.frameId);
              this.frameId = null;
            }
          }
        });
      }, { threshold: 0.02 });

      this.observer.observe(this.wrapper);
      this.setupScene();
    }

    resize() {
      this.width = this.wrapper.clientWidth || window.innerWidth;
      this.height = this.wrapper.clientHeight || 560;

      this.canvas.width = Math.floor(this.width * this.dpi);
      this.canvas.height = Math.floor(this.height * this.dpi);

      this.ctx.setTransform(this.dpi, 0, 0, this.dpi, 0, 0);
      this.setupScene();

      if (this.reducedMotion || !this.isVisible) {
        this.draw();
      }
    }

    setupScene() {
      const isMobile = this.width < 768;
      const isTablet = this.width >= 768 && this.width < 1080;
      const cx = this.width / 2;
      const cy = this.height * 0.44;

      // 1. SETUP 5 MAIN GOVERNANCE CAPABILITY NODES / SLABS
      this.governanceNodes = [];

      // 5 Major Architectural Nodes (Symmetrically balanced) + Support Relays
      const nodeDefinitions = [
        // 01. CHECKUP NODE (Top-Left): Static scan & telemetry
        {
          id: 'checkup',
          relX: -0.34, relY: -0.22,
          w: 115, h: 72, depth: 36,
          label: "01. CHECKUP",
          subLabel: "SCAN_65_CTRLS",
          type: "diagnostic",
          accentColor: "#00D2FF",
          floatSpeed: 1.1, floatAmp: 7, phase: 0.0
        },
        // 02. AUDIT NODE (Top-Right): In-depth inspection & vulnerability remediation
        {
          id: 'audit',
          relX: 0.34, relY: -0.22,
          w: 115, h: 72, depth: 36,
          label: "02. AUDIT",
          subLabel: "REMEDIATION_PATH",
          type: "audit_slab",
          accentColor: "#00D2FF",
          warnColor: "rgba(255, 77, 77, 0.7)",
          floatSpeed: 0.9, floatAmp: 9, phase: 1.8
        },
        // 03. RESCUE NODE (Bottom-Left): Legacy refactoring & stabilization
        {
          id: 'rescue',
          relX: -0.34, relY: 0.26,
          w: 115, h: 72, depth: 36,
          label: "03. RESCUE",
          subLabel: "FORTIFIED_CODE",
          type: "fortified",
          accentColor: "#00E599",
          floatSpeed: 1.3, floatAmp: 8, phase: 3.2
        },
        // 04. EMERGENCY NODE (Bottom-Right): Incident response & containment
        {
          id: 'emergency',
          relX: 0.34, relY: 0.26,
          w: 115, h: 72, depth: 36,
          label: "04. EMERGENCY",
          subLabel: "CONTAINMENT_OK",
          type: "priority",
          accentColor: "#00D2FF",
          floatSpeed: 1.0, floatAmp: 10, phase: 4.6
        },
        // 05. CARE NODE (Bottom-Center Symmetrical): Continuous governance & heartbeat
        {
          id: 'care',
          relX: 0.0, relY: 0.36,
          w: 110, h: 62, depth: 32,
          label: "05. CARE",
          subLabel: "HEARTBEAT_LIVE",
          type: "monitor",
          accentColor: "#00D2FF",
          floatSpeed: 1.2, floatAmp: 6, phase: 2.4
        },
        // Satellite Relay 01 (Deep left)
        {
          id: 'relay_left',
          relX: -0.44, relY: 0.03,
          w: 65, h: 45, depth: 25,
          label: "GATE_BUS_0",
          subLabel: "0x8A12",
          type: "relay",
          accentColor: "#00D2FF",
          floatSpeed: 0.8, floatAmp: 5, phase: 5.1
        },
        // Satellite Relay 02 (Deep right)
        {
          id: 'relay_right',
          relX: 0.44, relY: 0.03,
          w: 65, h: 45, depth: 25,
          label: "GATE_BUS_1",
          subLabel: "SHA256:OK",
          type: "relay",
          accentColor: "#00D2FF",
          floatSpeed: 1.4, floatAmp: 6, phase: 0.7
        }
      ];

      const scale = isMobile ? 0.65 : (isTablet ? 0.85 : 1.0);

      nodeDefinitions.forEach((spec, idx) => {
        // On mobile, simplify by hiding satellite relays
        if (isMobile && (spec.id === 'relay_left' || spec.id === 'relay_right')) return;

        const basePosX = cx + spec.relX * this.width * (isMobile ? 0.82 : 1.0);
        const basePosY = cy + spec.relY * this.height * (isMobile ? 0.75 : 1.0);

        this.governanceNodes.push({
          ...spec,
          w: spec.w * scale,
          h: spec.h * scale,
          depth: spec.depth * scale,
          baseX: basePosX,
          baseY: basePosY,
          currentX: basePosX,
          currentY: basePosY,
          reconfigPulse: idx * 1.2,
          validatedState: false,
          validationTimer: Math.random() * 5
        });
      });

      // Sort by Y for correct isometric depth occlusion
      this.governanceNodes.sort((a, b) => a.baseY - b.baseY);

      // 2. SETUP HIGHWAY DATA BUSES CONVERGING INTO CASTLE GATE CORE
      this.circuitHighways = [];
      const gateRadius = isMobile ? 65 : 125;

      this.governanceNodes.forEach((node, idx) => {
        // Connect each governance node to the central Castle Gate Core with multi-lane parallel traces
        const startX = node.baseX + node.w * 0.5;
        const startY = node.baseY + node.h * 0.5;

        const angleToCenter = Math.atan2(cy - startY, cx - startX);
        const targetX = cx + Math.cos(angleToCenter + Math.PI) * (-gateRadius);
        const targetY = cy + Math.sin(angleToCenter + Math.PI) * (-gateRadius);

        // Orthogonal / Isometric control points
        const cp1x = startX + (cx - startX) * 0.45;
        const cp1y = startY + ((idx % 2 === 0) ? -35 : 35);
        const cp2x = cx - (cx - startX) * 0.25;
        const cp2y = cy + ((idx % 2 === 0) ? 25 : -25);

        // Packets on this highway
        const packets = [];
        const packetCount = isMobile ? 1 : 2;
        for (let p = 0; p < packetCount; p++) {
          packets.push({
            progress: (p / packetCount) + (idx * 0.15) % 1.0,
            speed: 0.0035 + (idx % 3) * 0.0008,
            isValidated: false,
            color: '#00D2FF',
            size: isMobile ? 2.2 : 3.0
          });
        }

        this.circuitHighways.push({
          nodeId: node.id,
          startX, startY,
          cp1x, cp1y,
          cp2x, cp2y,
          targetX, targetY,
          packets,
          alpha: 0.24 + (idx % 3) * 0.08,
          lanes: isMobile ? 1 : 2
        });
      });

      // 3. SETUP AMBIENT DATA PARTICLES
      this.ambientPhotons = [];
      const photonCount = isMobile ? 12 : 30;
      for (let p = 0; p < photonCount; p++) {
        this.ambientPhotons.push({
          x: Math.random() * this.width,
          y: Math.random() * this.height,
          vx: (Math.random() - 0.5) * 0.22,
          vy: -Math.random() * 0.35 - 0.08,
          size: Math.random() * 2.0 + 0.8,
          alpha: Math.random() * 0.3 + 0.1,
          phase: Math.random() * Math.PI * 2
        });
      }
    }

    getBezierPoint(t, p0, p1, p2, p3) {
      const u = 1 - t;
      const tt = t * t;
      const uu = u * u;
      const uuu = uu * u;
      const ttt = tt * t;

      return {
        x: uuu * p0.x + 3 * uu * t * p1.x + 3 * u * tt * p2.x + ttt * p3.x,
        y: uuu * p0.y + 3 * uu * t * p1.y + 3 * u * tt * p2.y + ttt * p3.y
      };
    }

    drawGovernanceNode(node, time) {
      const ctx = this.ctx;
      const skew = 0.5;
      const levitation = Math.sin(time * node.floatSpeed + node.phase) * node.floatAmp;
      
      const x = node.currentX;
      const y = node.currentY + levitation;
      const w = node.w;
      const h = node.h;
      const d = node.depth;

      const topOffX = d * skew;
      const topOffY = -d * skew;

      // Governance breathing pulse
      const pulse = Math.sin(time * 1.6 + node.reconfigPulse) * 0.5 + 0.5;

      ctx.save();
      ctx.translate(x, y);

      // 1. FRONT PANEL (OBSIDIAN TITANIUM CHASSIS)
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.lineTo(w, 0);
      ctx.lineTo(w, h);
      ctx.lineTo(0, h);
      ctx.closePath();
      ctx.fillStyle = 'rgba(10, 14, 22, 0.94)';
      ctx.fill();
      ctx.strokeStyle = `rgba(255, 255, 255, 0.08)`;
      ctx.lineWidth = 0.8;
      ctx.stroke();

      // 2. TOP ISOMETRIC CAP (GOVERNANCE SENSOR MATRIX)
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.lineTo(topOffX, topOffY);
      ctx.lineTo(w + topOffX, topOffY);
      ctx.lineTo(w, 0);
      ctx.closePath();
      ctx.fillStyle = 'rgba(18, 26, 40, 0.96)';
      ctx.fill();

      // Accent border on top cap
      ctx.strokeStyle = node.type === 'audit_slab' && pulse > 0.65
        ? node.warnColor
        : `rgba(0, 210, 255, ${0.35 + pulse * 0.45})`;
      ctx.lineWidth = 1.2;
      ctx.stroke();

      // 3. RIGHT SIDE FACET
      ctx.beginPath();
      ctx.moveTo(w, 0);
      ctx.lineTo(w + topOffX, topOffY);
      ctx.lineTo(w + topOffX, h + topOffY);
      ctx.lineTo(w, h);
      ctx.closePath();
      ctx.fillStyle = 'rgba(6, 9, 14, 0.96)';
      ctx.fill();
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.04)';
      ctx.stroke();

      // 4. EMBOSSED TELEMETRY LABELS & CIRCUIT GRIDS
      ctx.font = '7.5px "JetBrains Mono", monospace';
      
      // Node Primary Title
      ctx.fillStyle = `rgba(0, 210, 255, ${0.75 + pulse * 0.25})`;
      ctx.fillText(node.label, 8, 16);

      // Node Sub-telemetry
      ctx.fillStyle = 'rgba(136, 148, 166, 0.4)';
      ctx.fillText(node.subLabel, 8, 28);

      // Micro status bus lines on face
      const lineRows = 2;
      for (let r = 0; r < lineRows; r++) {
        const rowY = 38 + r * 10;
        if (rowY < h - 10) {
          ctx.beginPath();
          ctx.moveTo(8, rowY);
          ctx.lineTo(w - 20, rowY);
          ctx.strokeStyle = `rgba(0, 210, 255, ${0.12 + (r === 0 ? pulse * 0.2 : 0)})`;
          ctx.lineWidth = 0.8;
          ctx.stroke();
        }
      }

      // Status Beacon Indicator LED
      ctx.beginPath();
      ctx.arc(w - 10, 14, 2.5, 0, Math.PI * 2);
      ctx.fillStyle = (node.type === 'audit_slab' && pulse > 0.7)
        ? '#FF4D4D'
        : (node.accentColor || '#00D2FF');
      ctx.fill();

      // Top Node Sensor Vertex Points
      const sensorX = w / 2 + (topOffX * 0.5);
      const sensorY = topOffY * 0.5;

      ctx.beginPath();
      ctx.arc(sensorX, sensorY, 3, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(0, 210, 255, ${0.6 + pulse * 0.4})`;
      ctx.fill();
      ctx.strokeStyle = '#FFFFFF';
      ctx.lineWidth = 0.8;
      ctx.stroke();

      ctx.restore();
    }

    drawCastleGateCore(cx, cy, time) {
      const ctx = this.ctx;
      const isMobile = this.width < 768;
      const baseR = isMobile ? 85 : 160;
      const pulse = Math.sin(time * 1.5) * 0.5 + 0.5;

      ctx.save();
      ctx.translate(cx, cy);

      // 1. DEEP CYAN ATMOSPHERIC FLARE
      const gradBg = ctx.createRadialGradient(0, 0, baseR * 0.1, 0, 0, baseR * 2.5);
      gradBg.addColorStop(0, `rgba(0, 210, 255, ${0.22 + pulse * 0.08})`);
      gradBg.addColorStop(0.35, `rgba(0, 210, 255, ${0.07 + pulse * 0.03})`);
      gradBg.addColorStop(0.7, 'rgba(6, 8, 12, 0.45)');
      gradBg.addColorStop(1, 'transparent');
      ctx.fillStyle = gradBg;
      ctx.beginPath();
      ctx.arc(0, 0, baseR * 2.5, 0, Math.PI * 2);
      ctx.fill();

      // 2. OUTER GOVERNANCE RETICLE NOTCH RING (CLOCKWISE)
      ctx.save();
      ctx.rotate(time * 0.06);
      ctx.strokeStyle = `rgba(0, 210, 255, ${0.25 + pulse * 0.15})`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(0, 0, baseR * 1.25, 0, Math.PI * 2);
      ctx.stroke();

      const notchCount = 36;
      for (let n = 0; n < notchCount; n++) {
        const ang = (n / notchCount) * Math.PI * 2;
        const isMajor = n % 6 === 0;
        const len = isMajor ? 10 : 4;
        const r1 = baseR * 1.25;
        const r2 = r1 - len;
        ctx.beginPath();
        ctx.moveTo(Math.cos(ang) * r1, Math.sin(ang) * r1);
        ctx.lineTo(Math.cos(ang) * r2, Math.sin(ang) * r2);
        ctx.strokeStyle = isMajor 
          ? `rgba(0, 210, 255, ${0.65 + pulse * 0.3})`
          : `rgba(255, 255, 255, 0.18)`;
        ctx.lineWidth = isMajor ? 1.4 : 0.7;
        ctx.stroke();
      }
      ctx.restore();

      // 3. SEGMENTED APERTURE SHIELD (COUNTER-CLOCKWISE)
      ctx.save();
      ctx.rotate(-time * 0.04);
      const segments = 5; // 5 segments matching 5 capabilities
      for (let s = 0; s < segments; s++) {
        const startAng = (s / segments) * Math.PI * 2;
        const endAng = startAng + (Math.PI * 2 / segments) * 0.68;
        ctx.beginPath();
        ctx.arc(0, 0, baseR * 1.05, startAng, endAng);
        ctx.strokeStyle = `rgba(0, 210, 255, ${0.5 + pulse * 0.3})`;
        ctx.lineWidth = 2.4;
        ctx.stroke();

        // Terminal vertex node
        const vx = Math.cos(startAng) * baseR * 1.05;
        const vy = Math.sin(startAng) * baseR * 1.05;
        ctx.beginPath();
        ctx.arc(vx, vy, 3, 0, Math.PI * 2);
        ctx.fillStyle = '#00D2FF';
        ctx.fill();
        ctx.strokeStyle = '#FFFFFF';
        ctx.lineWidth = 0.8;
        ctx.stroke();
      }
      ctx.restore();

      // 4. MAIN NEON GOVERNANCE RING
      ctx.beginPath();
      ctx.arc(0, 0, baseR * 0.84, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(0, 210, 255, ${0.6 + pulse * 0.35})`;
      ctx.lineWidth = 2;
      ctx.stroke();

      // 5. CASTLE GATE CORE IRIS
      const coreGrad = ctx.createRadialGradient(0, 0, 0, 0, 0, baseR * 0.44);
      coreGrad.addColorStop(0, `rgba(255, 255, 255, ${0.9 + pulse * 0.1})`);
      coreGrad.addColorStop(0.25, `rgba(0, 210, 255, ${0.8 + pulse * 0.2})`);
      coreGrad.addColorStop(0.65, `rgba(0, 210, 255, ${0.2 + pulse * 0.1})`);
      coreGrad.addColorStop(1, 'transparent');

      ctx.fillStyle = coreGrad;
      ctx.beginPath();
      ctx.arc(0, 0, baseR * 0.44, 0, Math.PI * 2);
      ctx.fill();

      // Central Shield Indicator
      ctx.strokeStyle = '#FFFFFF';
      ctx.lineWidth = 1.4;
      ctx.strokeRect(-6, -6, 12, 12);

      ctx.beginPath();
      ctx.arc(0, 0, 2.5, 0, Math.PI * 2);
      ctx.fillStyle = '#00E599';
      ctx.fill();

      ctx.restore();
    }

    draw() {
      if (!this.ctx) return;
      this.ctx.clearRect(0, 0, this.width, this.height);

      const isMobile = this.width < 768;
      const cx = this.width / 2 + this.mouse.x * 0.35;
      const cy = this.height * 0.44 + this.mouse.y * 0.35 - (this.scrollY * 0.12);

      // A. TECH-NOIR ISOMETRIC CIRCUIT FLOOR
      const gridCount = isMobile ? 8 : 16;
      this.ctx.lineWidth = 0.5;
      for (let g = 0; g <= gridCount; g++) {
        const ratio = g / gridCount;
        const xBottom = ratio * this.width;
        this.ctx.beginPath();
        this.ctx.moveTo(cx, cy);
        this.ctx.lineTo(xBottom, this.height);
        this.ctx.strokeStyle = 'rgba(0, 210, 255, 0.045)';
        this.ctx.stroke();
      }

      // Horizontal Floor Circuit Bus Lines
      for (let r = 1; r <= 4; r++) {
        const rRatio = Math.pow(r / 4, 2.2);
        const yLine = cy + rRatio * (this.height - cy);
        this.ctx.beginPath();
        this.ctx.moveTo(0, yLine);
        this.ctx.lineTo(this.width, yLine);
        this.ctx.strokeStyle = `rgba(0, 210, 255, ${0.02 + r * 0.012})`;
        this.ctx.stroke();
      }

      // Update node positions with parallax
      const nodeMap = new Map();
      this.governanceNodes.forEach((node, idx) => {
        const depthFactor = 0.85 + (idx % 3) * 0.15;
        node.currentX = node.baseX + this.mouse.x * depthFactor;
        node.currentY = node.baseY + this.mouse.y * depthFactor - (this.scrollY * 0.08);
        nodeMap.set(node.id, node);
      });

      // B. DATA HIGHWAYS & VALIDATION PACKETS
      this.circuitHighways.forEach((hw) => {
        const node = nodeMap.get(hw.nodeId);
        if (!node) return;

        const lev = Math.sin(this.time * node.floatSpeed + node.phase) * node.floatAmp;
        const p0 = { x: node.currentX + node.w * 0.5, y: node.currentY + lev + node.h * 0.5 };
        const p1 = { x: hw.cp1x + this.mouse.x * 0.4, y: hw.cp1y + this.mouse.y * 0.4 };
        const p2 = { x: hw.cp2x + this.mouse.x * 0.3, y: hw.cp2y + this.mouse.y * 0.3 };
        const p3 = { x: cx + (hw.targetX - (this.width / 2)), y: cy + (hw.targetY - (this.height * 0.44)) };

        // Main highway curve
        this.ctx.beginPath();
        this.ctx.moveTo(p0.x, p0.y);
        this.ctx.bezierCurveTo(p1.x, p1.y, p2.x, p2.y, p3.x, p3.y);
        this.ctx.strokeStyle = `rgba(0, 210, 255, ${hw.alpha})`;
        this.ctx.lineWidth = isMobile ? 1.0 : 1.4;
        this.ctx.stroke();

        // Parallel secondary lane
        if (hw.lanes > 1) {
          const off = 5;
          this.ctx.beginPath();
          this.ctx.moveTo(p0.x + off, p0.y + off);
          this.ctx.bezierCurveTo(p1.x + off, p1.y + off, p2.x + off, p2.y + off, p3.x + off, p3.y + off);
          this.ctx.strokeStyle = `rgba(0, 210, 255, ${hw.alpha * 0.5})`;
          this.ctx.lineWidth = 0.8;
          this.ctx.stroke();
        }

        // Draw traveling validation photons
        hw.packets.forEach((pkt) => {
          if (!this.reducedMotion) {
            pkt.progress += pkt.speed;
            if (pkt.progress > 1) {
              pkt.progress = 0;
              // Cycle validation state (turn green when arriving from Castle Gate, blue/cyan when inbound)
              pkt.isValidated = !pkt.isValidated;
            }
          }

          const pt = this.getBezierPoint(pkt.progress, p0, p1, p2, p3);
          const isVal = pkt.isValidated && pkt.progress > 0.4;
          const pktColor = isVal ? '#00E599' : '#00D2FF';

          // Photon Halo
          this.ctx.beginPath();
          this.ctx.arc(pt.x, pt.y, pkt.size * 2.4, 0, Math.PI * 2);
          this.ctx.fillStyle = isVal ? 'rgba(0, 229, 153, 0.35)' : 'rgba(0, 210, 255, 0.35)';
          this.ctx.fill();

          // Photon Core
          this.ctx.beginPath();
          this.ctx.arc(pt.x, pt.y, pkt.size, 0, Math.PI * 2);
          this.ctx.fillStyle = pktColor;
          this.ctx.fill();
        });
      });

      // C. CASTLE GATE GOVERNANCE CORE (CENTRAL REACTOR LAYER)
      this.drawCastleGateCore(cx, cy, this.time);

      // D. DRAW 5 GOVERNANCE CAPABILITY NODES
      this.governanceNodes.forEach((node) => {
        this.drawGovernanceNode(node, this.time);
      });

      // E. AMBIENT DATA PARTICLES
      this.ambientPhotons.forEach((p) => {
        if (!this.reducedMotion) {
          p.x += p.vx;
          p.y += p.vy;
          if (p.y < -10) {
            p.y = this.height + 10;
            p.x = Math.random() * this.width;
          }
          if (p.x < -10) p.x = this.width + 10;
          if (p.x > this.width + 10) p.x = -10;
        }

        const pulse = Math.sin(this.time * 2 + p.phase) * 0.5 + 0.5;
        this.ctx.beginPath();
        this.ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        this.ctx.fillStyle = `rgba(0, 210, 255, ${p.alpha + pulse * 0.25})`;
        this.ctx.fill();
      });
    }

    loop() {
      // Inertial mouse interpolation
      this.mouse.x += (this.mouse.targetX - this.mouse.x) * 0.055;
      this.mouse.y += (this.mouse.targetY - this.mouse.y) * 0.055;

      this.time += 0.016;
      this.draw();

      if (this.isVisible && !this.reducedMotion) {
        this.frameId = requestAnimationFrame(() => this.loop());
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new ServicesGovernanceMosaic();
  });
</script>
