---
// src/components/HeroCelestial.astro
---
<section class="hero-celestial" id="hero-celestial">
  <!-- Celestial Background Canvas: Orbital Rings & Constellation Particles -->
  <div class="hero-celestial__canvas-wrap" aria-hidden="true">
    <canvas id="hero-celestial-canvas" class="hero-celestial__canvas"></canvas>
    <div class="hero-celestial__contrast-mask"></div>
  </div>

  <div class="container hero-celestial__content">
    
    <!-- EYEBROW / BADGE -->
    <div class="hero-celestial__eyebrow-wrap reveal">
      <span class="hero-celestial__eyebrow">
        <span class="hero-celestial__eyebrow-dot"></span>
        FIRMA DE INGENIERÍA DIGITAL &amp; SOBERANÍA TECNOLÓGICA
      </span>
    </div>

    <!-- HEADLINE INTERACTIVO (PERTURBACIÓN FÍSICA SUAVE) -->
    <h1 class="hero-celestial__title" id="hero-title" aria-label="Ingeniería Digital. Soberanía Total.">
      <span class="hero-celestial__title-line hero-celestial__title-line--1">
        <span class="hero__char">I</span><span class="hero__char">N</span><span class="hero__char">G</span><span class="hero__char">E</span><span class="hero__char">N</span><span class="hero__char">I</span><span class="hero__char">E</span><span class="hero__char">R</span><span class="hero__char">Í</span><span class="hero__char">A</span><span class="hero__char">&nbsp;</span><span class="hero__char">D</span><span class="hero__char">I</span><span class="hero__char">G</span><span class="hero__char">I</span><span class="hero__char">T</span><span class="hero__char">A</span><span class="hero__char">L</span><span class="hero__char">.</span>
      </span>
      <span class="hero-celestial__title-line hero-celestial__title-line--2">
        <span class="hero__char">S</span><span class="hero__char">O</span><span class="hero__char">B</span><span class="hero__char">E</span><span class="hero__char">R</span><span class="hero__char">A</span><span class="hero__char">N</span><span class="hero__char">Í</span><span class="hero__char">A</span><span class="hero__char">&nbsp;</span><span class="hero__char">T</span><span class="hero__char">O</span><span class="hero__char">T</span><span class="hero__char">A</span><span class="hero__char">L</span><span class="hero__char">.</span>
      </span>
    </h1>

    <!-- SUBTÍTULO / COPY -->
    <p class="hero-celestial__copy">
      <strong class="hero-celestial__copy-highlight">Tu sitio. Tu código. Tus cuentas. Siempre.</strong><br class="hero-celestial__copy-break" />
      Desarrollamos plataformas web y sistemas a la medida con validación técnica determinista.
    </p>

    <!-- CTA PREMIUM REFINADO -->
    <div class="hero-celestial__actions">
      <a class="hero__button" href="/contacto" id="hero-cta-btn" aria-label="Iniciar Proyecto">
        <!-- 1. Aura exterior contenida (5-7px, blur 12px, opacity 0.30) -->
        <span class="hero__button-aura" aria-hidden="true"></span>
        <!-- 2. Borde multicolor refinado (1.2px) -->
        <span class="hero__button-border" aria-hidden="true"></span>
        <!-- 3. Núcleo oscuro + Luz interna que sigue al cursor -->
        <span class="hero__button-inner">
          <span class="hero__button-light" id="hero-button-light" aria-hidden="true"></span>
          <span class="hero__button-text">INICIAR PROYECTO</span>
          <svg class="hero__button-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </a>
    </div>

  </div>
</section>

<style>
  @keyframes chromaticRotate {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  .hero-celestial {
    position: relative;
    min-height: calc(100vh - 4.5rem);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 6.5rem 1.5rem 5.5rem 1.5rem;
    background: #040406;
    isolation: isolate;
  }

  .hero-celestial__canvas-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-celestial__canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }

  .hero-celestial__contrast-mask {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 76% 64% at 50% 48%,
      rgba(4, 4, 6, 0.88) 0%,
      rgba(4, 4, 6, 0.65) 55%,
      rgba(4, 4, 6, 0.95) 100%
    );
  }

  .hero-celestial__content {
    position: relative;
    z-index: 3;
    max-width: 1080px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  /* EYEBROW */
  .hero-celestial__eyebrow-wrap {
    margin-bottom: 1.35rem;
  }

  .hero-celestial__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.95rem;
    border-radius: 9999px;
    background: rgba(0, 210, 255, 0.05);
    border: 1px solid rgba(0, 210, 255, 0.2);
    font-family: var(--f-mono, monospace);
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--cyan, #00d2ff);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .hero-celestial__eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cyan, #00d2ff);
    box-shadow: 0 0 8px var(--cyan, #00d2ff);
  }

  /* TITLE */
  .hero-celestial__title {
    font-family: var(--f-sans, system-ui, -apple-system, sans-serif);
    font-size: clamp(2.1rem, 6.2vw, 4.4rem);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -0.035em;
    margin: 0 0 1.6rem 0;
    color: #FFFFFF;
    display: flex;
    flex-direction: column;
    align-items: center;
    user-select: none;
    width: 100%;
  }

  .hero-celestial__title-line {
    display: block;
    white-space: nowrap;
    max-width: 100%;
  }

  .hero-celestial__title-line--2 {
    color: #F1F5F9;
  }

  .hero__char {
    display: inline-block;
    will-change: transform;
    transform-origin: 50% 100%;
  }

  /* COPY */
  .hero-celestial__copy {
    font-size: clamp(0.98rem, 1.8vw, 1.15rem);
    color: #CBD5E1;
    line-height: 1.65;
    max-width: 66ch;
    margin: 0 auto 2.35rem auto;
    text-wrap: balance;
  }

  .hero-celestial__copy-highlight {
    color: #FFFFFF;
    font-weight: 700;
  }

  /* ACTIONS */
  .hero-celestial__actions {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* =========================================================================
     CTA BUTTON — GOOGLE AI / GEMINI LUMINESCENT TREATMENT
     ========================================================================= */
  .hero__button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border-radius: 9999px;
    cursor: pointer;
    padding: 1.2px; /* Borde multicolor refinado 1.2px */
    outline: none;
    isolation: isolate;
    will-change: transform;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero__button:focus-visible {
    outline: 2px solid #00D2FF;
    outline-offset: 4px;
  }

  /* 1. Aura Exterior Contenida */
  .hero__button-aura {
    position: absolute;
    inset: -6px; /* -6px estándar (5-7px) */
    border-radius: 9999px;
    background: conic-gradient(
      from 0deg,
      #3B82F6 0deg,
      #8B5CF6 72deg,
      #F43F5E 144deg,
      #F59E0B 216deg,
      #10B981 288deg,
      #3B82F6 360deg
    );
    filter: blur(12px); /* 12px difuso y delicado */
    opacity: 0.30; /* 0.30 emisión luminosa tenue y elegante */
    z-index: 1;
    pointer-events: none;
    animation: chromaticRotate 6s linear infinite; /* Rotación lenta 6s */
    transition: opacity 0.3s ease, filter 0.3s ease, inset 0.3s ease;
    will-change: transform, opacity;
  }

  /* 2. Borde Multicolor (1.2px) */
  .hero__button-border {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: conic-gradient(
      from 0deg,
      #3B82F6 0deg,
      #8B5CF6 72deg,
      #F43F5E 144deg,
      #F59E0B 216deg,
      #10B981 288deg,
      #3B82F6 360deg
    );
    z-index: 2;
    pointer-events: none;
    animation: chromaticRotate 6s linear infinite;
  }

  /* 3. Núcleo Oscuro Profundo */
  .hero__button-inner {
    position: relative;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.92rem 2.35rem;
    border-radius: 9999px;
    background: rgba(4, 4, 5, 0.86); /* Núcleo oscuro para contrastar */
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow: hidden;
    transition: background 0.25s ease;
  }

  /* 4. Luz Interna que Sigue al Cursor */
  .hero__button-light {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 4.5rem; /* 4.5rem refracción pequeña */
    height: 4.5rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.65) 0%, rgba(0, 210, 255, 0.25) 40%, transparent 70%);
    filter: blur(14px); /* 14px suave */
    opacity: 0.22; /* 0.22 refracción delicada */
    pointer-events: none;
    transform: translate(-50%, -50%);
    z-index: 4;
    transition: opacity 0.25s ease;
    will-change: left, top, opacity;
  }

  .hero__button-text {
    font-family: var(--f-sans, system-ui, sans-serif);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #FFFFFF;
    text-transform: uppercase;
    position: relative;
    z-index: 5;
  }

  .hero__button-arrow {
    color: #00D2FF;
    position: relative;
    z-index: 5;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* HOVER REFINADO */
  .hero__button:hover {
    transform: scale(1.01); /* Escala máxima 1.01 sin exageración */
  }

  .hero__button:hover .hero__button-aura {
    inset: -8px; /* Ampliación ligera a -8px */
    filter: blur(14px);
    opacity: 0.48; /* Incremento suave a 0.48 */
  }

  .hero__button:hover .hero__button-inner {
    background: rgba(7, 8, 12, 0.82);
  }

  .hero__button:hover .hero__button-arrow {
    transform: translateX(4px);
  }

  .hero__button:hover .hero__button-light {
    opacity: 0.28;
  }

  /* RESPONSIVE AJUSTES */
  @media (max-width: 480px) {
    .hero-celestial {
      padding: 5.5rem 1rem 4.5rem 1rem;
    }
    .hero-celestial__title {
      font-size: clamp(1.72rem, 8vw, 2.35rem);
      letter-spacing: -0.025em;
    }
    .hero-celestial__eyebrow {
      font-size: 0.68rem;
      padding: 0.3rem 0.75rem;
    }
    .hero__button-inner {
      padding: 0.85rem 1.85rem;
      gap: 0.6rem;
    }
    .hero__button-text {
      font-size: 0.85rem;
    }
  }

  @media (max-width: 360px) {
    .hero-celestial__title {
      font-size: 1.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__button-aura,
    .hero__button-border {
      animation: none;
    }
    .hero__char,
    .hero__button,
    .hero__button-arrow {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script is:inline>
  (function() {
    // 1. CELESTIAL BACKGROUND PARTICLES & ORBITAL RINGS CANVAS ENGINE
    const canvas = document.getElementById('hero-celestial-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpi = 1;
    let frameId = null;
    let isVisible = false;
    let time = 0;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Mouse parallax
    const mouse = { x: 0, y: 0, targetX: 0, targetY: 0 };

    // Stars/Particles bank
    const stars = [];
    const starCount = 65; // Balanced density that never competes with text

    function initStars() {
      stars.length = 0;
      for (let i = 0; i < starCount; i++) {
        stars.push({
          x: Math.random() * width,
          y: Math.random() * height,
          size: 0.7 + Math.random() * 1.4,
          baseAlpha: 0.12 + Math.random() * 0.35,
          twinkleSpeed: 0.01 + Math.random() * 0.025,
          twinklePhase: Math.random() * Math.PI * 2,
          speedY: (0.05 + Math.random() * 0.12),
          depth: 0.2 + Math.random() * 0.8
        });
      }
    }

    function resize() {
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      dpi = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(width * dpi);
      canvas.height = Math.floor(height * dpi);
      ctx.scale(dpi, dpi);
      if (stars.length === 0) initStars();
    }

    function drawCelestial() {
      if (!isVisible) return;
      ctx.clearRect(0, 0, width, height);

      time += 0.015;
      mouse.x += (mouse.targetX - mouse.x) * 0.05;
      mouse.y += (mouse.targetY - mouse.y) * 0.05;

      const centerX = width * 0.5 + mouse.x * 20;
      const centerY = height * 0.46 + mouse.y * 15;

      // Draw subtle architectural orbital rings
      ctx.save();
      const ringCount = 3;
      for (let i = 1; i <= ringCount; i++) {
        const radius = (Math.min(width, height) * 0.22) * i;
        ctx.beginPath();
        ctx.arc(centerX, centerY, radius, 0, Math.PI * 2);
        ctx.strokeStyle = i === 1 ? 'rgba(0, 210, 255, 0.05)' : 'rgba(255, 255, 255, 0.025)';
        ctx.lineWidth = 1;
        ctx.setLineDash(i === 2 ? [6, 12] : (i === 3 ? [2, 18] : []));
        ctx.stroke();
      }
      ctx.restore();

      // Draw celestial constellation stars
      for (let i = 0; i < stars.length; i++) {
        const star = stars[i];
        if (!reducedMotion) {
          star.y -= star.speedY;
          if (star.y < -10) star.y = height + 10;
        }

        const twinkle = Math.sin(time * star.twinkleSpeed * 60 + star.twinklePhase);
        const alpha = star.baseAlpha + twinkle * 0.15;
        const renderX = star.x + mouse.x * (star.depth * 25);
        const renderY = star.y + mouse.y * (star.depth * 25);

        ctx.beginPath();
        ctx.arc(renderX, renderY, star.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(180, 220, 255, ${Math.max(0.05, Math.min(0.7, alpha))})`;
        ctx.fill();
      }

      if (!reducedMotion) {
        frameId = requestAnimationFrame(drawCelestial);
      }
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        isVisible = entry.isIntersecting;
        if (isVisible && !frameId && !reducedMotion) {
          frameId = requestAnimationFrame(drawCelestial);
        } else if (!isVisible && frameId) {
          cancelAnimationFrame(frameId);
          frameId = null;
        }
      });
    }, { threshold: 0.05 });

    observer.observe(canvas);
    resize();
    window.addEventListener('resize', resize, { passive: true });

    window.addEventListener('pointermove', (e) => {
      mouse.targetX = (e.clientX / window.innerWidth) - 0.5;
      mouse.targetY = (e.clientY / window.innerHeight) - 0.5;
    }, { passive: true });

    // Initial draw
    drawCelestial();


    // 2. HEADLINE PHYSICAL SPRING PERTURBATION (7-9px translate, scale 0.94-1.16, skew 3.5deg)
    const title = document.getElementById('hero-title');
    const chars = title ? Array.from(title.querySelectorAll('.hero__char')) : [];

    if (title && chars.length > 0 && !reducedMotion) {
      const charStates = chars.map(() => ({
        targetY: 0,
        currentY: 0,
        targetScaleX: 1,
        currentScaleX: 1,
        targetScaleY: 1,
        currentScaleY: 1,
        targetSkew: 0,
        currentSkew: 0
      }));

      let isHoveringTitle = false;

      function updateCharPhysics() {
        let needsUpdate = false;

        for (let i = 0; i < chars.length; i++) {
          const s = charStates[i];
          const elem = chars[i];

          // Spring damping formulas
          s.currentY += (s.targetY - s.currentY) * 0.15;
          s.currentScaleX += (s.targetScaleX - s.currentScaleX) * 0.15;
          s.currentScaleY += (s.targetScaleY - s.currentScaleY) * 0.15;
          s.currentSkew += (s.targetSkew - s.currentSkew) * 0.15;

          if (
            Math.abs(s.targetY - s.currentY) > 0.05 ||
            Math.abs(s.targetScaleY - s.currentScaleY) > 0.005 ||
            Math.abs(s.targetSkew - s.currentSkew) > 0.05
          ) {
            needsUpdate = true;
          }

          elem.style.transform = `translateY(${s.currentY.toFixed(2)}px) scale(${s.currentScaleX.toFixed(3)}, ${s.currentScaleY.toFixed(3)}) skewX(${s.currentSkew.toFixed(2)}deg)`;
        }

        if (isHoveringTitle || needsUpdate) {
          requestAnimationFrame(updateCharPhysics);
        }
      }

      title.addEventListener('pointermove', (e) => {
        isHoveringTitle = true;
        const titleRect = title.getBoundingClientRect();
        const cursorX = e.clientX;
        const cursorY = e.clientY;

        for (let i = 0; i < chars.length; i++) {
          const charRect = chars[i].getBoundingClientRect();
          const charCenterX = charRect.left + charRect.width / 2;
          const charCenterY = charRect.top + charRect.height / 2;

          const dx = cursorX - charCenterX;
          const dy = cursorY - charCenterY;
          const dist = Math.hypot(dx, dy);

          const maxDist = 95; // Radius of perturbation
          if (dist < maxDist) {
            const factor = Math.cos((dist / maxDist) * (Math.PI / 2)); // Smooth cosine falloff
            charStates[i].targetY = -8.0 * factor; // 7-9px translate
            charStates[i].targetScaleY = 1 + (0.16 * factor); // 1.16 max scaleY
            charStates[i].targetScaleX = 1 - (0.06 * factor); // 0.94 min scaleX
            charStates[i].targetSkew = (dx > 0 ? -3.5 : 3.5) * factor; // 3.5deg max skew
          } else {
            charStates[i].targetY = 0;
            charStates[i].targetScaleX = 1;
            charStates[i].targetScaleY = 1;
            charStates[i].targetSkew = 0;
          }
        }
        requestAnimationFrame(updateCharPhysics);
      }, { passive: true });

      title.addEventListener('pointerleave', () => {
        isHoveringTitle = false;
        for (let i = 0; i < chars.length; i++) {
          charStates[i].targetY = 0;
          charStates[i].targetScaleX = 1;
          charStates[i].targetScaleY = 1;
          charStates[i].targetSkew = 0;
        }
        requestAnimationFrame(updateCharPhysics);
      });
    }


    // 3. CTA BUTTON CURSOR LIGHT TRACKING & SUBTLE MAGNETISM
    const ctaBtn = document.getElementById('hero-cta-btn');
    const buttonLight = document.getElementById('hero-button-light');

    if (ctaBtn && buttonLight) {
      ctaBtn.addEventListener('pointermove', (e) => {
        const rect = ctaBtn.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        buttonLight.style.left = `${x}px`;
        buttonLight.style.top = `${y}px`;

        if (!reducedMotion) {
          // Subtle magnetic pull (max 3-4px)
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;
          const magX = (x - centerX) * 0.08;
          const magY = (y - centerY) * 0.08;
          ctaBtn.style.transform = `translate(${magX.toFixed(1)}px, ${magY.toFixed(1)}px) scale(1.01)`;
        }
      }, { passive: true });

      ctaBtn.addEventListener('pointerleave', () => {
        if (!reducedMotion) {
          ctaBtn.style.transform = 'translate(0px, 0px) scale(1)';
        }
      });
    }
  })();
</script>