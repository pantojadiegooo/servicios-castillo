          // RENDERIZADO DEL RESULTADO
          document.getElementById('diag-progress-header').style.display = 'none';
          document.getElementById('step-5').style.display = 'none';
          document.getElementById('step-result').style.display = 'block';

          document.getElementById('res-greeting').innerText = 'Recomendación para ' + nombre + ' ' + apellido;
          document.getElementById('res-profile-summary').innerText = 'Ubicación: ' + ciudad + (empresa ? ' • Organización: ' + empresa : '') + ' • Familia: ' + family;
          document.getElementById('res-badge').innerText = primary.badge;
          document.getElementById('res-title').innerText = primary.title;
          document.getElementById('res-subtitle').innerText = primary.subtitle;
          document.getElementById('res-price').innerText = primary.price;
          document.getElementById('res-price-usd').innerText = primary.priceUsd;
          document.getElementById('res-reasoning').innerText = primary.reasoning;
          document.getElementById('res-not-needed').innerText = primary.notNeeded;
          document.getElementById('res-family').innerText = family;

          // COMPONENTE SECUNDARIO
          const secCard = document.getElementById('res-secondary-card');
          if (secondary) {
            secCard.style.display = 'block';
            document.getElementById('res-secondary-title').innerText = secondary.title;
            document.getElementById('res-secondary-desc').innerText = secondary.description;
          } else {
            secCard.style.display = 'none';
          }

          // TRADEOFF PRESUPUESTO
          const tradeCard = document.getElementById('res-budget-tradeoff');
          if (budgetTradeoff) {
            tradeCard.style.display = 'block';
            document.getElementById('res-tradeoff-title').innerText = budgetTradeoff.title;
            document.getElementById('res-tradeoff-msg').innerText = budgetTradeoff.message;
          } else {
            tradeCard.style.display = 'none';
          }

          // ENLACE A CONTACTO
          const contactUrl = '/contacto.html?paquete=' + encodeURIComponent(primary.paqueteParam) + '&necesidad=' + encodeURIComponent(primary.necesidadParam);
          document.getElementById('res-cta-contact').href = contactUrl;

          // ENLACE A WHATSAPP
          const waText = encodeURIComponent('Hola Grupo Castillo, completé el Diagnóstico Castillo en la web para ' + nombre + ' (' + ciudad + '). Mi recomendación resultante es: ' + primary.title + ' (' + primary.price + '). Me gustaría conocer los detalles de contratación.');
          document.getElementById('res-cta-whatsapp').href = 'https://wa.me/525512345678?text=' + waText;

          window.scrollTo({ top: document.getElementById('diag-app').offsetTop - 80, behavior: 'smooth' });
        };
      })();
    </script>

