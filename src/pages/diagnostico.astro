---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQItem from '../components/FAQItem.astro';
import CTABand from '../components/CTABand.astro';
import HeroEngineVisual from '../components/HeroEngineVisual.astro';

// CONFIGURACIÓN OFICIAL DE ATENCIÓN DIRECTA GRUPO CASTILLO
const OFFICIAL_WHATSAPP_NUMBER = '529518096110';
---

<BaseLayout
  title="Diagnóstico Comercial y Técnico — Orientación de Software | Grupo Castillo"
  description="Herramienta interactiva de orientación comercial: identifica en 3 preguntas el paquete web, servicio de intervención o gobernanza técnica adecuado para tu empresa."
  canonical="https://grupocastillo.lat/diagnostico"
  ogUrl="https://grupocastillo.lat/diagnostico"
>
  <main id="main">

    <section class="page-hero">
      <HeroEngineVisual />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="/">Inicio</a> / Diagnóstico Comercial</p>
        <div class="badge badge-cyan">TRIAGE INTERACTIVO • ORIENTACIÓN EN 2 MINUTOS</div>
        <h1>¿Qué solución técnica necesita realmente tu negocio?</h1>
        <p>No necesitas conocer nuestro catálogo para comenzar. Responde 3 preguntas guiadas y nuestro motor de decisión identificará el punto de partida adecuado para tu empresa.</p>
      </div>
    </section>

    <!-- ACCESO SECUNDARIO A COTIZACIÓN DIRECTA -->
    <section class="section" style="padding-top: 0.5rem; padding-bottom: 0.5rem;">
      <div class="container" style="max-width: 880px;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; padding: 0.75rem 1.25rem; background: rgba(14, 18, 27, 0.6); border: 1px solid var(--line-dark); border-radius: var(--radius); font-size: 0.84rem;">
          <span style="color: var(--steel-light);">¿Ya sabes qué paquete o servicio necesitas?</span>
          <a href="/contacto" style="color: var(--cyan); text-decoration: none; font-weight: 600;">Ir directamente al Formulario de Contacto →</a>
        </div>
      </div>
    </section>

    <!-- WIZARD CONTAINER -->
    <section class="section" style="padding-top: 1rem; padding-bottom: 4.5rem;">
      <div class="container" style="max-width: 880px;">
        
        <div class="glass-panel" id="diag-app" style="padding: 2.5rem; background: rgba(14, 18, 27, 0.95); border-color: rgba(52, 107, 241, 0.25); min-height: 480px; position: relative;">
          
          <!-- PROGRESS HEADER -->
          <div id="diag-progress-header" style="margin-bottom: 2rem; border-bottom: 1px solid var(--line-dark); padding-bottom: 1.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span id="diag-step-indicator" style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--cyan); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">PASO 1 DE 3: SITUACIÓN O NECESIDAD PRINCIPAL</span>
              <span id="diag-step-percent" style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-soft);">33% Completado</span>
            </div>
            <div style="width: 100%; height: 4px; background: rgba(255, 255, 255, 0.08); border-radius: 2px; overflow: hidden;">
              <div id="diag-progress-bar" style="width: 33%; height: 100%; background: linear-gradient(90deg, var(--cyan) 0%, #0088A8 100%); transition: width 0.3s ease;"></div>
            </div>
          </div>

          <!-- PASO 1: INTENCIÓN PRINCIPAL (PROBLEM-FIRST) -->
          <div class="diag-step" id="step-1" style="display: block;">
            <h2 style="font-size: 1.35rem; color: var(--paper); margin-bottom: 0.4rem;">01. ¿Qué describe mejor la necesidad de tu empresa?</h2>
            <p style="font-size: 0.88rem; color: var(--steel-light); margin-bottom: 1.5rem;">
              Selecciona el punto de partida para canalizar el análisis:
            </p>

            <div class="diag-options-grid" style="display: flex; flex-direction: column; gap: 0.85rem; margin-bottom: 2rem;">
              
              <label class="diag-option" style="display: flex; align-items: flex-start; gap: 1rem; padding: 1.15rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-md); cursor: pointer; transition: all 0.2s ease;">
                <input type="radio" name="intencion" value="construir" checked style="margin-top: 0.25rem;">
                <div>
                  <strong style="display: flex; align-items: center; color: var(--paper); font-size: 0.95rem; margin-bottom: 0.2rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right: 8px; flex-shrink: 0;"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path></svg>
                    Quiero construir un nuevo sitio web, plataforma o software
                  </strong>
                  <span style="font-size: 0.82rem; color: var(--steel-light); line-height: 1.45;">Desarrollo desde cero para landing pages, sitios corporativos, plataformas con pagos o software a la medida con 100% de titularidad.</span>
                </div>
              </label>

              <label class="diag-option" style="display: flex; align-items: flex-start; gap: 1rem; padding: 1.15rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-md); cursor: pointer; transition: all 0.2s ease;">
                <input type="radio" name="intencion" value="revisar" style="margin-top: 0.25rem;">
                <div>
                  <strong style="display: flex; align-items: center; color: var(--paper); font-size: 0.95rem; margin-bottom: 0.2rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right: 8px; flex-shrink: 0;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    Ya tengo un sitio o código y quiero evaluar su seguridad y calidad
                  </strong>
                  <span style="font-size: 0.82rem; color: var(--steel-light); line-height: 1.45;">Diagnóstico técnico en 72h (Castle Checkup) o auditoría profunda de arquitectura y seguridad antes de invertir.</span>
                </div>
              </label>

              <label class="diag-option" style="display: flex; align-items: flex-start; gap: 1rem; padding: 1.15rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-md); cursor: pointer; transition: all 0.2s ease;">
                <input type="radio" name="intencion" value="problema" style="margin-top: 0.25rem;">
                <div>
                  <strong style="display: flex; align-items: center; color: #FF6B6B; font-size: 0.95rem; margin-bottom: 0.2rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right: 8px; flex-shrink: 0;"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                    Tengo un problema, falla técnica o urgencia en producción
                  </strong>
                  <span style="font-size: 0.82rem; color: var(--steel-light); line-height: 1.45;">Sitio caído, errores 500, claves expuestas en Git o necesidad de rescate e intervención de ingenieros.</span>
                </div>
              </label>

              <label class="diag-option" style="display: flex; align-items: flex-start; gap: 1rem; padding: 1.15rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-md); cursor: pointer; transition: all 0.2s ease;">
                <input type="radio" name="intencion" value="mantenimiento" style="margin-top: 0.25rem;">
                <div>
                  <strong style="display: flex; align-items: center; color: var(--paper); font-size: 0.95rem; margin-bottom: 0.2rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right: 8px; flex-shrink: 0;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    Busco mantenimiento preventivo y supervisión continua
                  </strong>
                  <span style="font-size: 0.82rem; color: var(--steel-light); line-height: 1.45;">Póliza mensual Castle Care para monitoreo de uptime, parches de seguridad y horas directas de ingeniería.</span>
                </div>
              </label>

              <label class="diag-option" style="display: flex; align-items: flex-start; gap: 1rem; padding: 1.15rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-md); cursor: pointer; transition: all 0.2s ease;">
                <input type="radio" name="intencion" value="gobernanza" style="margin-top: 0.25rem;">
                <div>
                  <strong style="display: flex; align-items: center; color: var(--cyan); font-size: 0.95rem; margin-bottom: 0.2rem;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right: 8px; flex-shrink: 0;"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                    Busco gobernar cómo publica mi equipo técnico (CI/CD)
                  </strong>
                  <span style="font-size: 0.82rem; color: var(--steel-light); line-height: 1.45;">Integrar Castle Gate CLI y políticas CQS v1.1 para vetar automáticamente releases con vulnerabilidades.</span>
                </div>
              </label>

            </div>

            <div style="display: flex; justify-content: flex-end;">
              <button type="button" class="btn btn-primary" onclick="window.diagNext(1)">Continuar al Paso 2 →</button>
            </div>
          </div>

          <!-- PASO 2: PROFUNDIZACIÓN DINÁMICA SEGÚN INTENCIÓN -->
          <div class="diag-step" id="step-2" style="display: none;">
            <h2 style="font-size: 1.35rem; color: var(--paper); margin-bottom: 0.4rem;" id="step-2-title">02. Especifica el alcance de tu requerimiento</h2>
            <p style="font-size: 0.88rem; color: var(--steel-light); margin-bottom: 1.5rem;" id="step-2-desc">
              Selecciona la opción que mejor describa la escala de lo que necesitas:
            </p>

            <!-- SUB-BRANCH A: CONSTRUIR -->
            <div id="sub-branch-construir" class="diag-sub-branch" style="display: block;">
              <div class="diag-options-grid" style="display: flex; flex-direction: column; gap: 0.85rem; margin-bottom: 2rem;">
                
                <label class="diag-option" style="display: flex; align-items: flex-start; gap: 0.85rem; padding: 1rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-md); cursor: pointer;">
                  <input type="radio" name="scope_construir" value="iron" style="margin-top: 0.2rem;">
                  <div>
                    <strong style="color: var(--paper); font-size: 0.9rem;">Presencia Esencial One-Page ($2,800 MXN)</strong>
                    <span style="display: block; font-size: 0.78rem; color: var(--steel-light);">Landing page directa orientada a conversión a WhatsApp para independientes.</span>
                  </div>
                </label>

                <label class="diag-option" style="display: flex; align-items: flex-start; gap: 0.85rem; padding: 1rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-md); cursor: pointer;">
                  <input type="radio" name="scope_construir" value="bronze" style="margin-top: 0.2rem;">
                  <div>
                    <strong style="color: var(--paper); font-size: 0.9rem;">Presencia PyME / Captación Comercial ($4,500 MXN)</strong>
                    <span style="display: block; font-size: 0.78rem; color: var(--steel-light);">Estructura de hasta 5 secciones con formulario de captura para campañas publicitarias.</span>
                  </div>
                </label>

                <label class="diag-option" style="display: flex; align-items: flex-start; gap: 0.85rem; padding: 1rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-md); cursor: pointer;">
                  <input type="radio" name="scope_construir" value="silver" style="margin-top: 0.2rem;">
                  <div>
                    <strong style="color: var(--paper); font-size: 0.9rem;">Sitio Corporativo Multi-sección ($7,500 MXN)</strong>
                    <span style="display: block; font-size: 0.78rem; color: var(--steel-light);">Hasta 5 páginas internas para catálogo formal de servicios y posicionamiento SEO.</span>
                  </div>
                </label>

                <label class="diag-option" style="display: flex; align-items: flex-start; gap: 0.85rem; padding: 1rem; background: #07090E; border: 1px solid rgba(52, 107, 241, 0.4); border-radius: var(--radius-md); cursor: pointer;">
                  <input type="radio" name="scope_construir" value="gold" checked style="margin-top: 0.2rem;">
                  <div>
                    <strong style="color: var(--cyan); font-size: 0.9rem;">Sitio Integral con Blog / CMS Autogestionable ($12,500 MXN) • MÁS ELEGIDO</strong>
                    <span style="display: block; font-size: 0.78rem; color: var(--steel-light);">8-10 páginas con blog para publicar artículos, posicionar orgánicamente y panel autogestionable.</span>
                  </div>
                </label>

                <label class="diag-option" style="display: flex; align-items: flex-start; gap: 0.85rem; padding: 1rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-md); cursor: pointer;">
                  <input type="radio" name="scope_construir" value="platinum" style="margin-top: 0.2rem;">
                  <div>
                    <strong style="color: var(--paper); font-size: 0.9rem;">Plataforma con Pasarelas de Pago / CRM ($24,500 MXN)</strong>
                    <span style="display: block; font-size: 0.78rem; color: var(--steel-light);">Hasta 15 páginas con cobro en línea (Stripe/Mercado Pago) e integración de clientes.</span>
                  </div>
                </label>

                <label class="diag-option" style="display: flex; align-items: flex-start; gap: 0.85rem; padding: 1rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-md); cursor: pointer;">
                  <input type="radio" name="scope_construir" value="diamond" style="margin-top: 0.2rem;">
                  <div>
                    <strong style="color: var(--paper); font-size: 0.9rem;">Software a la Medida / Portal de Usuarios ($40,000+ MXN)</strong>
                    <span style="display: block; font-size: 0.78rem; color: var(--steel-light);">Desarrollo complejo con bases de datos, autenticación por roles y lógica personalizada.</span>
                  </div>
                </label>

              </div>
            </div>

            <!-- SUB-BRANCH B: REVISAR -->
            <div id="sub-branch-revisar" class="diag-sub-branch" style="display: none;">
              <div class="diag-options-grid" style="display: flex; flex-direction: column; gap: 0.85rem; margin-bottom: 2rem;">
                
                <label class="diag-option" style="display: flex; align-items: flex-start; gap: 0.85rem; padding: 1.15rem; background: #07090E; border: 1px solid rgba(52, 107, 241, 0.4); border-radius: var(--radius-md); cursor: pointer;">
                  <input type="radio" name="scope_revisar" value="checkup" checked style="margin-top: 0.2rem;">
                  <div>
                    <strong style="color: var(--cyan); font-size: 0.95rem;">Castle Checkup — Diagnóstico Ágil en 72h ($8,900 MXN • 100% Bonificable)</strong>
                    <span style="display: block; font-size: 0.82rem; color: var(--steel-light); margin-top: 0.2rem;">Evaluación completa de repositorio bajo controles CQS v1.1 para detectar fugas de claves, dependencias vulnerables y rendimiento. El 100% del costo se abona a cualquier desarrollo posterior.</span>
                  </div>
                </label>

                <label class="diag-option" style="display: flex; align-items: flex-start; gap: 0.85rem; padding: 1.15rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-md); cursor: pointer;">
                  <input type="radio" name="scope_revisar" value="audit" style="margin-top: 0.2rem;">
                  <div>
                    <strong style="color: var(--paper); font-size: 0.95rem;">Castle Audit — Due Diligence y Arquitectura (Desde $19,900 MXN)</strong>
                    <span style="display: block; font-size: 0.82rem; color: var(--steel-light); margin-top: 0.2rem;">Auditoría profunda para adquisiciones, fusiones o refactorizaciones complejas con dictamen técnico formal.</span>
                  </div>
                </label>

              </div>
            </div>

            <!-- SUB-BRANCH C: PROBLEMA / URGENCIA -->
            <div id="sub-branch-problema" class="diag-sub-branch" style="display: none;">
              <div class="diag-options-grid" style="display: flex; flex-direction: column; gap: 0.85rem; margin-bottom: 2rem;">
                
                <label class="diag-option" style="display: flex; align-items: flex-start; gap: 0.85rem; padding: 1.15rem; background: #07090E; border: 1px solid rgba(255, 77, 77, 0.4); border-radius: var(--radius-md); cursor: pointer;">
                  <input type="radio" name="scope_problema" value="emergency" checked style="margin-top: 0.2rem;">
                  <div>
                    <strong style="color: #FF4D4D; font-size: 0.95rem;">Contingencia Activa / Sitio Caído (Castle Emergency — Desde $5,900 MXN)</strong>
                    <span style="display: block; font-size: 0.82rem; color: var(--steel-light); margin-top: 0.2rem;">Falla crítica iniciada en las últimas 24-48 horas que requiere contención inmediata y hotfix en caliente.</span>
                  </div>
                </label>

                <label class="diag-option" style="display: flex; align-items: flex-start; gap: 0.85rem; padding: 1.15rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-md); cursor: pointer;">
                  <input type="radio" name="scope_problema" value="rescue" style="margin-top: 0.2rem;">
                  <div>
                    <strong style="color: var(--paper); font-size: 0.95rem;">Corrección / Rescate de Código Heredado (Castle Rescue — Desde $6,900 MXN)</strong>
                    <span style="display: block; font-size: 0.82rem; color: var(--steel-light); margin-top: 0.2rem;">Intervención quirúrgica con Pull Requests para sanear repositorios, parchar dependencias o estabilizar despliegues.</span>
                  </div>
                </label>

              </div>
            </div>

            <!-- SUB-BRANCH D: MANTENIMIENTO -->
            <div id="sub-branch-mantenimiento" class="diag-sub-branch" style="display: none;">
              <div class="diag-options-grid" style="display: flex; flex-direction: column; gap: 0.85rem; margin-bottom: 2rem;">
                
                <label class="diag-option" style="display: flex; align-items: flex-start; gap: 0.85rem; padding: 1.15rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-md); cursor: pointer;">
                  <input type="radio" name="scope_mantenimiento" value="care_basic" checked style="margin-top: 0.2rem;">
                  <div>
                    <strong style="color: var(--paper); font-size: 0.95rem;">Castle Care Basic ($590 MXN / mes)</strong>
                    <span style="display: block; font-size: 0.82rem; color: var(--steel-light); margin-top: 0.2rem;">Supervisión continua de disponibilidad (uptime 24/7), monitoreo SSL y parches de seguridad esenciales.</span>
                  </div>
                </label>

                <label class="diag-option" style="display: flex; align-items: flex-start; gap: 0.85rem; padding: 1.15rem; background: #07090E; border: 1px solid rgba(52, 107, 241, 0.4); border-radius: var(--radius-md); cursor: pointer;">
                  <input type="radio" name="scope_mantenimiento" value="care_pro" style="margin-top: 0.2rem;">
                  <div>
                    <strong style="color: var(--cyan); font-size: 0.95rem;">Castle Care Pro ($990 MXN / mes)</strong>
                    <span style="display: block; font-size: 0.82rem; color: var(--steel-light); margin-top: 0.2rem;">Supervisión integral de hasta 3 sitios, actualización preventiva de dependencias y soporte técnico prioritario.</span>
                  </div>
                </label>

                <label class="diag-option" style="display: flex; align-items: flex-start; gap: 0.85rem; padding: 1.15rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-md); cursor: pointer;">
                  <input type="radio" name="scope_mantenimiento" value="care_enterprise" style="margin-top: 0.2rem;">
                  <div>
                    <strong style="color: var(--paper); font-size: 0.95rem;">Castle Care Enterprise ($1,890 MXN / mes)</strong>
                    <span style="display: block; font-size: 0.82rem; color: var(--steel-light); margin-top: 0.2rem;">Gobernanza completa de hasta 10 proyectos, auditorías continuas y soporte multicanal dedicado.</span>
                  </div>
                </label>

              </div>
            </div>

            <!-- SUB-BRANCH E: GOBERNANZA -->
            <div id="sub-branch-gobernanza" class="diag-sub-branch" style="display: none;">
              <div class="diag-options-grid" style="display: flex; flex-direction: column; gap: 0.85rem; margin-bottom: 2rem;">
                
                <label class="diag-option" style="display: flex; align-items: flex-start; gap: 0.85rem; padding: 1.15rem; background: #07090E; border: 1px solid rgba(52, 107, 241, 0.4); border-radius: var(--radius-md); cursor: pointer;">
                  <input type="radio" name="scope_gobernanza" value="gate_cli" checked style="margin-top: 0.2rem;">
                  <div>
                    <strong style="color: var(--cyan); font-size: 0.95rem;">Castle Gate CLI — Licencia de Gobernanza ($9,900 MXN / año)</strong>
                    <span style="display: block; font-size: 0.82rem; color: var(--steel-light); margin-top: 0.2rem;">Motor local de veto determinista para CI/CD con 65 controles CQS v1.1, ejecución offline y emisión de certificados SHA-256.</span>
                  </div>
                </label>

              </div>
            </div>

            <div style="display: flex; justify-content: space-between;">
              <button type="button" class="btn btn-outline" onclick="window.diagPrev(2)">← Anterior</button>
              <button type="button" class="btn btn-primary" onclick="window.diagNext(2)">Continuar al Paso 3 →</button>
            </div>
          </div>

