              budgetTradeoff = {
                title: 'Optimización de Inversión (Sin Sobreingeniería)',
                message: 'Tu presupuesto estimado es más amplio de lo necesario para esta necesidad (' + primary.title + ': ' + primary.price + '). Aplicamos el principio del mínimo producto suficiente: te recomendamos no sobreinvertir en tecnología que tu operación aún no necesita.'
              };
            }
          }

          // RENDERIZAR RESULTADO
          document.getElementById('diag-progress-header').style.display = 'none';
          document.getElementById('step-3').style.display = 'none';
          document.getElementById('step-result').style.display = 'block';

          document.getElementById('res-badge').innerText = primary.badge;
          document.getElementById('res-title').innerText = primary.title;
          document.getElementById('res-subtitle').innerText = primary.subtitle;
          document.getElementById('res-price').innerText = primary.price;
          document.getElementById('res-reasoning').innerText = primary.reasoning;
          document.getElementById('res-not-needed').innerText = primary.notNeeded;
          document.getElementById('res-family').innerText = family;

          const tradeCard = document.getElementById('res-budget-tradeoff');
          if (budgetTradeoff) {
            tradeCard.style.display = 'block';
            document.getElementById('res-tradeoff-title').innerText = budgetTradeoff.title;
            document.getElementById('res-tradeoff-msg').innerText = budgetTradeoff.message;
          } else {
            tradeCard.style.display = 'none';
          }

          // PERSISTENCIA TEMPORAL DE SESIÓN (SIN COOKIES)
          try {
            sessionStorage.setItem('castle_diag_selection', JSON.stringify({
              paquete: primary.paqueteParam,
              necesidad: primary.necesidadParam,
              title: primary.title
            }));
          } catch (e) {}

          // ENLACE A FORMULARIO DE CONTACTO PRELLENADO
          const contactUrl = '/contacto?paquete=' + encodeURIComponent(primary.paqueteParam) + '&necesidad=' + encodeURIComponent(primary.necesidadParam);
          document.getElementById('res-cta-contact').href = contactUrl;

          // ENLACE A WHATSAPP
          const waText = encodeURIComponent('Hola Grupo Castillo, completé el Diagnóstico Comercial en su sitio web. Mi resultado recomendado fue: ' + primary.title + ' (' + primary.price + '). Me gustaría conocer los detalles de contratación y alcance formal.');
          document.getElementById('res-cta-whatsapp').href = 'https://wa.me/' + CASTILLO_WHATSAPP_NUMBER + '?text=' + waText;

          window.scrollTo({ top: document.getElementById('diag-app').offsetTop - 80, behavior: 'smooth' });
        };
      })();
    </script>

