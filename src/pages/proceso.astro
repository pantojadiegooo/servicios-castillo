---
import BaseLayout from '../layouts/BaseLayout.astro';
import GateSchematic from '../components/GateSchematic.astro';
import CTABand from '../components/CTABand.astro';
import InnerHeroVisual from '../components/InnerHeroVisual.astro';
---

<BaseLayout
  title="Proceso de 9 Etapas — Metodología Servicios Castillo"
  description="De Discover a Evolve: conoce las 9 etapas que garantizan ingeniería limpia, velocidad, accesibilidad y seguridad en cada proyecto."
  canonical="https://servicios-castillo.vercel.app/proceso.html"
  ogUrl="https://servicios-castillo.vercel.app/proceso.html"
>
  <main id="main">

    <section class="page-hero">
      <InnerHeroVisual type="proceso" />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="index.html">Inicio</a> / Proceso</p>
        <h1>Un sistema de ingeniería, no una lista de deseos.</h1>
        <p>Cada desarrollo, auditoría o intervención recorre un proceso estructurado en nueve etapas continuas para asegurar entregas previsibles y sin sorpresas.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="reveal">
          <GateSchematic compact={true} />
        </div>
      </div>
    </section>

    <section class="section section-dim">
      <div class="container">
        <div class="process-list reveal">
          <div class="process-row">
            <span class="process-code">01</span>
            <div>
              <h3>DISCOVER — Descubrimiento &amp; Alcance</h3>
              <p>Entendemos los objetivos del negocio, el usuario objetivo y los requerimientos funcionales. Definimos el alcance por escrito antes de iniciar.</p>
            </div>
          </div>
          <div class="process-row">
            <span class="process-code">02</span>
            <div>
              <h3>DESIGN — Arquitectura &amp; Experiencia UX/UI</h3>
              <p>Diseñamos la estructura de información, prototipos accesibles y la arquitectura de datos adecuada antes de escribir código.</p>
            </div>
          </div>
          <div class="process-row">
            <span class="process-code">03</span>
            <div>
              <h3>BUILD — Desarrollo Modular &amp; Limpio</h3>
              <p>Construimos la solución utilizando Astro SSG, HTML5 semántico, CSS modular y JS nativo sin sobreingeniería.</p>
            </div>
          </div>
          <div class="process-row">
            <span class="process-code">04</span>
            <div>
              <h3>TEST — QA Funcional &amp; Multiplataforma</h3>
              <p>Probamos flujos de formularios, responsividad en pantallas de 375px a 1440px+ y comportamiento interactivo.</p>
            </div>
          </div>
          <div class="process-row">
            <span class="process-code">05</span>
            <div>
              <h3>AUDIT — Auditoría de Calidad Independiente</h3>
              <p>Sometemos el código a inspección de vulnerabilidades (`npm audit`), verificación de tipos y auditoría de accesibilidad WCAG 2.2.</p>
            </div>
          </div>
          <div class="process-row">
            <span class="process-code">06</span>
            <div>
              <h3>GATE — Filtro de Validación Castillo Gate</h3>
              <p>Punto de control estricto. Si la solución no supera las métricas de aprobación en seguridad, velocidad, SEO y A11y, no se publica.</p>
            </div>
          </div>
          <div class="process-row">
            <span class="process-code">07</span>
            <div>
              <h3>LAUNCH — Despliegue en Producción</h3>
              <p>Publicación de la plataforma en hosting de alta disponibilidad (Vercel) con dominios, SSL y cabeceras configuradas.</p>
            </div>
          </div>
          <div class="process-row">
            <span class="process-code">08</span>
            <div>
              <h3>VERIFY — Verificación Post-Lanzamiento</h3>
              <p>Comprobación en vivo del comportamiento en producción, indexabilidad en motores de búsqueda y flujo de notificaciones.</p>
            </div>
          </div>
          <div class="process-row">
            <span class="process-code">09</span>
            <div>
              <h3>EVOLVE — Mantenimiento &amp; Evolución (Castle Care)</h3>
              <p>Acompañamiento continuo, monitoreo de disponibilidad 24/7 y respaldos periódicos a través de los planes Castle Care.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTABand
      title="¿Listo para iniciar la Fase 1 (Discover) de tu proyecto?"
      description="Cuéntanos tus necesidades y ubiquemos juntos el alcance correcto desde el primer día."
      ctaLabel="Iniciar Diagnóstico"
      ctaHref="contacto.html"
    />

  </main>
</BaseLayout>
