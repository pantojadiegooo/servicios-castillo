---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroEngineVisual from '../components/HeroEngineVisual.astro';
---

<BaseLayout
  title="Visualización y Aceptación de Cotización Oficial — Grupo Castillo"
  description="Revisa el alcance técnico, hitos, condiciones financieras y formaliza la aceptación de tu cotización oficial de Grupo Castillo."
  canonical="https://grupocastillo.lat/cotizacion"
  ogUrl="https://grupocastillo.lat/cotizacion"
>
  <main id="main">
    <section class="page-hero">
      <HeroEngineVisual />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="/">Inicio</a> / Cotización Oficial</p>
        <div class="badge badge-cyan">EXPEDIENTE DIGITAL • DOCUMENTO OFICIAL</div>
        <h1 id="quotation-hero-title">Cotización Oficial de Servicios</h1>
        <p>Validez legal, alcance delimitado por escrito y titularidad del 100% del código fuente para el cliente.</p>
      </div>
    </section>

    <section class="section" style="padding-top: 1rem; padding-bottom: 4rem;">
      <div class="container" style="max-width: 960px;">

        <!-- BÚSQUEDA DE COTIZACIÓN SI NO VIENE EN QUERY -->
        <div id="search-box" class="glass-panel reveal" style="padding: 2rem; margin-bottom: 2rem;">
          <h2 style="font-size: 1.15rem; color: var(--cyan); margin-bottom: 1rem;">Consultar Cotización por Identificador</h2>
          <form id="search-form" style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <input
              type="text"
              id="search-input"
              aria-label="Identificador de Cotización"
              placeholder="Ej. GC-Q-2026-000042"
              pattern="^GC-Q-\d{4}-\d{6}$"
              required
              style="flex: 1; min-width: 260px; padding: 0.75rem 1rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-sm); color: var(--paper); font-family: var(--f-mono);"
            />
            <button type="submit" class="btn btn-primary">Cargar Cotización →</button>
          </form>
        </div>

        <!-- CONTENEDOR PRINCIPAL DE LA COTIZACIÓN -->
        <div id="quotation-card" class="glass-panel reveal" style="display: none; padding: 2.5rem; background: rgba(14, 18, 27, 0.95); border: 1px solid rgba(52, 107, 241, 0.25);">
          
          <!-- CABECERA DE LA COTIZACIÓN -->
          <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; border-bottom: 1px solid var(--line-dark); padding-bottom: 1.5rem; margin-bottom: 1.5rem;">
            <div>
              <span class="badge badge-cyan" style="font-size: 0.75rem; font-family: var(--f-mono);" id="q-id">GC-Q-2026-000042</span>
              <h2 style="font-size: 1.6rem; color: var(--paper); margin: 0.5rem 0 0.25rem 0;" id="q-project-name">Nombre del Proyecto</h2>
              <p style="color: var(--steel-light); font-size: 0.88rem; margin: 0;" id="q-client-name">Cliente: Empresa / Titular</p>
            </div>
            <div style="text-align: right;">
              <div style="font-size: 0.8rem; color: var(--steel-soft); font-family: var(--f-mono);">VIGENCIA HASTA:</div>
              <div style="font-size: 1.05rem; color: var(--warning); font-family: var(--f-mono); font-weight: bold;" id="q-valid-until">15 Días Naturales</div>
              <div style="font-size: 0.75rem; color: var(--steel-soft); margin-top: 0.25rem;" id="q-version">Versión: v1.0</div>
            </div>
          </div>

          <!-- RESUMEN DE ALCANCE Y ESPECIFICACIONES -->
          <div style="margin-bottom: 2rem;">
            <h3 style="font-size: 1.05rem; color: var(--cyan); text-transform: uppercase; font-family: var(--f-mono); margin-bottom: 0.75rem;">1. Alcance de Ingeniería y Entregables</h3>
            <div id="q-scope" style="font-size: 0.9rem; color: var(--steel-light); line-height: 1.6; background: rgba(7, 9, 14, 0.6); padding: 1.25rem; border-radius: var(--radius-sm); border: 1px solid var(--line-dark);">
              Descripción del alcance.
            </div>
          </div>

          <!-- HITOS Y CRONOGRAMA -->
          <div style="margin-bottom: 2rem;">
            <h3 style="font-size: 1.05rem; color: var(--cyan); text-transform: uppercase; font-family: var(--f-mono); margin-bottom: 0.75rem;">2. Cronograma de Hitos y Entregables</h3>
            <div class="grid grid-2" style="gap: 1rem;">
              <div style="padding: 1rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-sm);">
                <strong style="color: var(--cyan); font-family: var(--f-mono);">H1 (25%):</strong> Arquitectura de información, wireframe y tokens de diseño.
              </div>
              <div style="padding: 1rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-sm);">
                <strong style="color: var(--cyan); font-family: var(--f-mono);">H2 (35%):</strong> Maquetación interactiva y componentes en entorno staging.
              </div>
              <div style="padding: 1rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-sm);">
                <strong style="color: var(--cyan); font-family: var(--f-mono);">H3 (20%):</strong> Integración de contenidos definitivos, formularios y SEO.
              </div>
              <div style="padding: 1rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-sm);">
                <strong style="color: var(--cyan); font-family: var(--f-mono);">H4 (20%):</strong> Auditoría Castle Gate (CQS v1.1), despliegue a producción y Handoff final.
              </div>
            </div>
          </div>

          <!-- DESGLOSE FINANCIERO -->
          <div style="margin-bottom: 2rem; background: rgba(7, 9, 14, 0.8); border: 1px solid rgba(52, 107, 241, 0.2); padding: 1.5rem; border-radius: var(--radius-sm);">
            <h3 style="font-size: 1.05rem; color: var(--paper); margin-bottom: 1rem;">3. Desglose Financiero y Esquema de Pagos</h3>
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.9rem; color: var(--steel-light);">
              <span>Subtotal Neto:</span>
              <span id="q-subtotal" style="font-family: var(--f-mono); color: var(--paper);">$0.00 MXN</span>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.75rem; font-size: 0.9rem; color: var(--steel-light);">
              <span>IVA (16% Parametrizable):</span>
              <span id="q-tax" style="font-family: var(--f-mono); color: var(--paper);">$0.00 MXN</span>
            </div>
            <div style="display: flex; justify-content: space-between; padding-top: 0.75rem; border-top: 1px solid var(--line-dark); font-size: 1.25rem; font-weight: bold; color: var(--cyan);">
              <span>Inversión Total:</span>
              <span id="q-total" style="font-family: var(--f-mono);">$0.00 MXN</span>
            </div>
            <div style="margin-top: 1rem; padding-top: 0.75rem; border-top: 1px dashed var(--line-dark); font-size: 0.85rem; color: var(--steel-light);">
              • <strong><span id="q-deposit-label">Anticipo Requerido (50%)</span>:</strong> <span id="q-deposit" style="font-family: var(--f-mono); color: var(--success); font-weight: bold;">$0.00 MXN</span> <span id="q-deposit-note">(Para reserva de capacidad e inicio de trabajos).</span><br/>
              • <strong><span id="q-balance-label">Finiquito contra Entrega (50%)</span>:</strong> <span id="q-balance" style="font-family: var(--f-mono);">$0.00 MXN</span> <span id="q-balance-note">(Tras validación de preentrega con Castle Gate).</span>
              <div id="q-terms-notice" style="font-size: 0.8rem; color: var(--cyan); margin-top: 0.5rem; display: none;"></div>
            </div>
          </div>

          <!-- VINCULACIÓN AL CONTRATO MARCO Y SOBERANÍA -->
          <div style="font-size: 0.82rem; color: var(--steel-soft); line-height: 1.5; margin-bottom: 2rem;">
            * Esta cotización constituye la Declaración de Trabajo (SOW) y Condiciones Particulares vinculadas al Contrato Marco de Prestación de Servicios (MSA GC-MSA-2026). Incluye 30 días naturales de garantía operativa post-entrega y 100% de titularidad exclusiva del código fuente, dominio e infraestructura para el cliente.
          </div>

          <!-- ACCIONES DE ACEPTACIÓN FORMAL O DERIVACIÓN ORIENTATIVA -->
          <div id="acceptance-section" style="border-top: 1px solid var(--line-dark); padding-top: 1.75rem;">
            <!-- ALERTA SI LA COTIZACIÓN REAL YA FUE ACEPTADA -->
            <div id="already-accepted-alert" style="display: none; padding: 1rem; background: rgba(0, 229, 153, 0.1); border-left: 3px solid var(--success); color: var(--paper); font-size: 0.9rem;">
              <strong>Cotización formalmente aceptada</strong> el <span id="accepted-date"></span>. Estado del proyecto: <span id="accepted-state" style="font-family: var(--f-mono); color: var(--cyan);"></span>.
              <div style="margin-top: 0.75rem;">
                <a href="/portal" class="btn btn-primary" style="font-size: 0.85rem;">Ir al Portal del Cliente →</a>
              </div>
            </div>

            <!-- AVISO Y CTA PARA COTIZACIONES DEMO / ESTIMACIONES ORIENTATIVAS -->
            <div id="demo-estimation-notice" style="display: none; padding: 1.5rem 1.75rem; background: rgba(52, 107, 241, 0.08); border-left: 3px solid var(--cyan); border-radius: var(--radius-sm); margin-top: 0.5rem;">
              <div style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--cyan); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700; margin-bottom: 0.35rem;">
                Estimación Comercial Orientativa
              </div>
              <h4 style="font-size: 1.1rem; color: var(--paper); margin: 0 0 0.5rem 0; font-weight: 700;">
                Esta es una referencia técnica y presupuestaria orientativa
              </h4>
              <p style="color: var(--steel-light); font-size: 0.88rem; line-height: 1.6; margin-bottom: 1.25rem;">
                El presente cálculo financiero se genera con fines informativos a partir de nuestro catálogo público. No constituye una cotización vinculante con folio asignado ni permite formalización contractual directa sin validación previa de requerimientos.
              </p>
              <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center;">
                <a id="demo-contact-cta" href="/contacto" class="btn btn-primary" style="padding: 0.75rem 1.35rem; font-size: 0.88rem;">
                  Solicitar Cotización Formalizada en Contacto →
                </a>
                <a href="https://wa.me/529518096110" target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="padding: 0.75rem 1.2rem; font-size: 0.88rem; border-color: #25D366; color: #25D366;">
                  Consultar por WhatsApp (+52 951 809 6110)
                </a>
              </div>
            </div>

            <!-- FORMULARIO DE ACEPTACIÓN EXCLUSIVO PARA COTIZACIONES REALES VALIDADAS -->
            <form id="accept-form" style="display: none;">
              <h3 style="font-size: 1.1rem; color: var(--paper); margin-bottom: 1rem;">Formalizar Aceptación de la Propuesta</h3>
              <div class="grid grid-2" style="gap: 1rem; margin-bottom: 1.25rem;">
                <div>
                  <label for="signer-name" style="display: block; font-size: 0.82rem; color: var(--steel-light); margin-bottom: 0.35rem;">Nombre Completo del Representante *</label>
                  <input type="text" id="signer-name" required placeholder="Ej. Ana Martínez" style="width: 100%; padding: 0.7rem 0.9rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-sm); color: var(--paper);" />
                </div>
                <div>
                  <label for="signer-email" style="display: block; font-size: 0.82rem; color: var(--steel-light); margin-bottom: 0.35rem;">Correo Corporativo Autorizado *</label>
                  <input type="email" id="signer-email" required autocomplete="email" inputmode="email" placeholder="representante@empresa.com" style="width: 100%; padding: 0.7rem 0.9rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-sm); color: var(--paper);" />
                </div>
              </div>
              <div style="margin-bottom: 1.25rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.84rem; color: var(--steel-light); cursor: pointer;">
                  <input type="checkbox" id="terms-check" required />
                  <span>Confirmo la aceptación del alcance, cronograma e importes de este SOW conforme a los términos del Contrato Marco GC-MSA-2026.</span>
                </label>
              </div>

              <!-- CONTENEDOR DE ERROR ACCESIBLE (INLINE) -->
              <div id="accept-error-message" role="alert" aria-live="assertive" style="display: none; padding: 1rem 1.25rem; background: rgba(255, 59, 92, 0.08); border: 1px solid rgba(255, 59, 92, 0.35); border-radius: var(--radius-sm); color: var(--paper); font-size: 0.88rem; line-height: 1.55; margin-bottom: 1.25rem;">
                <strong style="color: #FF4D4D; display: block; margin-bottom: 0.25rem;">No fue posible formalizar la aceptación</strong>
                <span id="accept-error-text">El servidor no pudo procesar la solicitud en este momento. Por favor verifica tus datos o contáctanos directamente a contacto@grupocastillo.lat.</span>
              </div>

              <button type="submit" id="btn-accept" class="btn btn-primary" style="width: 100%; padding: 0.9rem; font-size: 1rem;">
                Aceptar Cotización y Proceder al Pago del Anticipo
              </button>
            </form>

          </div>

        </div>

      </div>
    </section>

    <script is:inline>
      (function() {
        let currentProjectId = null;
        let isRealQuotation = false;

        const searchForm = document.getElementById('search-form');
        const searchInput = document.getElementById('search-input');
        const quotationCard = document.getElementById('quotation-card');
        const acceptForm = document.getElementById('accept-form');
        const alreadyAcceptedAlert = document.getElementById('already-accepted-alert');
        const demoNotice = document.getElementById('demo-estimation-notice');
        const demoContactCta = document.getElementById('demo-contact-cta');
        const acceptErrorMsg = document.getElementById('accept-error-message');
        const acceptErrorText = document.getElementById('accept-error-text');

        const getApiUrl = (path) => (window.__CASTILLO_API_URL__ || '') + path;

        function showAcceptError(msg) {
          if (acceptErrorMsg && acceptErrorText) {
            acceptErrorText.textContent = msg;
            acceptErrorMsg.style.display = 'block';
            acceptErrorMsg.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        }

        function clearAcceptError() {
          if (acceptErrorMsg) {
            acceptErrorMsg.style.display = 'none';
          }
        }

        // Leer parámetro ?id= o ?project= de URL
        const params = new URLSearchParams(window.location.search);
        const urlId = params.get('id') || params.get('project');
        const urlPackage = params.get('paquete') || params.get('package') || params.get('servicio') || params.get('service');

        if (urlId) {
          searchInput.value = urlId;
          loadQuotation(urlId, urlPackage);
        } else if (urlPackage) {
          displayDemoQuotation(urlPackage);
        }

        searchForm.addEventListener('submit', function(e) {
          e.preventDefault();
          const id = searchInput.value.trim();
          if (id) loadQuotation(id);
        });

        async function loadQuotation(id, packageHint) {
          clearAcceptError();
          try {
            const res = await fetch(getApiUrl(`/api/quotations/${encodeURIComponent(id)}`));
            if (!res.ok) {
              displayDemoQuotation(packageHint || id);
              return;
            }
            const data = await res.json();
            if (data && data.quotation && data.quotation.project_id) {
              renderRealQuotation(data.quotation);
            } else {
              displayDemoQuotation(packageHint || id);
            }
          } catch (e) {
            displayDemoQuotation(packageHint || id);
          }
        }

        function updateTermsUI(isEngineering, isCare, isGate) {
          const depositLabel = document.getElementById('q-deposit-label');
          const depositNote = document.getElementById('q-deposit-note');
          const balanceLabel = document.getElementById('q-balance-label');
          const balanceNote = document.getElementById('q-balance-note');
          const termsNotice = document.getElementById('q-terms-notice');

          if (isCare) {
            if (depositLabel) depositLabel.innerText = 'Cuota Mensual Estimada';
            if (depositNote) depositNote.innerText = '(Póliza mensual recurrente sin plazo forzoso).';
            if (balanceLabel) balanceLabel.innerText = 'Saldo Posterior';
            if (balanceNote) balanceNote.innerText = '($0.00 MXN - Facturación mensual anticipada).';
            if (termsNotice) {
              termsNotice.style.display = 'block';
              termsNotice.innerText = 'Castle Care se gestiona como suscripción recurrente con planes desde $590 MXN/mes (Basic $590, Pro $990, Enterprise $1,890 MXN/mes). No requiere anticipo de obra tradicional.';
            }
          } else if (isGate) {
            if (depositLabel) depositLabel.innerText = 'Inversión Anual Base';
            if (depositNote) depositNote.innerText = '(Licencia anual de runner CI/CD).';
            if (balanceLabel) balanceLabel.innerText = 'Saldo Posterior';
            if (balanceNote) balanceNote.innerText = '($0.00 MXN - Licencia anual liquidada al 100%).';
            if (termsNotice) {
              termsNotice.style.display = 'block';
              termsNotice.innerText = 'Castle Gate CLI se contrata bajo licenciamiento anual desde $9,900 MXN/año según el nivel de política requerido (C1 a C6).';
            }
          } else if (isEngineering) {
            if (depositLabel) depositLabel.innerText = 'Pago Único Requerido (100%)';
            if (depositNote) depositNote.innerText = '(Liquidación total previa al inicio de ingeniería).';
            if (balanceLabel) balanceLabel.innerText = 'Saldo Posterior (0%)';
            if (balanceNote) balanceNote.innerText = '($0.00 MXN - Sin saldos pendientes contra entrega).';
            if (termsNotice) {
              termsNotice.style.display = 'block';
              termsNotice.innerText = 'La capacidad de ingeniería se reserva después de confirmar el pago y recibir accesos e insumos necesarios.';
            }
          } else {
            if (depositLabel) depositLabel.innerText = 'Anticipo Requerido (50%)';
            if (depositNote) depositNote.innerText = '(Para reserva de capacidad e inicio de trabajos).';
            if (balanceLabel) balanceLabel.innerText = 'Finiquito contra Entrega (50%)';
            if (balanceNote) balanceNote.innerText = '(Tras validación de preentrega con Castle Gate).';
            if (termsNotice) {
              termsNotice.style.display = 'none';
            }
          }
        }

        function renderRealQuotation(q) {
          currentProjectId = q.project_id;
          isRealQuotation = true;

          document.getElementById('q-id').innerText = q.project_id;
          document.getElementById('q-project-name').innerText = q.project_name || 'Desarrollo de Plataforma Web';
          document.getElementById('q-client-name').innerText = 'Cliente: ' + (q.business_name || q.contact_name);
          document.getElementById('q-valid-until').innerText = q.valid_until_date
            ? new Date(q.valid_until_date).toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })
            : '15 Días Naturales';
          document.getElementById('q-version').innerText = 'Versión: v' + (q.version_number || '1.0');
          document.getElementById('q-scope').innerText = q.scope_description;

          const serviceId = String(q.service_package_id || '').toLowerCase();
          const isEngineering = ['checkup', 'emergency', 'rescue', 'audit'].includes(serviceId) || String(q.service_type || '').toUpperCase() === 'SPECIALIZED_SERVICE';
          const totalVal = Number(q.total_mxn || 0);
          const depositVal = isEngineering ? totalVal : Math.round((totalVal / 2) * 100) / 100;
          const balanceVal = isEngineering ? 0 : Math.round((totalVal - depositVal) * 100) / 100;

          document.getElementById('q-subtotal').innerText = '$' + Number(q.subtotal_mxn || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) + ' MXN';
          document.getElementById('q-tax').innerText = '$' + Number(q.tax_amount_mxn || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 }) + ' MXN';
          document.getElementById('q-total').innerText = '$' + totalVal.toLocaleString('es-MX', { minimumFractionDigits: 2 }) + ' MXN';
          document.getElementById('q-deposit').innerText = '$' + depositVal.toLocaleString('es-MX', { minimumFractionDigits: 2 }) + ' MXN';
          document.getElementById('q-balance').innerText = '$' + balanceVal.toLocaleString('es-MX', { minimumFractionDigits: 2 }) + ' MXN';

          updateTermsUI(isEngineering, false, false);

          if (demoNotice) demoNotice.style.display = 'none';

          if (q.is_accepted === 1) {
            acceptForm.style.display = 'none';
            alreadyAcceptedAlert.style.display = 'block';
            document.getElementById('accepted-date').innerText = q.accepted_at ? new Date(q.accepted_at).toLocaleString('es-MX') : 'Fecha registrada';
            document.getElementById('accepted-state').innerText = q.project_state || 'PAYMENT_PENDING';
          } else {
            acceptForm.style.display = 'block';
            alreadyAcceptedAlert.style.display = 'none';
          }

          quotationCard.style.display = 'block';
          quotationCard.scrollIntoView({ behavior: 'smooth' });
        }

        function displayDemoQuotation(packageHint) {
          currentProjectId = null;
          isRealQuotation = false;

          let subtotal = 12500;
          let projName = 'Plataforma Corporativa Living Glass (Castle Gold)';
          let scope = 'Desarrollo integral de plataforma web corporativa con Astro SSG, arquitectura de componentes Living Glass, optimización Core Web Vitals, accesibilidad WCAG 2.1 AA y certificación formal mediante Castle Gate CQS v1.1.';
          let packageParam = 'Castle Gold ($12,500 MXN)';
          let isEngineering = false;
          let isCare = false;
          let isGate = false;
          let customCtaHref = null;

          if (packageHint) {
            const p = String(packageHint).toLowerCase();
            if (p.includes('iron')) {
              subtotal = 2800;
              projName = 'Presencia One-Page Esencial (Castle Iron)';
              scope = 'Desarrollo de sitio One-Page ágil, enlace directo a WhatsApp, diseño responsivo optimizado y certificación Castle Gate C1.';
              packageParam = 'Castle Iron ($2,800 MXN)';
            } else if (p.includes('bronze')) {
              subtotal = 4500;
              projName = 'Landing Page Comercial de Alta Conversión (Castle Bronze)';
              scope = 'Desarrollo de landing comercial de hasta 5 secciones, formulario de captura, optimización de velocidad y certificación Castle Gate C1.';
              packageParam = 'Castle Bronze ($4,500 MXN)';
            } else if (p.includes('silver')) {
              subtotal = 7500;
              projName = 'Portal Web Corporativo Multi-página (Castle Silver)';
              scope = 'Desarrollo de sitio web corporativo de hasta 5 páginas, estructura SEO on-page, diseño modular y certificación Castle Gate C1.';
              packageParam = 'Castle Silver ($7,500 MXN)';
            } else if (p.includes('platinum')) {
              subtotal = 24500;
              projName = 'Plataforma Integrada con Pagos y CRM (Castle Platinum)';
              scope = 'Desarrollo de plataforma web de hasta 15 páginas, integración de pasarelas de pago (Stripe/Mercado Pago), webhooks para CRM y hardening de seguridad.';
              packageParam = 'Castle Platinum ($24,500 MXN)';
            } else if (p.includes('diamond') || p.includes('medida') || p.includes('avanzado')) {
              subtotal = 40000;
              projName = 'Ingeniería de Software a la Medida (Castle Diamond)';
              scope = 'Desarrollo de arquitectura de software personalizada por sprints, módulos operativos, portales con roles RBAC y gobernanza continua Castle Gate C4/C5.';
              packageParam = 'Castle Diamond (Desde $40,000 MXN)';
            } else if (p.includes('checkup')) {
              subtotal = 8900;
              projName = 'Diagnóstico Técnico Ágil 72h (Castle Checkup)';
              scope = 'Auditoría ágil de repositorio en 72 horas: escaneo de vulnerabilidades, fuga de credenciales, Core Web Vitals y sesión de entrega ejecutiva (100% bonificable).';
              packageParam = 'Castle Checkup ($8,900 MXN)';
              isEngineering = true;
            } else if (p.includes('audit')) {
              subtotal = 19900;
              projName = 'Auditoría Técnica Profunda y Due Diligence (Castle Audit)';
              scope = 'Evaluación exhaustiva de arquitectura, modelo de riesgos de seguridad, análisis estático y roadmap de remediación con reporte ejecutivo.';
              packageParam = 'Castle Audit (Desde $19,900 MXN)';
              isEngineering = true;
            } else if (p.includes('emergency') || p.includes('urgencia')) {
              subtotal = 5900;
              projName = 'Atención de Contingencias Técnicas (Castle Emergency)';
              scope = 'Intervención técnica inmediata para resolución de fallas críticas en producción y mitigación de riesgos.';
              packageParam = 'Castle Emergency ($5,900 MXN)';
              isEngineering = true;
            } else if (p.includes('rescue')) {
              subtotal = 6900;
              projName = 'Intervención y Rescate de Código (Castle Rescue)';
              scope = 'Refactorización, estabilización y corrección de código heredado o con problemas de arquitectura.';
              packageParam = 'Castle Rescue (Desde $6,900 MXN)';
              isEngineering = true;
            } else if (p.includes('care') || p.includes('cuidado') || p.includes('soporte') || p.includes('mantenimiento')) {
              subtotal = 590;
              projName = 'Póliza Mensual de Continuidad (Castle Care)';
              scope = 'Supervisión continua 24/7 de disponibilidad, monitoreo SSL, actualización periódica de dependencias y soporte preventivo sin plazos forzosos (Planes: Basic $590, Pro $990, Enterprise $1,890 MXN/mes).';
              packageParam = 'Castle Care (Desde $590 MXN/mes)';
              isCare = true;
              customCtaHref = `/contacto?necesidad=cuidado&paquete=${encodeURIComponent('Castle Care (Desde $590 MXN/mes)')}`;
            } else if (p.includes('gate') || p.includes('cqs') || p.includes('cli') || p.includes('licencia') || p.includes('gobernanza')) {
              subtotal = 9900;
              projName = 'Licencia Anual Castle Gate CLI (CQS v1.1)';
              scope = 'Licencia anual del motor de verificación determinista de 65 controles CQS v1.1 para integración en runners privados de CI/CD (Tarifa base desde $9,900 MXN/año con políticas C1 a C6).';
              packageParam = 'Castle Gate CLI ($9,900 MXN/año)';
              isGate = true;
              customCtaHref = `/contacto?necesidad=gate&paquete=${encodeURIComponent('Castle Gate CLI ($9,900 MXN/año)')}`;
            }
          }

          const tax = subtotal * 0.16;
          const total = subtotal + tax;
          let deposit = isEngineering ? total : Math.round((total / 2) * 100) / 100;
          let balance = isEngineering ? 0 : Math.round((total - deposit) * 100) / 100;

          if (isCare || isGate) {
            deposit = total;
            balance = 0;
          }

          document.getElementById('q-id').innerText = 'ESTIMACIÓN ORIENTATIVA';
          document.getElementById('q-project-name').innerText = projName;
          document.getElementById('q-client-name').innerText = 'Estimación para Consulta Comercial';
          document.getElementById('q-valid-until').innerText = 'Referencia Pública';
          document.getElementById('q-version').innerText = 'Demostración v1.0';
          document.getElementById('q-scope').innerText = scope;

          document.getElementById('q-subtotal').innerText = '$' + Number(subtotal).toLocaleString('es-MX', { minimumFractionDigits: 2 }) + ' MXN';
          document.getElementById('q-tax').innerText = '$' + Number(tax).toLocaleString('es-MX', { minimumFractionDigits: 2 }) + ' MXN';
          document.getElementById('q-total').innerText = '$' + Number(total).toLocaleString('es-MX', { minimumFractionDigits: 2 }) + ' MXN';
          document.getElementById('q-deposit').innerText = '$' + Number(deposit).toLocaleString('es-MX', { minimumFractionDigits: 2 }) + ' MXN';
          document.getElementById('q-balance').innerText = '$' + Number(balance).toLocaleString('es-MX', { minimumFractionDigits: 2 }) + ' MXN';

          updateTermsUI(isEngineering, isCare, isGate);

          if (acceptForm) acceptForm.style.display = 'none';
          if (alreadyAcceptedAlert) alreadyAcceptedAlert.style.display = 'none';
          if (demoNotice) {
            demoNotice.style.display = 'block';
            if (demoContactCta) {
              demoContactCta.href = customCtaHref || `/contacto?paquete=${encodeURIComponent(packageParam)}`;
            }
          }

          quotationCard.style.display = 'block';
          quotationCard.scrollIntoView({ behavior: 'smooth' });
        }

        acceptForm.addEventListener('submit', async function(e) {
          e.preventDefault();
          clearAcceptError();

          if (!isRealQuotation || !currentProjectId) {
            showAcceptError('Esta es una estimación orientativa y no puede ser formalizada directamente. Por favor solicita una cotización formal en nuestro canal de contacto.');
            return;
          }

          const nameInput = document.getElementById('signer-name');
          const emailInput = document.getElementById('signer-email');
          const name = nameInput ? nameInput.value.trim() : '';
          const email = emailInput ? emailInput.value.trim() : '';
          const btnAccept = document.getElementById('btn-accept');
          const originalText = btnAccept ? btnAccept.innerText : 'Aceptar Cotización y Proceder al Pago del Anticipo';

          if (btnAccept) {
            btnAccept.disabled = true;
            btnAccept.innerText = 'Formalizando Aceptación...';
          }

          try {
            const response = await fetch(getApiUrl(`/api/quotations/${encodeURIComponent(currentProjectId)}/accept`), {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ acceptedByName: name, acceptedByEmail: email })
            });

            if (response.ok) {
              window.location.href = `/portal?project=${encodeURIComponent(currentProjectId)}&email=${encodeURIComponent(email)}`;
            } else {
              let errDetail = 'El servidor no pudo procesar la aceptación formal de la cotización en este momento.';
              try {
                const errData = await response.json();
                if (errData && errData.message) errDetail = errData.message;
              } catch (_) {}
              showAcceptError(errDetail + ' Por favor verifica tus datos o contáctanos directamente a contacto@grupocastillo.lat.');
              if (btnAccept) {
                btnAccept.disabled = false;
                btnAccept.innerText = originalText;
              }
            }
          } catch (err) {
            showAcceptError('Error de conexión con el servidor. No se formalizó la cotización. Por favor reintenta o contáctanos a contacto@grupocastillo.lat o vía WhatsApp al +52 951 809 6110.');
            if (btnAccept) {
              btnAccept.disabled = false;
              btnAccept.innerText = originalText;
            }
          }
        });
      })();
    </script>
  </main>
</BaseLayout>
