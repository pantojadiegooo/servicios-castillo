---
import BaseLayout from '../layouts/BaseLayout.astro';
import GateSchematic from '../components/GateSchematic.astro';
import CTABand from '../components/CTABand.astro';
---

<BaseLayout
  title="Castle Care — Servicios Castillo"
  description="Mantenimiento y evolución continua para soluciones digitales: actualizaciones, seguridad, respaldos y monitoreo."
  canonical="https://serviciosorg-castillo.example.mx/cuidado.html"
  ogUrl="https://serviciosorg-castillo.example.mx/cuidado.html"
>
  <main id="main">

    <section class="page-hero">
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="index.html">Inicio</a> / <a href="soluciones.html">Soluciones</a> / Castle Care</p>
        <p class="eyebrow">CARE</p>
        <h1>Castle Care</h1>
        <p>Una solución digital sana necesita mantenimiento continuo, no solo un buen lanzamiento.</p>
      </div>
    </section>

    <section class="section">
      <div class="container two-col">
        <div class="reveal">
          <h2>Qué incluye</h2>
          <ul class="check-list">
            <li>Actualizaciones periódicas</li><li>Seguridad continua</li><li>Respaldos (backups)</li><li>Monitoreo</li><li>Corrección de incidencias</li><li>Optimización y evolución tecnológica</li>
          </ul>
        </div>
        <div class="reveal">
          <h2>Cómo trabajamos</h2>
          <div class="process-list">
            <div class="process-row" style="padding-block:1rem; grid-template-columns:60px 1fr;">
              <span class="process-code">01</span>
              <div><h3 style="font-size:1.05rem;">Monitoreo continuo</h3></div>
            </div><div class="process-row" style="padding-block:1rem; grid-template-columns:60px 1fr;">
              <span class="process-code">02</span>
              <div><h3 style="font-size:1.05rem;">Mantenimiento programado</h3></div>
            </div><div class="process-row" style="padding-block:1rem; grid-template-columns:60px 1fr;">
              <span class="process-code">03</span>
              <div><h3 style="font-size:1.05rem;">Reporte de estado</h3></div>
            </div><div class="process-row" style="padding-block:1rem; grid-template-columns:60px 1fr;">
              <span class="process-code">04</span>
              <div><h3 style="font-size:1.05rem;">Evolución según necesidades del negocio</h3></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-dim">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Castillo Security &amp; Quality Gate</p>
          <h2>También pasa por el Gate.</h2>
          <p>Todo proyecto, sin importar su tamaño, recorre el mismo sistema de validación antes de considerarse listo.</p>
        </div>
        <div class="reveal">
          <GateSchematic compact={true} />
        </div>
      </div>
    </section>

    <CTABand
      title="¿Quién cuida tu solución después del lanzamiento?"
      description="Con Castle Care tu solución se mantiene actualizada, segura y vigente."
    />

  </main>
</BaseLayout>
