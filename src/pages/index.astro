---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQItem from '../components/FAQItem.astro';
import CTABand from '../components/CTABand.astro';
import CastleTerminalSimulator from '../components/CastleTerminalSimulator.astro';
import HeroEngineVisual from '../components/HeroEngineVisual.astro';
import CastleGateBadge from '../components/CastleGateBadge.astro';
import TechIcon from '../components/TechIcon.astro';
---

<BaseLayout
  title="Grupo Castillo — Firma de Ingeniería Digital, Software a la Medida y Gobernanza"
  description="Grupo Castillo: Ingeniería digital para empresas. Desarrollo web de alto rendimiento, software a la medida, automatizaciones y tecnología propia de gobernanza determinista. Tu sitio, tu código, tus cuentas, siempre."
  canonical="https://servicios-castillo.vercel.app/index.html"
  ogUrl="https://servicios-castillo.vercel.app/index.html"
>
  <main id="main">

    <!-- =========================================================================
         01 — HERO (BENEFICIO COMERCIAL PRIMERO + SOBERANÍA TECNOLÓGICA)
         ========================================================================= -->
    <section class="hero" style="position: relative; overflow: hidden; padding-top: 6rem; padding-bottom: 5rem; background: #06080C;">
      <HeroEngineVisual />
      <div class="container hero-content-container" style="position: relative; z-index: 4; max-width: 960px; margin: 0 auto; text-align: center;">
        
        <p class="eyebrow" style="margin-bottom: 1.25rem; justify-content: center; color: var(--cyan);">
          FIRMA DE INGENIERÍA DIGITAL &amp; SOBERANÍA TECNOLÓGICA
        </p>

        <h1 style="font-size: clamp(2.2rem, 4vw, 3.5rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.025em; margin-bottom: 1.35rem; color: var(--paper);">
          Ingeniería digital para empresas.<br>
          <span style="color: var(--cyan);">Web, software, infraestructura y seguridad</span> construidos para ser tuyos.
        </h1>

        <p class="lede" style="font-size: 1.15rem; color: #E2E8F0; line-height: 1.7; margin-bottom: 2.25rem; max-width: 74ch; margin-left: auto; margin-right: auto;">
          <strong style="color: var(--paper);">Tu sitio. Tu código. Tus cuentas. Siempre.</strong> Desarrollamos plataformas web de alto rendimiento, sistemas a la medida y automatizaciones operativas con validación técnica determinista y 100% de titularidad jurídica.
        </p>

        <!-- CTA PRINCIPAL ÚNICO -->
        <div class="hero-actions" style="display: flex; justify-content: center; align-items: center; margin-bottom: 2.75rem;">
          <a class="btn btn-cta-crystal" href="/contacto.html" style="font-size: 1.05rem; padding: 0.95rem 2.5rem;">
            Iniciar Proyecto →
          </a>
        </div>

        <!-- PILLS DE CERTEZA TÉCNICA -->
        <div class="hero-metrics" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; padding-top: 1.75rem; border-top: 1px solid rgba(255, 255, 255, 0.12); max-width: 780px; margin: 0 auto;">
          <div>
            <strong style="display: block; font-size: 1.25rem; font-family: var(--f-mono); color: var(--paper);">100% Titularidad</strong>
            <span style="font-size: 0.76rem; color: #CBD5E1; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500;">Código &amp; Cuentas Propias</span>
          </div>
          <div>
            <strong style="display: block; font-size: 1.25rem; font-family: var(--f-mono); color: var(--cyan);">Web &amp; Software</strong>
            <span style="font-size: 0.76rem; color: #CBD5E1; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500;">Desarrollo a la Medida</span>
          </div>
          <div>
            <strong style="display: block; font-size: 1.25rem; font-family: var(--f-mono); color: var(--paper);">Castle Gate</strong>
            <span style="font-size: 0.76rem; color: #CBD5E1; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 500;">Gobernanza CQS v1.1</span>
          </div>
        </div>

      </div>
    </section>

    <!-- =========================================================================
         02 — QUÉ CONSTRUIMOS (CAPACIDADES REALES DE LA FIRMA)
         ========================================================================= -->
    <section class="section section-dim" id="que-construimos" style="padding-top: 4.5rem; padding-bottom: 4.5rem;">
      <div class="container">
        
        <div class="section-head reveal" style="text-align: center; max-width: 820px; margin: 0 auto 3rem auto;">
          <p class="eyebrow" style="color: var(--cyan); justify-content: center;">Capacidades Integrales de Ingeniería</p>
          <h2 style="font-size: 2.2rem; color: var(--paper);">Qué construimos para tu empresa</h2>
          <p style="color: #E2E8F0; font-size: 1.05rem; line-height: 1.65;">
            Grupo Castillo no es únicamente un estudio de páginas web. Diseñamos, construimos, auditamos y mantenemos activos digitales completos para resolver problemas operativos reales.
          </p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem; margin-bottom: 2rem;">
          
          <!-- 1. DESARROLLO WEB -->
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid var(--cyan); background: rgba(14, 18, 27, 0.9);">
            <div style="font-family: var(--f-mono); font-size: 0.76rem; color: var(--cyan); font-weight: 700; margin-bottom: 0.5rem; letter-spacing: 0.04em;">01 • WEB DE ALTO RENDIMIENTO</div>
            <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem; color: var(--paper); font-weight: 700;">Desarrollo Web Comercial</h3>
            <p style="font-size: 0.92rem; color: #E2E8F0; line-height: 1.65; margin-bottom: 1.25rem;">
              Plataformas web corporativas, landing pages de alta conversión, blogs autogestionables y sitios e-commerce construidos con arquitectura estática ultrarrápida (SSG) sin plantillas sobrecargadas.
            </p>
            <ul style="list-style: none; padding: 0; margin: 0 0 1.25rem 0; font-size: 0.86rem; line-height: 1.65;">
              <li style="display: flex; gap: 0.5rem; margin-bottom: 0.35rem;"><span style="color: var(--cyan); font-weight: bold;">•</span> <span style="color: #CBD5E1;">Sitios corporativos multi-sección</span></li>
              <li style="display: flex; gap: 0.5rem; margin-bottom: 0.35rem;"><span style="color: var(--cyan); font-weight: bold;">•</span> <span style="color: #CBD5E1;">Landing pages orientadas a WhatsApp / Leads</span></li>
              <li style="display: flex; gap: 0.5rem; margin-bottom: 0.35rem;"><span style="color: var(--cyan); font-weight: bold;">•</span> <span style="color: #CBD5E1;">Catálogos y tiendas con pagos tokenizados</span></li>
              <li style="display: flex; gap: 0.5rem;"><span style="color: var(--cyan); font-weight: bold;">•</span> <span style="color: #CBD5E1;">Optimización extrema de Core Web Vitals</span></li>
            </ul>
            <a href="/paquetes.html" style="font-size: 0.85rem; color: var(--cyan); text-decoration: none; font-weight: 600; margin-top: auto; display: inline-flex; align-items: center; gap: 0.35rem;">Ver Paquetes Web (Iron a Platinum) →</a>
          </div>

          <!-- 2. SOFTWARE A LA MEDIDA -->
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid var(--cyan); background: rgba(14, 18, 27, 0.9);">
            <div style="font-family: var(--f-mono); font-size: 0.76rem; color: var(--cyan); font-weight: 700; margin-bottom: 0.5rem; letter-spacing: 0.04em;">02 • SOFTWARE A LA MEDIDA</div>
            <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem; color: var(--paper); font-weight: 700;">Sistemas &amp; Aplicaciones Web</h3>
            <p style="font-size: 0.92rem; color: #E2E8F0; line-height: 1.65; margin-bottom: 1.25rem;">
              Desarrollo de software empresarial para digitalizar la operación de tu negocio: portales privados, plataformas SaaS, automatización de flujos y módulos adaptados a tus reglas operativas.
            </p>
            <ul style="list-style: none; padding: 0; margin: 0 0 1.25rem 0; font-size: 0.86rem; line-height: 1.65;">
              <li style="display: flex; gap: 0.5rem; margin-bottom: 0.35rem;"><span style="color: var(--cyan); font-weight: bold;">•</span> <span style="color: #CBD5E1;">CRM, ERP y control de inventarios a medida</span></li>
              <li style="display: flex; gap: 0.5rem; margin-bottom: 0.35rem;"><span style="color: var(--cyan); font-weight: bold;">•</span> <span style="color: #CBD5E1;">Portales de clientes y proveedores con roles (RBAC)</span></li>
              <li style="display: flex; gap: 0.5rem; margin-bottom: 0.35rem;"><span style="color: var(--cyan); font-weight: bold;">•</span> <span style="color: #CBD5E1;">Dashboards analíticos y reportería en tiempo real</span></li>
              <li style="display: flex; gap: 0.5rem;"><span style="color: var(--cyan); font-weight: bold;">•</span> <span style="color: #CBD5E1;">Desarrollo de APIs REST y servicios backend</span></li>
            </ul>
            <a href="/paquetes/diamond.html" style="font-size: 0.85rem; color: var(--cyan); text-decoration: none; font-weight: 600; margin-top: auto; display: inline-flex; align-items: center; gap: 0.35rem;">Ver Castle Diamond / Software a Medida →</a>
          </div>

          <!-- 3. AUTOMATIZACIÓN OPERATIVA -->
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid var(--cyan); background: rgba(14, 18, 27, 0.9);">
            <div style="font-family: var(--f-mono); font-size: 0.76rem; color: var(--cyan); font-weight: 700; margin-bottom: 0.5rem; letter-spacing: 0.04em;">03 • AUTOMATIZACIÓN</div>
            <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem; color: var(--paper); font-weight: 700;">Automatización &amp; Flujos</h3>
            <p style="font-size: 0.92rem; color: #E2E8F0; line-height: 1.65; margin-bottom: 1.25rem;">
              Conexión de herramientas para eliminar tareas manuales repetitivas y acelerar la atención a prospectos sin contratar plataformas mensuales costosas.
            </p>
            <ul style="list-style: none; padding: 0; margin: 0 0 1.25rem 0; font-size: 0.86rem; line-height: 1.65;">
              <li style="display: flex; gap: 0.5rem; margin-bottom: 0.35rem;"><span style="color: var(--cyan); font-weight: bold;">•</span> <span style="color: #CBD5E1;">Formularios inteligentes con validación y triage</span></li>
              <li style="display: flex; gap: 0.5rem; margin-bottom: 0.35rem;"><span style="color: var(--cyan); font-weight: bold;">•</span> <span style="color: #CBD5E1;">Integración con WhatsApp Cloud API y notificaciones</span></li>
              <li style="display: flex; gap: 0.5rem; margin-bottom: 0.35rem;"><span style="color: var(--cyan); font-weight: bold;">•</span> <span style="color: #CBD5E1;">Webhooks para sincronización de bases de datos</span></li>
              <li style="display: flex; gap: 0.5rem;"><span style="color: var(--cyan); font-weight: bold;">•</span> <span style="color: #CBD5E1;">Flujos de cotización y cobranza automática</span></li>
            </ul>
            <a href="/servicios.html" style="font-size: 0.85rem; color: var(--cyan); text-decoration: none; font-weight: 600; margin-top: auto; display: inline-flex; align-items: center; gap: 0.35rem;">Ver Servicios de Integración →</a>
          </div>

          <!-- 4. SEGURIDAD Y GOBERNANZA -->
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid var(--cyan); background: rgba(14, 18, 27, 0.9); display: flex; flex-direction: column;">
            <div style="font-family: var(--f-mono); font-size: 0.76rem; color: var(--cyan); font-weight: 700; margin-bottom: 0.5rem; letter-spacing: 0.04em;">04 • SEGURIDAD &amp; CALIDAD</div>
            <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem; color: var(--paper); font-weight: 700;">Seguridad, Auditoría &amp; Rescate</h3>
            <p style="font-size: 0.92rem; color: #E2E8F0; line-height: 1.65; margin-bottom: 1.25rem;">
              Auditoría estática de repositorios, saneamiento de secretos expuestos en Git, intervención directa en código (Rescue) y protocolo de veto en CI/CD con Castle Gate.
            </p>
            <ul style="list-style: none; padding: 0; margin: 0 0 1.25rem 0; font-size: 0.86rem; line-height: 1.65;">
              <li style="display: flex; gap: 0.5rem; margin-bottom: 0.35rem;"><span style="color: var(--cyan); font-weight: bold;">•</span> <span style="color: #CBD5E1;">Diagnóstico estático en 72h (Castle Checkup)</span></li>
              <li style="display: flex; gap: 0.5rem; margin-bottom: 0.35rem;"><span style="color: var(--cyan); font-weight: bold;">•</span> <span style="color: #CBD5E1;">Due Diligence y auditoría profunda (Castle Audit)</span></li>
              <li style="display: flex; gap: 0.5rem; margin-bottom: 0.35rem;"><span style="color: var(--cyan); font-weight: bold;">•</span> <span style="color: #CBD5E1;">Intervención y parches en código (Castle Rescue)</span></li>
              <li style="display: flex; gap: 0.5rem;"><span style="color: var(--cyan); font-weight: bold;">•</span> <span style="color: #CBD5E1;">Motor de veto determinista en memoria (Castle Gate)</span></li>
            </ul>
            <a href="/servicios/checkup.html" style="font-size: 0.85rem; color: var(--cyan); text-decoration: none; font-weight: 600; margin-top: auto; display: inline-flex; align-items: center; gap: 0.35rem;">Ver Diagnósticos y Rescate →</a>
          </div>

          <!-- 5. CONSULTORÍA DIGITAL -->
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid var(--cyan); grid-column: span 2; background: rgba(14, 18, 27, 0.9); display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="font-family: var(--f-mono); font-size: 0.76rem; color: var(--cyan); font-weight: 700; margin-bottom: 0.5rem; letter-spacing: 0.04em;">05 • CONSULTORÍA ESTRATÉGICA</div>
              <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem; color: var(--paper); font-weight: 700;">Consultoría Digital &amp; Roadmap Tecnológico</h3>
              <p style="font-size: 0.92rem; color: #E2E8F0; line-height: 1.65; margin-bottom: 1.25rem;">
                Acompañamos a directores generales y CTOs a definir la arquitectura correcta antes de gastar presupuesto. Evaluamos si conviene refactorizar un sistema heredado o construir desde cero, estructurando una hoja de ruta técnica realista.
              </p>
              <ul style="list-style: none; padding: 0; margin: 0 0 1.25rem 0; font-size: 0.86rem; line-height: 1.65; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.35rem 1rem;">
                <li style="display: flex; gap: 0.5rem;"><span style="color: var(--cyan); font-weight: bold;">•</span> <span style="color: #CBD5E1;">Evaluación técnica de viabilidad y arquitectura</span></li>
                <li style="display: flex; gap: 0.5rem;"><span style="color: var(--cyan); font-weight: bold;">•</span> <span style="color: #CBD5E1;">Auditoría de deuda técnica y refactorización</span></li>
                <li style="display: flex; gap: 0.5rem;"><span style="color: var(--cyan); font-weight: bold;">•</span> <span style="color: #CBD5E1;">Planificación de migración sin interrupción</span></li>
                <li style="display: flex; gap: 0.5rem;"><span style="color: var(--cyan); font-weight: bold;">•</span> <span style="color: #CBD5E1;">Sesiones estratégicas con el Ingeniero Líder</span></li>
              </ul>
            </div>
            <div style="display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: center; padding-top: 1rem; border-top: 1px solid rgba(255, 255, 255, 0.08); margin-top: auto;">
              <span style="font-size: 0.86rem; color: #CBD5E1;"><strong style="color: var(--paper);">Modalidad:</strong> Sesiones ejecutivas con el Ingeniero Líder</span>
              <span style="font-size: 0.86rem; color: #CBD5E1;"><strong style="color: var(--paper);">Cotización:</strong> Sujeto a alcance técnico</span>
              <a href="/servicios.html#consultoria-digital" class="btn btn-outline" style="padding: 0.45rem 1.1rem; font-size: 0.82rem; margin-left: auto;">Conocer Consultoría →</a>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- =========================================================================
         03 — CATÁLOGO COMERCIAL & SERVICIOS DE INGENIERÍA
         ========================================================================= -->
    <section class="section" id="paquetes-catalogo" style="padding-top: 4.5rem; padding-bottom: 4.5rem;">
      <div class="container">
        
        <div class="section-head reveal" style="text-align: center; max-width: 820px; margin: 0 auto 3rem auto;">
          <p class="eyebrow" style="color: var(--cyan); justify-content: center;">Catálogo Oficial de Desarrollo</p>
          <h2 style="font-size: 2.2rem; color: var(--paper);">Precios públicos, plazos objetivo y alcance formal</h2>
          <p style="color: #E2E8F0; font-size: 1.05rem; line-height: 1.65;">
            Sin cotizaciones opacas ni sorpresas de alcance. Cada paquete incluye Declaración de Trabajo (SOW), validación en Castle Gate y 100% de titularidad jurídica.
          </p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem; margin-bottom: 3rem;">
          
          <!-- IRON -->
          <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid #71717A; background: rgba(14, 18, 27, 0.9); display: flex; flex-direction: column;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.25rem;">
              <h3 style="font-size: 1.2rem; margin: 0; color: var(--paper);">Castle Iron</h3>
              <span style="font-family: var(--f-mono); font-size: 1.15rem; font-weight: 700; color: var(--paper);">$2,800 MXN</span>
            </div>
            <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--cyan); font-weight: 600; display: block; margin-bottom: 0.75rem;">Plazo objetivo: 3–5 días hábiles</span>
            <p style="font-size: 0.88rem; color: #E2E8F0; line-height: 1.6; margin-bottom: 1rem; flex-grow: 1;">
              Presencia One-Page directa con enlace directo a WhatsApp para profesionistas y micronegocios.
            </p>
            <div style="font-size: 0.82rem; color: #CBD5E1; margin-bottom: 1.25rem; padding-top: 0.5rem; border-top: 1px dashed rgba(255, 255, 255, 0.15); min-height: 48px; display: flex; align-items: center;">
              <div><strong style="color: var(--paper);">Add-on recomendado:</strong> Configuración de SEO Local &amp; Google Business Profile.</div>
            </div>
            <a href="/paquetes/iron.html" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Ficha Técnica Iron →</a>
          </div>

          <!-- BRONZE -->
          <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid #CD7F32; background: rgba(14, 18, 27, 0.9); display: flex; flex-direction: column;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.25rem;">
              <h3 style="font-size: 1.2rem; margin: 0; color: var(--paper);">Castle Bronze</h3>
              <span style="font-family: var(--f-mono); font-size: 1.15rem; font-weight: 700; color: var(--paper);">$4,500 MXN</span>
            </div>
            <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--cyan); font-weight: 600; display: block; margin-bottom: 0.75rem;">Plazo objetivo: 5–7 días hábiles</span>
            <p style="font-size: 0.88rem; color: #E2E8F0; line-height: 1.6; margin-bottom: 1rem; flex-grow: 1;">
              Landing comercial de hasta 5 secciones estructuradas con formulario de captación para campañas.
            </p>
            <div style="font-size: 0.82rem; color: #CBD5E1; margin-bottom: 1.25rem; padding-top: 0.5rem; border-top: 1px dashed rgba(255, 255, 255, 0.15); min-height: 48px; display: flex; align-items: center;">
              <div><strong style="color: var(--paper);">Add-on recomendado:</strong> Configuración de SEO Local &amp; Analítica de conversión.</div>
            </div>
            <a href="/paquetes/bronze.html" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Ficha Técnica Bronze →</a>
          </div>

          <!-- SILVER -->
          <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid #94A3B8; background: rgba(14, 18, 27, 0.9); display: flex; flex-direction: column;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.25rem;">
              <h3 style="font-size: 1.2rem; margin: 0; color: var(--paper);">Castle Silver</h3>
              <span style="font-family: var(--f-mono); font-size: 1.15rem; font-weight: 700; color: var(--paper);">$7,500 MXN</span>
            </div>
            <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--cyan); font-weight: 600; display: block; margin-bottom: 0.75rem;">Plazo objetivo: 7–10 días hábiles</span>
            <p style="font-size: 0.88rem; color: #E2E8F0; line-height: 1.6; margin-bottom: 1rem; flex-grow: 1;">
              Sitio web corporativo multi-página (hasta 5 vistas) para empresas con catálogo de servicios formal.
            </p>
            <div style="font-size: 0.82rem; color: #CBD5E1; margin-bottom: 1.25rem; padding-top: 0.5rem; border-top: 1px dashed rgba(255, 255, 255, 0.15); min-height: 48px; display: flex; align-items: center;">
              <div><strong style="color: var(--paper);">Add-on recomendado:</strong> Panel CMS Ligero de autoedición de contenidos.</div>
            </div>
            <a href="/paquetes/silver.html" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Ficha Técnica Silver →</a>
          </div>

          <!-- GOLD -->
          <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid #FFD700; background: rgba(14, 18, 27, 0.9); display: flex; flex-direction: column;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.25rem;">
              <h3 style="font-size: 1.2rem; margin: 0; color: var(--paper);">Castle Gold</h3>
              <span style="font-family: var(--f-mono); font-size: 1.15rem; font-weight: 700; color: var(--paper);">$12,500 MXN</span>
            </div>
            <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--cyan); font-weight: 600; display: block; margin-bottom: 0.75rem;">Plazo objetivo: 10–14 días hábiles</span>
            <p style="font-size: 0.88rem; color: #E2E8F0; line-height: 1.6; margin-bottom: 1rem; flex-grow: 1;">
              8–10 páginas con Blog / CMS autogestionable y arquitectura SEO avanzada para posicionamiento orgánico.
            </p>
            <div style="padding: 0.75rem; background: rgba(0, 210, 255, 0.08); border-left: 3px solid var(--cyan); border-radius: var(--radius-sm); font-size: 0.78rem; color: #E2E8F0; margin-bottom: 1.25rem; line-height: 1.45; min-height: 64px; display: flex; align-items: center;">
              <div>ℹ <strong style="color: var(--paper);">Nota de alcance:</strong> Insumos provistos por el cliente. Redacción completa desde cero disponible como servicio adicional.</div>
            </div>
            <a href="/paquetes/gold.html" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Ficha Técnica Gold →</a>
          </div>

