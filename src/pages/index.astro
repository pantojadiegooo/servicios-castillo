---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQItem from '../components/FAQItem.astro';
import CTABand from '../components/CTABand.astro';
import CastleGateVisual from '../components/CastleGateVisual.astro';
import CastleTerminalSimulator from '../components/CastleTerminalSimulator.astro';
---

<BaseLayout
  title="Grupo Castillo — Firma de Ingeniería de Software y Gobernanza Tecnológica"
  description="Grupo Castillo construye plataformas web de alto rendimiento, interviene código heredado y aplica tecnología propia de gobernanza determinista para releases seguros."
  canonical="https://servicios-castillo.vercel.app/index.html"
  ogUrl="https://servicios-castillo.vercel.app/index.html"
>
  <main id="main">

    <!-- 01 — HERO & IDENTIDAD CORPORATIVA (SIN PRECIOS EN HERO) -->
    <section class="hero" style="position: relative; overflow: hidden; padding-top: 6rem; padding-bottom: 5.5rem;">
      <CastleGateVisual />
      <div class="container" style="position: relative; z-index: 2; max-width: 960px; margin: 0 auto; text-align: center;">
        <div class="badge badge-cyan" style="margin-bottom: 1.5rem; display: inline-flex;">
          <span class="badge-dot"></span> FIRMA DE INGENIERÍA DIGITAL &amp; GOBERNANZA TÉCNICA
        </div>
        <h1 style="font-size: clamp(2.3rem, 4.2vw, 3.8rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.025em; margin-bottom: 1.5rem;">
          Construimos, evaluamos, corregimos y protegemos <span style="color: var(--cyan);">sistemas digitales confiables.</span>
        </h1>
        <p class="lede" style="font-size: 1.15rem; color: var(--steel-light); line-height: 1.7; margin-bottom: 2.25rem; max-width: 72ch; margin-left: auto; margin-right: auto;">
          Grupo Castillo combina desarrollo web de alto rendimiento con propiedad absoluta del código para el cliente, intervención especializada en código heredado y tecnología propia para la gobernanza de releases.
        </p>
        <div class="hero-actions" style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3rem;">
          <a class="btn btn-primary" href="soluciones.html">Conocer Soluciones</a>
          <a class="btn btn-outline" href="paquetes.html">Explorar Paquetes Build</a>
          <a class="btn btn-outline" href="nosotros.html">Filosofía &amp; Principios</a>
        </div>

        <div class="hero-metrics" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; padding-top: 2rem; border-top: 1px solid var(--glass-border); max-width: 720px; margin: 0 auto;">
          <div>
            <strong style="display: block; font-size: 1.35rem; font-family: var(--f-mono); color: var(--paper);">100% Cliente</strong>
            <span style="font-size: 0.75rem; color: var(--steel-soft); text-transform: uppercase; letter-spacing: 0.05em;">Propiedad de Código</span>
          </div>
          <div>
            <strong style="display: block; font-size: 1.35rem; font-family: var(--f-mono); color: var(--paper);">72h Objetivo</strong>
            <span style="font-size: 0.75rem; color: var(--steel-soft); text-transform: uppercase; letter-spacing: 0.05em;">Diagnóstico Checkup</span>
          </div>
          <div>
            <strong style="display: block; font-size: 1.35rem; font-family: var(--f-mono); color: var(--paper);">Tecnología Propia</strong>
            <span style="font-size: 0.75rem; color: var(--steel-soft); text-transform: uppercase; letter-spacing: 0.05em;">Castle Gate Engine</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 — PROBLEMAS REALES DEL CLIENTE (EMPATÍA Y RIESGOS) -->
    <section class="section section-dim" id="problemas">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Desafíos Frecuentes</p>
          <h2>Las dificultades que resolvemos para nuestros clientes</h2>
          <p>Identificamos los puntos de fricción más comunes en el desarrollo y mantenimiento de software.</p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem;">
          <div class="card glass-panel" style="padding: 2rem;">
            <div style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-soft); margin-bottom: 0.5rem;">ESCENARIO 01</div>
            <h3 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--paper);">Código Abandonado o Huérfano</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              El desarrollador o agencia original desapareció y nadie en tu empresa se atreve a modificar el sistema por temor a romper la operación.
            </p>
          </div>

          <div class="card glass-panel" style="padding: 2rem;">
            <div style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-soft); margin-bottom: 0.5rem;">ESCENARIO 02</div>
            <h3 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--paper);">Falta de Certeza de Calidad</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              Tu sitio funciona pero desconoces si contiene claves expuestas, fallas de accesibilidad o problemas de lentitud que ahuyentan clientes.
            </p>
          </div>

          <div class="card glass-panel" style="padding: 2rem;">
            <div style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-soft); margin-bottom: 0.5rem;">ESCENARIO 03</div>
            <h3 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--paper);">Dependencia y Falta de Propiedad</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              Proveedores que retienen dominios o código en plataformas cerradas, impidiendo que tu empresa tenga el control real de sus activos.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 03 — SOLUCIONES: QUÉ HACE GRUPO CASTILLO -->
    <section class="section" id="soluciones">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Capacidades de Ingeniería</p>
          <h2>Un modelo integral para el ciclo de vida del software</h2>
          <p>Estructuramos nuestras capacidades en líneas de acción claras y complementarias.</p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem;">
          
          <div class="card glass-panel" style="padding: 2rem;">
            <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--cyan); font-weight: 700;">BUILD</span>
            <h3 style="font-size: 1.2rem; margin: 0.5rem 0;">Construimos</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1.25rem;">
              Desarrollamos sitios y plataformas web desde nivel esencial (Iron) hasta software a medida (Diamond) con propiedad total del código.
            </p>
            <a href="paquetes.html" style="font-size: 0.82rem; color: var(--cyan); text-decoration: none; font-weight: 600;">Ver Catálogo Build →</a>
          </div>

          <div class="card glass-panel" style="padding: 2rem;">
            <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--cyan); font-weight: 700;">CHECKUP &amp; AUDIT</span>
            <h3 style="font-size: 1.2rem; margin: 0.5rem 0;">Diagnosticamos &amp; Investigamos</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1.25rem;">
              Evaluamos repositorios en 72h con Castle Checkup o realizamos investigaciones profundas de arquitectura con Castle Audit.
            </p>
            <a href="servicios/checkup.html" style="font-size: 0.82rem; color: var(--cyan); text-decoration: none; font-weight: 600;">Ver Servicios de Diagnóstico →</a>
          </div>

          <div class="card glass-panel" style="padding: 2rem;">
            <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--cyan); font-weight: 700;">RESCUE &amp; CARE</span>
            <h3 style="font-size: 1.2rem; margin: 0.5rem 0;">Corregimos &amp; Acompañamos</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1.25rem;">
              Intervenimos repositorios para sanear secretos y ofrecemos supervisión técnica continua mediante suscripciones mensuales Castle Care.
            </p>
            <a href="servicios/care.html" style="font-size: 0.82rem; color: var(--cyan); text-decoration: none; font-weight: 600;">Ver Planes de Continuidad →</a>
          </div>

        </div>
      </div>
    </section>

    <!-- 04 — CÓMO TRABAJAMOS: PROCESO DISCIPLINADO -->
    <section class="section section-dim" id="metodologia">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Metodología de Trabajo</p>
          <h2>Proceso claro, transparente y sin sorpresas</h2>
          <p>Cada proyecto avanza por fases estructuradas con entregables definidos por escrito.</p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem;">
          <div class="card glass-panel" style="padding: 2rem;">
            <div style="font-family: var(--f-mono); font-size: 1.4rem; color: var(--cyan); font-weight: 800; margin-bottom: 0.5rem;">01</div>
            <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--paper);">Fase Discover &amp; Alcance</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              Analizamos requerimientos, definimos el paquete o servicio adecuado y establecemos el presupuesto y número de revisiones por contrato.
            </p>
          </div>

          <div class="card glass-panel" style="padding: 2rem;">
            <div style="font-family: var(--f-mono); font-size: 1.4rem; color: var(--cyan); font-weight: 800; margin-bottom: 0.5rem;">02</div>
            <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--paper);">Ingeniería &amp; Validación</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              Construimos o intervenimos el software aplicando estándares de calidad estricta, accesibilidad WCAG y rendimiento de carga.
            </p>
          </div>

          <div class="card glass-panel" style="padding: 2rem;">
            <div style="font-family: var(--f-mono); font-size: 1.4rem; color: var(--cyan); font-weight: 800; margin-bottom: 0.5rem;">03</div>
            <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--paper);">Entrega &amp; Propiedad</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              Desplegamos en tu infraestructura a tu propio nombre, entregamos repositorios limpios y ofrecemos opción de acompañamiento Castle Care.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 05 — SEGMENTACIÓN: ORIENTACIÓN POR TIPO DE CLIENTE -->
    <section class="section" id="segmentacion">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Orientación Comercial</p>
          <h2>Soluciones adaptadas a la escala de tu organización</h2>
          <p>Identifica rápidamente qué servicios corresponden al momento actual de tu negocio.</p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.75rem;">
          
          <div class="card glass-panel" style="padding: 2.25rem;">
            <span class="badge badge-cyan" style="margin-bottom: 1rem;">PROFESIONALES &amp; MICRONEGOCIOS</span>
            <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Presencia Digital Rápida</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1.25rem;">
              Para independientes, consultores y comercios que requieren una web ágil con WhatsApp sin costos elevados de desarrollo.
            </p>
            <ul style="list-style: none; padding: 0; font-size: 0.85rem; color: var(--steel-light); display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1.5rem;">
              <li>→ <strong>Castle Iron:</strong> One-Page esencial ($2,800 MXN)</li>
              <li>→ <strong>Castle Bronze:</strong> Landing de ventas ($4,500 MXN)</li>
            </ul>
            <a href="paquetes.html" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Paquetes de Entrada →</a>
          </div>

          <div class="card glass-panel" style="padding: 2.25rem; border-color: rgba(0, 210, 255, 0.35);">
            <span class="badge badge-cyan" style="margin-bottom: 1rem;">PYMES &amp; EMPRESAS</span>
            <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Plataformas Corporativas</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1.25rem;">
              Para empresas que necesitan comunicar múltiples servicios, publicar contenido autogestionable y conectar con clientes institucionales.
            </p>
            <ul style="list-style: none; padding: 0; font-size: 0.85rem; color: var(--steel-light); display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1.5rem;">
              <li>→ <strong>Castle Silver / Gold:</strong> Sitios multi-página y Blog</li>
              <li>→ <strong>Castle Care Pro:</strong> Supervisión continua ($7,900 MXN/m)</li>
            </ul>
            <a href="paquetes/gold.html" class="btn btn-primary" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Castle Gold →</a>
          </div>

          <div class="card glass-panel" style="padding: 2.25rem;">
            <span class="badge badge-cyan" style="margin-bottom: 1rem;">EQUIPOS DE SOFTWARE &amp; ORGANIZACIONES</span>
            <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Gobernanza &amp; Rescate</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1.25rem;">
              Para directores técnicos y corporativos que requieren validar releases en CI/CD, intervenir código heredado o realizar Due Diligence.
            </p>
            <ul style="list-style: none; padding: 0; font-size: 0.85rem; color: var(--steel-light); display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1.5rem;">
              <li>→ <strong>Castle Checkup &amp; Audit:</strong> Diagnóstico de repositorios</li>
              <li>→ <strong>Castle Gate CLI:</strong> Motor determinista C1 a C6</li>
            </ul>
            <a href="castle-gate.html" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.82rem;">Conocer Castle Gate →</a>
          </div>

        </div>
      </div>
    </section>

    <!-- 06 — EVIDENCIA TECNOLÓGICA & DEMOSTRACIÓN INTERACTIVA (TERMINAL CLI) -->
    <section class="section section-dark" id="evidencia-tecnologica">
      <div class="container">
        <div class="two-col" style="align-items: center; gap: 3.5rem;">
          
          <div class="reveal">
            <div class="badge badge-cyan" style="margin-bottom: 1rem;">TECNOLOGÍA PROPIA DIFERENCIAL</div>
            <h2 style="font-size: 2.1rem; line-height: 1.2; margin-bottom: 1.25rem;">
              Gobernanza Determinista de Releases: Castle Gate
            </h2>
            <p style="font-size: 1rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.25rem;">
              A diferencia de agencias convencionales, Grupo Castillo desarrolló su propio motor de gobernanza de software. Castle Gate evalúa estáticamente 65 controles CQS v1.1 en memoria para garantizar que ningún release con secretos expuestos o fallas críticas llegue a producción.
            </p>
            
            <ul style="list-style: none; padding: 0; margin-bottom: 1.75rem; font-size: 0.9rem; color: var(--paper); display: flex; flex-direction: column; gap: 0.5rem;">
              <li>✔ <strong>100% Offline:</strong> Cero telemetría y cero dependencias externas.</li>
              <li>✔ <strong>Gate Breakers:</strong> Veto inmediato en CI/CD con Exit Code 1.</li>
              <li>✔ <strong>Release Certificate:</strong> Evidencia inmutable sellada con SHA-256.</li>
            </ul>

            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
              <a href="castle-gate.html" class="btn btn-primary">Especificación y Licenciamiento →</a>
              <a href="servicios/checkup.html" class="btn btn-outline">Solicitar Checkup Inicial</a>
            </div>
          </div>

          <!-- TERMINAL INTERACTIVA EN SU UBICACIÓN DE EVIDENCIA -->
          <div class="reveal">
            <CastleTerminalSimulator />
          </div>

        </div>
      </div>
    </section>

    <!-- 07 — PRINCIPIOS DE CONFIANZA, PRIVACIDAD Y PROPIEDAD -->
    <section class="section section-dim" id="confianza">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Principios de Confianza</p>
          <h2>Responsabilidad técnica y respeto a tus activos</h2>
          <p>Construimos relaciones profesionales fundamentadas en la transparencia y la certeza operativa.</p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem;">
          
          <div class="card glass-panel" style="padding: 2rem;">
            <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: var(--paper);">Propiedad Absoluta del Cliente</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              El código fuente, los repositorios y las cuentas de hosting se registran 100% a tu nombre. Cero dependencias forzosas ni retención de activos digitales.
            </p>
          </div>

          <div class="card glass-panel" style="padding: 2rem;">
            <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: var(--paper);">Privacidad y Tratamiento Responsable</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              La información proporcionada se trata conforme a acuerdos de confidencialidad estrictos. Solicitamos únicamente los accesos mínimos indispensables.
            </p>
          </div>

          <div class="card glass-panel" style="padding: 2rem;">
            <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: var(--paper);">Contratos y Alcance por Escrito</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              Cada paquete y servicio cuenta con entregables delimitados, número de revisiones por contrato y cotizaciones transparentes sin costos ocultos.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- 08 — PREGUNTAS FRECUENTES GENERALES -->
    <section class="section" id="faq">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Preguntas Frecuentes</p>
          <h2>Respuestas claras sobre Grupo Castillo</h2>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Por qué elegir a Grupo Castillo frente a una agencia convencional?" answer="Grupo Castillo combina desarrollo web accesible con rigor de ingeniería y tecnología propia de gobernanza (Castle Gate), garantizando que tu plataforma sea veloz, segura y de tu completa propiedad." />
              <FAQItem question="¿El código y las cuentas nos pertenecen?" answer="Sí, absolutamente. Todo el código fuente, repositorios, configuraciones de hosting y dominios quedan registrados 100% a tu nombre sin dependencias artificiales." />
              <FAQItem question="¿Qué es el diagnóstico Castle Checkup?" answer="Es un servicio ágil ($8,900 MXN) donde evaluamos tu repositorio con 65 controles CQS v1.1 en 72h hábiles para detectar fugas de credenciales, con 100% de crédito aplicado hacia tu contratación de Castle Gate." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Castle Gate transmite información fuera de nuestra infraestructura?" answer="No. Castle Gate es un motor 100% offline con cero dependencias externas y cero llamadas de red. Se ejecuta exclusivamente en la memoria local de tu equipo o en los runners de tu CI/CD privado." />
              <FAQItem question="¿Cómo solicitamos una propuesta formal?" answer="Completa el formulario de contacto con los detalles de tu proyecto o repositorio. Te respondemos con una propuesta técnica por escrito en menos de 24 horas hábiles." />
              <FAQItem question="¿Qué soporte continuo ofrecen después del lanzamiento?" answer="Mediante los planes mensuales Castle Care (desde $3,500 MXN/mes) ofrecemos monitoreo continuo, respaldos automáticos, parches de seguridad y horas de ingeniería de rescate (Rescue) incluidas." />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 09 — CTA BAND FINAL -->
    <CTABand
      title="Hablemos de tu proyecto o repositorio."
      description="Cuéntanos qué necesita tu negocio y coordinamos una evaluación técnica inicial en menos de 24 horas hábiles."
      ctaLabel="Iniciar Contacto"
      ctaHref="contacto.html"
    />

  </main>
</BaseLayout>
