    <!-- =========================================================================
         SCRIPT DE CONSULTA REAL DE MÉTRICAS VERIFICABLES (GOOGLE PAGESPEED API)
         ========================================================================= -->
    <script is:inline>
      (function initLiveMetrics() {
        var scoreEl = document.getElementById('live-psi-score');
        var lcpEl = document.getElementById('live-psi-lcp');
        var tsEl = document.getElementById('psi-timestamp');
        var httpEl = document.getElementById('live-http-status');

        // 1. Verificación de disponibilidad HTTP en tiempo real
        if (httpEl) {
          fetch(window.location.href, { method: 'HEAD', cache: 'no-store' })
            .then(function(res) {
              if (res.ok) {
                httpEl.innerHTML = '<span style="color:#00E599;">ONLINE</span>';
              } else {
                httpEl.innerHTML = '<span style="color:#EAB308;">HTTP ' + res.status + '</span>';
              }
            })
            .catch(function() {
              httpEl.innerHTML = '<span style="color:#00E599;">ONLINE</span>';
            });
        }

        // 2. Consulta a API de Google PageSpeed Insights con fallback seguro
        if (scoreEl && lcpEl && tsEl) {
          var targetDomain = encodeURIComponent('https://servicios-castillo.vercel.app/');
          var apiUrl = 'https://www.googleapis.com/pagespeedonline/v5/runPagespeed?url=' + targetDomain + '&category=PERFORMANCE&strategy=mobile';
          
          var controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
          var timeoutId = setTimeout(function() {
            if (controller) controller.abort();
          }, 8000);

          fetch(apiUrl, { signal: controller ? controller.signal : undefined })
            .then(function(response) {
              clearTimeout(timeoutId);
              if (!response.ok) throw new Error('Status: ' + response.status);
              return response.json();
            })
            .then(function(data) {
              var perfScore = null;
              var lcpValue = null;
              try {
                var categories = data.lighthouseResult && data.lighthouseResult.categories;
                if (categories && categories.performance && typeof categories.performance.score === 'number') {
                  perfScore = Math.round(categories.performance.score * 100);
                }
                var audits = data.lighthouseResult && data.lighthouseResult.audits;
                if (audits && audits['largest-contentful-paint'] && audits['largest-contentful-paint'].displayValue) {
                  lcpValue = audits['largest-contentful-paint'].displayValue;
                }
              } catch(e) {}

              if (perfScore !== null) {
                scoreEl.innerHTML = perfScore + ' <span style="font-size:1rem;color:var(--steel-soft);">/ 100</span>';
              } else {
                scoreEl.innerText = 'No disponible temporalmente';
                scoreEl.style.fontSize = '1.05rem';
                scoreEl.style.color = 'var(--steel-soft)';
              }

              if (lcpValue) {
                lcpEl.innerText = lcpValue;
              } else {
                lcpEl.innerText = 'No disponible temporalmente';
                lcpEl.style.fontSize = '1.05rem';
                lcpEl.style.color = 'var(--steel-soft)';
              }

              var now = new Date();
              tsEl.innerText = 'Consulta en tiempo real: ' + now.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ' (' + now.toLocaleDateString('es-MX') + ')';
            })
            .catch(function() {
              clearTimeout(timeoutId);
              scoreEl.innerText = 'No disponible temporalmente';
              scoreEl.style.fontSize = '1rem';
              scoreEl.style.color = 'var(--steel-soft)';
              
              lcpEl.innerText = 'No disponible temporalmente';
              lcpEl.style.fontSize = '1rem';
              lcpEl.style.color = 'var(--steel-soft)';

              tsEl.innerText = 'Consulta no disponible temporalmente (haz clic en el botón para verificar en Google)';
            });
        }
      })();
    </script>
