---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQItem from '../components/FAQItem.astro';
import CTABand from '../components/CTABand.astro';
import CastleTerminalSimulator from '../components/CastleTerminalSimulator.astro';
import HeroEngineVisual from '../components/HeroEngineVisual.astro';
import CastleGateBadge from '../components/CastleGateBadge.astro';
---

<BaseLayout
  title="Grupo Castillo — Firma de Ingeniería Digital, Software a la Medida y Gobernanza"
  description="Grupo Castillo: Ingeniería digital para empresas. Desarrollo web de alto rendimiento, software a la medida, automatizaciones y tecnología propia de gobernanza determinista. Tu sitio, tu código, tus cuentas, siempre."
  canonical="https://servicios-castillo.vercel.app/index.html"
  ogUrl="https://servicios-castillo.vercel.app/index.html"
>
  <main id="main">

    <!-- =========================================================================
         01 — HERO (BENEFICIO COMERCIAL PRIMERO + SOBERANÍA TECNOLÓGICA)
         ========================================================================= -->
    <section class="hero" style="position: relative; overflow: hidden; padding-top: 6rem; padding-bottom: 5rem; background: #06080C;">
      <HeroEngineVisual />
      <div class="container hero-content-container" style="position: relative; z-index: 4; max-width: 960px; margin: 0 auto; text-align: center;">
        
        <p class="eyebrow" style="margin-bottom: 1.25rem; justify-content: center; color: var(--cyan);">
          FIRMA DE INGENIERÍA DIGITAL &amp; SOBERANÍA TECNOLÓGICA
        </p>

        <h1 style="font-size: clamp(2.2rem, 4vw, 3.5rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.025em; margin-bottom: 1.35rem; color: var(--paper);">
          Ingeniería digital para empresas.<br>
          <span style="color: var(--cyan);">Web, software, infraestructura y seguridad</span> construidos para ser tuyos.
        </h1>

        <p class="lede" style="font-size: 1.15rem; color: var(--steel-light); line-height: 1.7; margin-bottom: 2.25rem; max-width: 74ch; margin-left: auto; margin-right: auto;">
          <strong style="color: var(--paper);">Tu sitio. Tu código. Tus cuentas. Siempre.</strong> Desarrollamos plataformas web de alto rendimiento, sistemas a la medida y automatizaciones operativas con validación técnica determinista y 100% de titularidad jurídica.
        </p>

        <!-- CTAS PRINCIPALES Y VISIBLES -->
        <div class="hero-actions" style="display: flex; gap: 1rem; justify-content: center; align-items: center; flex-wrap: wrap; margin-bottom: 2.75rem;">
          <a class="btn btn-primary" href="/contacto.html" style="padding: 0.85rem 1.75rem; font-size: 0.95rem;">
            Iniciar Proyecto →
          </a>
          <a class="btn btn-outline" href="https://wa.me/525512345678?text=Hola%20Grupo%20Castillo%2C%20me%20gustar%C3%ADa%20cotizar%20un%20proyecto%20de%20ingenier%C3%ADa" target="_blank" rel="noopener" style="border-color: #25D366; color: #25D366; padding: 0.85rem 1.5rem; font-size: 0.92rem; display: inline-flex; align-items: center; gap: 0.5rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"></path></svg>
            WhatsApp Directo
          </a>
          <a class="btn btn-outline" href="/diagnostico.html" style="padding: 0.85rem 1.5rem; font-size: 0.92rem;">
            Diagnóstico Guiado en 2 Min
          </a>
        </div>

        <!-- PILLS DE CERTEZA TÉCNICA -->
        <div class="hero-metrics" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; padding-top: 1.75rem; border-top: 1px solid rgba(255, 255, 255, 0.08); max-width: 780px; margin: 0 auto;">
          <div>
            <strong style="display: block; font-size: 1.25rem; font-family: var(--f-mono); color: var(--paper);">100% Titularidad</strong>
            <span style="font-size: 0.74rem; color: var(--steel-soft); text-transform: uppercase; letter-spacing: 0.05em;">Código &amp; Cuentas Propias</span>
          </div>
          <div>
            <strong style="display: block; font-size: 1.25rem; font-family: var(--f-mono); color: var(--cyan);">Web &amp; Software</strong>
            <span style="font-size: 0.74rem; color: var(--steel-soft); text-transform: uppercase; letter-spacing: 0.05em;">Desarrollo a la Medida</span>
          </div>
          <div>
            <strong style="display: block; font-size: 1.25rem; font-family: var(--f-mono); color: var(--paper);">Castle Gate</strong>
            <span style="font-size: 0.74rem; color: var(--steel-soft); text-transform: uppercase; letter-spacing: 0.05em;">Gobernanza CQS v1.1</span>
          </div>
        </div>

      </div>
    </section>

    <!-- =========================================================================
         02 — QUÉ CONSTRUIMOS (CAPACIDADES REALES DE LA FIRMA)
         ========================================================================= -->
    <section class="section section-dim" id="que-construimos" style="padding-top: 4.5rem; padding-bottom: 4.5rem;">
      <div class="container">
        
        <div class="section-head reveal" style="text-align: center; max-width: 820px; margin: 0 auto 3rem auto;">
          <p class="eyebrow" style="color: var(--cyan); justify-content: center;">Capacidades Integrales de Ingeniería</p>
          <h2 style="font-size: 2.2rem; color: var(--paper);">Qué construimos para tu empresa</h2>
          <p style="color: var(--steel-light); font-size: 1rem; line-height: 1.65;">
            Grupo Castillo no es únicamente un estudio de páginas web. Diseñamos, construimos, auditamos y mantenemos activos digitales completos para resolver problemas operativos reales.
          </p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem; margin-bottom: 2rem;">
          
          <!-- 1. DESARROLLO WEB -->
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid var(--cyan);">
            <div style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--cyan); font-weight: 700; margin-bottom: 0.5rem;">01 • WEB DE ALTO RENDIMIENTO</div>
            <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem; color: var(--paper);">Desarrollo Web Comercial</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1.25rem;">
              Plataformas web corporativas, landing pages de alta conversión, blogs autogestionables y sitios e-commerce construidos con arquitectura estática ultrarrápida (SSG) sin plantillas sobrecargadas.
            </p>
            <ul style="list-style: none; padding: 0; margin: 0 0 1.25rem 0; font-size: 0.82rem; color: var(--steel-soft); line-height: 1.6;">
              <li>• Sitios corporativos multi-sección</li>
              <li>• Landing pages orientadas a WhatsApp / Leads</li>
              <li>• Catálogos y tiendas con pagos tokenizados</li>
              <li>• Optimización extrema de Core Web Vitals</li>
            </ul>
            <a href="/paquetes.html" style="font-size: 0.82rem; color: var(--cyan); text-decoration: none; font-weight: 600; margin-top: auto;">Ver Paquetes Web (Iron a Platinum) →</a>
          </div>

          <!-- 2. SOFTWARE A LA MEDIDA -->
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid var(--cyan); border-color: rgba(0, 210, 255, 0.35);">
            <div style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--cyan); font-weight: 700; margin-bottom: 0.5rem;">02 • SOFTWARE A LA MEDIDA</div>
            <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem; color: var(--paper);">Sistemas &amp; Aplicaciones Web</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1.25rem;">
              Desarrollo de software empresarial para digitalizar la operación de tu negocio: portales privados, plataformas SaaS, automatización de flujos y módulos adaptados a tus reglas operativas.
            </p>
            <ul style="list-style: none; padding: 0; margin: 0 0 1.25rem 0; font-size: 0.82rem; color: var(--steel-soft); line-height: 1.6;">
              <li>• CRM, ERP y control de inventarios a medida</li>
              <li>• Portales de clientes y proveedores con roles (RBAC)</li>
              <li>• Dashboards analíticos y reportería en tiempo real</li>
              <li>• Desarrollo de APIs REST y servicios backend</li>
            </ul>
            <a href="/paquetes/diamond.html" style="font-size: 0.82rem; color: var(--cyan); text-decoration: none; font-weight: 600; margin-top: auto;">Ver Castle Diamond / Software a Medida →</a>
          </div>

          <!-- 3. AUTOMATIZACIÓN OPERATIVA -->
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid var(--cyan);">
            <div style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--cyan); font-weight: 700; margin-bottom: 0.5rem;">03 • AUTOMATIZACIÓN</div>
            <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem; color: var(--paper);">Automatización &amp; Flujos</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1.25rem;">
              Conexión de herramientas para eliminar tareas manuales repetitivas y acelerar la atención a prospectos sin contratar plataformas mensuales costosas.
            </p>
            <ul style="list-style: none; padding: 0; margin: 0 0 1.25rem 0; font-size: 0.82rem; color: var(--steel-soft); line-height: 1.6;">
              <li>• Formularios inteligentes con validación y triage</li>
              <li>• Integración con WhatsApp Cloud API y notificaciones</li>
              <li>• Webhooks para sincronización de bases de datos</li>
              <li>• Flujos de cotización y cobranza automática</li>
            </ul>
            <a href="/servicios.html" style="font-size: 0.82rem; color: var(--cyan); text-decoration: none; font-weight: 600; margin-top: auto;">Ver Servicios de Integración →</a>
          </div>

          <!-- 4. SEGURIDAD Y GOBERNANZA -->
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid var(--cyan);">
            <div style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--cyan); font-weight: 700; margin-bottom: 0.5rem;">04 • SEGURIDAD &amp; CALIDAD</div>
            <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem; color: var(--paper);">Seguridad, Auditoría &amp; Rescate</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1.25rem;">
              Auditoría estática de repositorios, saneamiento de secretos expuestos en Git, intervención directa en código (Rescue) y protocolo de veto en CI/CD con Castle Gate.
            </p>
            <ul style="list-style: none; padding: 0; margin: 0 0 1.25rem 0; font-size: 0.82rem; color: var(--steel-soft); line-height: 1.6;">
              <li>• Diagnóstico estático en 72h (Castle Checkup)</li>
              <li>• Due Diligence y auditoría profunda (Castle Audit)</li>
              <li>• Intervención y parches en código (Castle Rescue)</li>
              <li>• Motor de veto determinista en memoria (Castle Gate)</li>
            </ul>
            <a href="/servicios/checkup.html" style="font-size: 0.82rem; color: var(--cyan); text-decoration: none; font-weight: 600; margin-top: auto;">Ver Diagnósticos y Rescate →</a>
          </div>

          <!-- 5. CONSULTORÍA DIGITAL -->
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid var(--cyan); grid-column: span 2;">
            <div style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--cyan); font-weight: 700; margin-bottom: 0.5rem;">05 • CONSULTORÍA ESTRATÉGICA</div>
            <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem; color: var(--paper);">Consultoría Digital &amp; Roadmap Tecnológico</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1.25rem;">
              Acompañamos a directores generales y CTOs a definir la arquitectura correcta antes de gastar presupuesto. Evaluamos si conviene refactorizar un sistema heredado o construir desde cero, estructurando una hoja de ruta técnica realista.
            </p>
            <div style="display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: center;">
              <span style="font-size: 0.82rem; color: var(--steel-light);"><strong style="color: var(--paper);">Modalidad:</strong> Sesiones ejecutivas con el Ingeniero Líder</span>
              <span style="font-size: 0.82rem; color: var(--steel-light);"><strong style="color: var(--paper);">Cotización:</strong> Sujeto a alcance técnico</span>
              <a href="/servicios.html#consultoria-digital" class="btn btn-outline" style="padding: 0.4rem 1rem; font-size: 0.8rem; margin-left: auto;">Conocer Consultoría →</a>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- =========================================================================
         03 — CATÁLOGO COMERCIAL & SERVICIOS DE INGENIERÍA
         ========================================================================= -->
    <section class="section" id="paquetes-catalogo" style="padding-top: 4.5rem; padding-bottom: 4.5rem;">
      <div class="container">
        
        <div class="section-head reveal" style="text-align: center; max-width: 820px; margin: 0 auto 3rem auto;">
          <p class="eyebrow" style="color: var(--cyan); justify-content: center;">Catálogo Oficial de Desarrollo</p>
          <h2 style="font-size: 2.2rem; color: var(--paper);">Precios públicos, plazos objetivo y alcance formal</h2>
          <p style="color: var(--steel-light); font-size: 1rem; line-height: 1.65;">
            Sin cotizaciones opacas ni sorpresas de alcance. Cada paquete incluye Declaración de Trabajo (SOW), validación en Castle Gate y 100% de titularidad jurídica.
          </p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem; margin-bottom: 3rem;">
          
          <!-- IRON -->
          <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid #71717A;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.25rem;">
              <h3 style="font-size: 1.2rem; margin: 0; color: var(--paper);">Castle Iron</h3>
              <span style="font-family: var(--f-mono); font-size: 1.15rem; font-weight: 700; color: var(--paper);">$2,800 MXN</span>
            </div>
            <span style="font-family: var(--f-mono); font-size: 0.76rem; color: var(--cyan); display: block; margin-bottom: 0.75rem;">Plazo objetivo: 3–5 días hábiles</span>
            <p style="font-size: 0.84rem; color: var(--steel-light); line-height: 1.55; margin-bottom: 1rem;">
              Presencia One-Page directa con enlace directo a WhatsApp para profesionistas y micronegocios.
            </p>
            <div style="font-size: 0.78rem; color: var(--steel-soft); margin-bottom: 1.25rem; padding-top: 0.5rem; border-top: 1px dashed var(--line-dark);">
              <strong>Add-on recomendado:</strong> Configuración de SEO Local &amp; Google Business Profile.
            </div>
            <a href="/paquetes/iron.html" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.8rem; margin-top: auto;">Ver Ficha Técnica Iron →</a>
          </div>

          <!-- BRONZE -->
          <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid #CD7F32;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.25rem;">
              <h3 style="font-size: 1.2rem; margin: 0; color: var(--paper);">Castle Bronze</h3>
              <span style="font-family: var(--f-mono); font-size: 1.15rem; font-weight: 700; color: var(--paper);">$4,500 MXN</span>
            </div>
            <span style="font-family: var(--f-mono); font-size: 0.76rem; color: var(--cyan); display: block; margin-bottom: 0.75rem;">Plazo objetivo: 5–7 días hábiles</span>
            <p style="font-size: 0.84rem; color: var(--steel-light); line-height: 1.55; margin-bottom: 1rem;">
              Landing comercial de hasta 5 secciones estructuradas con formulario de captación para campañas.
            </p>
            <div style="font-size: 0.78rem; color: var(--steel-soft); margin-bottom: 1.25rem; padding-top: 0.5rem; border-top: 1px dashed var(--line-dark);">
              <strong>Add-on recomendado:</strong> Configuración de SEO Local &amp; Analítica de conversión.
            </div>
            <a href="/paquetes/bronze.html" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.8rem; margin-top: auto;">Ver Ficha Técnica Bronze →</a>
          </div>

          <!-- SILVER -->
          <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid #94A3B8;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.25rem;">
              <h3 style="font-size: 1.2rem; margin: 0; color: var(--paper);">Castle Silver</h3>
              <span style="font-family: var(--f-mono); font-size: 1.15rem; font-weight: 700; color: var(--paper);">$7,500 MXN</span>
            </div>
            <span style="font-family: var(--f-mono); font-size: 0.76rem; color: var(--cyan); display: block; margin-bottom: 0.75rem;">Plazo objetivo: 7–10 días hábiles</span>
            <p style="font-size: 0.84rem; color: var(--steel-light); line-height: 1.55; margin-bottom: 1rem;">
              Sitio web corporativo multi-página (hasta 5 vistas) para empresas con catálogo de servicios formal.
            </p>
            <div style="font-size: 0.78rem; color: var(--steel-soft); margin-bottom: 1.25rem; padding-top: 0.5rem; border-top: 1px dashed var(--line-dark);">
              <strong>Add-on recomendado:</strong> Panel CMS Ligero de autoedición de contenidos.
            </div>
            <a href="/paquetes/silver.html" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.8rem; margin-top: auto;">Ver Ficha Técnica Silver →</a>
          </div>

          <!-- GOLD (MÁS ELEGIDO) -->
          <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid #FFD700; border-color: rgba(0, 210, 255, 0.4); background: linear-gradient(180deg, rgba(0, 210, 255, 0.05) 0%, var(--glass-surface) 100%);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
              <span class="badge badge-cyan" style="font-size: 0.65rem; padding: 2px 7px;">MÁS ELEGIDO</span>
              <span style="font-family: var(--f-mono); font-size: 1.15rem; font-weight: 700; color: var(--paper);">$12,500 MXN</span>
            </div>
            <h3 style="font-size: 1.2rem; margin: 0.2rem 0; color: var(--paper);">Castle Gold</h3>
            <span style="font-family: var(--f-mono); font-size: 0.76rem; color: var(--cyan); display: block; margin-bottom: 0.75rem;">Plazo objetivo: 10–14 días hábiles</span>
            <p style="font-size: 0.84rem; color: var(--steel-light); line-height: 1.55; margin-bottom: 0.75rem;">
              8–10 páginas con Blog / CMS autogestionable y arquitectura SEO avanzada para posicionamiento orgánico.
            </p>
            <div style="padding: 0.65rem; background: rgba(0, 210, 255, 0.05); border-radius: var(--radius-sm); font-size: 0.75rem; color: var(--steel-light); margin-bottom: 1.25rem; line-height: 1.4;">
              ℹ <em>Nota de alcance:</em> Insumos provistos por el cliente. Redacción completa desde cero disponible como servicio adicional.
            </div>
            <a href="/paquetes/gold.html" class="btn btn-primary" style="width: 100%; text-align: center; font-size: 0.8rem; margin-top: auto;">Ver Ficha Técnica Gold →</a>
          </div>

          <!-- PLATINUM -->
          <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid #E0E7FF;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.25rem;">
              <h3 style="font-size: 1.2rem; margin: 0; color: var(--paper);">Castle Platinum</h3>
              <span style="font-family: var(--f-mono); font-size: 1.15rem; font-weight: 700; color: var(--paper);">$24,500 MXN</span>
            </div>
            <span style="font-family: var(--f-mono); font-size: 0.76rem; color: var(--cyan); display: block; margin-bottom: 0.75rem;">Plazo objetivo: 15–20 días hábiles</span>
            <p style="font-size: 0.84rem; color: var(--steel-light); line-height: 1.55; margin-bottom: 0.75rem;">
              Hasta 15 páginas con pasarelas de pago (Stripe / Mercado Pago), conexión a CRM y seguridad reforzada.
            </p>
            <div style="padding: 0.65rem; background: rgba(0, 210, 255, 0.05); border-radius: var(--radius-sm); font-size: 0.75rem; color: var(--steel-light); margin-bottom: 1.25rem; line-height: 1.4;">
              ℹ <em>Nota de alcance:</em> Insumos provistos por el cliente. Redacción completa desde cero disponible como servicio adicional.
            </div>
            <a href="/paquetes/platinum.html" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.8rem; margin-top: auto;">Ver Ficha Técnica Platinum →</a>
          </div>

          <!-- DIAMOND / SOFTWARE A MEDIDA -->
          <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid #00D2FF; border-color: rgba(0, 210, 255, 0.35); background: linear-gradient(180deg, rgba(0, 210, 255, 0.04) 0%, var(--glass-surface) 100%);">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.25rem;">
              <h3 style="font-size: 1.2rem; margin: 0; color: var(--paper);">Castle Diamond</h3>
              <span style="font-family: var(--f-mono); font-size: 1.15rem; font-weight: 700; color: var(--cyan);">Desde $40,000 MXN</span>
            </div>
            <span style="font-family: var(--f-mono); font-size: 0.76rem; color: var(--steel-soft); display: block; margin-bottom: 0.75rem;">Software a la Medida • Por Sprints</span>
            <p style="font-size: 0.84rem; color: var(--steel-light); line-height: 1.55; margin-bottom: 1rem;">
              Ingeniería de Software a Medida: ERP, CRM, portales RBAC, bases de datos complejas e integraciones personalizadas.
            </p>
            <div style="font-size: 0.78rem; color: var(--steel-soft); margin-bottom: 1.25rem; padding-top: 0.5rem; border-top: 1px dashed var(--line-dark);">
              <strong>Metodología:</strong> Arquitectura modular, sprints de entrega y validación continua en Gate.
            </div>
            <a href="/paquetes/diamond.html" class="btn btn-primary" style="width: 100%; text-align: center; font-size: 0.8rem; margin-top: auto;">Ver Software a Medida →</a>
          </div>

        </div>

        <!-- NOTA DE TRANSPARENCIA SOBRE PLAZOS -->
        <p class="currency-disclaimer" style="text-align: center; max-width: 720px; margin: 0 auto 3rem auto; font-size: 0.8rem; color: var(--steel-soft);">
          * Los plazos indicados son tiempos objetivo de ingeniería calculados a partir de la recepción de insumos completos. No constituyen garantía estricta de entrega. Precios expresados en pesos mexicanos (MXN).
        </p>

        <!-- LÍNEAS DE SERVICIOS DE INGENIERÍA COMPLEMENTARIOS -->
