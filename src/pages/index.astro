---
import BaseLayout from '../layouts/BaseLayout.astro';
import GateSchematic from '../components/GateSchematic.astro';
import FAQItem from '../components/FAQItem.astro';
import CTABand from '../components/CTABand.astro';
import CastleGateVisual from '../components/CastleGateVisual.astro';
---

<BaseLayout
  title="Servicios Castillo — Desarrollo e Ingeniería Web a Precios Accesibles"
  description="Construimos, optimizamos y protegemos sitios web veloces, accesibles y seguros. Calidad de ingeniería digital con precios claros para PYMEs y negocios."
  canonical="https://servicios-castillo.vercel.app/index.html"
  ogUrl="https://servicios-castillo.vercel.app/index.html"
>
  <main id="main">

    <section class="hero">
      <CastleGateVisual />
      <div class="container hero-container-grid">
        <div class="hero-text-block">
          <p class="eyebrow">Ingeniería Digital · Desarrollo Web</p>
          <h1>Desarrollo e Ingeniería Web con Estándar Profesional.</h1>
          <p class="lede">Construimos, auditamos y protegemos plataformas digitales sólidas, verificables y mantenibles. Sin sobreingeniería, sin costos ocultos, bajo un protocolo de validación documentado.</p>
          <div class="hero-actions">
            <a class="btn btn-gold" href="contacto.html">Cotizar mi Proyecto</a>
            <a class="btn btn-outline" href="contacto.html?necesidad=auditar">Analizar mi Sitio Actual</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Líneas de Trabajo</p>
          <h2>Soluciones adaptadas a la etapa actual de tu negocio.</h2>
          <p>Ya sea que necesites lanzar una web desde cero, diagnosticar fallas o reconstruir tu plataforma, tenemos un esquema claro de trabajo.</p>
        </div>
        <div class="reveal">
        <div class="solutions-strip">
          <a href="soluciones.html#build">
            <span class="s-code">BUILD</span>
            <span class="s-name">Build</span>
            <span class="s-desc">Creamos sitios y soluciones desde cero.</span>
          </a><a href="auditoria.html">
            <span class="s-code">AUDIT</span>
            <span class="s-name">Audit</span>
            <span class="s-desc">Analizamos la velocidad y seguridad de tu web.</span>
          </a><a href="intervencion.html">
            <span class="s-code">INTV</span>
            <span class="s-name">Intervention</span>
            <span class="s-desc">Corregimos errores, lentitud y fallas móviles.</span>
          </a><a href="transformacion.html">
            <span class="s-code">TRNS</span>
            <span class="s-name">Transformation</span>
            <span class="s-desc">Reconstruimos y migramos plataformas obsoletas.</span>
          </a><a href="cuidado.html">
            <span class="s-code">CARE</span>
            <span class="s-name">Care</span>
            <span class="s-desc">Mantenimiento, respaldos y soporte continuo.</span>
          </a>
        </div></div>
      </div>
    </section>

    <section class="section section-dim">
      <div class="container two-col">
        <div class="reveal">
          <p class="eyebrow">¿Tu web actual no genera los resultados esperados?</p>
          <h2>No necesariamente tienes que rehacer todo desde cero.</h2>
          <p>Si tu sitio carga lento, se desacomoda en celulares, pierde contactos o tiene errores técnicos, podemos intervenirlo y optimizarlo directamente sin desperdiciar tu inversión previa.</p>
          <a class="btn btn-line" href="contacto.html?necesidad=auditar">Diagnosticar mi Web Actual</a>
        </div>
        <div class="grid" style="gap:1rem;">
          <div class="card card-light reveal">
            <span class="card-num">01 — CASTLE AUDIT</span>
            <h3>Identificamos los puntos de fuga.</h3>
            <p>Diagnóstico de velocidad, accesibilidad, seguridad y SEO para ubicar exactamente qué está fallando.</p>
          </div>
          <div class="card card-light reveal">
            <span class="card-num">02 — CASTLE INTERVENTION</span>
            <h3>Reparamos lo que está roto.</h3>
            <p>Corregimos código, aceleramos la carga y ajustamos el diseño móvil sin rehacer lo que ya funciona.</p>
          </div>
          <div class="card card-light reveal">
            <span class="card-num">03 — CASTLE TRANSFORMATION</span>
            <h3>Migramos si la base es obsoleta.</h3>
            <p>Cuando la tecnología actual ya no permite crecer: rediseño UX/UI y migración conservando tu posicionamiento SEO.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Castillo Security &amp; Quality Gate</p>
          <h2>No construimos para entregar. Construimos para validar.</h2>
          <p>Cada proyecto recorre un proceso de 9 etapas de control de calidad. Si una solución no supera las verificaciones de rendimiento, seguridad y accesibilidad, no se publica.</p>
        </div>
        <div class="reveal">
          <GateSchematic />
        </div>
        <p style="margin-top:2rem;"><a class="btn btn-outline" href="seguridad-calidad.html">Conocer el Proceso Gate a Detalle</a></p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Castle Packages</p>
          <h2>Precios transparentes y alcance claro desde el primer día.</h2>
          <p>Paquetes competitivos diseñados para ofrecer máximo valor de ingeniería sin sobrecostos de agencia tradicional.</p>
        </div>
        <div class="packages-grid reveal">
          
          <div class="package-card" data-tier="bronze">
            <span class="tier-swatch" aria-hidden="true"></span>
            <h3>Castle Bronze</h3>
            <div class="package-price">$4,500 MXN</div>
            <ul>
              <li>Landing page personalizada</li><li>Hasta 5 secciones de contenido</li><li>Diseño 100% responsivo</li><li>WhatsApp y formulario integrado</li><li>SEO técnico fundamental</li><li>Optimización de imágenes</li><li>Conexión HTTPS segura</li><li>Accesibilidad base (WCAG)</li><li>Integración de analítica</li><li>Castillo Quality Gate incluido</li>
            </ul>
            <div class="package-rounds">2 rondas de revisión</div>
            <a class="btn btn-line" href="contacto.html?paquete=Castle%20Bronze">Solicitar Bronze</a>
          </div>
          <div class="package-card" data-tier="silver">
            <span class="tier-swatch" aria-hidden="true"></span>
            <h3>Castle Silver</h3>
            <div class="package-price">$7,500 MXN</div>
            <ul>
              <li>Sitio de hasta 5 páginas</li><li>Diseño visual a medida</li><li>Arquitectura de contenidos</li><li>Formularios de contacto avanzables</li><li>WhatsApp directo e integrado</li><li>SEO técnico por página</li><li>Optimización de velocidad</li><li>Revisión de accesibilidad</li><li>Verificación de seguridad base</li><li>Castillo Quality Gate incluido</li>
            </ul>
            <div class="package-rounds">3 rondas de revisión</div>
            <a class="btn btn-line" href="contacto.html?paquete=Castle%20Silver">Solicitar Silver</a>
          </div>
          <div class="package-card" data-tier="gold">
            <span class="package-tag">Más Popular</span>
            <span class="tier-swatch" aria-hidden="true"></span>
            <h3>Castle Gold</h3>
            <div class="package-price">$12,500 MXN</div>
            <ul>
              <li>Sitio de 8 a 10 páginas</li><li>Diseño UX/UI enfocado en conversión</li><li>SEO técnico avanzado</li><li>Formularios y flujos personalizados</li><li>CMS / Blog autogestionable</li><li>Optimización Core Web Vitals</li><li>Accesibilidad WCAG 2.2 AA</li><li>Pruebas multiplataforma</li><li>Certificado de entrega y código fuente</li><li>Castillo Quality Gate completo</li>
            </ul>
            <div class="package-rounds">4 rondas de revisión</div>
            <a class="btn btn-line" href="contacto.html?paquete=Castle%20Gold">Solicitar Castle Gold</a>
          </div>
          <div class="package-card" data-tier="platinum">
            <span class="tier-swatch" aria-hidden="true"></span>
            <h3>Castle Platinum</h3>
            <div class="package-price">$24,500 MXN</div>
            <ul>
              <li>Arquitectura de hasta 15 páginas</li><li>Diseño avanzado y personalizado</li><li>Gestor CMS con flujos a medida</li><li>Integraciones externas con APIs</li><li>SEO y rendimiento de alta especificación</li><li>Seguridad y hardening reforzado</li><li>Pruebas de carga y compatibilidad</li><li>Auditoría previa al lanzamiento</li><li>Castillo Quality Gate completo</li>
            </ul>
            <div class="package-rounds">5 rondas de revisión</div>
            <a class="btn btn-line" href="contacto.html?paquete=Castle%20Platinum">Solicitar Platinum</a>
          </div>
          <div class="package-card" data-tier="diamond">
            <span class="tier-swatch" aria-hidden="true"></span>
            <h3>Castle Diamond</h3>
            <div class="package-price">Desde $40,000 MXN</div>
            <ul>
              <li>Desarrollo de software web a medida</li><li>Sin límites artificiales de páginas</li><li>E-commerce, portales y aplicaciones</li><li>Paneles de administración y APIs</li><li>Autenticación y bases de datos</li><li>Integración de sistemas y automatización</li><li>Arquitectura de alta disponibilidad</li><li>Cotización precisa según requerimientos</li>
            </ul>
            <div class="package-rounds">Rondas según alcance</div>
            <a class="btn btn-line" href="contacto.html?paquete=Castle%20Diamond">Solicitar propuesta personalizada</a>
          </div>
        </div>
        <p style="margin-top:2rem;"><a class="btn btn-line" href="paquetes.html">Comparar todos los detalles de Castle Packages</a></p>
      </div>
    </section>

    <section class="section section-dim">
      <div class="container two-col">
        <div class="reveal">
          <p class="eyebrow">Transparencia &amp; Autonomía</p>
          <h2>Construimos para que tu negocio crezca, no para amarrarte a nosotros.</h2>
          <p>Definimos el alcance por escrito antes de empezar. Las cuentas de hosting, dominio e infraestructura te pertenecen por completo. Te entregamos el código fuente limpio para que tengas independencia total.</p>
        </div>
        <ul class="check-list reveal">
          <li>Precios finales sin letras chiquitas ni cargos sorpresa.</li>
          <li>Alcance por escrito antes de dar el primer paso.</li>
          <li>Documentación técnica y código fuente entregado.</li>
          <li>Inteligencia Artificial como herramienta de análisis, siempre bajo validación y supervisión de ingenieros humanos.</li>
        </ul>
      </div>
    </section>

    <section class="section" id="faq">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Preguntas Frecuentes</p>
          <h2>Todo claro antes de iniciar.</h2>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Cuánto cuesta un sitio web con Servicios Castillo?" answer="Nuestros paquetes van desde $4,500 MXN para una landing page optimizada (Castle Bronze), hasta $12,500 MXN para plataformas corporativas completas (Castle Gold). Para sistemas a medida, cotizamos desde $40,000 MXN." />
              <FAQItem question="¿Qué es el Castillo Security & Quality Gate?" answer="Es nuestro protocolo interno de 9 etapas (Discover, Design, Build, Test, Audit, Gate, Launch, Verify, Evolve). Evaluamos objetivamente velocidad, accesibilidad, seguridad y SEO antes de publicar." />
              <FAQItem question="¿El sitio web y el código me pertenecen?" answer="Sí, totalmente. El código fuente se entrega y las cuentas de hosting y dominio quedan a tu nombre. No creamos dependencias artificiales." />
              <FAQItem question="¿Utilizan inteligencia artificial en sus desarrollos?" answer="Utilizamos IA como acelerador de análisis, optimización y detección de patrones de error. La arquitectura, diseño y validación de seguridad son ejecutadas y supervisadas por ingenieros." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="Si ya tengo un sitio web roto o lento, ¿pueden arreglarlo?" answer="Sí. No siempre es necesario empezar de cero. Con Castle Intervention o Castle Audit analizamos tu web actual, corregimos los errores de carga o visuales y optimizamos tu código existente." />
              <FAQItem question="¿Cuántas revisiones se incluyen durante el desarrollo?" answer="Van desde 2 rondas de revisión en Castle Bronze hasta 5 en Castle Platinum. En cada ronda ajustamos el diseño y contenido según tus observaciones." />
              <FAQItem question="¿Ofrecen mantenimiento técnico post-lanzamiento?" answer="Sí, mediante los planes Castle Care ofrecemos monitoreo de disponibilidad 24/7, respaldos automatizados, parches de seguridad y actualización de contenidos." />
              <FAQItem question="¿Cómo solicitó un diagnóstico o cotización?" answer="Solo llena el formulario de contacto con los detalles de tu proyecto. Te enviamos una propuesta técnica y económica clara en menos de 24 horas hábiles." />
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTABand
      title="Hablemos de tu proyecto digital."
      description="Cuéntanos qué necesita tu negocio y te ayudamos a elegir la opción técnica y económica más conveniente."
      ctaLabel="Solicitar Cotización"
      ctaHref="contacto.html"
    />

  </main>
</BaseLayout>
