---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQItem from '../components/FAQItem.astro';
import CTABand from '../components/CTABand.astro';
import CastleTerminalSimulator from '../components/CastleTerminalSimulator.astro';
import HeroEngineVisual from '../components/HeroEngineVisual.astro';
import CastleGateBadge from '../components/CastleGateBadge.astro';
---

<BaseLayout
  title="Grupo Castillo — Firma de Ingeniería de Software y Gobernanza Tecnológica"
  description="Grupo Castillo construye plataformas web de alto rendimiento, interviene código heredado y aplica tecnología propia de gobernanza determinista para releases seguros."
  canonical="https://servicios-castillo.vercel.app/index.html"
  ogUrl="https://servicios-castillo.vercel.app/index.html"
>
  <main id="main">

    <!-- 01 — HERO & IDENTIDAD CORPORATIVA -->
    <section class="hero" style="position: relative; overflow: hidden; padding-top: 6.5rem; padding-bottom: 5.5rem; background: #06080C;">
      <HeroEngineVisual />
      <div class="container hero-content-container" style="position: relative; z-index: 4; max-width: 960px; margin: 0 auto; text-align: center;">
        <p class="eyebrow" style="margin-bottom: 1.5rem; justify-content: center;">
          FIRMA DE INGENIERÍA DIGITAL &amp; GOBERNANZA TÉCNICA
        </p>
        <h1 style="font-size: clamp(2.1rem, 3.8vw, 3.4rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.025em; margin-bottom: 1.5rem;">
          Tu sitio, tu código, tus cuentas — <span style="color: var(--cyan);">siempre.</span> Desarrollo web y gobernanza técnica sin las prácticas que te han hecho desconfiar de otras agencias.
        </h1>
        <p class="lede" style="font-size: 1.15rem; color: var(--steel-light); line-height: 1.7; margin-bottom: 2.25rem; max-width: 72ch; margin-left: auto; margin-right: auto;">
          Desarrollo web de alto rendimiento con titularidad absoluta del código para el cliente, intervención técnica en sistemas existentes y tecnología propia para la gobernanza de releases.
        </p>
        <div class="hero-actions" style="display: flex; gap: 1.25rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3rem;">
          <a class="btn btn-primary" href="/paquetes.html">Explorar Paquetes Web</a>
          <a class="btn btn-outline" href="/diagnostico.html">Iniciar Diagnóstico Guiado</a>
        </div>

        <div class="hero-metrics" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; padding-top: 2rem; border-top: 1px solid rgba(255, 255, 255, 0.08); max-width: 760px; margin: 0 auto;">
          <div>
            <strong style="display: block; font-size: 1.35rem; font-family: var(--f-mono); color: var(--paper);">100% Titularidad</strong>
            <span style="font-size: 0.75rem; color: var(--steel-soft); text-transform: uppercase; letter-spacing: 0.05em;">Código &amp; Cuentas Propias</span>
          </div>
          <div>
            <strong style="display: block; font-size: 1.35rem; font-family: var(--f-mono); color: var(--paper);">72h Objetivo</strong>
            <span style="font-size: 0.75rem; color: var(--steel-soft); text-transform: uppercase; letter-spacing: 0.05em;">Diagnóstico Checkup</span>
          </div>
          <div>
            <strong style="display: block; font-size: 1.35rem; font-family: var(--f-mono); color: var(--paper);">CQS v1.1</strong>
            <span style="font-size: 0.75rem; color: var(--steel-soft); text-transform: uppercase; letter-spacing: 0.05em;">Castle Gate Runner</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 — QUÉ HACEMOS (4 PILARES DE CAPACIDAD TÉCNICA) -->
    <section class="section section-dim" id="que-hacemos">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Capacidades de Ingeniería</p>
          <h2>Cuatro pilares para el ciclo de vida del software</h2>
          <p>Acompañamos a organizaciones en cada etapa técnica sin fricciones ni dependencias artificiales.</p>
        </div>

        <div class="grid grid-4 reveal" style="gap: 1.25rem;">
          <div class="card glass-panel" style="padding: 1.75rem;">
            <div style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--cyan); font-weight: 700; margin-bottom: 0.5rem;">01 • CONSTRUCCIÓN</div>
            <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: var(--paper);">Desarrollo Web</h3>
            <p style="font-size: 0.85rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1rem;">
              Sitios y plataformas web de alta velocidad mediante arquitectura estática SSG, diseño a medida y código propio del cliente.
            </p>
            <a href="/paquetes.html" style="font-size: 0.8rem; color: var(--cyan); text-decoration: none; font-weight: 600;">Ver Catálogo de Sitios Web →</a>
          </div>

          <div class="card glass-panel" style="padding: 1.75rem;">
            <div style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--cyan); font-weight: 700; margin-bottom: 0.5rem;">02 • EVALUACIÓN</div>
            <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: var(--paper);">Evaluamos</h3>
            <p style="font-size: 0.85rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1rem;">
              Auditorías estáticas de seguridad, accesibilidad y rendimiento en repositorios existentes con Castle Checkup y Castle Audit.
            </p>
            <a href="/servicios/checkup.html" style="font-size: 0.8rem; color: var(--cyan); text-decoration: none; font-weight: 600;">Ver Diagnósticos →</a>
          </div>

          <div class="card glass-panel" style="padding: 1.75rem;">
            <div style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--cyan); font-weight: 700; margin-bottom: 0.5rem;">03 • INTERVENCIÓN</div>
            <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: var(--paper);">Corregimos</h3>
            <p style="font-size: 0.85rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1rem;">
              Rescate de software heredado, saneamiento de claves expuestas y respuesta técnica ante caídas críticas de producción.
            </p>
            <a href="/servicios/rescue.html" style="font-size: 0.8rem; color: var(--cyan); text-decoration: none; font-weight: 600;">Ver Servicios de Rescate →</a>
          </div>

          <div class="card glass-panel" style="padding: 1.75rem;">
            <div style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--cyan); font-weight: 700; margin-bottom: 0.5rem;">04 • CONTINUIDAD</div>
            <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: var(--paper);">Mantenemos</h3>
            <p style="font-size: 0.85rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1rem;">
              Supervisión de disponibilidad, parches mensuales de seguridad y re-certificación periódica mediante pólizas Castle Care.
            </p>
            <span style="display: block; font-family: var(--f-mono); font-size: 0.82rem; color: var(--paper); margin-bottom: 0.75rem;">Desde $3,500 MXN <span style="color: var(--steel-soft);">/ mes</span></span>
            <a href="/servicios/care.html" style="font-size: 0.8rem; color: var(--cyan); text-decoration: none; font-weight: 600;">Ver Planes Care →</a>
          </div>

        </div>
      </div>
    </section>

    <!-- 03 — PARA QUIÉN: 3 PERFILES SIN AMONTONAMIENTO DE PRECIOS -->
    <section class="section" id="para-quien">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Segmentación</p>
          <h2>Soluciones adaptadas a cada escala de organización</h2>
          <p>Propuestas técnicas calibradas según las prioridades de tu etapa de negocio.</p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem;">
          
          <div class="card glass-panel" style="padding: 2.25rem;">
            <div class="badge badge-cyan" style="font-size: 0.7rem; margin-bottom: 0.75rem;">PERFIL 01</div>
            <h3 style="font-size: 1.2rem; margin-bottom: 0.5rem;">Profesionales &amp; Micronegocios</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1.25rem;">
              Para consultores, médicos, despachos o comercios que requieren una presencia web arquitectónica, rápida, con enlace directo a WhatsApp y sin costos recurrentes forzados.
            </p>
            <div style="font-size: 0.8rem; color: var(--paper); font-family: var(--f-mono); margin-bottom: 1rem;">
              Enfoque: <strong>Lanzamiento ágil y conversión directa</strong>
            </div>
            <a href="/paquetes.html" class="btn btn-outline btn-sm">Ver Opciones Recomendadas</a>
          </div>

          <div class="card glass-panel" style="padding: 2.25rem; border-color: rgba(0, 210, 255, 0.35);">
            <div class="badge badge-cyan" style="font-size: 0.7rem; margin-bottom: 0.75rem;">PERFIL 02</div>
            <h3 style="font-size: 1.2rem; margin-bottom: 0.5rem;">PyMEs &amp; Empresas en Crecimiento</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1.25rem;">
              Para empresas que necesitan una plataforma corporativa multi-página, catálogo autogestionable, blog técnico y acompañamiento continuo de mantenimiento.
            </p>
            <div style="font-size: 0.8rem; color: var(--paper); font-family: var(--f-mono); margin-bottom: 1rem;">
              Enfoque: <strong>Escalabilidad corporativa y gobernanza</strong>
            </div>
            <a href="/paquetes.html" class="btn btn-primary btn-sm">Ver Plataformas Corporativas</a>
          </div>

          <div class="card glass-panel" style="padding: 2.25rem;">
            <div class="badge badge-cyan" style="font-size: 0.7rem; margin-bottom: 0.75rem;">PERFIL 03</div>
            <h3 style="font-size: 1.2rem; margin-bottom: 0.5rem;">Líderes Técnicos &amp; Equipos de Software</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1.25rem;">
              Para CTOs y directores que necesitan auditar código antes de una inversión, sanear secretos expuestos en repositorios heredados o integrar Castle Gate en pipelines de CI/CD.
            </p>
            <div style="font-size: 0.8rem; color: var(--paper); font-family: var(--f-mono); margin-bottom: 1rem;">
              Enfoque: <strong>Auditoría profunda y veto determinista</strong>
            </div>
            <a href="/servicios.html" class="btn btn-outline btn-sm">Ver Servicios de Ingeniería</a>
          </div>

        </div>
      </div>
    </section>

    <!-- 04 — CÓMO TRABAJAMOS (PROCESO DISCIPLINADO) -->
    <section class="section section-dim" id="metodologia">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Metodología de Trabajo</p>
          <h2>Proceso de ingeniería claro, predecible y documentado</h2>
          <p>Cada proyecto avanza por fases estructuradas con entregables definidos por escrito.</p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem;">
          <div class="card glass-panel" style="padding: 2rem;">
            <div style="font-family: var(--f-mono); font-size: 1.4rem; color: var(--cyan); font-weight: 800; margin-bottom: 0.5rem;">01</div>
            <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--paper);">Alcance &amp; Contrato por Escrito</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              Definimos la Declaración de Trabajo (SOW), el inventario de rutas, las rondas de revisión y el presupuesto fijo antes de escribir una sola línea de código.
            </p>
          </div>

          <div class="card glass-panel" style="padding: 2rem;">
            <div style="font-family: var(--f-mono); font-size: 1.4rem; color: var(--cyan); font-weight: 800; margin-bottom: 0.5rem;">02</div>
            <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--paper);">Ingeniería &amp; Validación CQS</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              Construimos sobre arquitectura estática y ejecutamos Castle Gate Runner para comprobar que el release cumpla los umbrales de seguridad, accesibilidad y rendimiento.
            </p>
          </div>

          <div class="card glass-panel" style="padding: 2rem;">
            <div style="font-family: var(--f-mono); font-size: 1.4rem; color: var(--cyan); font-weight: 800; margin-bottom: 0.5rem;">03</div>
            <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--paper);">Handoff &amp; Soberanía Total</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              Transferimos el repositorio Git, el hosting y el dominio a tus cuentas directas. El cliente conserva el 100% de titularidad con 30 días de garantía técnica.
            </p>
            <details style="margin-top: 0.75rem; font-size: 0.82rem; color: var(--steel-light); line-height: 1.6;">
              <summary style="cursor: pointer; color: var(--cyan); font-family: var(--f-mono); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.03em;">¿Qué cubre la garantía de 30 días?</summary>
              <div style="margin-top: 0.6rem; padding-left: 0.25rem;">
                <p style="margin: 0 0 0.5rem 0;"><strong style="color: var(--paper);">Cubre (sin costo):</strong> cualquier error, bug o falla de funcionamiento en lo entregado y aprobado en el SOW — formularios, botones, responsive, errores de despliegue. Corrección sin costo y sin límite de reportes dentro de los 30 días.</p>
                <p style="margin: 0 0 0.5rem 0;"><strong style="color: var(--paper);">No cubre:</strong> cambios de contenido, diseño o alcance fuera del SOW original; fallas causadas por terceros (dominio, hosting o integraciones que administre el cliente); ni modificaciones realizadas después de la entrega por el cliente o un tercero.</p>
                <p style="margin: 0;"><strong style="color: var(--paper);">Cierre:</strong> al día 30 se entrega un reporte de cierre documentando qué se corrigió.</p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </section>

    <!-- 05 — ¿POR QUÉ TRABAJAMOS ASÍ? (PRINCIPIO DE SOBERANÍA) -->
    <section class="section section-dim" id="por-que-castle">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Compromiso de Soberanía</p>
          <h2>¿Por qué trabajamos así?</h2>
          <p>Lo que construimos para ti sigue siendo 100% tuyo: sin ataduras, sin retención de cuentas y sin mensualidades ocultas.</p>
        </div>

        <div class="grid grid-4 reveal" style="gap: 1.25rem; margin-bottom: 2.25rem;">
          <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid var(--cyan);">
            <h3 style="font-size: 1.1rem; margin-bottom: 0.35rem; color: var(--paper);">Tu Dominio</h3>
            <p style="font-size: 0.84rem; color: var(--steel-light); line-height: 1.55; margin: 0;">Registrado a tu nombre directo desde el día uno. Control DNS exclusivo.</p>
          </div>
          <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid var(--cyan);">
            <h3 style="font-size: 1.1rem; margin-bottom: 0.35rem; color: var(--paper);">Tu Código</h3>
            <p style="font-size: 0.84rem; color: var(--steel-light); line-height: 1.55; margin: 0;">Repositorio Git propio con 100% de titularidad jurídica por contrato.</p>
          </div>
          <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid var(--cyan);">
            <h3 style="font-size: 1.1rem; margin-bottom: 0.35rem; color: var(--paper);">Tus Cuentas</h3>
            <p style="font-size: 0.84rem; color: var(--steel-light); line-height: 1.55; margin: 0;">Hosting, analítica y servicios en tus propias cuentas administrativas.</p>
          </div>
          <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid var(--cyan);">
            <h3 style="font-size: 1.1rem; margin-bottom: 0.35rem; color: var(--paper);">Tu Salida</h3>
            <p style="font-size: 0.84rem; color: var(--steel-light); line-height: 1.55; margin: 0;">Arquitectura abierta y documentada para migrar cuando lo decidas.</p>
          </div>
        </div>

        <div style="text-align: center;">
          <a href="/porque-elegirnos.html" class="btn btn-outline">Conoce Nuestra Filosofía y Diferenciación Completa →</a>
        </div>
      </div>
    </section>

    <!-- 06 — CASTLE GATE: NARRATIVA TÉCNICA SECUENCIAL -->
    <section class="section section-dark" id="castle-gate-tecnologia">
      <div class="container">
        <div class="two-col" style="align-items: center; gap: 3.5rem;">
          
          <div class="reveal">
            <div class="badge badge-cyan" style="margin-bottom: 1rem;">TECNOLOGÍA PROPIA DIFERENCIAL</div>
            <h2 style="font-size: 2.1rem; line-height: 1.2; margin-bottom: 1.25rem;">
              Gobernanza Determinista de Releases: Castle Gate
            </h2>
            <p style="font-size: 1rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.5rem;">
              A diferencia de agencias convencionales, Grupo Castillo desarrolló su propio motor de gobernanza. Castle Gate opera directamente en la memoria local de tu runner CI/CD para vetar liberaciones que incumplan los controles CQS v1.1.
            </p>
            
            <div style="display: flex; flex-direction: column; gap: 0.85rem; margin-bottom: 2rem;">
              <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--cyan); font-weight: bold; background: rgba(0,210,255,0.1); padding: 2px 8px; border-radius: 4px;">01</span>
                <div>
                  <strong style="color: var(--paper); font-size: 0.9rem;">Evaluación en Memoria Local:</strong>
                  <span style="font-size: 0.85rem; color: var(--steel-light); display: block;">Análisis estático sin enviar tu código fuente ni credenciales a servidores externos.</span>
                </div>
              </div>
              <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--cyan); font-weight: bold; background: rgba(0,210,255,0.1); padding: 2px 8px; border-radius: 4px;">02</span>
                <div>
                  <strong style="color: var(--paper); font-size: 0.9rem;">Gate Breakers Automáticos:</strong>
                  <span style="font-size: 0.85rem; color: var(--steel-light); display: block;">Veto inmediato en CI/CD con Exit Code 1 ante secretos expuestos o vulnerabilidades críticas.</span>
                </div>
              </div>
              <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--cyan); font-weight: bold; background: rgba(0,210,255,0.1); padding: 2px 8px; border-radius: 4px;">03</span>
                <div>
                  <strong style="color: var(--paper); font-size: 0.9rem;">Evidencia Criptográfica:</strong>
                  <span style="font-size: 0.85rem; color: var(--steel-light); display: block;">Emisión de certificado JSON firmado con SHA-256 vinculado al commit exacto del release.</span>
                </div>
              </div>
            </div>

            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
              <a href="/castle-gate.html" class="btn btn-primary">Especificación y Licenciamiento →</a>
              <a href="/servicios/checkup.html" class="btn btn-outline">Solicitar Checkup Inicial</a>
            </div>
          </div>

          <div class="reveal">
            <CastleTerminalSimulator />
          </div>

        </div>
      </div>
    </section>

    <!-- 07 — CASO INTERNO DE REFERENCIA: CASTLE WEB (DOGFOODING) -->
    <section class="section section-dim" id="caso-interno">
      <div class="container">
        <div class="glass-panel reveal" style="padding: 2.5rem; border-color: rgba(0, 210, 255, 0.25); background: linear-gradient(135deg, rgba(6, 8, 12, 0.95) 0%, rgba(18, 48, 74, 0.3) 100%);">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1.5rem;">
            <div>
              <span class="badge badge-cyan" style="margin-bottom: 0.75rem;">VALIDACIÓN INTERNA — DOGFOODING</span>
              <h2 style="font-size: 1.8rem; margin: 0 0 0.5rem 0; color: var(--paper);">
                Este sitio, evaluado con nuestra propia metodología
              </h2>
              <p style="font-size: 0.95rem; color: var(--steel-light); margin: 0; max-width: 65ch; line-height: 1.6;">
                Aplicamos Castle Gate sobre nuestra propia plataforma antes de ofrecerlo a clientes. Este es el resultado: 24 rutas estáticas SSG, 7 componentes visuales interactivos y 100% de controles CQS v1.1 aprobados con 0 errores y 0 vulnerabilidades. <em style="color: var(--steel-soft);">Esta es una validación interna, no un caso de cliente externo.</em>
              </p>
            </div>
            <div style="text-align: right;">
              <CastleGateBadge variant="compact" validationId="CG-2026-68D04F" releaseSha="3d61237" isSelfValidation={true} />
            </div>
          </div>

          <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid rgba(255, 255, 255, 0.08);">
            <div>
              <span style="font-size: 0.75rem; color: var(--steel-soft); text-transform: uppercase; font-family: var(--f-mono);">Puntuación CQS</span>
              <strong style="display: block; font-size: 1.3rem; color: #00E599; font-family: var(--f-mono);">100.0 / 100</strong>
            </div>
            <div>
              <span style="font-size: 0.75rem; color: var(--steel-soft); text-transform: uppercase; font-family: var(--f-mono);">Rutas SSG</span>
              <strong style="display: block; font-size: 1.3rem; color: var(--paper); font-family: var(--f-mono);">24 Páginas</strong>
            </div>
            <div>
              <span style="font-size: 0.75rem; color: var(--steel-soft); text-transform: uppercase; font-family: var(--f-mono);">Accesibilidad</span>
              <strong style="display: block; font-size: 1.3rem; color: var(--paper); font-family: var(--f-mono);">WCAG AA 100%</strong>
            </div>
            <div>
              <span style="font-size: 0.75rem; color: var(--steel-soft); text-transform: uppercase; font-family: var(--f-mono);">Secretos / CVEs</span>
              <strong style="display: block; font-size: 1.3rem; color: #00E599; font-family: var(--f-mono);">0 Detectados</strong>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 08 — SITIOS WEB Y PAQUETES -->
    <section class="section" id="paquetes-catalogo">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Desarrollo Web</p>
