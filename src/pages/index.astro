---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQItem from '../components/FAQItem.astro';
import CTABand from '../components/CTABand.astro';
import CastleTerminalSimulator from '../components/CastleTerminalSimulator.astro';
import HeroEngineVisual from '../components/HeroEngineVisual.astro';
---

<BaseLayout
  title="Grupo Castillo — Firma de Ingeniería de Software y Gobernanza Tecnológica"
  description="Grupo Castillo construye plataformas web de alto rendimiento, interviene código heredado y aplica tecnología propia de gobernanza determinista para releases seguros."
  canonical="https://servicios-castillo.vercel.app/index.html"
  ogUrl="https://servicios-castillo.vercel.app/index.html"
>
  <main id="main">

    <!-- 01 — HERO & IDENTIDAD CORPORATIVA (CINEMÁTICO DE ALTA GAMA) -->
    <section class="hero" style="position: relative; overflow: hidden; padding-top: 6.5rem; padding-bottom: 5.5rem; background: #06080C;">
      <HeroEngineVisual />
      <div class="container hero-content-container" style="position: relative; z-index: 4; max-width: 960px; margin: 0 auto; text-align: center;">
        <p class="eyebrow" style="margin-bottom: 1.5rem; justify-content: center;">
          FIRMA DE INGENIERÍA DIGITAL &amp; GOBERNANZA TÉCNICA
        </p>
        <h1 style="font-size: clamp(2.3rem, 4.2vw, 3.8rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.025em; margin-bottom: 1.5rem;">
          Construimos, evaluamos, corregimos y protegemos <span style="color: var(--cyan);">sistemas digitales confiables.</span>
        </h1>
        <p class="lede" style="font-size: 1.15rem; color: var(--steel-light); line-height: 1.7; margin-bottom: 2.25rem; max-width: 72ch; margin-left: auto; margin-right: auto;">
          Grupo Castillo combina desarrollo web de alto rendimiento con titularidad y control del código para el cliente, intervención técnica en sistemas existentes y tecnología propia para la gobernanza determinista de releases.
        </p>
        <div class="hero-actions" style="display: flex; gap: 1.25rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3rem;">
          <a class="btn btn-primary" href="/paquetes.html">Explorar Paquetes Build</a>
          <a class="btn btn-outline" href="/diagnostico.html">¿No sabes qué necesitas? Inicia Diagnóstico</a>
        </div>

        <div class="hero-metrics" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; padding-top: 2rem; border-top: 1px solid rgba(255, 255, 255, 0.08); max-width: 760px; margin: 0 auto;">
          <div>
            <strong style="display: block; font-size: 1.35rem; font-family: var(--f-mono); color: var(--paper);">Titularidad del Cliente</strong>
            <span style="font-size: 0.75rem; color: var(--steel-soft); text-transform: uppercase; letter-spacing: 0.05em;">Código &amp; Cuentas Propias</span>
          </div>
          <div>
            <strong style="display: block; font-size: 1.35rem; font-family: var(--f-mono); color: var(--paper);">72h Objetivo</strong>
            <span style="font-size: 0.75rem; color: var(--steel-soft); text-transform: uppercase; letter-spacing: 0.05em;">Diagnóstico Checkup</span>
          </div>
          <div>
            <strong style="display: block; font-size: 1.35rem; font-family: var(--f-mono); color: var(--paper);">Tecnología Propia</strong>
            <span style="font-size: 0.75rem; color: var(--steel-soft); text-transform: uppercase; letter-spacing: 0.05em;">Castle Gate Engine</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 — PROBLEMAS REALES DEL CLIENTE (EMPATÍA Y RIESGOS) -->
    <section class="section section-dim" id="problemas">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Desafíos Frecuentes</p>
          <h2>Las dificultades que resolvemos para nuestros clientes</h2>
          <p>Identificamos los puntos de fricción más comunes en el desarrollo y mantenimiento de software.</p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem;">
          <div class="card glass-panel" style="padding: 2rem;">
            <div style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-soft); margin-bottom: 0.5rem;">ESCENARIO 01</div>
            <h3 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--paper);">Código Abandonado o Huérfano</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              El desarrollador o agencia original desapareció y nadie en tu empresa se atreve a modificar el sistema por temor a romper la operación.
            </p>
          </div>

          <div class="card glass-panel" style="padding: 2rem;">
            <div style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-soft); margin-bottom: 0.5rem;">ESCENARIO 02</div>
            <h3 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--paper);">Falta de Certeza de Calidad</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              Tu sitio funciona pero desconoces si contiene claves expuestas, fallas de accesibilidad o problemas de lentitud que ahuyentan clientes.
            </p>
          </div>

          <div class="card glass-panel" style="padding: 2rem;">
            <div style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-soft); margin-bottom: 0.5rem;">ESCENARIO 03</div>
            <h3 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--paper);">Dependencia y Falta de Control</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              Proveedores que retienen dominios o código en plataformas cerradas, impidiendo que tu empresa tenga el control real de sus activos.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 03 — SOLUCIONES: QUÉ HACE GRUPO CASTILLO -->
    <section class="section" id="soluciones">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Capacidades de Ingeniería</p>
          <h2>Un modelo integral para el ciclo de vida del software</h2>
          <p>Estructuramos nuestras capacidades en líneas de acción claras y complementarias.</p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem;">
          
          <div class="card glass-panel" style="padding: 2rem;">
            <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--cyan); font-weight: 700;">BUILD</span>
            <h3 style="font-size: 1.2rem; margin: 0.5rem 0;">Construimos</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1.25rem;">
              Desarrollamos sitios y plataformas web desde nivel esencial (Iron) hasta software a medida (Diamond) con titularidad jurídica del cliente.
            </p>
            <a href="/paquetes.html" style="font-size: 0.82rem; color: var(--cyan); text-decoration: none; font-weight: 600;">Ver Catálogo Build →</a>
          </div>

          <div class="card glass-panel" style="padding: 2rem;">
            <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--cyan); font-weight: 700;">CHECKUP &amp; AUDIT</span>
            <h3 style="font-size: 1.2rem; margin: 0.5rem 0;">Diagnosticamos &amp; Investigamos</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1.25rem;">
              Evaluamos repositorios en 72h hábiles con Castle Checkup o realizamos auditorías profundas de arquitectura con Castle Audit.
            </p>
            <a href="/servicios/checkup.html" style="font-size: 0.82rem; color: var(--cyan); text-decoration: none; font-weight: 600;">Ver Castle Checkup ($8,900 MXN) →</a>
          </div>

          <div class="card glass-panel" style="padding: 2rem;">
            <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--cyan); font-weight: 700;">RESCUE &amp; CARE</span>
            <h3 style="font-size: 1.2rem; margin: 0.5rem 0;">Corregimos &amp; Acompañamos</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1.25rem;">
              Intervenimos repositorios para sanear secretos y ofrecemos supervisión técnica continua mediante suscripciones mensuales Castle Care.
            </p>
            <a href="/servicios/care.html" style="font-size: 0.82rem; color: var(--cyan); text-decoration: none; font-weight: 600;">Ver Planes de Continuidad Care →</a>
          </div>

        </div>

        <!-- DIAGNÓSTICO CALLOUT BANNER -->
        <div class="glass-panel reveal" style="margin-top: 2.5rem; padding: 2.25rem; border-left: 4px solid var(--cyan); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem; background: linear-gradient(135deg, rgba(0, 210, 255, 0.05) 0%, rgba(14, 18, 27, 0.9) 100%);">
          <div>
            <span class="badge badge-cyan" style="margin-bottom: 0.5rem; font-size: 0.7rem;">ORIENTACIÓN COMERCIAL GUIADA</span>
            <h3 style="font-size: 1.25rem; margin-bottom: 0.35rem; color: var(--paper);">¿Incertidumbre sobre qué solución elegir?</h3>
            <p style="font-size: 0.9rem; color: var(--steel-light); margin: 0; max-width: 60ch;">
              No necesitas conocer nuestro catálogo técnico para comenzar. Utiliza nuestro Diagnóstico Castillo interactivo para determinar el punto de partida exacto para tu empresa.
            </p>
          </div>
          <div>
            <a href="/diagnostico.html" class="btn btn-primary" style="white-space: nowrap;">Iniciar Diagnóstico Castillo →</a>
          </div>
        </div>

      </div>
    </section>

    <!-- 04 — CÓMO TRABAJAMOS: PROCESO DISCIPLINADO -->
    <section class="section section-dim" id="metodologia">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Metodología de Trabajo</p>
          <h2>Proceso claro, transparente y sin sorpresas</h2>
          <p>Cada proyecto avanza por fases estructuradas con entregables definidos por escrito.</p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem;">
          <div class="card glass-panel" style="padding: 2rem;">
            <div style="font-family: var(--f-mono); font-size: 1.4rem; color: var(--cyan); font-weight: 800; margin-bottom: 0.5rem;">01</div>
            <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--paper);">Fase Discover &amp; Alcance</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              Analizamos requerimientos, definimos el paquete o servicio adecuado y establecemos el presupuesto y número de revisiones por contrato.
            </p>
          </div>

          <div class="card glass-panel" style="padding: 2rem;">
            <div style="font-family: var(--f-mono); font-size: 1.4rem; color: var(--cyan); font-weight: 800; margin-bottom: 0.5rem;">02</div>
            <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--paper);">Ingeniería &amp; Validación</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              Construimos o intervenimos con código modular y sometemos cada release a los controles de seguridad, accesibilidad y rendimiento.
            </p>
          </div>

          <div class="card glass-panel" style="padding: 2rem;">
            <div style="font-family: var(--f-mono); font-size: 1.4rem; color: var(--cyan); font-weight: 800; margin-bottom: 0.5rem;">03</div>
            <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--paper);">Entrega &amp; Gobernanza</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              Publicamos en producción, transferimos accesos directos al cliente y entregamos reportes técnicos de cumplimiento.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 05 — SEGMENTACIÓN: A QUIÉN ATENDEMOS -->
    <section class="section" id="segmentacion">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Segmentación de Clientes</p>
          <h2>Soluciones adaptadas a cada escala y necesidad</h2>
          <p>Diseñamos propuestas específicas según el tipo de organización y su madurez digital.</p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem;">
          
          <div class="card glass-panel" style="padding: 2.25rem;">
            <div class="badge badge-cyan" style="font-size: 0.7rem; margin-bottom: 0.75rem;">MICRONEGOCIOS</div>
            <h3 style="font-size: 1.2rem; margin-bottom: 0.5rem;">Personas / Profesionales / Micronegocios</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1.25rem;">
              Para consultores, médicos, abogados o comercios que necesitan una presencia web rápida, profesional y con enlace directo a WhatsApp.
            </p>
            <p style="font-size: 0.82rem; color: var(--paper); font-family: var(--f-mono);">Solución recomendada: <strong>Castle Iron ($2,800 MXN)</strong> o <strong>Bronze ($4,500 MXN)</strong></p>
          </div>

          <div class="card glass-panel" style="padding: 2.25rem; border-color: rgba(0, 210, 255, 0.35);">
            <div class="badge badge-cyan" style="font-size: 0.7rem; margin-bottom: 0.75rem;">PYMES &amp; EMPRESAS</div>
            <h3 style="font-size: 1.2rem; margin-bottom: 0.5rem;">PyMEs / Empresas</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1.25rem;">
              Para empresas que buscan un sitio corporativo multi-página, catálogo autogestionable con blog/CMS y acompañamiento continuo.
            </p>
            <p style="font-size: 0.82rem; color: var(--paper); font-family: var(--f-mono);">Solución recomendada: <strong>Castle Silver ($7,500 MXN)</strong>, <strong>Gold ($12,500 MXN)</strong> o <strong>Care Pro</strong></p>
          </div>

          <div class="card glass-panel" style="padding: 2.25rem;">
            <div class="badge badge-cyan" style="font-size: 0.7rem; margin-bottom: 0.75rem;">EQUIPOS DE SOFTWARE</div>
            <h3 style="font-size: 1.2rem; margin-bottom: 0.5rem;">Equipos de Software / Organizaciones</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1.25rem;">
              Para CTOs y directores que requieren auditar código antes de una inversión, sanear secretos expuestos o gobernar pipelines de CI/CD.
            </p>
            <p style="font-size: 0.82rem; color: var(--paper); font-family: var(--f-mono);">Solución recomendada: <strong>Castle Checkup ($8,900 MXN)</strong>, <strong>Audit</strong> o <strong>Castle Gate CLI</strong></p>
          </div>

        </div>
      </div>
    </section>

    <!-- 06 — EVIDENCIA TECNOLÓGICA & DEMOSTRACIÓN INTERACTIVA (TERMINAL CLI) -->
    <section class="section section-dark" id="evidencia-tecnologica">
      <div class="container">
        <div class="two-col" style="align-items: center; gap: 3.5rem;">
          
          <div class="reveal">
            <div class="badge badge-cyan" style="margin-bottom: 1rem;">TECNOLOGÍA PROPIA DIFERENCIAL</div>
            <h2 style="font-size: 2.1rem; line-height: 1.2; margin-bottom: 1.25rem;">
              Gobernanza Determinista de Releases: Castle Gate
            </h2>
            <p style="font-size: 1rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.25rem;">
              A diferencia de agencias convencionales, Grupo Castillo desarrolló su propio motor de gobernanza de software. Castle Gate evalúa estáticamente controles CQS v1.1 en la memoria local del runner para vetar releases que incumplan las políticas configuradas en tu CI/CD.
            </p>
            
            <ul style="list-style: none; padding: 0; margin-bottom: 1.75rem; font-size: 0.9rem; color: var(--paper); display: flex; flex-direction: column; gap: 0.5rem;">
              <li><strong>Ejecución Local en Memoria:</strong> No requiere enviar tu código fuente a servidores externos.</li>
              <li><strong>Gate Breakers:</strong> Veto inmediato en CI/CD con Exit Code 1 ante secretos críticos.</li>
              <li><strong>Release Certificate:</strong> Integridad técnica verificable mediante sello criptográfico SHA-256.</li>
            </ul>

            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
              <a href="/castle-gate.html" class="btn btn-primary">Especificación y Licenciamiento →</a>
              <a href="/servicios/checkup.html" class="btn btn-outline">Solicitar Checkup Inicial ($8,900 MXN)</a>
            </div>
          </div>

          <!-- TERMINAL INTERACTIVA EN SU UBICACIÓN DE EVIDENCIA -->
          <div class="reveal">
            <CastleTerminalSimulator />
          </div>

        </div>
      </div>
    </section>

    <!-- 07 — PRINCIPIOS DE CONFIANZA, PRIVACIDAD Y TITULARIDAD -->
    <section class="section section-dim" id="confianza">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Principios de Confianza</p>
          <h2>Responsabilidad técnica y respeto a tus activos</h2>
          <p>Construimos relaciones profesionales fundamentadas en la transparencia y la certeza operativa.</p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem;">
          
          <div class="card glass-panel" style="padding: 2rem;">
            <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: var(--paper);">Titularidad del Cliente</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              El código fuente original entregado, los repositorios y las cuentas de hosting permanecen bajo la titularidad y control del cliente conforme a contrato.
            </p>
          </div>

          <div class="card glass-panel" style="padding: 2rem;">
            <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: var(--paper);">Privacidad y Menor Privilegio</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              La información del proyecto se trata con estricta confidencialidad. Solicitamos únicamente los accesos mínimos indispensables y cerramos credenciales tras la entrega.
            </p>
          </div>

          <div class="card glass-panel" style="padding: 2rem;">
            <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: var(--paper);">Contratos y Alcance por Escrito</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              Cada paquete y servicio cuenta con entregables delimitados, número de revisiones por contrato y cotizaciones transparentes sin costos ocultos.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- 08 — PREGUNTAS FRECUENTES GENERALES -->
    <section class="section" id="faq">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Preguntas Frecuentes</p>
          <h2>Respuestas claras sobre Grupo Castillo</h2>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Por qué elegir a Grupo Castillo frente a una agencia convencional?" answer="Grupo Castillo combina desarrollo web accesible con rigor de ingeniería y tecnología propia de gobernanza (Castle Gate), asegurando que tu plataforma sea veloz, estructurada y quede bajo tu control." />
              <FAQItem question="¿El código y las cuentas nos pertenecen?" answer="Sí. Todo el código fuente original entregado, repositorios y configuraciones de hosting quedan registrados bajo la titularidad y control del cliente conforme a contrato." />
              <FAQItem question="¿Qué es el diagnóstico Castle Checkup?" answer="Es un servicio ágil ($8,900 MXN / ~$525 USD) donde evaluamos tu repositorio bajo 65 controles CQS v1.1 en 72h hábiles para detectar fugas de claves, con 100% de abono acreditable hacia tu contratación anual de Castle Gate dentro de los 30 días posteriores." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Castle Gate transmite información fuera de nuestra infraestructura?" answer="No. La evaluación de Castle Gate se ejecuta localmente en la memoria del runner y no requiere enviar tu código fuente ni secretos a servidores externos." />
              <FAQItem question="¿Cómo solicitamos una propuesta formal?" answer="Completa el formulario de contacto o utiliza nuestro Diagnóstico Castillo guiado. Te respondemos con una propuesta técnica por escrito en menos de 24 horas hábiles." />
              <FAQItem question="¿Qué soporte continuo ofrecen después del lanzamiento?" answer="Mediante los planes mensuales Castle Care (desde $3,500 MXN/mes) ofrecemos supervisión de uptime, parches de seguridad y horas de ingeniería de rescate (Rescue) incluidas según contrato." />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 09 — CTA BAND FINAL -->
    <CTABand
      title="Hablemos de tu proyecto o repositorio."
      description="Cuéntanos qué necesita tu negocio o inicia con nuestro diagnóstico comercial interactivo."
      ctaLabel="Iniciar Diagnóstico Castillo"
      ctaHref="/diagnostico.html"
    />

  </main>
</BaseLayout>
