              }
            })
            .catch(function() {
              httpEl.innerHTML = '<span style="color:#00E599;">ONLINE</span>';
            });
        }

        // 2. Consulta a API de Google PageSpeed Insights con fallback seguro
        if (scoreEl && lcpEl && tsEl) {
          var targetDomain = encodeURIComponent('https://servicios-castillo.vercel.app/');
          var apiUrl = 'https://www.googleapis.com/pagespeedonline/v5/runPagespeed?url=' + targetDomain + '&category=PERFORMANCE&strategy=mobile';
          
          var controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
          var timeoutId = setTimeout(function() {
            if (controller) controller.abort();
          }, 25000);

          fetch(apiUrl, { signal: controller ? controller.signal : undefined })
            .then(function(response) {
              clearTimeout(timeoutId);
              if (response.status === 429) {
                var err429 = new Error('RateLimitExceeded');
                err429.isRateLimit = true;
                throw err429;
              }
              if (!response.ok) throw new Error('Status: ' + response.status);
              return response.json();
            })
            .then(function(data) {
              var perfScore = null;
              var lcpValue = null;
              try {
                var categories = data.lighthouseResult && data.lighthouseResult.categories;
                if (categories && categories.performance && typeof categories.performance.score === 'number') {
                  perfScore = Math.round(categories.performance.score * 100);
                }
                var audits = data.lighthouseResult && data.lighthouseResult.audits;
                if (audits && audits['largest-contentful-paint'] && audits['largest-contentful-paint'].displayValue) {
                  lcpValue = audits['largest-contentful-paint'].displayValue;
                }
              } catch(e) {}

              if (perfScore !== null) {
                scoreEl.innerHTML = perfScore + ' <span style="font-size:1rem;color:#CBD5E1;">/ 100</span>';
              } else {
                scoreEl.innerHTML = '<span style="font-size:1rem;color:#CBD5E1;">Verificar en vivo</span>';
              }

              if (lcpValue) {
                lcpEl.innerText = lcpValue;
              } else {
                lcpEl.innerHTML = '<span style="font-size:1rem;color:#CBD5E1;">Verificar en vivo</span>';
              }

              var now = new Date();
              tsEl.innerText = 'Consulta en tiempo real: ' + now.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ' (' + now.toLocaleDateString('es-MX') + ')';
            })
            .catch(function(err) {
              clearTimeout(timeoutId);
              if (err && err.isRateLimit) {
                scoreEl.innerHTML = '<span style="font-size:0.95rem;color:#CBD5E1;font-weight:600;">Verificar en vivo ↗</span>';
                lcpEl.innerHTML = '<span style="font-size:0.95rem;color:#CBD5E1;font-weight:600;">Verificar en vivo ↗</span>';
                tsEl.innerText = 'Cuota de API pública de Google agotada temporalmente (haz clic en el botón para auditoría en vivo)';
              } else {
                scoreEl.innerHTML = '<span style="font-size:0.95rem;color:#CBD5E1;">Verificar en vivo ↗</span>';
                lcpEl.innerHTML = '<span style="font-size:0.95rem;color:#CBD5E1;">Verificar en vivo ↗</span>';
                tsEl.innerText = 'Consulta en tiempo real: haz clic en el botón para verificar en Google PageSpeed Insights';
              }
            });
        }
      })();
    </script>
  </main>
</BaseLayout>
