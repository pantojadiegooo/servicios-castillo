          <a href="/index.html" class="btn btn-outline">Volver a Grupo Castillo</a>
          <a href="/acuerdo-impact.html" class="btn btn-outline">Leer Acuerdo de Participación</a>
        </div>
      </div>
    </section>

  </main>
