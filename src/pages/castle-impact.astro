---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABand from '../components/CTABand.astro';
import InnerHeroVisual from '../components/InnerHeroVisual.astro';
---

<BaseLayout
  title="Castle Impact | Iniciativa Pro Bono de Ingeniería — Grupo Castillo"
  description="Castle Impact pone capacidad de ingeniería, seguridad higiénica y rigor técnico al servicio de organizaciones sociales para fortalecer su autonomía operativa."
  canonical="https://servicios-castillo.vercel.app/castle-impact.html"
  ogUrl="https://servicios-castillo.vercel.app/castle-impact.html"
>
  <main id="main">

    <!-- 01. HERO SECTION -->
    <section class="page-hero">
      <InnerHeroVisual type="nosotros" />
      <div class="container page-hero-inner" style="max-width: 980px; text-align: center; margin: 0 auto;">
        <p class="breadcrumb" style="justify-content: center;"><a href="/index.html">Inicio</a> / Castle Impact</p>
        <div class="badge badge-cyan" style="margin-bottom: 1.25rem;">
          <span class="gate-dot"></span> INICIATIVA INSTITUCIONAL PRO BONO
        </div>
        <h1 style="font-size: clamp(2.2rem, 1.8rem + 2vw, 3.4rem); line-height: 1.15; margin-bottom: 1.2rem;">
          La ingeniería también puede <span style="color: var(--cyan);">servir.</span>
        </h1>
        <p style="font-size: 1.1rem; line-height: 1.7; max-width: 780px; margin: 0 auto 2rem; color: var(--steel-light);">
          Grupo Castillo no quiere regalar tecnología. Quiere poner capacidad de ingeniería —tiempo, conocimiento técnico y experiencia metodológica— al servicio de organizaciones que necesitan fortalecerse para poder cumplir mejor su misión, sin cobrar por ello.
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3rem;">
          <a href="#postulacion" class="btn btn-primary">Postular Organización</a>
          <a href="#metodologia" class="btn btn-outline">Conocer la Metodología</a>
        </div>

        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; max-width: 720px; margin: 0 auto; text-align: center;">
          <div class="glass-panel" style="padding: 1.25rem 1rem;">
            <div style="font-family: var(--f-mono); font-size: 1.3rem; font-weight: 700; color: var(--cyan); margin-bottom: 0.25rem;">$0 MXN</div>
            <div style="font-size: 0.8rem; color: var(--steel);">Sin Costo para la Organización</div>
          </div>
          <div class="glass-panel" style="padding: 1.25rem 1rem;">
            <div style="font-family: var(--f-mono); font-size: 1.3rem; font-weight: 700; color: var(--success); margin-bottom: 0.25rem;">100%</div>
            <div style="font-size: 0.8rem; color: var(--steel);">Soberanía y Control de Activos</div>
          </div>
          <div class="glass-panel" style="padding: 1.25rem 1rem;">
            <div style="font-family: var(--f-mono); font-size: 1.3rem; font-weight: 700; color: var(--paper); margin-bottom: 0.25rem;">Ledger</div>
            <div style="font-size: 0.8rem; color: var(--steel);">Transparencia y Evidencia</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 02. EL PROBLEMA SECTION -->
    <section id="problema" class="section">
      <div class="container">
        <div style="text-align: center; max-width: 800px; margin: 0 auto 3rem;">
          <div class="badge">DIAGNÓSTICO DE REALIDAD</div>
          <h2 style="font-size: 2rem; color: var(--paper); margin: 0.75rem 0 1rem;">El Problema: La Brecha Técnica en Causas Sociales</h2>
          <p style="color: var(--steel-light); font-size: 1rem; line-height: 1.7;">
            Existen organizaciones admirables con misión clara, personas comprometidas y profunda voluntad humana, pero enfrentan limitaciones tecnológicas críticas que reducen su impacto o ponen en riesgo su operación diaria.
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
          <div class="glass-panel reveal" style="padding: 2.25rem;">
            <div style="width: 42px; height: 42px; border-radius: var(--radius-sm); background: var(--cyan-subtle); border: 1px solid var(--cyan-border); color: var(--cyan); display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem;">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            </div>
            <h3 style="font-size: 1.2rem; color: var(--paper); margin-bottom: 0.75rem;">Información Vulnerable</h3>
            <p style="font-size: 0.92rem; line-height: 1.65; color: var(--steel);">
              Datos sensibles de beneficiarios, víctimas, donantes o voluntarios almacenados en hojas de cálculo desprotegidas o sistemas sin cifrado ni controles de acceso estructurados.
            </p>
          </div>

          <div class="glass-panel reveal" style="padding: 2.25rem;">
            <div style="width: 42px; height: 42px; border-radius: var(--radius-sm); background: var(--cyan-subtle); border: 1px solid var(--cyan-border); color: var(--cyan); display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem;">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            </div>
            <h3 style="font-size: 1.2rem; color: var(--paper); margin-bottom: 0.75rem;">Procesos Manuales Frágiles</h3>
            <p style="font-size: 0.92rem; line-height: 1.65; color: var(--steel);">
              Cientos de horas invertidas en tareas administrativas repetitivas que consumen el tiempo del equipo y aumentan la probabilidad de errores operativos o pérdida de registros.
            </p>
          </div>

          <div class="glass-panel reveal" style="padding: 2.25rem;">
            <div style="width: 42px; height: 42px; border-radius: var(--radius-sm); background: var(--cyan-subtle); border: 1px solid var(--cyan-border); color: var(--cyan); display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem;">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <h3 style="font-size: 1.2rem; color: var(--paper); margin-bottom: 0.75rem;">Dependencia Crítica</h3>
            <p style="font-size: 0.92rem; line-height: 1.65; color: var(--steel);">
              Infraestructuras y sistemas que dependen del conocimiento no documentado de una sola persona, generando parálisis técnica y desamparo operativo cuando el encargado se retira.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 03. NUESTRA INTERVENCIÓN SECTION -->
    <section id="metodologia" class="section" style="background: var(--ink-surface);">
      <div class="container">
        <div style="text-align: center; max-width: 800px; margin: 0 auto 3rem;">
          <div class="badge badge-cyan">METODOLOGÍA DE 7 ETAPAS</div>
          <h2 style="font-size: 2rem; color: var(--paper); margin: 0.75rem 0 1rem;">Nuestra Intervención</h2>
          <p style="color: var(--steel-light); font-size: 1rem; line-height: 1.7;">
            No actuamos con improvisación ni soluciones superficiales. Cada intervención de Castle Impact sigue un ciclo de ingeniería riguroso, medible y orientado a la transferencia definitiva.
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
          <div class="glass-panel" style="padding: 1.75rem 1.25rem;">
            <div style="font-family: var(--f-mono); color: var(--cyan); font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem;">01. Escuchar</div>
            <h4 style="font-size: 1.05rem; color: var(--paper); margin-bottom: 0.5rem;">Comprensión Humana</h4>
            <p style="font-size: 0.85rem; color: var(--steel); line-height: 1.6;">Comprender a fondo la misión, el contexto real de trabajo y la dinámica operativa diaria de la organización.</p>
          </div>
          <div class="glass-panel" style="padding: 1.75rem 1.25rem;">
            <div style="font-family: var(--f-mono); color: var(--cyan); font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem;">02. Diagnosticar</div>
            <h4 style="font-size: 1.05rem; color: var(--paper); margin-bottom: 0.5rem;">Auditoría Técnica</h4>
            <p style="font-size: 0.85rem; color: var(--steel); line-height: 1.6;">Auditar técnicamente la infraestructura, bases de datos, higiene de seguridad y procesos actuales.</p>
          </div>
          <div class="glass-panel" style="padding: 1.75rem 1.25rem;">
            <div style="font-family: var(--f-mono); color: var(--cyan); font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem;">03. Priorizar</div>
            <h4 style="font-size: 1.05rem; color: var(--paper); margin-bottom: 0.5rem;">Foco Crítico</h4>
            <p style="font-size: 0.85rem; color: var(--steel); line-height: 1.6;">Identificar la intervención puntual de mayor apalancamiento que elimine riesgos o multiplique capacidad.</p>
          </div>
          <div class="glass-panel" style="padding: 1.75rem 1.25rem;">
            <div style="font-family: var(--f-mono); color: var(--cyan); font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem;">04. Intervenir</div>
            <h4 style="font-size: 1.05rem; color: var(--paper); margin-bottom: 0.5rem;">Ingeniería Directa</h4>
            <p style="font-size: 0.85rem; color: var(--steel); line-height: 1.6;">Ejecutar ingeniería profesional: refactorización, desarrollo seguro, automatización o estabilización.</p>
          </div>
          <div class="glass-panel" style="padding: 1.75rem 1.25rem;">
            <div style="font-family: var(--f-mono); color: var(--cyan); font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem;">05. Transferir</div>
            <h4 style="font-size: 1.05rem; color: var(--paper); margin-bottom: 0.5rem;">Soberanía Total</h4>
            <p style="font-size: 0.85rem; color: var(--steel); line-height: 1.6;">Traspasar formalmente accesos maestros, repositorios, credenciales y documentación completa.</p>
          </div>
          <div class="glass-panel" style="padding: 1.75rem 1.25rem;">
            <div style="font-family: var(--f-mono); color: var(--cyan); font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem;">06. Acompañar</div>
            <h4 style="font-size: 1.05rem; color: var(--paper); margin-bottom: 0.5rem;">Capacitación</h4>
            <p style="font-size: 0.85rem; color: var(--steel); line-height: 1.6;">Capacitar al personal y brindar un período acotado de soporte para asegurar adopción efectiva.</p>
          </div>
          <div class="glass-panel" style="padding: 1.75rem 1.25rem;">
            <div style="font-family: var(--f-mono); color: var(--cyan); font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem;">07. Medir</div>
            <h4 style="font-size: 1.05rem; color: var(--paper); margin-bottom: 0.5rem;">Registro Transparente</h4>
            <p style="font-size: 0.85rem; color: var(--steel); line-height: 1.6;">Evaluar el resultado objetivo y registrar transparentemente aciertos y aprendizajes en el Ledger.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 04. NO CONSTRUIMOS POR CONSTRUIR SECTION -->
    <section class="section">
      <div class="container">
        <div class="glass-panel" style="padding: 3rem; border-color: rgba(0, 210, 255, 0.2);">
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem; align-items: center;">
            <div>
              <div class="badge">HONESTIDAD DIAGNÓSTICA</div>
              <h2 style="font-size: 1.8rem; color: var(--paper); margin: 0.75rem 0 1rem;">No Construimos por Construir</h2>
              <p style="color: var(--steel-light); font-size: 0.96rem; line-height: 1.75; margin-bottom: 1rem;">
                La tecnología no es un fin en sí misma; es únicamente una herramienta de trabajo. Si una organización necesita un sitio web accesible y rápido, se construye. Si necesita seguridad e higiene técnica, se trabaja en seguridad. Si necesita automatizar flujos de datos, se automatiza.
              </p>
              <p style="color: var(--steel-light); font-size: 0.96rem; line-height: 1.75;">
                Pero si tras el diagnóstico determinamos que la tecnología <strong>no</strong> es la solución adecuada para el problema de la organización, la responsabilidad ética de Grupo Castillo es expresarlo con total claridad y no implementar software innecesario que consuma energía y recursos.
              </p>
            </div>
            <div class="glass-panel" style="padding: 2rem; background: var(--ink);">
              <h4 style="color: var(--cyan); font-size: 1.1rem; margin-bottom: 1rem;">Compromiso de Honestidad Técnica</h4>
              <ul style="list-style: none; padding: 0;">
                <li style="margin-bottom: 0.85rem; display: flex; gap: 0.75rem; font-size: 0.9rem; color: var(--steel-light);">
                  <span style="color: var(--success); font-weight: bold;">[+]</span>
                  <span>Construcción orientada estrictamente a necesidades reales identificadas.</span>
                </li>
                <li style="margin-bottom: 0.85rem; display: flex; gap: 0.75rem; font-size: 0.9rem; color: var(--steel-light);">
                  <span style="color: var(--success); font-weight: bold;">[+]</span>
                  <span>Cero adopción de herramientas complejas que requieran mantenimiento costoso.</span>
                </li>
                <li style="display: flex; gap: 0.75rem; font-size: 0.9rem; color: var(--steel-light);">
                  <span style="color: var(--success); font-weight: bold;">[+]</span>
                  <span>Dictamen honesto cuando la solución requiera procesos humanos, no software.</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 05. CAPACIDADES SECTION -->
    <section id="capacidades" class="section" style="background: var(--ink-surface);">
      <div class="container">
        <div style="text-align: center; max-width: 800px; margin: 0 auto 3rem;">
          <div class="badge badge-cyan">CAPACIDADES TÉCNICAS</div>
          <h2 style="font-size: 2rem; color: var(--paper); margin: 0.75rem 0 1rem;">Ingeniería al Servicio de Causas Legítimas</h2>
          <p style="color: var(--steel-light); font-size: 1rem; line-height: 1.7;">
            Ponemos a disposición de las organizaciones seleccionadas el mismo rigor técnico y estándares de ingeniería aplicados a software de misión crítica.
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem;">
          <div class="glass-panel" style="padding: 1.75rem;">
            <h4 style="color: var(--cyan); font-size: 1.1rem; margin-bottom: 0.5rem;">Ingeniería de Software</h4>
            <p style="font-size: 0.88rem; color: var(--steel); line-height: 1.6;">Desarrollo limpio, modular y mantenible adaptado a los recursos reales de la organización.</p>
          </div>
          <div class="glass-panel" style="padding: 1.75rem;">
            <h4 style="color: var(--cyan); font-size: 1.1rem; margin-bottom: 0.5rem;">Seguridad Higiénica</h4>
            <p style="font-size: 0.88rem; color: var(--steel); line-height: 1.6;">Higiene técnica, detección de credenciales expuestas, transporte cifrado HTTPS y protección de datos.</p>
          </div>
          <div class="glass-panel" style="padding: 1.75rem;">
            <h4 style="color: var(--cyan); font-size: 1.1rem; margin-bottom: 0.5rem;">Automatización</h4>
            <p style="font-size: 0.88rem; color: var(--steel); line-height: 1.6;">Flujos de datos automatizados para eliminar tareas manuales repetitivas y reducir errores humanos.</p>
          </div>
          <div class="glass-panel" style="padding: 1.75rem;">
            <h4 style="color: var(--cyan); font-size: 1.1rem; margin-bottom: 0.5rem;">Infraestructura</h4>
            <p style="font-size: 0.88rem; color: var(--steel); line-height: 1.6;">Configuración y estabilización de servidores, dominios y bases de datos con costos mínimos.</p>
          </div>
          <div class="glass-panel" style="padding: 1.75rem;">
            <h4 style="color: var(--cyan); font-size: 1.1rem; margin-bottom: 0.5rem;">Continuidad Operativa</h4>
            <p style="font-size: 0.88rem; color: var(--steel); line-height: 1.6;">Estrategias de respaldo periódico, recuperación ante contingencias y prevención de pérdida de datos.</p>
          </div>
          <div class="glass-panel" style="padding: 1.75rem;">
            <h4 style="color: var(--cyan); font-size: 1.1rem; margin-bottom: 0.5rem;">Evidencia Técnica</h4>
            <p style="font-size: 0.88rem; color: var(--steel); line-height: 1.6;">Verificación estática y trazabilidad objetiva que acredite la integridad de los entregables.</p>
          </div>
          <div class="glass-panel" style="padding: 1.75rem;">
            <h4 style="color: var(--cyan); font-size: 1.1rem; margin-bottom: 0.5rem;">Documentación</h4>
            <p style="font-size: 0.88rem; color: var(--steel); line-height: 1.6;">Manuales claros y diagramas técnicos comprensibles para que el equipo interno pueda operar el sistema.</p>
          </div>
          <div class="glass-panel" style="padding: 1.75rem;">
            <h4 style="color: var(--cyan); font-size: 1.1rem; margin-bottom: 0.5rem;">Capacitación</h4>
            <p style="font-size: 0.88rem; color: var(--steel); line-height: 1.6;">Sesiones de transferencia técnica directa con el personal de la organización para asegurar autonomía.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 06 & 07. PRINCIPIOS Y SOBERANÍA SECTION -->
    <section id="soberania" class="section">
      <div class="container">
        <div style="text-align: center; max-width: 800px; margin: 0 auto 3rem;">
          <div class="badge">PILAR FUNDAMENTAL</div>
          <h2 style="font-size: 2rem; color: var(--paper); margin: 0.75rem 0 1rem;">Principios y Soberanía Tecnológica</h2>
          <p style="color: var(--steel-light); font-size: 1rem; line-height: 1.7;">
            Garantizamos cuatro principios innegociables para proteger la independencia y dignidad de las organizaciones participantes.
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 3rem;">
          <div class="glass-panel" style="padding: 1.75rem; text-align: center;">
            <div style="font-family: var(--f-mono); color: var(--cyan); font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem;">Sin Costo</div>
            <p style="font-size: 0.85rem; color: var(--steel);">Cero honorarios, tarifas ocultas o expectativas comerciales.</p>
          </div>
          <div class="glass-panel" style="padding: 1.75rem; text-align: center;">
            <div style="font-family: var(--f-mono); color: var(--cyan); font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem;">Sin Dependencia</div>
            <p style="font-size: 0.85rem; color: var(--steel);">Control total de dominios, cuentas, código y accesos.</p>
          </div>
          <div class="glass-panel" style="padding: 1.75rem; text-align: center;">
            <div style="font-family: var(--f-mono); color: var(--cyan); font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem;">Con Evidencia</div>
            <p style="font-size: 0.85rem; color: var(--steel);">Verificación técnica y trazabilidad auditable de resultados.</p>
          </div>
          <div class="glass-panel" style="padding: 1.75rem; text-align: center;">
            <div style="font-family: var(--f-mono); color: var(--cyan); font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem;">Con Transparencia</div>
            <p style="font-size: 0.85rem; color: var(--steel);">Registro formal de proyectos y rendición de cuentas.</p>
          </div>
        </div>

        <div class="glass-panel" style="padding: 2.5rem;">
          <h3 style="font-size: 1.4rem; color: var(--paper); margin-bottom: 1rem;">¿Qué significa exactamente "Sin Dependencia"?</h3>
          <p style="color: var(--steel-light); font-size: 0.95rem; line-height: 1.7; margin-bottom: 1.5rem;">
            La organización participante debe conservar, siempre que sea técnicamente viable, la titularidad y control exclusivo de:
          </p>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem;">
            <div style="padding: 1.25rem; background: var(--ink); border-radius: var(--radius-sm); border: 1px solid var(--line-subtle);">
              <div style="color: var(--cyan); font-weight: 600; font-size: 0.9rem; margin-bottom: 0.25rem;">Dominios y DNS</div>
              <p style="font-size: 0.82rem; color: var(--steel);">Registrados siempre a nombre de la organización en sus propios proveedores.</p>
            </div>
            <div style="padding: 1.25rem; background: var(--ink); border-radius: var(--radius-sm); border: 1px solid var(--line-subtle);">
              <div style="color: var(--cyan); font-weight: 600; font-size: 0.9rem; margin-bottom: 0.25rem;">Cuentas e Infraestructura</div>
              <p style="font-size: 0.82rem; color: var(--steel);">Plataformas de nube y hosting bajo cuentas administradas por la organización.</p>
            </div>
            <div style="padding: 1.25rem; background: var(--ink); border-radius: var(--radius-sm); border: 1px solid var(--line-subtle);">
              <div style="color: var(--cyan); font-weight: 600; font-size: 0.9rem; margin-bottom: 0.25rem;">Código y Licencias</div>
              <p style="font-size: 0.82rem; color: var(--steel);">Código fuente completo entregado con licencias libres o de uso irrestricto.</p>
            </div>
            <div style="padding: 1.25rem; background: var(--ink); border-radius: var(--radius-sm); border: 1px solid var(--line-subtle);">
              <div style="color: var(--cyan); font-weight: 600; font-size: 0.9rem; margin-bottom: 0.25rem;">Datos y Registros</div>
              <p style="font-size: 0.82rem; color: var(--steel);">Custodia y control exclusivo de bases de datos, sin copias no autorizadas.</p>
            </div>
            <div style="padding: 1.25rem; background: var(--ink); border-radius: var(--radius-sm); border: 1px solid var(--line-subtle);">
              <div style="color: var(--cyan); font-weight: 600; font-size: 0.9rem; margin-bottom: 0.25rem;">Accesos Administrativos</div>
              <p style="font-size: 0.82rem; color: var(--steel);">Credenciales maestras y permisos de superusuario en manos del equipo interno.</p>
            </div>
            <div style="padding: 1.25rem; background: var(--ink); border-radius: var(--radius-sm); border: 1px solid var(--line-subtle);">
