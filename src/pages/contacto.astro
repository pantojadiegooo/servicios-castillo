---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQItem from '../components/FAQItem.astro';
import HeroEngineVisual from '../components/HeroEngineVisual.astro';
import TechIcon from '../components/TechIcon.astro';

const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || 'https://formspree.io/f/maewolbo';
const OFFICIAL_WHATSAPP_NUMBER = '529518096110';
---

<BaseLayout
  title="Contacto y Cotización Directa — Grupo Castillo"
  description="Cotiza tu desarrollo web, plataforma o solicita una evaluación técnica de código. Respuesta y propuesta por escrito en menos de 24 horas."
  canonical="https://grupocastillo.lat/contacto"
  ogUrl="https://grupocastillo.lat/contacto"
>
  <main id="main">

    <section class="page-hero">
      <HeroEngineVisual />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="/">Inicio</a> / Contacto &amp; Cotización</p>
        <div class="badge badge-cyan">CANAL DIRECTO • RESPUESTA &lt; 24H</div>
        <h1>Iniciemos tu Proyecto o Evaluación Técnica</h1>
        <p>Cuéntanos sobre tus requerimientos o sitio actual. Te responderemos con una propuesta formal de alcance y presupuesto por escrito en menos de 24 horas.</p>
      </div>
    </section>

    <!-- FORMULARIO PRINCIPAL ADAPTATIVO -->
    <section class="section" style="padding-top: 1rem; padding-bottom: 4rem;">
      <div class="container" style="max-width: 900px;">

        <!-- CANALES DIRECTOS DE ATENCIÓN Y PRESENCIA OFICIAL -->
        <div class="glass-panel reveal" style="padding: 1.25rem 1.75rem; border: 1px solid var(--line-dark); background: rgba(14, 18, 27, 0.7); margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.25rem;">
          <div>
            <span style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--cyan); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700; display: block; margin-bottom: 0.25rem;">Canal Inmediato &amp; Redes Oficiales</span>
            <p style="color: var(--steel-light); font-size: 0.85rem; margin: 0;">Atención directa de ingeniería y presencia digital oficial de Grupo Castillo.</p>
          </div>
          <div style="display: flex; gap: 0.65rem; align-items: center; flex-wrap: wrap;">
            <a href="mailto:contacto@grupocastillo.lat" class="btn btn-outline" style="padding: 0.45rem 0.95rem; font-size: 0.82rem; display: inline-flex; align-items: center; gap: 0.5rem;">
              <TechIcon name="mail" size={16} />
              <span>contacto@grupocastillo.lat</span>
            </a>
            <a href={`https://wa.me/${OFFICIAL_WHATSAPP_NUMBER}`} target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="padding: 0.45rem 0.95rem; font-size: 0.82rem; display: inline-flex; align-items: center; gap: 0.5rem;">
              <TechIcon name="whatsapp" size={16} />
              <span>WhatsApp (+52 951 809 6110)</span>
            </a>
            <a href="https://www.instagram.com/grupocastillooo/" target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="padding: 0.45rem 0.85rem; font-size: 0.82rem; display: inline-flex; align-items: center; gap: 0.45rem;">
              <TechIcon name="instagram" size={16} />
              <span>Instagram</span>
            </a>
            <a href="https://www.facebook.com/profile.php?id=61593987536435" target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="padding: 0.45rem 0.85rem; font-size: 0.82rem; display: inline-flex; align-items: center; gap: 0.45rem;">
              <TechIcon name="facebook" size={16} />
              <span>Facebook</span>
            </a>
          </div>
        </div>

        <!-- BANNER DE DIAGNÓSTICO GUIADO ALTERNATIVO -->
        <div class="glass-panel reveal" style="padding: 1.25rem 1.75rem; border: 1px solid rgba(52, 107, 241, 0.3); background: linear-gradient(135deg, rgba(14, 18, 27, 0.95) 0%, rgba(18, 48, 74, 0.3) 100%); margin-bottom: 2.25rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
          <div>
            <span class="badge badge-cyan" style="font-size: 0.65rem; padding: 2px 6px; margin-bottom: 0.25rem;">TRIAGE COMERCIAL</span>
            <strong style="display: block; color: var(--paper); font-size: 0.95rem;">¿No tienes certeza de cuál servicio o paquete elegir?</strong>
            <p style="color: var(--steel-light); font-size: 0.82rem; margin: 0; line-height: 1.5;">Responde 3 preguntas guiadas en nuestro Diagnóstico para recibir una recomendación automática.</p>
          </div>
          <a href="/diagnostico" class="btn btn-outline" style="padding: 0.5rem 1.2rem; font-size: 0.82rem; white-space: nowrap;">Iniciar Diagnóstico Guiado →</a>
        </div>

        <!-- TARJETA DEL FORMULARIO -->
        <div class="glass-panel reveal" style="padding: 2.5rem; background: rgba(14, 18, 27, 0.9); border-color: rgba(52, 107, 241, 0.25);">
          
          <!-- INDICADOR DINÁMICO DE PRELLENADO (SI VIENE DE PAQUETE O DIAGNÓSTICO) -->
          <div id="prefill-alert" style="display: none; margin-bottom: 1.75rem; padding: 0.85rem 1.25rem; background: rgba(52, 107, 241, 0.08); border-left: 3px solid var(--cyan); border-radius: var(--radius-sm); font-size: 0.85rem; color: var(--paper);">
            <strong style="color: var(--cyan);">Solicitud contextualizada:</strong> <span id="prefill-text">Cotización para paquete seleccionado.</span>
          </div>

          <!-- SELECTOR VISUAL DE INTENCIÓN (PASO 1 • FALLBACK SI NO HAY PRELLENADO) -->
          <div id="intent-selector-wrap" style="margin-bottom: 2rem;">
            <label style="display: block; font-family: var(--f-mono); font-size: 0.82rem; color: var(--cyan); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.75rem;">
              1. ¿Cuál es el objetivo principal de tu consulta?
            </label>
            <div class="grid grid-2" id="intent-selector" style="gap: 0.85rem;">
              
              <button type="button" class="intent-btn active" data-intent="construir" style="text-align: left; padding: 1rem 1.15rem; background: #07090E; border: 1px solid rgba(52, 107, 241, 0.5); border-radius: var(--radius-md); cursor: pointer; transition: all 0.2s ease;">
                <strong style="display: flex; align-items: center; color: var(--paper); font-size: 0.92rem; margin-bottom: 0.2rem;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right: 8px; flex-shrink: 0;"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path></svg>
                  Construir un Nuevo Sitio o Sistema
                </strong>
                <span style="font-size: 0.78rem; color: var(--steel-light); display: block; line-height: 1.4;">Crear una landing page, sitio corporativo, blog autogestionable o software a la medida.</span>
              </button>

              <button type="button" class="intent-btn" data-intent="revisar" style="text-align: left; padding: 1rem 1.15rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-md); cursor: pointer; transition: all 0.2s ease;">
                <strong style="display: flex; align-items: center; color: var(--paper); font-size: 0.92rem; margin-bottom: 0.2rem;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right: 8px; flex-shrink: 0;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                  Evaluar / Auditar Código Existente
                </strong>
                <span style="font-size: 0.78rem; color: var(--steel-light); display: block; line-height: 1.4;">Diagnóstico ágil Castle Checkup (72h) o auditoría profunda de seguridad y arquitectura.</span>
              </button>

              <button type="button" class="intent-btn" data-intent="problema" style="text-align: left; padding: 1rem 1.15rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-md); cursor: pointer; transition: all 0.2s ease;">
                <strong style="display: flex; align-items: center; color: var(--paper); font-size: 0.92rem; margin-bottom: 0.2rem;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right: 8px; flex-shrink: 0;"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                  Intervención / Rescate Técnico
                </strong>
                <span style="font-size: 0.78rem; color: var(--steel-light); display: block; line-height: 1.4;">Corregir fallas en producción, reparar pipelines, parchar CVEs o recuperar control de activos.</span>
              </button>

              <button type="button" class="intent-btn" data-intent="mantenimiento" style="text-align: left; padding: 1rem 1.15rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-md); cursor: pointer; transition: all 0.2s ease;">
                <strong style="display: flex; align-items: center; color: var(--paper); font-size: 0.92rem; margin-bottom: 0.2rem;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right: 8px; flex-shrink: 0;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                  Mantenimiento Continuo (Castle Care)
                </strong>
                <span style="font-size: 0.78rem; color: var(--steel-light); display: block; line-height: 1.4;">Supervisión de uptime, parches de seguridad periódicos y soporte mensual de ingeniería.</span>
              </button>

            </div>
          </div>

          <!-- FORMULARIO PRINCIPAL -->
          <form id="contact-form" class="form-grid" action={formEndpoint} method="POST">
            
            <!-- CAMPO OCULTO DE INTENCIÓN Y ANTISPAM (HONEYPOT) -->
            <input type="hidden" id="intencion_comercial" name="intencion_comercial" value="construir">
            <input type="hidden" id="paquete_origen" name="paquete_origen" value="">
            <div style="position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; opacity: 0; pointer-events: none;" aria-hidden="true">
              <label for="_gotcha_hp">No llenar este campo si eres humano</label>
              <input type="text" id="_gotcha_hp" name="_gotcha" tabindex="-1" autocomplete="off" value="">
            </div>

            <div class="field">
              <label for="nombre">Nombre Completo <span style="color: var(--cyan);">*</span></label>
              <input type="text" id="nombre" name="nombre" required autocomplete="name" placeholder="Ej. Ana Martínez">
            </div>

            <div class="field">
              <label for="empresa">Empresa u Organización <span class="hint">(opcional)</span></label>
              <input type="text" id="empresa" name="empresa" autocomplete="organization" placeholder="Ej. Alpha Consulting">
            </div>

            <div class="field">
              <label for="email">Correo Electrónico Corporativo o Personal <span style="color: var(--cyan);">*</span></label>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder="correo@empresa.com">
            </div>

            <div class="field">
              <label for="whatsapp">Teléfono o WhatsApp <span class="hint">(opcional pero recomendado)</span></label>
              <input type="tel" id="whatsapp" name="whatsapp" autocomplete="tel" placeholder="+52 951 809 6110">
            </div>

            <div class="field">
              <label for="tipo_proyecto">Servicio o Paquete de Interés <span style="color: var(--cyan);">*</span></label>
              <select id="tipo_proyecto" name="tipo_proyecto" required>
                <optgroup label="Desarrollo Web (Paquetes)">
                  <option value="Castle Iron ($2,800 MXN)">Castle Iron — $2,800 MXN (Landing Esencial)</option>
                  <option value="Castle Bronze ($4,500 MXN)">Castle Bronze — $4,500 MXN (Presencia PyME)</option>
                  <option value="Castle Silver ($7,500 MXN)">Castle Silver — $7,500 MXN (Multi-sección)</option>
                  <option value="Castle Gold ($12,500 MXN)" selected>Castle Gold — $12,500 MXN (Más Elegido • Con Blog/CMS)</option>
                  <option value="Castle Platinum ($24,500 MXN)">Castle Platinum — $24,500 MXN (Integrado / Pagos)</option>
                  <option value="Castle Diamond (Desde $40,000 MXN)">Castle Diamond — Desde $40,000 MXN (Software a la Medida)</option>
                </optgroup>
                <optgroup label="Servicios de Ingeniería &amp; Consultoría">
                  <option value="Castle Checkup ($8,900 MXN)">Castle Checkup — $8,900 MXN (Diagnóstico 72h • 100% Bonificable)</option>
                  <option value="Castle Audit ($19,900 MXN)">Castle Audit — Desde $19,900 MXN (Due Diligence Completo)</option>
                  <option value="Consultoría Digital &amp; Roadmap">Consultoría Digital &amp; Roadmap Tecnológico (Sujeto a cotización)</option>
                </optgroup>
                <optgroup label="Intervención &amp; Rescate">
                  <option value="Castle Rescue ($6,900 MXN)">Castle Rescue — Desde $6,900 MXN (Intervención de Código)</option>
                  <option value="Castle Emergency ($5,900 MXN)">Castle Emergency — $5,900 MXN (Atención de Contingencias)</option>
                </optgroup>
                <optgroup label="Mantenimiento &amp; Gobernanza">
                  <option value="Castle Care (Desde $590 MXN/mes)">Castle Care — Desde $590 MXN / mes (Continuidad)</option>
                  <option value="Castle Gate CLI ($9,900 MXN/año)">Castle Gate CLI — $9,900 MXN / año (Gobernanza CQS v1.1)</option>
                  <option value="Otro requerimiento">Otro requerimiento técnico</option>
                </optgroup>
              </select>
            </div>

            <div class="field">
              <label for="presupuesto">Rango de Inversión Orientativo</label>
              <select id="presupuesto" name="presupuesto">
                <option value="">Selecciona un rango estimado</option>
                <option value="hasta-5k">Hasta $5,000 MXN (Iron / Bronze)</option>
                <option value="5k-15k" selected>$5,000 – $15,000 MXN (Silver / Gold)</option>
                <option value="15k-30k">$15,000 – $30,000 MXN (Platinum)</option>
                <option value="mas-40k">$40,000 MXN o más (Diamond / Proyectos Avanzados)</option>
                <option value="checkup">$8,900 MXN (Diagnóstico Checkup 72h)</option>
                <option value="care-mensual">$590 – $2,490 MXN / mes (Castle Care)</option>
                <option value="por-definir">Por definir / Deseo asesoría previa</option>
              </select>
            </div>

            <div class="field full">
              <label for="descripcion">Detalles de tu requerimiento o URL actual <span style="color: var(--cyan);">*</span></label>
              <textarea id="descripcion" name="descripcion" rows="3" required placeholder="Cuéntanos brevemente qué necesitas resolver, las secciones clave que imaginas o la URL de tu sitio/repositorio si deseas una revisión previa."></textarea>
            </div>

            <div class="field full" style="text-align: center; margin-top: 1rem;">
              <button class="btn btn-primary" type="submit" style="width: 100%; max-width: 340px; margin: 0 auto; padding: 0.85rem 1.5rem; font-size: 0.95rem;">
                Enviar Solicitud de Cotización →
              </button>
              <p style="font-size: 0.78rem; color: var(--steel-soft); margin-top: 0.85rem;">
                Toda información se maneja bajo confidencialidad estricta. Te enviamos una propuesta formal en menos de 24 horas.
              </p>
            </div>

          </form>

          <!-- MENSAJE DE ÉXITO DE ENVÍO -->
          <div id="form-success-message" style="display: none; text-align: center; padding: 2rem 1rem; background: rgba(0, 229, 153, 0.04); border: 1px dashed rgba(0, 229, 153, 0.3); border-radius: var(--radius-md); margin-top: 1.5rem;">
            <div style="font-size: 2.5rem; color: #00E599; margin-bottom: 0.75rem;">✓</div>
            <h3 style="font-size: 1.25rem; color: var(--paper); margin-bottom: 0.5rem; font-weight: 700;">¡Solicitud de Cotización Recibida!</h3>
            <p style="color: var(--steel-light); font-size: 0.88rem; line-height: 1.6; max-width: 480px; margin: 0 auto 1.5rem auto;">
              Un ingeniero de Grupo Castillo revisará tu caso en menos de 24 horas y te enviará una propuesta formal por correo electrónico.
            </p>
            <button class="btn btn-outline" onclick="window.location.reload()" style="font-size: 0.8rem; padding: 0.5rem 1.25rem;">Enviar otra solicitud</button>
          </div>

        </div>

        <!-- PANEL INFORMATIVO DE PROCESO POST-CONTACTO -->
        <div class="glass-panel reveal" style="padding: 2rem; background: rgba(14, 18, 27, 0.6); border-color: var(--line-dark); margin-top: 2rem;">
          <h2 style="font-size: 1.15rem; color: var(--cyan); border-bottom: 1px solid var(--line-dark); padding-bottom: 0.75rem; margin-bottom: 1.5rem; font-weight: 700;">
            ¿Qué ocurre después de enviar tu solicitud?
          </h2>
          
          <div class="grid grid-3" style="gap: 1.75rem;">
            <div>
              <div style="font-family: var(--f-mono); font-size: 1.4rem; color: var(--cyan); margin-bottom: 0.4rem; font-weight: bold;">01</div>
              <h3 style="font-size: 0.92rem; color: var(--paper); margin-bottom: 0.4rem; font-weight: 600;">Revisión Técnica (&lt; 24h)</h3>
              <p style="font-size: 0.84rem; color: var(--steel-light); line-height: 1.55; margin: 0;">Un ingeniero de Grupo Castillo analiza tu solicitud o inspecciona tu URL para estructurar el alcance.</p>
            </div>
            <div>
              <div style="font-family: var(--f-mono); font-size: 1.4rem; color: var(--cyan); margin-bottom: 0.4rem; font-weight: bold;">02</div>
              <h3 style="font-size: 0.92rem; color: var(--paper); margin-bottom: 0.4rem; font-weight: 600;">Propuesta por Escrito</h3>
              <p style="font-size: 0.84rem; color: var(--steel-light); line-height: 1.55; margin: 0;">Recibes por correo un desglose claro de entregables, paquete recomendado y presupuesto fijo.</p>
            </div>
            <div>
              <div style="font-family: var(--f-mono); font-size: 1.4rem; color: var(--cyan); margin-bottom: 0.4rem; font-weight: bold;">03</div>
              <h3 style="font-size: 0.92rem; color: var(--paper); margin-bottom: 0.4rem; font-weight: 600;">Sesión Discover (15 min)</h3>
              <p style="font-size: 0.84rem; color: var(--steel-light); line-height: 1.55; margin: 0;">Si la propuesta te resulta adecuada, agendamos una llamada ágil para acordar contrato e inicio.</p>
            </div>
          </div>

          <div style="margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--line-dark); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <p style="font-size: 0.82rem; color: var(--steel-soft); margin: 0;">¿Deseas comparar antes los 6 paquetes web?</p>
            <a href="/paquetes" class="btn btn-outline" style="padding: 0.45rem 1rem; font-size: 0.78rem;">Ver Catálogo de Paquetes →</a>
          </div>
        </div>

      </div>
    </section>

    <!-- SCRIPT DE INTERACCIÓN Y PRELLENADO INTELIGENTE -->
    <script>
      (function() {
        const params = new URLSearchParams(window.location.search);
        let paqParam = params.get('paquete');
        let necParam = params.get('necesidad');
        const presParam = params.get('presupuesto');

        // Fallback de contexto temporal mediante sessionStorage (sin cookies)
        if (!paqParam && !necParam) {
          try {
            const saved = sessionStorage.getItem('castle_diag_selection');
            if (saved) {
              const parsed = JSON.parse(saved);
              if (parsed && (parsed.paquete || parsed.necesidad)) {
                paqParam = parsed.paquete;
                necParam = parsed.necesidad;
              }
            }
          } catch (e) {}
        }
        
        const tipoSelect = document.getElementById('tipo_proyecto');
        const presSelect = document.getElementById('presupuesto');
        const prefillAlert = document.getElementById('prefill-alert');
        const prefillText = document.getElementById('prefill-text');
        const intencionInput = document.getElementById('intencion_comercial');
        const paqueteOrigenInput = document.getElementById('paquete_origen');
        const intentButtons = document.querySelectorAll('.intent-btn');

        // FUNCIÓN PARA ACTIVAR PESTAÑA VISUAL
        function setIntent(intentName) {
          intencionInput.value = intentName;
          intentButtons.forEach(btn => {
            if (btn.getAttribute('data-intent') === intentName) {
              btn.style.borderColor = 'rgba(52, 107, 241, 0.6)';
              btn.style.background = '#0d131f';
            } else {
              btn.style.borderColor = 'var(--line-dark)';
              btn.style.background = '#07090E';
            }
          });
        }

        // LISTENERS PARA SELECTOR DE INTENCIÓN
        intentButtons.forEach(btn => {
          btn.addEventListener('click', function() {
            const intent = this.getAttribute('data-intent');
            setIntent(intent);

            // AUTO-ADAPTAR SELECTS
            if (intent === 'construir') {
              tipoSelect.value = 'Castle Gold ($12,500 MXN)';
              presSelect.value = '5k-15k';
            } else if (intent === 'revisar') {
              tipoSelect.value = 'Castle Checkup ($8,900 MXN)';
              presSelect.value = 'checkup';
            } else if (intent === 'problema') {
              tipoSelect.value = 'Castle Rescue ($6,900 MXN)';
              presSelect.value = '5k-15k';
            } else if (intent === 'mantenimiento') {
              tipoSelect.value = 'Castle Care (Desde $590 MXN/mes)';
              presSelect.value = 'care-mensual';
            }
          });
        });

        // PARSEO DE PARÁMETROS URL
        if (paqParam || necParam) {
          const rawTarget = paqParam || necParam;
          const target = rawTarget.toLowerCase();
          paqueteOrigenInput.value = rawTarget;

          // Ocultar selector redundante si ya se especificó necesidad o paquete en la URL
          const intentWrap = document.getElementById('intent-selector-wrap');
          if (intentWrap) {
            intentWrap.style.display = 'none';
          }

          let detectedIntent = 'construir';
          let matchedOption = '';

          if (target.includes('iron')) {
            matchedOption = 'Castle Iron ($2,800 MXN)';
            presSelect.value = 'hasta-5k';
            detectedIntent = 'construir';
          } else if (target.includes('bronze')) {
            matchedOption = 'Castle Bronze ($4,500 MXN)';
            presSelect.value = 'hasta-5k';
            detectedIntent = 'construir';
          } else if (target.includes('silver')) {
            matchedOption = 'Castle Silver ($7,500 MXN)';
            presSelect.value = '5k-15k';
            detectedIntent = 'construir';
          } else if (target.includes('gold')) {
            matchedOption = 'Castle Gold ($12,500 MXN)';
            presSelect.value = '5k-15k';
            detectedIntent = 'construir';
          } else if (target.includes('platinum')) {
            matchedOption = 'Castle Platinum ($24,500 MXN)';
            presSelect.value = '15k-30k';
            detectedIntent = 'construir';
          } else if (target.includes('diamond') || target.includes('avanzado') || target.includes('medida')) {
            matchedOption = 'Castle Diamond (Desde $40,000 MXN)';
            presSelect.value = 'mas-40k';
            detectedIntent = 'construir';
          } else if (target.includes('checkup')) {
            matchedOption = 'Castle Checkup ($8,900 MXN)';
            presSelect.value = 'checkup';
            detectedIntent = 'revisar';
          } else if (target.includes('audit') || target === 'revisar') {
            matchedOption = target.includes('audit') ? 'Castle Audit ($19,900 MXN)' : 'Castle Checkup ($8,900 MXN)';
            presSelect.value = target.includes('audit') ? '15k-30k' : 'checkup';
            detectedIntent = 'revisar';
          } else if (target.includes('consultoria') || target.includes('roadmap')) {
            matchedOption = 'Consultoría Digital & Roadmap';
            presSelect.value = 'por-definir';
            detectedIntent = 'revisar';
          } else if (target.includes('rescue') || target.includes('mejorar')) {
            matchedOption = 'Castle Rescue ($6,900 MXN)';
            presSelect.value = '5k-15k';
            detectedIntent = 'problema';
          } else if (target.includes('emergency') || target.includes('urgencia') || target === 'problema') {
            matchedOption = target.includes('emergency') ? 'Castle Emergency ($5,900 MXN)' : 'Castle Rescue ($6,900 MXN)';
            presSelect.value = '5k-15k';
            detectedIntent = 'problema';
          } else if (target.includes('care') || target.includes('mantenimiento') || target.includes('cuidado')) {
            matchedOption = 'Castle Care (Desde $590 MXN/mes)';
            presSelect.value = 'care-mensual';
            detectedIntent = 'mantenimiento';
          } else if (target.includes('gate') || target.includes('gobernanza')) {
            matchedOption = 'Castle Gate CLI ($9,900 MXN/año)';
            presSelect.value = '5k-15k';
            detectedIntent = 'revisar';
          } else if (target === 'construir') {
            matchedOption = 'Castle Gold ($12,500 MXN)';
            presSelect.value = '5k-15k';
            detectedIntent = 'construir';
          }

          if (matchedOption) {
            tipoSelect.value = matchedOption;
          }

          setIntent(detectedIntent);

          // MOSTRAR BANNER DE PRELLENADO
          prefillAlert.style.display = 'block';
          prefillText.innerText = 'Has seleccionado ' + rawTarget + '. El formulario ha sido configurado para acelerar tu solicitud.';
        }

        if (presParam && presSelect) {
          presSelect.value = presParam;
        }

        // Intercept form submission for AJAX post and GA4 Lead event triggering
        const form = document.getElementById('contact-form');
        const successMsg = document.getElementById('form-success-message');
        if (form && successMsg) {
          form.addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Check honeypot for spam mitigation
            const gotchaInput = form.querySelector('input[name="_gotcha"]');
            if (gotchaInput && gotchaInput.value) {
              form.style.display = 'none';
              const prefillAlert = document.getElementById('prefill-alert');
              if (prefillAlert) prefillAlert.style.display = 'none';
              const intentSelector = document.getElementById('intent-selector-wrap');
              if (intentSelector) intentSelector.style.display = 'none';
              successMsg.style.display = 'block';
              return;
            }

            const submitBtn = form.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerText;
            submitBtn.disabled = true;
            submitBtn.innerText = 'Enviando...';

            const formData = new FormData(form);
            fetch(form.action, {
              method: 'POST',
              body: formData,
              headers: { 'Accept': 'application/json' }
            })
            .then(function(res) {
              if (res.ok) {
                form.style.display = 'none';
                const prefillAlert = document.getElementById('prefill-alert');
                if (prefillAlert) prefillAlert.style.display = 'none';
                const intentSelector = document.getElementById('intent-selector-wrap');
                if (intentSelector) intentSelector.style.display = 'none';
                successMsg.style.display = 'block';

                // GA4 generate_lead Event (with NO personal information!)
                if (typeof window.gtag === 'function') {
                  const selectedService = document.getElementById('tipo_proyecto').value;
                  const intencion = document.getElementById('intencion_comercial').value;
                  window.gtag('event', 'generate_lead', {
                    cta_location: 'contacto',
                    package_name: selectedService,
                    intent_type: intencion,
                    contact_method: 'formspree'
                  });
                }
              } else {
                alert('Hubo un problema al enviar tu solicitud. Por favor intenta de nuevo o escríbenos directamente a contacto@grupocastillo.lat.');
                submitBtn.disabled = false;
                submitBtn.innerText = originalText;
              }
            })
            .catch(function() {
              alert('Error de conexión. Por favor verifica tu red o contáctanos por WhatsApp/Correo.');
              submitBtn.disabled = false;
              submitBtn.innerText = originalText;
            });
          });
        }
      })();
    </script>

