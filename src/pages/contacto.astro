---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQItem from '../components/FAQItem.astro';
import InnerHeroVisual from '../components/InnerHeroVisual.astro';

const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || 'https://formspree.io/f/maewolbo';
---

<BaseLayout
  title="Contacto y Diagnóstico Inicial — Grupo Castillo"
  description="Cotiza tu desarrollo o solicita un diagnóstico técnico Castle Checkup para tu repositorio o sitio web. Respuesta en menos de 24 horas hábiles."
  canonical="https://servicios-castillo.vercel.app/contacto.html"
  ogUrl="https://servicios-castillo.vercel.app/contacto.html"
>
  <main id="main">

    <section class="page-hero">
      <InnerHeroVisual type="contacto" />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="/index.html">Inicio</a> / Contacto &amp; Cotización</p>
        <h1>Iniciemos tu Proyecto Digital</h1>
        <p>Cuéntanos sobre tu negocio o sitio web actual. Te enviamos una evaluación técnica y propuesta de trabajo en menos de 24 horas hábiles.</p>
      </div>
    </section>

    <!-- ORIENTACIÓN PREVIA DIAGNÓSTICO -->
    <section class="section" style="padding-top: 1rem; padding-bottom: 1.5rem;">
      <div class="container" style="max-width: 920px;">
        <div class="glass-panel reveal" style="padding: 1.25rem 1.75rem; border-left: 3px solid var(--cyan); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; background: rgba(14, 18, 27, 0.75);">
          <div>
            <strong style="color: var(--paper); font-size: 0.95rem;">¿No tienes certeza de cuál paquete o servicio elegir?</strong>
            <p style="color: var(--steel-light); font-size: 0.82rem; margin: 0.2rem 0 0 0;">Utiliza nuestro Diagnóstico Castillo para obtener una recomendación técnica en menos de 2 minutos.</p>
          </div>
          <a href="/diagnostico.html" class="btn btn-outline" style="padding: 0.45rem 1rem; font-size: 0.8rem;">Iniciar Diagnóstico →</a>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top: 0.5rem;">
      <div class="container">
        <!-- Formulario centrado -->
        <div class="reveal" style="max-width: 920px; margin: 0 auto 4rem auto;">
          <form id="contact-form" class="form-grid" action={formEndpoint} method="POST">
            <div class="field">
              <label for="nombre">Nombre Completo o Empresa</label>
              <input type="text" id="nombre" name="nombre" required autocomplete="name" placeholder="Ej. Ana Martínez / Grupo Alpha">
            </div>
            <div class="field">
              <label for="email">Correo Electrónico</label>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder="correo@empresa.com">
            </div>
            <div class="field">
              <label for="whatsapp">Teléfono / WhatsApp <span class="hint">(opcional)</span></label>
              <input type="tel" id="whatsapp" name="whatsapp" autocomplete="tel" placeholder="+52 55 1234 5678">
            </div>
            <div class="field">
              <label for="necesidad">¿Qué necesita tu negocio?</label>
              <select id="necesidad" name="necesidad" required>
                <option value="">Selecciona una opción</option>
                <option value="checkup">Diagnóstico Castle Checkup ($8,900 MXN / 72h)</option>
                <option value="iron">Presencia Digital Básica (Castle Iron - $2,800 MXN)</option>
                <option value="crear">Crear un sitio web nuevo (Build Bronze a Diamond)</option>
                <option value="mejorar">Acelerar o reparar web actual (Castle Rescue / Intervention)</option>
                <option value="auditar">Auditoría profunda de arquitectura y seguridad (Castle Audit)</option>
                <option value="gate-licencia">Licenciamiento de Castle Gate CLI (C1 a C6)</option>
                <option value="transformar">Reconstruir / Migrar plataforma obsoleta (Transformation)</option>
                <option value="cuidado">Mantenimiento y gobernanza continua (Castle Care)</option>
                <option value="urgencia">Intervención prioritaria urgente (Castle Emergency)</option>
                <option value="otro">Otro requerimiento a medida</option>
              </select>
            </div>
            <div class="field">
              <label for="presupuesto">Presupuesto Estimado / Paquete</label>
              <select id="presupuesto" name="presupuesto">
                <option value="">Selecciona un rango aproximado (MXN)</option>
                <option value="checkup">$8,900 MXN (~$525 USD) — Castle Checkup 72h</option>
                <option value="care-essential">$3,500 MXN / mes (~$205 USD) — Care Essential</option>
                <option value="care-pro">$7,900 MXN / mes (~$465 USD) — Care Pro</option>
                <option value="care-enterprise">$17,900 MXN / mes (~$1,050 USD) — Care Enterprise</option>
                <option value="gate-c1">$9,900 MXN / año — Castle Gate C1 Foundation</option>
                <option value="gate-c2">$16,900 MXN / año — Castle Gate C2 Standard</option>
                <option value="gate-c3">$26,900 MXN / año — Castle Gate C3 Professional</option>
                <option value="iron">$2,800 MXN (~$165 USD) — Castle Iron</option>
                <option value="bronze">$4,500 MXN — Castle Bronze</option>
                <option value="silver">$7,500 MXN — Castle Silver</option>
                <option value="gold">$12,500 MXN — Castle Gold</option>
                <option value="platinum">$24,500 MXN — Castle Platinum</option>
                <option value="diamond">$40,000 MXN o más — Castle Diamond / A Medida</option>
                <option value="rescue">$6,900 – $12,900 MXN — Castle Rescue</option>
                <option value="audit">$19,900 – $39,900 MXN — Castle Audit</option>
                <option value="emergency">Desde $5,900 MXN — Castle Emergency</option>
                <option value="por-definir">Requiero asesoría previa</option>
              </select>
            </div>
            <div class="field">
              <label for="plazo">Plazo Deseado de Entrega</label>
              <select id="plazo" name="plazo">
                <option value="">Selecciona una prioridad</option>
                <option value="urgente">Lo antes posible (1 a 2 semanas)</option>
                <option value="normal">Estándar (2 a 4 semanas)</option>
                <option value="planificado">Sin prisa / Planificación a futuro</option>
              </select>
            </div>
            <div class="field full">
              <label for="descripcion">Detalles de tu Proyecto o Repositorio</label>
              <textarea id="descripcion" name="descripcion" rows="4" required placeholder="Cuéntanos brevemente de tu negocio, los objetivos de tu web o la dirección URL / stack de tu proyecto."></textarea>
            </div>
            <div class="field full" style="text-align: center; margin-top: 1rem;">
              <button class="btn btn-primary" type="submit" style="width: 100%; max-width: 320px; margin: 0 auto;">Solicitar Propuesta</button>
              <p style="font-size:.8rem; color:var(--steel-soft); margin-top:.75rem;">Tu información es confidencial. Te respondemos en menos de 24 horas hábiles.</p>
            </div>
          </form>
          <p style="font-size:.78rem; color:var(--steel-soft); margin-top:1.5rem; text-align:center;">Tu solicitud llega directamente a los ingenieros de Grupo Castillo.</p>
        </div>

        <!-- ¿Qué ocurre después de enviar? -->
        <div class="reveal" style="max-width: 920px; margin: 0 auto;">
          <div class="gate-report wide" style="background: var(--ink-card); border: 1px solid var(--line-dark); border-radius: var(--radius-lg); box-shadow: var(--shadow-md);">
            <div class="gate-report-head" style="font-size: 1.25rem; color: var(--cyan); border-bottom: 1px solid var(--line-dark); padding-bottom: 1rem; margin-bottom: 1.5rem;">
              <strong>¿Qué ocurre después de enviar?</strong>
            </div>
            <div class="grid grid-3" style="gap: 2rem;">
              <div>
                <div style="font-family: var(--f-mono); font-size: 1.5rem; color: var(--cyan); margin-bottom: 0.5rem; font-weight: bold;">01</div>
                <h4 style="font-size: 0.95rem; color: var(--paper); margin-bottom: 0.5rem; font-weight: 600;">Revisión Técnica</h4>
                <p style="font-size: 0.85rem; color: var(--steel-light); line-height: 1.6; margin: 0;">Analizamos la información de tu proyecto o inspeccionamos tu URL actual bajo criterios de optimización.</p>
              </div>
              <div>
                <div style="font-family: var(--f-mono); font-size: 1.5rem; color: var(--cyan); margin-bottom: 0.5rem; font-weight: bold;">02</div>
                <h4 style="font-size: 0.95rem; color: var(--paper); margin-bottom: 0.5rem; font-weight: 600;">Propuesta Clara</h4>
                <p style="font-size: 0.85rem; color: var(--steel-light); line-height: 1.6; margin: 0;">Te enviamos por correo una propuesta detallada de alcance, paquete recomendado y presupuesto por escrito.</p>
              </div>
              <div>
                <div style="font-family: var(--f-mono); font-size: 1.5rem; color: var(--cyan); margin-bottom: 0.5rem; font-weight: bold;">03</div>
                <h4 style="font-size: 0.95rem; color: var(--paper); margin-bottom: 0.5rem; font-weight: 600;">Etapa Discover</h4>
                <p style="font-size: 0.85rem; color: var(--steel-light); line-height: 1.6; margin: 0;">Si apruebas la propuesta, agendamos una llamada de 15 minutos para iniciar la fase formal de planificación.</p>
              </div>
            </div>

            <div style="margin-top: 2.25rem; padding-top: 1.5rem; border-top: 1px solid var(--line-dark); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
              <p style="font-size: .85rem; color: var(--steel-soft); margin: 0;">¿Prefieres explorar primero los paquetes?</p>
              <a href="/paquetes.html" class="btn btn-outline" style="padding: 0.55rem 1.25rem; font-size: 0.8rem; height: auto;">Ver comparativa de Castle Packages →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-dim" id="faq">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Preguntas Frecuentes</p>
          <h2>Todo claro antes de iniciar.</h2>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿En cuánto tiempo recibiré respuesta?" answer="Analizamos cada solicitud en menos de 24 horas hábiles. Te enviaremos un correo con la evaluación inicial y las opciones recomendadas." />
              <FAQItem question="¿Debo tener todo el contenido listo para empezar?" answer="No necesariamente. Te orientamos en la estructura de contenidos durante la fase inicial Discover y organizamos la información de tu negocio." />
              <FAQItem question="¿Puedo solicitar solo un diagnóstico técnico Checkup?" answer="Sí, absolutamente. Castle Checkup ($8,900 MXN) y Castle Audit son servicios independientes para diagnosticar problemas de carga, secretos o seguridad sin compromiso de contratar otro servicio." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Los presupuestos tienen algún costo?" answer="No. La evaluación inicial y el desglose de cotización son completamente gratuitos y sin compromiso comercial." />
              <FAQItem question="¿Qué pasa si mi presupuesto es ajustado?" answer="Te asesoramos para comenzar con Castle Iron ($2,800 MXN) o Castle Bronze ($4,500 MXN) que ofrecen calidad y velocidad sin comprometer tu inversión." />
              <FAQItem question="¿Cómo se valida la calidad del trabajo?" answer="Todo proyecto, independientemente del presupuesto, debe aprobar las pruebas de rendimiento, accesibilidad y seguridad de nuestro protocolo Castillo Quality Gate." />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Context pre-population script -->
    <script is:inline>
      (function() {
        const params = new URLSearchParams(window.location.search);
        const paquete = params.get('paquete');
        const necesidad = params.get('necesidad');

        if (necesidad) {
          const necSelect = document.getElementById('necesidad');
          if (necSelect) {
            for (let i = 0; i < necSelect.options.length; i++) {
              if (necSelect.options[i].value === necesidad) {
                necSelect.selectedIndex = i;
                break;
              }
            }
          }
        }

        if (paquete) {
          const presSelect = document.getElementById('presupuesto');
          const descInput = document.getElementById('descripcion');
          if (presSelect) {
            const pLower = paquete.toLowerCase();
            for (let i = 0; i < presSelect.options.length; i++) {
              if (presSelect.options[i].text.toLowerCase().includes(pLower)) {
                presSelect.selectedIndex = i;
                break;
              }
            }
          }
          if (descInput && !descInput.value) {
            descInput.value = `Interesado en cotizar: ${paquete}.`;
          }
        }
      })();
    </script>

  </main>
</BaseLayout>
