---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQItem from '../components/FAQItem.astro';

const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || 'https://formspree.io/f/maewolbo';
---

<BaseLayout
  title="Contacto y Diagnóstico Inicial — Servicios Castillo"
  description="Cotiza tu desarrollo o solicita un diagnóstico técnico para tu sitio web. Respuesta en menos de 24 horas hábiles."
  canonical="https://servicios-castillo.vercel.app/contacto.html"
  ogUrl="https://servicios-castillo.vercel.app/contacto.html"
>
  <main id="main">

    <section class="page-hero">
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="index.html">Inicio</a> / Contacto &amp; Cotización</p>
        <h1>Iniciemos tu Proyecto Digital</h1>
        <p>Cuéntanos sobre tu negocio o sitio web actual. Te enviamos una evaluación técnica y propuesta de trabajo en menos de 24 horas hábiles.</p>
      </div>
    </section>

    <section class="section">
      <div class="container two-col">
        <div class="reveal">
          <form id="contact-form" class="form-grid" action={formEndpoint} method="POST">
            <div class="field">
              <label for="nombre">Nombre Completo o Empresa</label>
              <input type="text" id="nombre" name="nombre" required autocomplete="name" placeholder="Ej. Ana Martínez / Grupo Alpha">
            </div>
            <div class="field">
              <label for="email">Correo Electrónico</label>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder="correo@empresa.com">
            </div>
            <div class="field">
              <label for="whatsapp">Teléfono / WhatsApp <span class="hint">(opcional)</span></label>
              <input type="tel" id="whatsapp" name="whatsapp" autocomplete="tel" placeholder="+52 55 1234 5678">
            </div>
            <div class="field">
              <label for="necesidad">¿Qué necesita tu negocio?</label>
              <select id="necesidad" name="necesidad" required>
                <option value="">Selecciona una opción</option>
                <option value="crear">Crear un sitio web nuevo (Build)</option>
                <option value="mejorar">Acelerar o reparar mi web actual (Intervention)</option>
                <option value="auditar">Diagnosticar velocidad y seguridad (Audit)</option>
                <option value="transformar">Reconstruir/Migrar plataforma obsoleta (Transformation)</option>
                <option value="cuidado">Mantenimiento y soporte continuo (Care)</option>
                <option value="otro">Otro requerimiento a medida</option>
              </select>
            </div>
            <div class="field">
              <label for="presupuesto">Presupuesto Estimado</label>
              <select id="presupuesto" name="presupuesto">
                <option value="">Selecciona un rango aproximado</option>
                <option value="4.5-7.5k">$4,500 – $7,500 MXN (Bronze / Silver)</option>
                <option value="7.5-12.5k">$7,500 – $12,500 MXN (Silver / Gold)</option>
                <option value="12.5-24.5k">$12,500 – $24,500 MXN (Gold / Platinum)</option>
                <option value="24.5-40k">$24,500 – $40,000 MXN (Platinum / Diamond)</option>
                <option value="40k+">$40,000 MXN o más (Diamond / A Medida)</option>
                <option value="por-definir">Requiero asesoría previa</option>
              </select>
            </div>
            <div class="field">
              <label for="plazo">Plazo Deseado de Entrega</label>
              <select id="plazo" name="plazo">
                <option value="">Selecciona una prioridad</option>
                <option value="urgente">Lo antes posible (1 a 2 semanas)</option>
                <option value="normal">Estándar (2 a 4 semanas)</option>
                <option value="planificado">Sin prisa / Planificación a futuro</option>
              </select>
            </div>
            <div class="field full">
              <label for="descripcion">Detalles de tu Proyecto o Sitio Actual</label>
              <textarea id="descripcion" name="descripcion" rows="4" required placeholder="Cuéntanos brevemente de tu negocio, los objetivos de tu web o la dirección URL de tu sitio actual si necesitas una revisión."></textarea>
            </div>
            <div class="field full">
              <button class="btn btn-gold" type="submit">Enviar Solicitud de Cotización</button>
              <p style="font-size:.8rem; color:var(--steel-soft); margin-top:.5rem;">🔒 Tu información es 100% confidencial. Respuesta técnica en menos de 24h hábiles. Sin compromisos ni llamadas molestas de ventas.</p>
            </div>
          </form>
          <p style="font-size:.78rem; color:var(--steel-soft); margin-top:1rem;">Canal oficial de recepción de solicitudes activado mediante transmisión segura encriptada (Formspree).</p>
        </div>
        <div class="reveal">
          <div class="gate-report">
            <div class="gate-report-head"><strong>¿Qué ocurre después de enviar?</strong></div>
            <ol style="margin-top:1rem; padding-left:1.2rem; color:var(--paper-soft); font-size:.9rem; line-height:1.6;">
              <li style="margin-bottom:.5rem;"><strong>Revisión Técnica:</strong> Analizamos la información de tu proyecto o inspeccionamos tu URL actual.</li>
              <li style="margin-bottom:.5rem;"><strong>Propuesta Clara:</strong> Te enviamos por correo una propuesta de alcance, paquete recomendado y presupuesto por escrito.</li>
              <li><strong>Etapa Discover:</strong> Si apruebas la propuesta, agendamos una llamada breve para iniciar la construcción o intervención.</li>
            </ol>
            <div style="margin-top:1.5rem; padding-top:1rem; border-top:1px solid rgba(255,255,255,0.08);">
              <p style="font-size:.85rem; color:var(--steel);">¿Prefieres explorar primero los paquetes?</p>
              <a href="paquetes.html" style="color:var(--gold); font-size:.9rem; text-decoration:underline;">Ver comparativa completa de Castle Packages →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-dim" id="faq">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Preguntas Frecuentes</p>
          <h2>Todo claro antes de iniciar.</h2>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿En cuánto tiempo recibiré respuesta?" answer="Analizamos cada formulario en menos de 24 horas hábiles. Te enviaremos un correo con la evaluación inicial y las opciones recomendadas." />
              <FAQItem question="¿Debo tener todo el contenido listo para empezar?" answer="No necesariamente. Te orientamos en la estructura de contenidos durante la fase inicial Discover y organizamos la información de tu negocio." />
              <FAQItem question="¿Puedo solicitar solo una auditoría técnica?" answer="Sí, absolutamente. Castle Audit es un servicio independiente para diagnosticar problemas de carga o seguridad sin compromiso de contratar otro servicio." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Los presupuestos tienen algún costo?" answer="No. La evaluación inicial y el desglose de cotización son completamente gratuitos y sin compromiso comercial." />
              <FAQItem question="¿Qué pasa si mi presupuesto es ajustado?" answer="Te asesoramos para definir un producto mínimo viables con nuestro paquete Castle Bronze ($4,500 MXN) que garantice calidad y velocidad sin comprometer tu inversión." />
              <FAQItem question="¿Cómo garantizan la calidad del trabajo?" answer="Todo proyecto, independientemente del presupuesto, debe aprobar las pruebas de rendimiento, accesibilidad y seguridad de nuestro protocolo Castillo Quality Gate." />
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
