---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABand from '../components/CTABand.astro';
import InnerHeroVisual from '../components/InnerHeroVisual.astro';
---

<BaseLayout
  title="Casos de Estudio y Demostración de Capacidades — Grupo Castillo"
  description="Explora nuestros casos de estudio de arquitectura web, incluyendo la auditoría técnica en vivo de nuestra propia plataforma digital."
  canonical="https://servicios-castillo.vercel.app/proyectos.html"
  ogUrl="https://servicios-castillo.vercel.app/proyectos.html"
>
  <main id="main">

    <section class="page-hero">
      <InnerHeroVisual type="proyectos" />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="/index.html">Inicio</a> / Proyectos</p>
        <h1>Casos de Estudio &amp; Caso de Referencia Propio</h1>
        <p>Demostramos nuestra ingeniería mediante la auditoría técnica en vivo de nuestra propia plataforma y casos ilustrativos estructurados por problema, solución y resultados verificables.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <!-- LIVING CASE STUDY -->
        <div class="reveal" style="margin-bottom:3rem;">
          <article class="project-case glass-panel" style="border-color: rgba(0, 210, 255, 0.3); background: rgba(14, 18, 27, 0.75); padding: 2.25rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
              <span class="badge badge-cyan" style="font-weight:700;">PROYECTO PROPIO — LIVING CASE STUDY EN VIVO</span>
            </div>

            <h2 style="margin-top:1rem; font-size:1.6rem; color:var(--paper);">Plataforma Digital Grupo Castillo — Caso de Referencia Propio</h2>
            <p style="color:var(--steel-light); margin-block:.75rem; max-width:70ch;">La mejor demostración de lo que construimos es nuestro propio sitio web: una plataforma de carga ágil, segura y accesible sin utilizar sobreingeniería ni dependencias innecesarias.</p>

            <div class="grid grid-3" style="margin-block:1.5rem; gap:1rem;">
              <div class="card glass-panel" style="padding:1.25rem; background: rgba(10, 12, 15, 0.85); border: 1px solid var(--line-dark);">
                <span style="font-size:.75rem; color:var(--steel-soft); text-transform:uppercase; letter-spacing:0.05em; font-family:var(--f-mono);">Compilación Estática</span>
                <p style="font-size:1.4rem; font-weight:700; color:var(--cyan); margin-top:.2rem;">&lt; 1.5s SSG</p>
                <p style="font-size:.82rem; color:var(--steel-light); margin: 0;">23 rutas .html generadas por Astro SSG</p>
              </div>
              <div class="card glass-panel" style="padding:1.25rem; background: rgba(10, 12, 15, 0.85); border: 1px solid var(--line-dark);">
                <span style="font-size:.75rem; color:var(--steel-soft); text-transform:uppercase; letter-spacing:0.05em; font-family:var(--f-mono);">JavaScript Cliente</span>
                <p style="font-size:1.4rem; font-weight:700; color:var(--cyan); margin-top:.2rem;">Nativo Modular</p>
                <p style="font-size:.82rem; color:var(--steel-light); margin: 0;">0 frameworks pesados, 0 bundles inflados</p>
              </div>
              <div class="card glass-panel" style="padding:1.25rem; background: rgba(10, 12, 15, 0.85); border: 1px solid var(--line-dark);">
                <span style="font-size:.75rem; color:var(--steel-soft); text-transform:uppercase; letter-spacing:0.05em; font-family:var(--f-mono);">Auditoría de Dependencias</span>
                <p style="font-size:1.4rem; font-weight:700; color:var(--cyan); margin-top:.2rem;">0 Vulnerabilidades</p>
                <p style="font-size:.82rem; color:var(--steel-light); margin: 0;">Resultado verificado en escaneo <code style="font-size:.75rem; background:rgba(255,255,255,0.06); color:var(--paper);">npm audit</code></p>
              </div>
            </div>

            <dl class="case-steps">
              <div><dt>Desafío Técnico</dt><dd style="color:var(--steel-light);">Crear una web comercial liviana, elegante y accesible sin recurrir a plantillas recargadas ni frameworks client-side pesados.</dd></div>
              <div><dt>Arquitectura</dt><dd style="color:var(--steel-light);">Astro SSG estático, Vanilla CSS modularizado, JavaScript nativo ES6+ y etiquetado estructurado Schema.org.</dd></div>
              <div><dt>Validación Gate</dt><dd style="color:var(--steel-light);">Compilación estática limpia, 0 errores en <code style="font-size:.8rem; background:rgba(255,255,255,0.08); color:var(--paper);">astro check</code> y accesibilidad WCAG 2.2 AA auditada.</dd></div>
            </dl>
          </article>
        </div>

        <div class="section-head reveal" style="margin-top:3rem;">
          <p class="eyebrow" style="color: var(--cyan);">Metodología de Trabajo</p>
          <h2>Demostración por Línea de Servicio</h2>
        </div>

        <div class="grid grid-2 reveal">
          <article class="project-case glass-panel" style="padding: 2rem;">
            <span class="badge badge-demo">Caso Ilustrativo — Desarrollo Web</span>
            <h3 style="margin-top:.9rem;">Desarrollo Institucional para Negocio de Servicios</h3>
            <dl class="case-steps">
              <div><dt>Problema</dt><dd>Dependencia exclusiva de redes sociales sin presencia web propia ni canal formal de captación.</dd></div>
              <div><dt>Solución</dt><dd>Sitio multi-sección con arquitectura de contenido clara, enlace directo a WhatsApp y formulario accesible.</dd></div>
              <div><dt>Tecnología</dt><dd>HTML5 semántico, CSS responsivo y optimización de velocidad de carga.</dd></div>
              <div><dt>Validación</dt><dd>Verificado bajo las 9 etapas del protocolo Castillo Quality Gate.</dd></div>
            </dl>
          </article>
        
          <article class="project-case glass-panel" style="padding: 2rem;">
            <span class="badge badge-demo">Caso Ilustrativo — Rescue</span>
            <h3 style="margin-top:.9rem;">Optimización de Rendimiento &amp; Reparación Móvil</h3>
            <dl class="case-steps">
              <div><dt>Problema</dt><dd>Tiempos de carga lentos, fallas en pantallas de celular y scripts de terceros bloqueantes.</dd></div>
              <div><dt>Solución</dt><dd>Optimización de recursos (WebP), eliminación de CSS/JS no utilizado y saneamiento de responsividad.</dd></div>
              <div><dt>Tecnología</dt><dd>Auditoría de navegación + optimización de assets + refactorización en código.</dd></div>
              <div><dt>Validación</dt><dd>Prueba de rendimiento y Core Web Vitals post-intervención.</dd></div>
            </dl>
          </article>
        
          <article class="project-case glass-panel" style="padding: 2rem;">
            <span class="badge badge-demo">Caso Ilustrativo — Migración</span>
            <h3 style="margin-top:.9rem;">Reconstrucción y Migración de Sitio Legacy</h3>
            <dl class="case-steps">
              <div><dt>Problema</dt><dd>Plataforma basada en CMS antiguo, difícil de actualizar y propensa a fallas de seguridad.</dd></div>
              <div><dt>Solución</dt><dd>Reconstrucción en arquitectura moderna, rediseño UX/UI y mapa de redirecciones 301 para SEO.</dd></div>
              <div><dt>Tecnología</dt><dd>Astro SSG + diseño responsivo + preservación de URLs canónicas históricas.</dd></div>
              <div><dt>Validación</dt><dd>Quality Gate completo con verificación de cero enlaces rotos.</dd></div>
            </dl>
          </article>
        
          <article class="project-case glass-panel" style="padding: 2rem;">
            <span class="badge badge-demo">Caso Ilustrativo — Care</span>
            <h3 style="margin-top:.9rem;">Mantenimiento Técnico Continuo &amp; Supervisión</h3>
            <dl class="case-steps">
              <div><dt>Problema</dt><dd>Sitio en producción sin supervisión activa, propenso a incidencias y desactualizaciones de librerías.</dd></div>
              <div><dt>Solución</dt><dd>Supervisión estructurada de disponibilidad, respaldos periódicos y parches de seguridad.</dd></div>
              <div><dt>Tecnología</dt><dd>Monitoreo continuo + actualizaciones técnicas + reportes mensuales de estado.</dd></div>
              <div><dt>Validación</dt><dd>Reporte de salud y estabilidad de la plataforma.</dd></div>
            </dl>
          </article>
        </div>

        <p style="margin-top:2rem; color:var(--steel-soft); font-size:.85rem; max-width:65ch;">Nota de transparencia: Los casos etiquetados como "Caso Ilustrativo" muestran la metodología de análisis y documentación que aplicamos en cada desarrollo. Esta sección se actualiza continuamente con proyectos autorizados por nuestros clientes.</p>
      </div>
    </section>

    <CTABand
      title="¿Quieres que tu negocio tenga una plataforma con este estándar de ingeniería?"
      description="Cuéntanos tus requerimientos o inicia con un diagnóstico técnico guiado."
      ctaLabel="Iniciar Diagnóstico"
      ctaHref="/diagnostico.html"
    />

  </main>
</BaseLayout>
