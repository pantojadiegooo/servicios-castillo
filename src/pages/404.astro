---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABand from '../components/CTABand.astro';
import InnerHeroVisual from '../components/InnerHeroVisual.astro';
---

<BaseLayout
  title="Página No Encontrada (404) — Grupo Castillo"
  description="La página solicitada no está disponible o ha sido reubicada dentro del portal oficial de Grupo Castillo."
  canonical="https://grupocastillo.lat/404"
  ogUrl="https://grupocastillo.lat/404"
>
  <main id="main">

    <section class="page-hero">
      <InnerHeroVisual type="diagnostico" />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="/">Inicio</a> / Error 404</p>
        <div class="badge badge-cyan">404 • DIRECCIÓN NO ENCONTRADA</div>
        <h1>La página que buscas no existe o ha sido reubicada.</h1>
        <p>Verifica que la dirección esté escrita correctamente o utiliza nuestro menú para navegar hacia el catálogo o las líneas de servicio.</p>
        <div class="hero-actions" style="margin-top:1.5rem; display: flex; gap: 1rem; flex-wrap: wrap;">
          <a class="btn btn-primary" href="/">Volver al Inicio</a>
          <a class="btn btn-outline" href="/diagnostico">Diagnóstico de Necesidad</a>
          <a class="btn btn-outline" href="/contacto">Contacto</a>
        </div>
      </div>
    </section>

    <CTABand
      title="¿Tienes dudas sobre qué servicio necesitas?"
      description="Utiliza nuestro Diagnóstico Castillo para obtener una recomendación técnica inmediata."
      ctaLabel="Iniciar Diagnóstico"
      ctaHref="/diagnostico"
    />

  </main>
</BaseLayout>
