---
import BaseLayout from '../layouts/BaseLayout.astro';
import GateSchematic from '../components/GateSchematic.astro';
import CTABand from '../components/CTABand.astro';
import InnerHeroVisual from '../components/InnerHeroVisual.astro';
---

<BaseLayout
  title="Castle Transformation — Reconstrucción y Migración Digital | Grupo Castillo"
  description="Rediseño, migración de plataforma y nueva arquitectura tecnológica cuando la base actual ya no permite escalar."
  canonical="https://servicios-castillo.vercel.app/transformacion.html"
  ogUrl="https://servicios-castillo.vercel.app/transformacion.html"
>
  <main id="main">

    <section class="page-hero">
      <InnerHeroVisual type="transformacion" />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="/index.html">Inicio</a> / <a href="/servicios.html">Servicios</a> / Castle Transformation</p>
        <p class="eyebrow">TRANSFORMATION</p>
        <h1>Castle Transformation: Reconstruir sobre cimientos sólidos.</h1>
        <p>Cuando la base técnica de tu sitio es obsoleta, lenta o costosa de mantener, migramos la solución hacia una arquitectura moderna, limpia y escalable.</p>
      </div>
    </section>

    <section class="section">
      <div class="container two-col">
        <div class="reveal">
          <p class="eyebrow">¿Cuándo transformar?</p>
          <h2>Escenarios de Reconstrucción</h2>
          <ul class="check-list" style="margin-top:1rem;">
            <li><strong>Sistemas legacy inmanejables:</strong> Sitios construidos sobre plantillas recargadas o plugins incompatibles.</li>
            <li><strong>Migración de plataforma (Replatforming):</strong> Cambio de CMS o migración hacia una arquitectura estática ultra rápida.</li>
            <li><strong>Rediseño UX/UI orientado a conversión:</strong> Renovación de la experiencia visual y arquitectura de información.</li>
            <li><strong>Consolidación de infraestructura:</strong> Unificación de landing pages o sitios dispersos bajo un solo estándar de calidad.</li>
          </ul>
        </div>
        <div class="reveal">
          <p class="eyebrow">Estrategia de ejecución</p>
          <h2>Proceso de Transformación</h2>
          <div class="process-list">
            <div class="process-row" style="padding-block:.85rem; grid-template-columns:50px 1fr;">
              <span class="process-code">01</span>
              <div><h3 style="font-size:1rem;">Discovery &amp; Auditoría Inicial</h3><p style="font-size:.85rem; color:var(--steel-light);">Rescatamos la lógica funcional y contenido valioso de la web anterior.</p></div>
            </div>
            <div class="process-row" style="padding-block:.85rem; grid-template-columns:50px 1fr;">
              <span class="process-code">02</span>
              <div><h3 style="font-size:1rem;">Arquitectura &amp; Diseño</h3><p style="font-size:.85rem; color:var(--steel-light);">Definimos la nueva pila tecnológica, estructura de datos y experiencia UX.</p></div>
            </div>
            <div class="process-row" style="padding-block:.85rem; grid-template-columns:50px 1fr;">
              <span class="process-code">03</span>
              <div><h3 style="font-size:1rem;">Desarrollo Modular</h3><p style="font-size:.85rem; color:var(--steel-light);">Construimos la nueva plataforma asegurando velocidad y código mantenible.</p></div>
            </div>
            <div class="process-row" style="padding-block:.85rem; grid-template-columns:50px 1fr;">
              <span class="process-code">04</span>
              <div><h3 style="font-size:1rem;">Migración &amp; Redirecciones SEO</h3><p style="font-size:.85rem; color:var(--steel-light);">Preservamos el posicionamiento de tus URLs actuales mediante redirecciones limpias.</p></div>
            </div>
            <div class="process-row" style="padding-block:.85rem; grid-template-columns:50px 1fr;">
              <span class="process-code">05</span>
              <div><h3 style="font-size:1rem;">Gate &amp; Lanzamiento</h3><p style="font-size:.85rem; color:var(--steel-light);">Validación completa bajo el Security &amp; Quality Gate antes del despliegue.</p></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-dim">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Castillo Security &amp; Quality Gate</p>
          <h2>Validación rigurosa en el lanzamiento</h2>
          <p>Toda transformación es sometida a validación de calidad para asegurar Core Web Vitals óptimos y SEO preservado.</p>
        </div>
        <div class="reveal">
          <GateSchematic compact={true} />
        </div>
      </div>
    </section>

    <CTABand
      title="¿Tu plataforma actual ya no aguanta el crecimiento del negocio?"
      description="Hablemos de cómo migrar o reconstruir la arquitectura sin perder lo que ya funciona ni arriesgar tu posicionamiento SEO."
      ctaLabel="Iniciar Diagnóstico Castillo"
      ctaHref="/diagnostico.html"
    />

  </main>
</BaseLayout>
