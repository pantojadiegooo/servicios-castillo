---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQItem from '../components/FAQItem.astro';
import CTABand from '../components/CTABand.astro';
import InnerHeroVisual from '../components/InnerHeroVisual.astro';
---

<BaseLayout
  title="Catálogo Comercial y Paquetes de Ingeniería — Grupo Castillo"
  description="Catálogo oficial de desarrollo web y gobernanza tecnológica de Grupo Castillo: Paquetes Build (Iron a Diamond) y continuidad técnica con Castle Care."
  canonical="https://servicios-castillo.vercel.app/paquetes.html"
  ogUrl="https://servicios-castillo.vercel.app/paquetes.html"
>
  <main id="main">

    <section class="page-hero">
      <InnerHeroVisual type="paquetes" />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="index.html">Inicio</a> / Catálogo de Paquetes</p>
        <h1>Catálogo de Paquetes: Ingeniería con Alcance y Precios Claros</h1>
        <p>Desde presencia digital básica para independientes hasta plataformas complejas de software a medida, todo respaldado por nuestro protocolo de validación técnica.</p>
      </div>
    </section>

    <!-- 1. BUILD PACKAGES (IRON TO DIAMOND) -->
    <section class="section">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Línea Build: Proyectos de Desarrollo Único</p>
          <h2>Escalera Progresiva de Soluciones Web</h2>
          <p>Seis niveles estructurados según el alcance, complejidad y objetivos de tu negocio. Precios iniciales de mercado.</p>
        </div>

        <div class="packages-grid-6 reveal">
          
          <!-- IRON -->
          <div class="package-card" data-tier="iron">
            <span class="tier-swatch" aria-hidden="true"></span>
            <div class="package-profile">Micronegocios &amp; Profesionales</div>
            <h3>Castle Iron</h3>
            <div class="package-price-wrap">
              <div class="package-price">$2,800 MXN</div>
              <span class="price-sub-usd">~$165 USD</span>
            </div>
            <p style="font-size: 0.82rem; color: var(--steel-soft); margin-bottom: 1rem; line-height: 1.45; min-height: 48px;">
              <strong>Ideal si:</strong> Eres un profesional independiente o negocio local que necesita presencia en internet hoy con WhatsApp y carga instantánea.
            </p>
            <ul>
              <li>Presencia digital esencial y veloz</li>
              <li>Estructura One-Page / Tarjeta digital</li>
              <li>Diseño responsivo optimizado para móviles</li>
              <li>Botón directo de WhatsApp y llamada</li>
              <li>Configuración de dominio y SSL</li>
              <li>SEO técnico base de indexación</li>
              <li>Castillo Quality Gate base incluido</li>
            </ul>
            <div class="package-rounds">1 ronda de revisión</div>
            <a class="btn btn-outline" href="contacto.html?paquete=Castle%20Iron">Solicitar Iron</a>
          </div>

          <!-- BRONZE -->
          <div class="package-card" data-tier="bronze">
            <span class="tier-swatch" aria-hidden="true"></span>
            <div class="package-profile">Comercios Locales &amp; Landing Pages</div>
            <h3>Castle Bronze</h3>
            <div class="package-price-wrap">
              <div class="package-price">$4,500 MXN</div>
              <span class="price-sub-usd">~$265 USD</span>
            </div>
            <p style="font-size: 0.82rem; color: var(--steel-soft); margin-bottom: 1rem; line-height: 1.45; min-height: 48px;">
              <strong>Ideal si:</strong> Quieres promocionar un servicio o campaña específica mediante una landing page comercial con formulario de clientes.
            </p>
            <ul>
              <li>Landing page comercial personalizada</li>
              <li>Hasta 5 secciones de contenido</li>
              <li>Diseño adaptativo móvil y desktop</li>
              <li>Integración con WhatsApp y Formulario</li>
              <li>SEO técnico por sección</li>
              <li>Optimización de imágenes y carga</li>
              <li>Conexión segura HTTPS y SSL</li>
              <li>Accesibilidad base (WCAG)</li>
              <li>Castillo Quality Gate incluido</li>
            </ul>
            <div class="package-rounds">2 rondas de revisión</div>
            <a class="btn btn-outline" href="contacto.html?paquete=Castle%20Bronze">Solicitar Bronze</a>
          </div>

          <!-- SILVER -->
          <div class="package-card" data-tier="silver">
            <span class="tier-swatch" aria-hidden="true"></span>
            <div class="package-profile">PyMEs &amp; Empresas de Servicios</div>
            <h3>Castle Silver</h3>
            <div class="package-price-wrap">
              <div class="package-price">$7,500 MXN</div>
              <span class="price-sub-usd">~$440 USD</span>
            </div>
            <p style="font-size: 0.82rem; color: var(--steel-soft); margin-bottom: 1rem; line-height: 1.45; min-height: 48px;">
              <strong>Ideal si:</strong> Tu empresa requiere un sitio web corporativo estructurado de hasta 5 páginas para presentar servicios, credenciales y equipo.
            </p>
            <ul>
              <li>Sitio corporativo de hasta 5 páginas</li>
              <li>Diseño visual a medida</li>
              <li>Arquitectura de contenidos y servicios</li>
              <li>Formularios de contacto accesibles</li>
              <li>Botón directo de WhatsApp</li>
              <li>SEO técnico optimizado por página</li>
              <li>Optimización de velocidad de carga</li>
              <li>Verificación de accesibilidad y seguridad</li>
              <li>Castillo Quality Gate incluido</li>
            </ul>
            <div class="package-rounds">3 rondas de revisión</div>
            <a class="btn btn-outline" href="contacto.html?paquete=Castle%20Silver">Solicitar Silver</a>
          </div>

          <!-- GOLD (POPULAR) -->
          <div class="package-card" data-tier="gold">
            <span class="package-tag">Más Popular</span>
            <span class="tier-swatch" aria-hidden="true"></span>
            <div class="package-profile">Empresas en Crecimiento &amp; Conversión</div>
            <h3>Castle Gold</h3>
            <div class="package-price-wrap">
              <div class="package-price">$12,500 MXN</div>
              <span class="price-sub-usd">~$735 USD</span>
            </div>
            <p style="font-size: 0.82rem; color: var(--steel-soft); margin-bottom: 1rem; line-height: 1.45; min-height: 48px;">
              <strong>Ideal si:</strong> Buscas máxima velocidad, posicionamiento SEO, gestión de blog/CMS autogestionable y diseño orientado a captar prospectos.
            </p>
            <ul>
              <li>Plataforma web de 8 a 10 páginas</li>
              <li>Diseño UX/UI enfocado en conversión</li>
              <li>SEO técnico avanzado estructurado</li>
              <li>Formularios y flujos de leads a medida</li>
              <li>Gestor CMS / Blog autogestionable</li>
              <li>Optimización Core Web Vitals (LCP &lt; 1s)</li>
              <li>Accesibilidad WCAG 2.2 AA</li>
              <li>Pruebas multiplataforma exhaustivas</li>
              <li>Certificado de entrega y código fuente</li>
              <li>Castillo Quality Gate completo</li>
            </ul>
            <div class="package-rounds">4 rondas de revisión</div>
            <a class="btn btn-primary" href="contacto.html?paquete=Castle%20Gold">Solicitar Castle Gold</a>
          </div>

          <!-- PLATINUM -->
          <div class="package-card" data-tier="platinum">
            <span class="tier-swatch" aria-hidden="true"></span>
            <div class="package-profile">Corporativos &amp; Plataformas Integradas</div>
            <h3>Castle Platinum</h3>
            <div class="package-price-wrap">
              <div class="package-price">$24,500 MXN</div>
              <span class="price-sub-usd">~$1,440 USD</span>
            </div>
            <p style="font-size: 0.82rem; color: var(--steel-soft); margin-bottom: 1rem; line-height: 1.45; min-height: 48px;">
              <strong>Ideal si:</strong> Necesitas conectar tu plataforma con CRMs, pasarelas de pago o APIs externas bajo alta fidelidad y seguridad reforzada.
            </p>
            <ul>
              <li>Arquitectura de hasta 15 páginas</li>
              <li>Diseño avanzado de alta fidelidad</li>
              <li>Gestor CMS con flujos personalizados</li>
              <li>Integraciones externas con APIs o CRM</li>
              <li>SEO y rendimiento de alta especificación</li>
              <li>Hardening de seguridad reforzado</li>
              <li>Pruebas funcionales y de compatibilidad</li>
              <li>Auditoría técnica previa al lanzamiento</li>
              <li>Castillo Quality Gate completo</li>
            </ul>
            <div class="package-rounds">5 rondas de revisión</div>
            <a class="btn btn-outline" href="contacto.html?paquete=Castle%20Platinum">Solicitar Platinum</a>
          </div>

          <!-- DIAMOND -->
          <div class="package-card" data-tier="diamond">
            <span class="tier-swatch" aria-hidden="true"></span>
            <div class="package-profile">Software a Medida &amp; Alta Escala</div>
            <h3>Castle Diamond</h3>
            <div class="package-price-wrap">
              <div class="package-price">Desde $40,000 MXN</div>
              <span class="price-sub-usd">~$2,350 USD</span>
            </div>
            <p style="font-size: 0.82rem; color: var(--steel-soft); margin-bottom: 1rem; line-height: 1.45; min-height: 48px;">
              <strong>Ideal si:</strong> Requieres un sistema web a medida, portal de clientes, plataforma e-commerce de alto volumen o arquitectura de alta disponibilidad.
            </p>
            <ul>
              <li>Desarrollo de software web personalizado</li>
              <li>Sin límites artificiales de páginas</li>
              <li>Portales, paneles y autenticación</li>
              <li>Bases de datos y APIs dedicadas</li>
              <li>Integración de sistemas y automatización</li>
              <li>Arquitectura de alta disponibilidad</li>
              <li>Evaluación bajo políticas C4 a C6</li>
              <li>Presupuesto según requerimientos</li>
            </ul>
            <div class="package-rounds">Rondas según alcance</div>
            <a class="btn btn-outline" href="contacto.html?paquete=Castle%20Diamond">Solicitar Propuesta</a>
          </div>

        </div>
        <p class="currency-disclaimer">
          * Precios iniciales de lanzamiento en pesos mexicanos (MXN). Equivalente USD informativo aproximado; la cotización final y facturación contractual se realiza en MXN. Solicitudes adicionales fuera de alcance se cotizan y documentan por escrito antes de iniciar.
        </p>
      </div>
    </section>

    <!-- 2. CASTLE CARE (RECURRING SUBSCRIPTION LINE) -->
    <section class="section section-dark" id="care">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Línea Recurrente: Continuidad &amp; Gobernanza</p>
          <h2>Castle Care: Acompañamiento Técnico Mensual</h2>
          <p>¿Qué ocurre después del lanzamiento? Supervisión activa, parches de seguridad y horas de ingeniería de rescate incluidas en tu contrato mensual.</p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem;">
          
          <!-- ESSENTIAL -->
          <div class="card glass-panel" style="padding: 2.25rem;">
            <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-light); font-weight: 700;">PLAN MENSUAL</span>
            <h3 style="font-size: 1.3rem; margin: 0.5rem 0 0.25rem 0;">Care Essential</h3>
            <div class="package-price-wrap">
              <div class="package-price">$3,500 MXN <span style="font-size: 0.85rem; font-weight: normal; color: var(--steel-soft);">/ mes</span></div>
              <span class="price-sub-usd">~$205 USD / mes</span>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem;">
              <li style="padding: 6px 0; font-size: 0.88rem; color: var(--steel-light); border-top: 1px dashed var(--line-dark);">✔ 1 Repositorio activo monitoreado</li>
              <li style="padding: 6px 0; font-size: 0.88rem; color: var(--steel-light); border-top: 1px dashed var(--line-dark);">✔ 1 Revisión mensual de certificados y score</li>
              <li style="padding: 6px 0; font-size: 0.88rem; color: var(--steel-light); border-top: 1px dashed var(--line-dark);">✔ 1 Sesión mensual (hasta 1 hora)</li>
              <li style="padding: 6px 0; font-size: 0.88rem; color: var(--steel-light); border-top: 1px dashed var(--line-dark);">✔ Monitoreo de disponibilidad y respaldos</li>
              <li style="padding: 6px 0; font-size: 0.88rem; color: var(--steel-light); border-top: 1px dashed var(--line-dark);">✔ 15% Descuento en horas de Castle Rescue</li>
            </ul>
            <a href="contacto.html?necesidad=cuidado" class="btn btn-outline" style="width: 100%;">Solicitar Care Essential</a>
          </div>

          <!-- PRO -->
          <div class="card glass-panel" style="padding: 2.25rem; border-color: rgba(0, 210, 255, 0.35); background: linear-gradient(180deg, rgba(0, 210, 255, 0.05) 0%, var(--glass-surface) 100%);">
            <span class="badge badge-cyan" style="margin-bottom: 0.5rem; font-size: 0.68rem; padding: 2px 7px;">RECOMENDADO</span>
            <h3 style="font-size: 1.3rem; margin: 0.5rem 0 0.25rem 0;">Care Pro</h3>
            <div class="package-price-wrap">
              <div class="package-price">$7,900 MXN <span style="font-size: 0.85rem; font-weight: normal; color: var(--steel-soft);">/ mes</span></div>
              <span class="price-sub-usd">~$465 USD / mes</span>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem;">
              <li style="padding: 6px 0; font-size: 0.88rem; color: var(--steel-light); border-top: 1px dashed var(--line-dark);">✔ Hasta 3 Repositorios activos monitoreados</li>
              <li style="padding: 6px 0; font-size: 0.88rem; color: var(--steel-light); border-top: 1px dashed var(--line-dark);">✔ 2 Revisiones mensuales + seguimiento CI/CD</li>
              <li style="padding: 6px 0; font-size: 0.88rem; color: var(--steel-light); border-top: 1px dashed var(--line-dark);">✔ 2 Sesiones mensuales de consultoría</li>
              <li style="padding: 6px 0; font-size: 0.88rem; color: var(--cyan); font-weight: 600; border-top: 1px dashed var(--line-dark);">✔ 4 Horas/mes de Remediación Directa (Rescue)</li>
              <li style="padding: 6px 0; font-size: 0.88rem; color: var(--steel-light); border-top: 1px dashed var(--line-dark);">✔ Canal de atención prioritario</li>
            </ul>
            <a href="contacto.html?necesidad=cuidado" class="btn btn-primary" style="width: 100%;">Solicitar Care Pro</a>
          </div>

          <!-- ENTERPRISE -->
          <div class="card glass-panel" style="padding: 2.25rem;">
            <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-light); font-weight: 700;">ALTA DISPONIBILIDAD</span>
            <h3 style="font-size: 1.3rem; margin: 0.5rem 0 0.25rem 0;">Care Enterprise</h3>
            <div class="package-price-wrap">
              <div class="package-price">$17,900 MXN <span style="font-size: 0.85rem; font-weight: normal; color: var(--steel-soft);">/ mes</span></div>
              <span class="price-sub-usd">~$1,050 USD / mes</span>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem;">
              <li style="padding: 6px 0; font-size: 0.88rem; color: var(--steel-light); border-top: 1px dashed var(--line-dark);">✔ Hasta 8 Repositorios en gobernanza continua</li>
              <li style="padding: 6px 0; font-size: 0.88rem; color: var(--steel-light); border-top: 1px dashed var(--line-dark);">✔ Revisiones continuas y seguimiento de releases</li>
              <li style="padding: 6px 0; font-size: 0.88rem; color: var(--steel-light); border-top: 1px dashed var(--line-dark);">✔ Mesa de arquitectura (hasta 4 sesiones/mes)</li>
              <li style="padding: 6px 0; font-size: 0.88rem; color: var(--cyan); font-weight: 600; border-top: 1px dashed var(--line-dark);">✔ 10 Horas/mes de Remediación Directa (Rescue)</li>
              <li style="padding: 6px 0; font-size: 0.88rem; color: var(--steel-light); border-top: 1px dashed var(--line-dark);">✔ Atención prioritaria y servicios Emergency bajo condiciones</li>
            </ul>
            <a href="contacto.html?necesidad=cuidado" class="btn btn-outline" style="width: 100%;">Solicitar Care Enterprise</a>
          </div>

        </div>
        <p class="currency-disclaimer">
          * Planes de suscripción mensual facturados en MXN. Las horas de remediación no utilizadas no se acumulan entre períodos. Horas adicionales o intervenciones fuera de alcance se cotizan por separado.
        </p>
      </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="section section-dim">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Preguntas Frecuentes sobre el Catálogo</p>
          <h2>Dudas habituales antes de contratar.</h2>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Qué diferencia hay entre un paquete Build y Castle Care?" answer="Los paquetes Build (Iron a Diamond) son proyectos de desarrollo de entrega única con alcance cerrado. Castle Care es una suscripción mensual recurrente para mantener la seguridad, el uptime y la calidad del código a lo largo del tiempo." />
              <FAQItem question="¿El dominio y el hosting están incluidos?" answer="El costo de hosting y dominio es propiedad del cliente. Te asesoramos para contratar la infraestructura directamente a tu nombre, garantizando que el dominio y las cuentas te pertenezcan por completo desde el primer día." />
              <FAQItem question="¿Cómo funcionan las rondas de revisión?" answer="En cada ronda te presentamos los avances de diseño o funcionalidad. Recopilamos tu retroalimentación y realizamos los ajustes solicitados dentro del alcance acordado antes del lanzamiento final." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Puedo solicitar cambios de alcance durante el proyecto?" answer="Sí. Si durante el proceso decides agregar más secciones o funciones, evaluamos el cambio, te entregamos una cotización complementaria clara y continuamos sin sorpresas." />
              <FAQItem question="¿Todos los paquetes incluyen el Castillo Quality Gate?" answer="Sí, absolutamente. Sin importar si contratas Castle Iron o Castle Diamond, cada entrega pasa por nuestras pruebas de rendimiento, seguridad y accesibilidad." />
              <FAQItem question="¿Entregan el código fuente de la página?" answer="Sí. Al finalizar el proyecto y aprobar el Gate, te entregamos la documentación del proyecto y el repositorio con el código fuente para que tengas propiedad absoluta." />
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTABand
      title="¿Tienes dudas sobre cuál opción elegir?"
      description="Cuéntanos sobre tu negocio y te ayudaremos a elegir la opción técnica y económica ideal."
      ctaLabel="Hablar con un Especialista"
      ctaHref="contacto.html"
    />

  </main>
</BaseLayout>
