---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQItem from '../components/FAQItem.astro';
import CTABand from '../components/CTABand.astro';
import ModularAssemblyVisual from '../components/ModularAssemblyVisual.astro';
---

<BaseLayout
  title="Catálogo Oficial de Sitios Web — Grupo Castillo"
  description="Catálogo de desarrollo web e ingeniería de Grupo Castillo: 5 sitios web estandarizados (Iron a Platinum) con precios transparentes en MXN y Proyectos Avanzados a medida."
  canonical="https://servicios-castillo.vercel.app/paquetes.html"
  ogUrl="https://servicios-castillo.vercel.app/paquetes.html"
>
  <main id="main">

    <section class="page-hero">
      <ModularAssemblyVisual />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="/index.html">Inicio</a> / Sitios Web</p>
        <div class="badge badge-cyan">CATÁLOGO DE SITIOS WEB • 5 NIVELES ESTANDARIZADOS</div>
        <h1>Sitios Web Profesionales e Ingeniería Digital</h1>
        <p>Precios claros, alcance delimitado por escrito y titularidad del código para el cliente desde el primer día.</p>
      </div>
    </section>

    <!-- ORIENTACIÓN Y SEGMENTACIÓN -->
    <section class="section" style="padding-top: 1.5rem; padding-bottom: 2rem;">
      <div class="container">
        <div class="glass-panel reveal" style="padding: 1.75rem 2rem; background: rgba(14, 18, 27, 0.7); border-color: rgba(255, 255, 255, 0.08);">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
            <div style="font-size: 0.82rem; font-family: var(--f-mono); color: var(--cyan); text-transform: uppercase; letter-spacing: 0.06em;">
              Orientación por Tipo de Negocio
            </div>
            <a href="/diagnostico.html" style="font-size: 0.82rem; color: var(--cyan); text-decoration: underline; font-weight: 600;">¿Incertidumbre sobre qué nivel elegir? Iniciar Diagnóstico →</a>
          </div>
          <div class="grid grid-3" style="gap: 1.5rem;">
            <div style="border-left: 2px solid var(--steel-soft); padding-left: 1rem;">
              <h4 style="font-size: 0.95rem; color: var(--paper); margin-bottom: 0.35rem;">Personas / Profesionales / Micronegocios</h4>
              <p style="font-size: 0.85rem; color: var(--steel-light); margin: 0; line-height: 1.5;">
                Presencia ágil y botón directo a WhatsApp. Recomendados: <strong>Castle Iron</strong> ($2,800 MXN) y <strong>Castle Bronze</strong> ($4,500 MXN).
              </p>
            </div>
            <div style="border-left: 2px solid var(--cyan); padding-left: 1rem;">
              <h4 style="font-size: 0.95rem; color: var(--paper); margin-bottom: 0.35rem;">PyMEs / Empresas</h4>
              <p style="font-size: 0.85rem; color: var(--steel-light); margin: 0; line-height: 1.5;">
                Sitios corporativos y blogs autogestionables. Recomendados: <strong>Castle Silver</strong> ($7,500 MXN) y <strong>Castle Gold</strong> ($12,500 MXN).
              </p>
            </div>
            <div style="border-left: 2px solid var(--paper); padding-left: 1rem;">
              <h4 style="font-size: 0.95rem; color: var(--paper); margin-bottom: 0.35rem;">Equipos de Software / Organizaciones</h4>
              <p style="font-size: 0.85rem; color: var(--steel-light); margin: 0; line-height: 1.5;">
                Integraciones complejas, APIs y alta escala. Recomendados: <strong>Castle Platinum</strong> ($24,500 MXN) y <strong>Proyectos Avanzados</strong> (Desde $40,000 MXN).
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- LOS 5 SITIOS WEB ESTANDARIZADOS -->
    <section class="section" id="catalogo-sitios" style="padding-top: 1rem;">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Sitios Web Estandarizados</p>
          <h2>Catálogo de 5 Sitios Web</h2>
          <p>Desde presencia básica para profesionistas independientes hasta plataformas integradas con pasarelas de pago.</p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem; margin-bottom: 3rem;">
          
          <!-- 1. CASTLE IRON -->
          <div class="card glass-panel" style="padding: 2.25rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-light); font-weight: 700;">NIVEL 01 • ESENCIAL</span>
            </div>
            <h3 style="font-size: 1.4rem; margin: 0.25rem 0;">Castle Iron</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); margin-bottom: 1.25rem; min-height: 2.8rem;">
              Presencia digital esencial One-Page para profesionistas y micronegocios.
            </p>
            <div class="package-price-wrap" style="margin-bottom: 1.25rem;">
              <div class="package-price" style="font-size: 1.4rem; font-family: var(--f-mono); font-weight: 700; color: var(--paper);">$2,800 MXN</div>
              <span class="price-sub-usd" style="display: block; font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-soft); margin-top: 0.25rem;">~$165 USD</span>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
              <li>Estructura One-Page (1 vista ágil)</li>
              <li>Enlace directo a WhatsApp</li>
              <li>Optimización de carga instantánea</li>
              <li>Certificado SSL y hosting incluido</li>
              <li>1 ronda de revisión formal</li>
            </ul>
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
              <a class="btn btn-outline" href="/paquetes/iron.html" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Ficha Técnica →</a>
              <a class="btn btn-primary" href="/contacto.html?paquete=Castle%20Iron" style="width: 100%; text-align: center; font-size: 0.82rem;">Cotizar Castle Iron</a>
            </div>
          </div>

          <!-- 2. CASTLE BRONZE -->
          <div class="card glass-panel" style="padding: 2.25rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-light); font-weight: 700;">NIVEL 02 • CAPTACIÓN</span>
            </div>
            <h3 style="font-size: 1.4rem; margin: 0.25rem 0;">Castle Bronze</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); margin-bottom: 1.25rem; min-height: 2.8rem;">
              Landing comercial enfocada en conversión para campañas y nuevos productos.
            </p>
            <div class="package-price-wrap" style="margin-bottom: 1.25rem;">
              <div class="package-price" style="font-size: 1.4rem; font-family: var(--f-mono); font-weight: 700; color: var(--paper);">$4,500 MXN</div>
              <span class="price-sub-usd" style="display: block; font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-soft); margin-top: 0.25rem;">~$265 USD</span>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
              <li>Hasta 5 secciones estructuradas</li>
              <li>Formulario de captación de clientes</li>
              <li>Integración analítica básica</li>
              <li>Diseño adaptado a móviles</li>
              <li>2 rondas de revisión formal</li>
            </ul>
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
              <a class="btn btn-outline" href="/paquetes/bronze.html" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Ficha Técnica →</a>
              <a class="btn btn-primary" href="/contacto.html?paquete=Castle%20Bronze" style="width: 100%; text-align: center; font-size: 0.82rem;">Cotizar Castle Bronze</a>
            </div>
          </div>

          <!-- 3. CASTLE SILVER -->
          <div class="card glass-panel" style="padding: 2.25rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-light); font-weight: 700;">NIVEL 03 • CORPORATIVO</span>
            </div>
            <h3 style="font-size: 1.4rem; margin: 0.25rem 0;">Castle Silver</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); margin-bottom: 1.25rem; min-height: 2.8rem;">
              Sitio corporativo multi-página para empresas que requieren estructura formal.
            </p>
            <div class="package-price-wrap" style="margin-bottom: 1.25rem;">
              <div class="package-price" style="font-size: 1.4rem; font-family: var(--f-mono); font-weight: 700; color: var(--paper);">$7,500 MXN</div>
              <span class="price-sub-usd" style="display: block; font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-soft); margin-top: 0.25rem;">~$440 USD</span>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
              <li>Hasta 5 páginas completas independientes</li>
              <li>Menú de navegación interactivo</li>
              <li>SEO on-page y metadatos estructurados</li>
              <li>Protocolo de validación técnica incluido</li>
              <li>3 rondas de revisión formal</li>
            </ul>
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
              <a class="btn btn-outline" href="/paquetes/silver.html" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Ficha Técnica →</a>
              <a class="btn btn-primary" href="/contacto.html?paquete=Castle%20Silver" style="width: 100%; text-align: center; font-size: 0.82rem;">Cotizar Castle Silver</a>
            </div>
          </div>

          <!-- 4. CASTLE GOLD (POPULAR) -->
          <div class="card glass-panel" style="padding: 2.25rem; border-color: rgba(0, 210, 255, 0.35); background: linear-gradient(180deg, rgba(0, 210, 255, 0.05) 0%, var(--glass-surface) 100%);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.75rem;">
              <span class="badge badge-cyan" style="font-size: 0.65rem; padding: 2px 7px;">MÁS POPULAR</span>
              <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--cyan); font-weight: 700;">NIVEL 04</span>
            </div>
            <h3 style="font-size: 1.4rem; margin: 0.25rem 0;">Castle Gold</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); margin-bottom: 1.25rem; min-height: 2.8rem;">
              Plataforma de crecimiento corporativo con Blog / CMS autogestionable.
            </p>
            <div class="package-price-wrap" style="margin-bottom: 1.25rem;">
              <div class="package-price" style="font-size: 1.4rem; font-family: var(--f-mono); font-weight: 700; color: var(--paper);">$12,500 MXN</div>
              <span class="price-sub-usd" style="display: block; font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-soft); margin-top: 0.25rem;">~$735 USD</span>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
              <li>8 a 10 páginas completas</li>
              <li>Blog / CMS autogestionable</li>
              <li>Optimización Core Web Vitals</li>
              <li>SEO avanzado Schema.org (JSON-LD)</li>
              <li>4 rondas de revisión formal</li>
            </ul>
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
              <a class="btn btn-outline" href="/paquetes/gold.html" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Ficha Técnica →</a>
              <a class="btn btn-primary" href="/contacto.html?paquete=Castle%20Gold" style="width: 100%; text-align: center; font-size: 0.82rem;">Cotizar Castle Gold</a>
            </div>
          </div>

          <!-- 5. CASTLE PLATINUM -->
          <div class="card glass-panel" style="padding: 2.25rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-light); font-weight: 700;">NIVEL 05 • INTEGRADO</span>
            </div>
            <h3 style="font-size: 1.4rem; margin: 0.25rem 0;">Castle Platinum</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); margin-bottom: 1.25rem; min-height: 2.8rem;">
              Plataforma avanzada con integración de APIs, CRM, pagos y seguridad reforzada.
            </p>
            <div class="package-price-wrap" style="margin-bottom: 1.25rem;">
              <div class="package-price" style="font-size: 1.4rem; font-family: var(--f-mono); font-weight: 700; color: var(--paper);">$24,500 MXN</div>
              <span class="price-sub-usd" style="display: block; font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-soft); margin-top: 0.25rem;">~$1,440 USD</span>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
              <li>Hasta 15 páginas y secciones dinámicas</li>
              <li>Integración de pagos (Stripe / Mercado Pago)</li>
              <li>Conexión con CRM y bases de datos</li>
              <li>Hardening de seguridad y cabeceras estrictas</li>
              <li>5 rondas de revisión formal</li>
            </ul>
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
              <a class="btn btn-outline" href="/paquetes/platinum.html" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Ficha Técnica →</a>
              <a class="btn btn-primary" href="/contacto.html?paquete=Castle%20Platinum" style="width: 100%; text-align: center; font-size: 0.82rem;">Cotizar Castle Platinum</a>
            </div>
          </div>

        </div>

        <p class="currency-disclaimer" style="text-align: center; margin-bottom: 3rem;">
          * Tarifas expresadas en pesos mexicanos (MXN). Equivalentes en USD son informativos. La cotización contractual y facturación se realiza en MXN.
        </p>
      </div>
    </section>

    <!-- PROYECTOS AVANZADOS (SECCIÓN INDEPENDIENTE FUERA DE LA TABLA) -->
    <section class="section section-dark" id="proyectos-avanzados">
      <div class="container">
        <div class="two-col reveal" style="align-items: center; gap: 3.5rem;">
          <div>
            <span class="badge badge-cyan" style="margin-bottom: 0.75rem;">DESARROLLO A LA MEDIDA</span>
            <h2 style="font-size: 2.1rem; line-height: 1.2; margin-bottom: 1rem; color: var(--paper);">Proyectos Avanzados</h2>
            <p style="font-size: 1.05rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.25rem;">
              Cuando el proyecto deja de ser un sitio web estandarizado y necesita software nuevo, lógica propia o una arquitectura más compleja, pasa a Proyectos Avanzados.
            </p>
            <p style="font-size: 0.92rem; color: var(--steel-soft); line-height: 1.6; margin-bottom: 2rem;">
              Desarrollamos aplicaciones web a la medida, portales privados con control de accesos por roles (RBAC), arquitecturas desacopladas e integraciones empresariales complejas.
            </p>
            <div style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: center;">
              <a href="/contacto.html?necesidad=proyecto-avanzado" class="btn btn-primary" style="padding: 0.85rem 1.75rem;">Hablar de un proyecto →</a>
              <span style="font-family: var(--f-mono); font-size: 0.95rem; color: var(--cyan); font-weight: 700;">Referencia: Desde $40,000 MXN</span>
            </div>
          </div>

          <div class="glass-panel" style="padding: 2.25rem; background: rgba(14, 18, 27, 0.85); border-color: rgba(0, 210, 255, 0.35);">
            <h3 style="font-size: 1.25rem; color: var(--paper); margin-bottom: 1rem;">Capacidades de Proyectos Avanzados</h3>
            <ul class="feature-list" style="margin-bottom: 1.5rem;">
              <li>Software a medida y lógica de negocio exclusiva</li>
              <li>Portales de usuarios, clientes y permisos RBAC</li>
              <li>Bases de datos relacionales y no relacionales</li>
              <li>Infraestructura Edge y alta disponibilidad</li>
              <li>Gobernanza técnica y validación en CI/CD</li>
            </ul>
            <div style="font-size: 0.82rem; color: var(--steel-soft); border-top: 1px dashed var(--line-dark); padding-top: 1rem;">
              ℹ Cada proyecto avanzado se cotiza formalmente tras una sesión inicial de definición de alcance técnico y arquitectura.
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TABLA COMPARATIVA DE LOS 5 SITIOS WEB -->
    <section class="section section-dim" id="comparativa">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Matriz de Características</p>
          <h2>Comparativa Técnica de los 5 Sitios Web</h2>
          <p>Transparencia en lo que incluye cada nivel de desarrollo estandarizado.</p>
        </div>

        <div class="comparison-table-wrap reveal">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Característica</th>
                <th>Iron</th>
                <th>Bronze</th>
                <th>Silver</th>
                <th style="color: var(--cyan);">Gold</th>
                <th>Platinum</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="font-weight: 600;">Inversión Inicial</td>
                <td style="font-family: var(--f-mono);">$2,800 MXN</td>
                <td style="font-family: var(--f-mono);">$4,500 MXN</td>
                <td style="font-family: var(--f-mono);">$7,500 MXN</td>
                <td style="font-family: var(--f-mono); font-weight: bold; color: var(--cyan);">$12,500 MXN</td>
                <td style="font-family: var(--f-mono);">$24,500 MXN</td>
              </tr>
              <tr>
                <td style="font-weight: 600;">Estructura de Páginas</td>
                <td>1 Vista (One-Page)</td>
                <td>Hasta 5 Secciones</td>
                <td>Hasta 5 Páginas</td>
                <td>8 a 10 Páginas</td>
                <td>Hasta 15 Páginas</td>
              </tr>
              <tr>
                <td style="font-weight: 600;">Botón WhatsApp / Contacto</td>
                <td style="color: var(--success);">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
              </tr>
              <tr>
                <td style="font-weight: 600;">Formulario de Captación</td>
                <td style="color: var(--steel-soft);">—</td>
                <td style="color: var(--success);">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
              </tr>
              <tr>
                <td style="font-weight: 600;">Blog / CMS Autogestionable</td>
                <td style="color: var(--steel-soft);">—</td>
                <td style="color: var(--steel-soft);">—</td>
                <td style="color: var(--steel-soft);">—</td>
                <td style="color: var(--success); font-weight: bold;">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
              </tr>
              <tr>
                <td style="font-weight: 600;">Integración APIs / Pagos / CRM</td>
                <td style="color: var(--steel-soft);">—</td>
                <td style="color: var(--steel-soft);">—</td>
                <td style="color: var(--steel-soft);">—</td>
                <td style="color: var(--steel-soft);">—</td>
                <td style="color: var(--success); font-weight: bold;">Incluido</td>
              </tr>
              <tr>
                <td style="font-weight: 600;">Rondas de Revisión</td>
                <td>1 ronda</td>
                <td>2 rondas</td>
                <td>3 rondas</td>
                <td>4 rondas</td>
                <td>5 rondas</td>
              </tr>
              <tr>
                <td style="font-weight: 600;">Titularidad de Código</td>
                <td style="color: var(--success);">100% Cliente</td>
                <td style="color: var(--success);">100% Cliente</td>
                <td style="color: var(--success);">100% Cliente</td>
                <td style="color: var(--success);">100% Cliente</td>
                <td style="color: var(--success);">100% Cliente</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ENLACE HACIA SERVICIOS TÉCNICOS Y CONTINUIDAD -->
    <section class="section">
      <div class="container">
        <div class="glass-panel reveal" style="padding: 2.5rem; background: rgba(14, 18, 27, 0.7); border-color: rgba(255, 255, 255, 0.08); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem;">
          <div>
            <span class="badge badge-cyan" style="margin-bottom: 0.5rem;">¿BUSCAS ACOMPAÑAMIENTO O AUDITORÍA?</span>
            <h3 style="font-size: 1.4rem; margin: 0.25rem 0 0.5rem 0;">Servicios de Diagnóstico, Rescate y Continuidad Mensual</h3>
            <p style="font-size: 0.9rem; color: var(--steel-light); margin: 0;">
              Explora nuestros servicios independientes: Castle Checkup ($8,900 MXN), Castle Audit, Castle Rescue y suscripciones mensuales Castle Care.
            </p>
          </div>
          <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href="/servicios.html" class="btn btn-primary">Ver Todos los Servicios →</a>
            <a href="/servicios/care.html" class="btn btn-outline">Ver Planes Castle Care</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="section section-dim" id="faq">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Preguntas Frecuentes sobre Sitios Web</p>
          <h2>Todo claro antes de contratar</h2>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Cómo se realiza el proceso de pago?" answer="Trabajamos típicamente con un esquema de 50% de anticipo para iniciar la arquitectura y 50% contra entrega final tras completar las rondas de revisión formal." />
              <FAQItem question="¿El código nos pertenece conforme a contrato?" answer="Sí. Todo el código fuente entregado, repositorios y cuentas de hosting permanecen bajo la titularidad y control del cliente conforme al contrato de servicios." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
