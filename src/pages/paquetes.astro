---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQItem from '../components/FAQItem.astro';
import CTABand from '../components/CTABand.astro';
import HeroEngineVisual from '../components/HeroEngineVisual.astro';
---

<BaseLayout
  title="Catálogo Oficial de Paquetes — Grupo Castillo"
  description="Catálogo de 6 paquetes de desarrollo web de Grupo Castillo: desde Castle Iron ($2,999 MXN) hasta Castle Diamond ($50,000 MXN). Precios transparentes, código tuyo."
  canonical="https://grupocastillo.lat/paquetes"
  ogUrl="https://grupocastillo.lat/paquetes"
>
  <main id="main">

    <section class="page-hero">
      <HeroEngineVisual />
      <div class="container page-hero-inner">
        <p class="eyebrow" style="margin-bottom: 1.25rem; justify-content: center; color: var(--cyan);">
          CATÁLOGO DE DESARROLLO
        </p>
        <h1>Paquetes de <span style="color: var(--cyan);">Desarrollo Web e Ingeniería</span></h1>
        <p>Precios claros, alcance delimitado por escrito y titularidad del código para el cliente desde el primer día.</p>
        <div style="margin-top: 1.5rem;">
          <a href="/diagnostico" class="btn btn-cta-crystal" style="font-size: 1.05rem; padding: 0.95rem 2.5rem;">Iniciar Diagnóstico →</a>
        </div>
      </div>
    </section>

    <!-- LOS 6 PAQUETES -->
    <section class="section" id="catalogo-sitios" style="padding-top: 1rem;">
      <div class="container">
        <div class="section-head reveal" style="text-align: center; max-width: 820px; margin: 0 auto 3rem auto;">
          <p class="eyebrow" style="color: var(--cyan); justify-content: center;">Catálogo Oficial</p>
          <h2>Catálogo de 6 Paquetes</h2>
          <p>Desde presencia básica para profesionistas independientes hasta plataformas de software a la medida.</p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem; margin-bottom: 3rem;">
          
          <!-- 1. CASTLE IRON -->
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid var(--iron);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-light); font-weight: 700;">NIVEL 01 • ESENCIAL</span>
              <span style="font-family: var(--f-mono); font-size: 0.75rem; font-weight: 700; color: var(--cyan); letter-spacing: 0.05em;">3–5 DÍAS</span>
            </div>
            <h3 style="font-size: 1.4rem; margin: 0.25rem 0;">Castle Iron</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); margin-bottom: 1.25rem; min-height: 2.8rem;">
              Presencia digital esencial One-Page para profesionistas y micronegocios.
            </p>
            <div class="package-price-wrap" style="margin-bottom: 1.25rem;">
              <div class="package-price" style="font-size: 1.4rem; font-family: var(--f-mono); font-weight: 700; color: var(--paper);">$2,999 MXN</div>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light); display: flex; flex-direction: column; gap: 0.4rem;">
              <li>Estructura One-Page (1 vista ágil)</li>
              <li>Enlace directo a WhatsApp</li>
              <li>Optimización de carga y rendimiento web</li>
              <li>Certificado SSL y configuración de hosting</li>
              <li>1 ronda de revisión formal</li>
              <li style="color: var(--steel-soft); font-size: 0.8rem;"><em>Add-on: SEO Local / Google Business Profile (sujeto a cotización)</em></li>
            </ul>
            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: auto;">
              <a class="btn btn-outline" href="/paquetes/iron" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Ficha Técnica →</a>
              <a class="btn btn-primary" href="/contacto?paquete=Castle%20Iron" style="width: 100%; text-align: center; font-size: 0.82rem;">Cotizar Castle Iron</a>
            </div>
          </div>

          <!-- 2. CASTLE BRONZE -->
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid var(--bronze);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-light); font-weight: 700;">NIVEL 02 • CAPTACIÓN</span>
              <span style="font-family: var(--f-mono); font-size: 0.75rem; font-weight: 700; color: var(--cyan); letter-spacing: 0.05em;">5–7 DÍAS</span>
            </div>
            <h3 style="font-size: 1.4rem; margin: 0.25rem 0;">Castle Bronze</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); margin-bottom: 1.25rem; min-height: 2.8rem;">
              Landing comercial enfocada en conversión para campañas y nuevos productos.
            </p>
            <div class="package-price-wrap" style="margin-bottom: 1.25rem;">
              <div class="package-price" style="font-size: 1.4rem; font-family: var(--f-mono); font-weight: 700; color: var(--paper);">$4,900 MXN</div>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light); display: flex; flex-direction: column; gap: 0.4rem;">
              <li>Hasta 5 secciones estructuradas</li>
              <li>Formulario de captación de clientes</li>
              <li>Integración analítica básica</li>
              <li>Diseño adaptado a móviles</li>
              <li>2 rondas de revisión formal</li>
              <li style="color: var(--steel-soft); font-size: 0.8rem;"><em>Add-on: SEO Local / Google Business Profile (sujeto a cotización)</em></li>
            </ul>
            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: auto;">
              <a class="btn btn-outline" href="/paquetes/bronze" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Ficha Técnica →</a>
              <a class="btn btn-primary" href="/contacto?paquete=Castle%20Bronze" style="width: 100%; text-align: center; font-size: 0.82rem;">Cotizar Castle Bronze</a>
            </div>
          </div>

          <!-- 3. CASTLE SILVER -->
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid var(--silver);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-light); font-weight: 700;">NIVEL 03 • CORPORATIVO</span>
              <span style="font-family: var(--f-mono); font-size: 0.75rem; font-weight: 700; color: var(--cyan); letter-spacing: 0.05em;">7–10 DÍAS</span>
            </div>
            <h3 style="font-size: 1.4rem; margin: 0.25rem 0;">Castle Silver</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); margin-bottom: 1.25rem; min-height: 2.8rem;">
              Sitio corporativo multi-página para empresas que requieren estructura formal.
            </p>
            <div class="package-price-wrap" style="margin-bottom: 1.25rem;">
              <div class="package-price" style="font-size: 1.4rem; font-family: var(--f-mono); font-weight: 700; color: var(--paper);">$7,900 MXN</div>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light); display: flex; flex-direction: column; gap: 0.4rem;">
              <li>Hasta 5 páginas completas independientes</li>
              <li>Menú de navegación estructurado</li>
              <li>SEO on-page y metadatos estructurados</li>
              <li>Validación técnica Castle Gate C1</li>
              <li>3 rondas de revisión formal</li>
              <li style="color: var(--steel-soft); font-size: 0.8rem;"><em>Add-on: CMS ligero de autoedición disponible (sujeto a cotización)</em></li>
            </ul>
            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: auto;">
              <a class="btn btn-outline" href="/paquetes/silver" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Ficha Técnica →</a>
              <a class="btn btn-primary" href="/contacto?paquete=Castle%20Silver" style="width: 100%; text-align: center; font-size: 0.82rem;">Cotizar Castle Silver</a>
            </div>
          </div>

          <!-- 4. CASTLE GOLD -->
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid #FFD700;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-light); font-weight: 700;">NIVEL 04 • CRECIMIENTO</span>
              <span style="font-family: var(--f-mono); font-size: 0.75rem; font-weight: 700; color: var(--cyan); letter-spacing: 0.05em;">10–14 DÍAS</span>
            </div>
            <h3 style="font-size: 1.4rem; margin: 0.25rem 0;">Castle Gold</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); margin-bottom: 1.25rem; min-height: 2.8rem;">
              Plataforma de crecimiento corporativo con Blog / CMS autogestionable.
            </p>
            <div class="package-price-wrap" style="margin-bottom: 1.25rem;">
              <div class="package-price" style="font-size: 1.4rem; font-family: var(--f-mono); font-weight: 700; color: var(--paper);">$12,900 MXN</div>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light); display: flex; flex-direction: column; gap: 0.4rem;">
              <li>8 a 10 páginas completas</li>
              <li>Blog / CMS autogestionable</li>
              <li>Optimización Core Web Vitals</li>
              <li>SEO avanzado Schema.org (JSON-LD)</li>
              <li>4 rondas de revisión formal</li>
              <li style="color: var(--steel-soft); font-size: 0.8rem;"><em>Redacción desde cero: No incluida (disponible sujeta a cotización)</em></li>
              <li style="color: var(--steel-soft); font-size: 0.8rem;"><em>Add-on: Estrategia de contenido y conversión (sujeta a cotización)</em></li>
            </ul>
            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: auto;">
              <a class="btn btn-outline" href="/paquetes/gold" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Ficha Técnica →</a>
              <a class="btn btn-primary" href="/contacto?paquete=Castle%20Gold" style="width: 100%; text-align: center; font-size: 0.82rem;">Cotizar Castle Gold</a>
            </div>
          </div>

          <!-- 5. CASTLE PLATINUM -->
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid var(--platinum);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-light); font-weight: 700;">NIVEL 05 • INTEGRADO</span>
              <span style="font-family: var(--f-mono); font-size: 0.75rem; font-weight: 700; color: var(--cyan); letter-spacing: 0.05em;">15–20 DÍAS</span>
            </div>
            <h3 style="font-size: 1.4rem; margin: 0.25rem 0;">Castle Platinum</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); margin-bottom: 1.25rem; min-height: 2.8rem;">
              Plataforma avanzada con integración de APIs, CRM, pagos y seguridad reforzada.
            </p>
            <div class="package-price-wrap" style="margin-bottom: 1.25rem;">
              <div class="package-price" style="font-size: 1.4rem; font-family: var(--f-mono); font-weight: 700; color: var(--paper);">$25,900 MXN</div>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light); display: flex; flex-direction: column; gap: 0.4rem;">
              <li>Hasta 15 páginas y secciones dinámicas</li>
              <li>Integración de pagos (Stripe / Mercado Pago)</li>
              <li>Conexión con CRM y bases de datos</li>
              <li>Hardening de seguridad y cabeceras estrictas</li>
              <li>5 rondas de revisión formal</li>
              <li style="color: var(--steel-soft); font-size: 0.8rem;"><em>Redacción desde cero: No incluida (disponible sujeta a cotización)</em></li>
              <li style="color: var(--steel-soft); font-size: 0.8rem;"><em>Add-on: Estrategia de contenido y conversión (sujeta a cotización)</em></li>
            </ul>
            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: auto;">
              <a class="btn btn-outline" href="/paquetes/platinum" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Ficha Técnica →</a>
              <a class="btn btn-primary" href="/contacto?paquete=Castle%20Platinum" style="width: 100%; text-align: center; font-size: 0.82rem;">Cotizar Castle Platinum</a>
            </div>
          </div>

          <!-- 6. CASTLE DIAMOND / SOFTWARE A MEDIDA -->
          <div class="card glass-panel" id="proyectos-avanzados" style="padding: 2.25rem; border-top: 3px solid #346BF1;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-light); font-weight: 700;">NIVEL 06 • A MEDIDA</span>
              <span style="font-family: var(--f-mono); font-size: 0.75rem; font-weight: 700; color: var(--cyan); letter-spacing: 0.05em;">POR SPRINTS</span>
            </div>
            <h3 style="font-size: 1.4rem; margin: 0.25rem 0;">Castle Diamond</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); margin-bottom: 1.25rem; min-height: 2.8rem;">
              Ingeniería de software a la medida, portales de clientes, ERP/CRM e integraciones de alta disponibilidad.
            </p>
            <div class="package-price-wrap" style="margin-bottom: 1.25rem;">
              <div class="package-price" style="font-size: 1.4rem; font-family: var(--f-mono); font-weight: 700; color: var(--paper);">$50,000 MXN</div>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light); display: flex; flex-direction: column; gap: 0.4rem;">
              <li>Arquitectura de software y base de datos a medida</li>
              <li>Portales de usuarios, permisos y roles (RBAC)</li>
              <li>Infraestructura Edge / Alta Disponibilidad</li>
              <li>Integraciones con ERP, CRM o sistemas legados</li>
              <li>Entregables continuos y sprints documentados</li>
              <li style="color: var(--steel-soft); font-size: 0.8rem;"><em>Sujeto a evaluación y cotización según requerimientos</em></li>
            </ul>
            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: auto;">
              <a class="btn btn-outline" href="/paquetes/diamond" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Ficha Técnica →</a>
              <a class="btn btn-primary" href="/contacto?paquete=Castle%20Diamond" style="width: 100%; text-align: center; font-size: 0.82rem;">Cotizar Software a Medida</a>
            </div>
          </div>

        </div>

        <!-- SECCIÓN DE ADD-ONS Y COMPLEMENTOS COMERCIALES -->
        <div class="glass-panel reveal" style="padding: 2rem; border-color: rgba(52, 107, 241, 0.2); background: rgba(14, 18, 27, 0.85); margin-bottom: 2.5rem;">
          <div style="margin-bottom: 1.25rem;">
            <h3 style="font-size: 1.4rem; color: var(--paper); margin: 0 0 0.35rem 0;">Complementos y Add-ons para tus Proyectos</h3>
            <div style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--cyan); font-weight: 700; letter-spacing: 0.05em; margin-bottom: 0.65rem;">MÓDULOS Y SERVICIOS ADICIONALES</div>
            <p style="font-size: 0.86rem; color: var(--steel-light); margin: 0;">
              Amplía las capacidades de tu paquete sin comprometer la arquitectura estática, sin crear dependencias artificiales ni costos ocultos.
            </p>
          </div>

          <div class="grid grid-4" style="gap: 1.25rem;">
            <div style="padding: 1rem; background: #06080C; border: 1px solid var(--line-dark); border-radius: var(--radius-sm);">
              <strong style="display: block; color: var(--paper); font-size: 0.88rem; margin-bottom: 0.35rem;">SEO Local / Perfil Google</strong>
              <p style="font-size: 0.78rem; color: var(--steel-light); margin: 0 0 0.5rem 0; line-height: 1.45;">Configuración de Google Business Profile y marcado local para paquetes Iron y Bronze.</p>
              <span style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--cyan);">Sujeto a cotización</span>
            </div>

            <div style="padding: 1rem; background: #06080C; border: 1px solid var(--line-dark); border-radius: var(--radius-sm);">
              <strong style="display: block; color: var(--paper); font-size: 0.88rem; margin-bottom: 0.35rem;">CMS Ligero de Autoedición</strong>
              <p style="font-size: 0.78rem; color: var(--steel-light); margin: 0 0 0.5rem 0; line-height: 1.45;">Panel visual para modificar textos e imágenes en paquetes Silver sin tocar código.</p>
              <span style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--cyan);">Sujeto a cotización</span>
            </div>

            <div style="padding: 1rem; background: #06080C; border: 1px solid var(--line-dark); border-radius: var(--radius-sm);">
              <strong style="display: block; color: var(--paper); font-size: 0.88rem; margin-bottom: 0.35rem;">Estrategia de Contenido</strong>
              <p style="font-size: 0.78rem; color: var(--steel-light); margin: 0 0 0.5rem 0; line-height: 1.45;">Arquitectura de mensajes, CTAs y contenidos orientados a conversión para Gold y Platinum.</p>
              <span style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--cyan);">Sujeto a cotización</span>
            </div>

            <div style="padding: 1rem; background: #06080C; border: 1px solid var(--line-dark); border-radius: var(--radius-sm);">
              <strong style="display: block; color: var(--paper); font-size: 0.88rem; margin-bottom: 0.35rem;">Automatizaciones Ligeras</strong>
              <p style="font-size: 0.78rem; color: var(--steel-light); margin: 0 0 0.5rem 0; line-height: 1.45;">Webhooks, formularios inteligentes, notificaciones por email y WhatsApp sin lock-in.</p>
              <span style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--cyan);">Sujeto a cotización</span>
            </div>
          </div>
        </div>

        <p class="currency-disclaimer" style="text-align: center; margin-bottom: 3rem;">
          * Tarifas oficiales expresadas en pesos mexicanos (MXN). Los plazos señalados son estimados / objetivos y comienzan a computarse tras la recepción completa de contenidos base, accesos a cuentas y validación de diseño por parte del cliente.
        </p>
      </div>
    </section>

    <!-- TABLA COMPARATIVA COMPLETA DE LOS 6 PAQUETES -->
    <section class="section section-dim" id="comparativa" style="padding-top: 4.5rem; padding-bottom: 4.5rem;">
      <div class="container">
        <div class="section-head reveal" style="text-align: center; max-width: 820px; margin: 0 auto 3rem auto;">
          <p class="eyebrow" style="color: var(--cyan); justify-content: center;">Matriz de Características</p>
          <h2>Comparativa Técnica de los 6 Paquetes</h2>
          <p>Transparencia en lo que incluye cada nivel de desarrollo.</p>
        </div>

        <div class="comparison-table-wrap reveal">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Característica</th>
                <th>Iron</th>
                <th>Bronze</th>
                <th>Silver</th>
                <th>Gold</th>
                <th>Platinum</th>
                <th>Diamond</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="font-weight: 600;">Inversión Inicial</td>
                <td style="font-family: var(--f-mono);">$2,999 MXN</td>
                <td style="font-family: var(--f-mono);">$4,900 MXN</td>
                <td style="font-family: var(--f-mono);">$7,900 MXN</td>
                <td style="font-family: var(--f-mono);">$12,900 MXN</td>
                <td style="font-family: var(--f-mono);">$25,900 MXN</td>
                <td style="font-family: var(--f-mono);">$50,000 MXN</td>
              </tr>
              <tr>
                <td style="font-weight: 600;">Estructura de Páginas</td>
                <td>1 Vista (One-Page)</td>
                <td>Hasta 5 Secciones</td>
                <td>Hasta 5 Páginas</td>
                <td>8 a 10 Páginas</td>
                <td>Hasta 15 Páginas</td>
                <td>A la medida</td>
              </tr>
              <tr>
                <td style="font-weight: 600;">Botón WhatsApp / Contacto</td>
                <td style="color: var(--success);">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
              </tr>
              <tr>
                <td style="font-weight: 600;">Formulario de Captación</td>
                <td style="color: var(--steel-soft);">—</td>
                <td style="color: var(--success);">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
              </tr>
              <tr>
                <td style="font-weight: 600;">Blog / CMS Autogestionable</td>
                <td style="color: var(--steel-soft);">—</td>
                <td style="color: var(--steel-soft);">—</td>
                <td style="color: var(--steel-soft);">—</td>
                <td style="color: var(--success); font-weight: bold;">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
              </tr>
              <tr>
                <td style="font-weight: 600;">Integración APIs / Pagos / CRM</td>
                <td style="color: var(--steel-soft);">—</td>
                <td style="color: var(--steel-soft);">—</td>
                <td style="color: var(--steel-soft);">—</td>
                <td style="color: var(--steel-soft);">—</td>
                <td style="color: var(--success); font-weight: bold;">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
              </tr>
              <tr>
                <td style="font-weight: 600;">Rondas de Revisión</td>
                <td>1 ronda</td>
                <td>2 rondas</td>
                <td>3 rondas</td>
                <td>4 rondas</td>
                <td>5 rondas</td>
                <td>Por sprint</td>
