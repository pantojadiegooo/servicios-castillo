---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQItem from '../components/FAQItem.astro';
import CTABand from '../components/CTABand.astro';
import ServicesGovernanceVisual from '../components/ServicesGovernanceVisual.astro';
---

<BaseLayout
  title="Servicios de Ingeniería de Software y Diagnóstico — Grupo Castillo"
  description="Catálogo de servicios de ingeniería especializados de Grupo Castillo: Castle Checkup (72h), Castle Audit, Castle Rescue, Castle Emergency, Castle Care y Consultoría Digital."
  canonical="https://grupocastillo.lat/servicios"
  ogUrl="https://grupocastillo.lat/servicios"
>
  <main id="main">

    <section class="page-hero">
      <ServicesGovernanceVisual />
      <div class="container page-hero-inner">
        <p class="eyebrow" style="margin-bottom: 1.25rem; justify-content: center; color: var(--cyan);">
          SERVICIOS DE INGENIERÍA & GOBERNANZA
        </p>
        <h1>Servicios de Ingeniería para <span style="color: var(--cyan);">Sitios Web y Software</span></h1>
        <p>Diagnóstico estático de código, auditorías de arquitectura, rescate técnico ante fallas, contingencias, consultoría tecnológica y mantenimiento continuo.</p>
        <div style="margin-top: 1.5rem;">
          <a href="/diagnostico" class="btn btn-cta-crystal" style="font-size: 1.05rem; padding: 0.95rem 2.5rem;">Iniciar Diagnóstico →</a>
        </div>
      </div>
    </section>

    <!-- TODOS LOS SERVICIOS DE INGENIERÍA -->
    <section class="section" id="catalogo-servicios" style="padding-top: 1rem; padding-bottom: 4.5rem;">
      <div class="container">
        <div class="section-head reveal" style="text-align: center; max-width: 820px; margin: 0 auto 3rem auto;">
          <p class="eyebrow" style="color: var(--cyan); justify-content: center;">Catálogo de Servicios</p>
          <h2>Diagnóstico, Rescate, Consultoría y Mantenimiento</h2>
          <p>Servicios independientes para evaluar la salud de tu código, resolver problemas críticos y mantener tus plataformas operando con máxima seguridad y soberanía.</p>
        </div>

        <div class="services-grid-5 reveal">
          
          <!-- 1. CASTLE CHECKUP -->
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid #346BF1;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--steel-light); font-weight: 700;">SERVICIO 01 • ÁGIL</span>
              <span style="font-family: var(--f-mono); font-size: 0.78rem; font-weight: 700; color: var(--cyan); letter-spacing: 0.05em;">DIAGNÓSTICO</span>
            </div>
            <h3 style="font-size: 1.35rem; margin: 0.25rem 0 0.5rem 0;">Castle Checkup</h3>
            <p style="font-size: 0.85rem; color: var(--steel-light); min-height: 2.8rem; margin: 0;">Diagnóstico estático del repositorio bajo 65 controles CQS v1.1.</p>
            
            <div style="margin: 1.25rem 0; padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border);">
              <div style="font-size: 1.85rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper);">$8,900 MXN</div>
              <span style="font-size: 0.8rem; color: var(--cyan); font-family: var(--f-mono);">100% Acreditable</span>
            </div>

            <ul style="font-size: 0.85rem; color: var(--steel-light); list-style: none; padding: 0; margin-bottom: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; gap: 0.5rem;">
              <li>Escaneo en memoria de secretos expuestos</li>
              <li>Reporte interactivo con score CQS</li>
              <li>Sesión de 1h con el Ingeniero Líder</li>
              <li>100% Acreditable hacia contratación de desarrollo</li>
            </ul>

            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: auto;">
              <a class="btn btn-outline" href="/servicios/checkup" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Ficha Técnica →</a>
              <a class="btn btn-primary" href="/contacto?necesidad=checkup" style="width: 100%; text-align: center; font-size: 0.82rem;">Solicitar Checkup (72h)</a>
            </div>
          </div>

          <!-- 2. CASTLE AUDIT -->
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid #F59E0B;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--steel-light); font-weight: 700;">SERVICIO 02 • PROFUNDO</span>
              <span style="font-family: var(--f-mono); font-size: 0.78rem; font-weight: 700; color: var(--cyan); letter-spacing: 0.05em;">DILIGENCIA</span>
            </div>
            <h3 style="font-size: 1.35rem; margin: 0.25rem 0 0.5rem 0;">Castle Audit</h3>
            <p style="font-size: 0.85rem; color: var(--steel-light); min-height: 2.8rem; margin: 0;">Auditoría exhaustiva de arquitectura, seguridad y código heredado.</p>
            
            <div style="margin: 1.25rem 0; padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border);">
              <div style="font-size: 1.85rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper);">$19,900 MXN</div>
              <span style="font-size: 0.8rem; color: var(--cyan); font-family: var(--f-mono);">Standard a Enterprise</span>
            </div>

            <ul style="font-size: 0.85rem; color: var(--steel-light); list-style: none; padding: 0; margin-bottom: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; gap: 0.5rem;">
              <li>Análisis profundo de deuda técnica</li>
              <li>Inspección de dependencias y vulnerabilidades</li>
              <li>Matriz de riesgos priorizados P0 a P3</li>
              <li>Hoja de ruta técnica de remediación</li>
            </ul>

            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: auto;">
              <a class="btn btn-outline" href="/servicios/audit" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Modalidades de Audit →</a>
              <a class="btn btn-primary" href="/contacto?necesidad=auditar" style="width: 100%; text-align: center; font-size: 0.82rem;">Cotizar Castle Audit</a>
            </div>
          </div>

          <!-- 3. CASTLE RESCUE -->
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid #F97316;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--steel-light); font-weight: 700;">SERVICIO 03 • RECUPERACIÓN</span>
              <span style="font-family: var(--f-mono); font-size: 0.78rem; font-weight: 700; color: var(--cyan); letter-spacing: 0.05em;">INTERVENCIÓN</span>
            </div>
            <h3 style="font-size: 1.35rem; margin: 0.25rem 0 0.5rem 0;">Castle Rescue</h3>
            <p style="font-size: 0.85rem; color: var(--steel-light); min-height: 2.8rem; margin: 0;">Ingeniería directa en el repositorio para sanear secretos y reparar fallas.</p>
            
            <div style="margin: 1.25rem 0; padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border);">
              <div style="font-size: 1.85rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper);">$6,900 MXN</div>
              <span style="font-size: 0.8rem; color: var(--cyan); font-family: var(--f-mono);">Bolsas Express / Standard</span>
            </div>

            <ul style="font-size: 0.85rem; color: var(--steel-light); list-style: none; padding: 0; margin-bottom: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; gap: 0.5rem;">
              <li>Remediación directa en Pull Requests</li>
              <li>Rotación y blindaje de secretos expuestos</li>
              <li>Desbloqueo de CI/CD y fallas de compilación</li>
              <li>Validación estricta post-intervención</li>
            </ul>

            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: auto;">
              <a class="btn btn-outline" href="/servicios/rescue" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Alcance Rescue →</a>
              <a class="btn btn-primary" href="/contacto?necesidad=mejorar" style="width: 100%; text-align: center; font-size: 0.82rem;">Solicitar Rescue</a>
            </div>
          </div>

          <!-- 4. CASTLE EMERGENCY -->
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid #EF4444;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--steel-light); font-weight: 700;">SERVICIO 04 • URGENCIAS</span>
              <span style="font-family: var(--f-mono); font-size: 0.78rem; font-weight: 700; color: #EF4444; letter-spacing: 0.05em;">PRIORITARIO</span>
            </div>
            <h3 style="font-size: 1.35rem; margin: 0.25rem 0 0.5rem 0;">Castle Emergency</h3>
            <p style="font-size: 0.85rem; color: var(--steel-light); min-height: 2.8rem; margin: 0;">Respuesta técnica prioritaria para contención de incidentes críticos.</p>
            
            <div style="margin: 1.25rem 0; padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border);">
              <div style="font-size: 1.85rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper);">$5,900 MXN</div>
              <span style="font-size: 0.8rem; color: var(--cyan); font-family: var(--f-mono);">Contención Inicial Prioritaria</span>
            </div>

            <ul style="font-size: 0.85rem; color: var(--steel-light); list-style: none; padding: 0; margin-bottom: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; gap: 0.5rem;">
              <li>Asignación prioritaria de ingeniería</li>
              <li>Diagnóstico de causa raíz en contingencia</li>
              <li>Mitigación inmediata de brechas y caídas</li>
              <li>Reporte forense post-incidente</li>
            </ul>

            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: auto;">
              <a class="btn btn-outline" href="/servicios/emergency" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Protocolo Emergency →</a>
              <a class="btn btn-primary" href="/contacto?necesidad=urgencia" style="width: 100%; text-align: center; font-size: 0.82rem;">Activar Emergency</a>
            </div>
          </div>

          <!-- 5. CASTLE CARE -->
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid #10B981;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--steel-light); font-weight: 700;">SERVICIO 05 • RECURRENTE</span>
              <span style="font-family: var(--f-mono); font-size: 0.78rem; font-weight: 700; color: #10B981; letter-spacing: 0.05em;">CONTINUIDAD</span>
            </div>
            <h3 style="font-size: 1.35rem; margin: 0.25rem 0 0.5rem 0;">Castle Care</h3>
            <p style="font-size: 0.85rem; color: var(--steel-light); min-height: 2.8rem; margin: 0;">Suscripción mensual de supervisión, parches de seguridad y horas Rescue.</p>
            
            <div style="margin: 1.25rem 0; padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border);">
              <div style="font-size: 1.85rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper);">Desde $590 MXN <span style="font-size: 0.8rem; color: var(--steel-soft); font-weight: normal;">/ mes</span></div>
              <span style="font-size: 0.8rem; color: var(--cyan); font-family: var(--f-mono);">Continuidad y Soporte</span>
            </div>

            <ul style="font-size: 0.85rem; color: var(--steel-light); list-style: none; padding: 0; margin-bottom: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; gap: 0.5rem;">
              <li>Supervisión mensual activa de uptime</li>
              <li>Horas Rescue directas incluidas (Pro/Ent)</li>
              <li>Parches de seguridad y dependencias</li>
              <li>Sesiones mensuales de arquitectura</li>
            </ul>

            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: auto;">
              <a class="btn btn-outline" href="/servicios/care" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Planes Castle Care →</a>
              <a class="btn btn-primary" href="/contacto?necesidad=cuidado" style="width: 100%; text-align: center; font-size: 0.82rem;">Suscribirme a Care</a>
            </div>
          </div>

        </div>

        <!-- SECCIÓN DE CONSULTORÍA DIGITAL Y ROADMAP TECNOLÓGICO -->
        <div class="glass-panel reveal" style="padding: 2.5rem; border-color: rgba(52, 107, 241, 0.25); background: rgba(14, 18, 27, 0.85); margin-bottom: 1rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 2rem;">
            <div style="max-width: 680px; flex: 1 1 480px;">
              <h3 style="font-size: 1.45rem; color: var(--paper); margin: 0 0 0.35rem 0;">Consultoría Digital &amp; Roadmap Tecnológico</h3>
              <div style="font-family: var(--f-mono); font-size: 0.78rem; font-weight: 700; color: var(--cyan); letter-spacing: 0.08em; margin-bottom: 1rem;">ASESORÍA ESTRATÉGICA INDEPENDIENTE</div>
              <p style="font-size: 0.92rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1rem;">
                Acompañamos a directores y líderes de negocio en la toma de decisiones tecnológicas críticas: evaluación independiente de propuestas técnicas de terceros, planificación de migraciones complejas, auditoría de continuidad operativa y definición de arquitectura para evitar vendor lock-in.
              </p>
              <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.86rem; color: var(--steel-light); display: flex; flex-direction: column; gap: 0.4rem;">
                <li>• Dictámenes técnicos y Due Diligence de proveedores de software.</li>
                <li>• Planes de mitigación y contingencia ante dependencias tecnológicas críticas.</li>
                <li>• Diseño de arquitectura de sistemas y selección de infraestructura sin sobrecostos.</li>
              </ul>
            </div>
            <div style="min-width: 220px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;">
              <div style="font-size: 1.4rem; font-family: var(--f-mono); font-weight: 700; color: var(--cyan); margin-bottom: 1rem; text-align: center;">Sujeto a Aprobación</div>
              <a href="/contacto?necesidad=consultoria" class="btn btn-primary" style="width: 100%; min-width: 200px; text-align: center; font-size: 0.85rem;">Solicitar Consultoría</a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- TABLA COMPARATIVA DE SERVICIOS -->
    <section class="section section-dim" id="comparativa" style="padding-top: 4.5rem; padding-bottom: 4.5rem;">
      <div class="container">
        <div class="section-head reveal" style="text-align: center; max-width: 820px; margin: 0 auto 3rem auto;">
          <p class="eyebrow" style="color: var(--cyan); justify-content: center;">Matriz de Características</p>
          <h2>Comparativa Técnica de Servicios</h2>
          <p>Transparencia en alcances, tiempos de respuesta y entregables de cada modalidad.</p>
        </div>

        <div class="comparison-table-wrap reveal">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Característica</th>
                <th>Checkup</th>
                <th>Audit</th>
                <th>Rescue</th>
                <th>Emergency</th>
                <th>Care</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="font-weight: 600;">Inversión Inicial</td>
                <td style="font-family: var(--f-mono);">$8,900 MXN</td>
                <td style="font-family: var(--f-mono);">$19,900 MXN</td>
                <td style="font-family: var(--f-mono);">$6,900 MXN</td>
                <td style="font-family: var(--f-mono);">$5,900 MXN</td>
                <td style="font-family: var(--f-mono);">Desde $590 MXN/mes</td>
              </tr>
              <tr>
                <td style="font-weight: 600;">Naturaleza</td>
                <td>Diagnóstico</td>
                <td>Auditoría</td>
                <td>Intervención</td>
                <td>Contención</td>
                <td>Suscripción</td>
              </tr>
              <tr>
                <td style="font-weight: 600;">Tiempo de Entrega</td>
                <td>72h</td>
                <td>Según modalidad</td>
                <td>Según bolsa</td>
                <td>Prioritario/Inmediato</td>
                <td>Continuo</td>
              </tr>
              <tr>
                <td style="font-weight: 600;">Acreditable a otros servicios</td>
                <td style="color: var(--success); font-weight: 600;">Incluido</td>
                <td style="color: var(--steel-soft);">—</td>
                <td style="color: var(--steel-soft);">—</td>
                <td style="color: var(--steel-soft);">—</td>
                <td style="color: var(--steel-soft);">—</td>
              </tr>
              <tr>
                <td style="font-weight: 600;">Acceso a Repositorio</td>
                <td>Solo lectura</td>
                <td>Solo lectura</td>
                <td>Escritura (PRs)</td>
                <td>Escritura</td>
                <td>Escritura</td>
              </tr>
              <tr>
                <td style="font-weight: 600;">Reporte CQS v1.1</td>
                <td style="color: var(--success);">Incluido</td>
                <td style="color: var(--success);">Incluido</td>
                <td>Post-intervención</td>
                <td>Forense post-incidente</td>
                <td>Mensual</td>
              </tr>
              <tr>
                <td style="font-weight: 600;">Sesión con Ingeniero Líder</td>
                <td style="color: var(--success);">Incluido</td>
                <td style="color: var(--success);">Incluida</td>
                <td style="color: var(--steel-soft);">—</td>
                <td style="color: var(--steel-soft);">—</td>
                <td>Mensual</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="reveal" style="font-size: 0.82rem; color: var(--steel-soft); text-align: center; margin-top: 1.25rem; line-height: 1.5;">
          * Castle Gate es nuestra tecnología interna de gobernanza de calidad y seguridad (CQS v1.1). No es una certificación regulatoria externa. <a href="/castle-gate" style="color: var(--cyan); text-decoration: underline; font-weight: 600;">Ver especificación completa →</a>
        </p>
      </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="section section-dim" id="faq" style="padding-top: 4.5rem; padding-bottom: 4.5rem; border-top: 1px solid var(--line-dark);">
      <div class="container">
        <div class="section-head reveal" style="text-align: center; max-width: 820px; margin: 0 auto 3rem auto;">
          <p class="eyebrow" style="color: var(--cyan); justify-content: center;">Preguntas Frecuentes sobre Servicios de Ingeniería</p>
          <h2 style="font-size: 2.2rem; color: var(--paper);">Todo claro antes de iniciar</h2>
          <p style="color: #E2E8F0; font-size: 1.05rem; line-height: 1.65;">
            Resolvemos las dudas comerciales y operativas más comunes con total transparencia:
          </p>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem question="¿Por dónde empezar si no conozco el estado de mi código?" answer="El punto de entrada recomendado es Castle Checkup ($8,900 MXN / 72h). Te entrega una radiografía completa y el 100% se acredita hacia la contratación de cualquier desarrollo o servicio posterior." />
              <FAQItem question="¿Puedo contratar Castle Rescue sin haber hecho un Checkup?" answer="Sí. Si ya identificaste un problema puntual (por ejemplo una clave expuesta o un pipeline roto), puedes solicitar directamente un paquete Rescue Express o Standard." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
              <FAQItem question="¿Qué diferencia hay entre Rescue y Emergency?" answer="Rescue es una intervención programada para sanear repositorios y pipelines. Emergency es una activación de prioridad inmediata para contener incidentes críticos activos." />
              <FAQItem question="¿Cómo se resguarda la confidencialidad de nuestro software?" answer="Firmamos un acuerdo mutuo de confidencialidad (NDA) antes de recibir acceso y ejecutamos todas las pruebas en entornos aislados y privados." />
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTABand
      title="¿Necesitas apoyo técnico para tu <span style='color: var(--cyan);'>software</span>?"
      description="Cuéntanos la situación de tu proyecto o utiliza nuestro diagnóstico comercial guiado."
      ctaLabel="Iniciar Diagnóstico"
      ctaHref="/diagnostico"
    />

  </main>
</BaseLayout>
