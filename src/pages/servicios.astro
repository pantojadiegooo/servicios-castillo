---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQItem from '../components/FAQItem.astro';
import CTABand from '../components/CTABand.astro';
import ServicesGovernanceVisual from '../components/ServicesGovernanceVisual.astro';
---

<BaseLayout
  title="Servicios de Ingeniería de Software y Diagnóstico — Grupo Castillo"
  description="Catálogo de servicios de ingeniería especializados de Grupo Castillo: Castle Checkup (72h), Castle Audit, Castle Rescue, Castle Emergency, Castle Care, Software a Medida y Consultoría Digital."
  canonical="https://servicios-castillo.vercel.app/servicios.html"
  ogUrl="https://servicios-castillo.vercel.app/servicios.html"
>
  <main id="main">

    <section class="page-hero">
      <ServicesGovernanceVisual />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="/index.html">Inicio</a> / Servicios de Ingeniería</p>
        <div class="badge badge-cyan">INGENIERÍA Y GOBERNANZA ESPECIALIZADA</div>
        <h1>Servicios de Ingeniería para Sitios Web y Software</h1>
        <p>Diagnóstico estático de código, auditorías de arquitectura, rescate técnico ante fallas, contingencias, consultoría tecnológica y mantenimiento continuo.</p>
        <div style="margin-top: 1.25rem;">
          <a href="/diagnostico.html" class="btn btn-outline" style="font-size: 0.85rem; padding: 0.5rem 1.2rem;">¿Incertidumbre sobre qué servicio necesitas? Iniciar Diagnóstico →</a>
        </div>
      </div>
    </section>

    <!-- TODOS LOS SERVICIOS DE INGENIERÍA -->
    <section class="section" id="catalogo-servicios" style="padding-top: 1rem;">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Catálogo de Servicios</p>
          <h2>Diagnóstico, Rescate, Consultoría y Mantenimiento</h2>
          <p>Servicios independientes para evaluar la salud de tu código, resolver problemas críticos y mantener tus plataformas operando con máxima seguridad y soberanía.</p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem; margin-bottom: 3rem;">
          
          <!-- 1. CASTLE CHECKUP -->
          <div class="card glass-panel" style="padding: 2.25rem; border-color: rgba(0, 210, 255, 0.35); background: linear-gradient(180deg, rgba(0, 210, 255, 0.05) 0%, var(--glass-surface) 100%);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--cyan); font-weight: 700;">SERVICIO 01 • ÁGIL</span>
              <span class="badge badge-cyan" style="font-size: 0.65rem; padding: 2px 6px;">72H HÁBILES</span>
            </div>
            <h3 style="font-size: 1.35rem; margin: 0.25rem 0 0.5rem 0;">Castle Checkup</h3>
            <p style="font-size: 0.85rem; color: var(--steel-light); min-height: 2.8rem; margin: 0;">Diagnóstico estático del repositorio bajo 65 controles CQS v1.1.</p>
            
            <div style="margin: 1.25rem 0; padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border);">
              <div style="font-size: 1.85rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper);">$8,900 MXN</div>
              <span style="font-size: 0.8rem; color: var(--steel-soft); font-family: var(--f-mono);">100% Acreditable hacia servicios posteriores</span>
            </div>

            <ul style="font-size: 0.85rem; color: var(--steel-light); list-style: none; padding: 0; margin-bottom: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; gap: 0.5rem;">
              <li>Escaneo en memoria de secretos expuestos</li>
              <li>Reporte interactivo con score CQS</li>
              <li>Sesión de 1h con el Ingeniero Líder</li>
              <li>100% Acreditable hacia contratación de desarrollo</li>
            </ul>

            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: auto;">
              <a class="btn btn-outline" href="/servicios/checkup.html" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Ficha Técnica →</a>
              <a class="btn btn-primary" href="/contacto.html?necesidad=checkup" style="width: 100%; text-align: center; font-size: 0.82rem;">Solicitar Checkup (72h)</a>
            </div>
          </div>

          <!-- 2. CASTLE AUDIT -->
          <div class="card glass-panel" style="padding: 2.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--cyan); font-weight: 700;">SERVICIO 02 • PROFUNDO</span>
              <span class="badge badge-cyan" style="font-size: 0.65rem; padding: 2px 6px;">DUE DILIGENCE</span>
            </div>
            <h3 style="font-size: 1.35rem; margin: 0.25rem 0 0.5rem 0;">Castle Audit</h3>
            <p style="font-size: 0.85rem; color: var(--steel-light); min-height: 2.8rem; margin: 0;">Auditoría exhaustiva de arquitectura, seguridad y código heredado.</p>
            
            <div style="margin: 1.25rem 0; padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border);">
              <div style="font-size: 1.85rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper);">Desde $19,900 MXN</div>
              <span style="font-size: 0.8rem; color: var(--steel-soft); font-family: var(--f-mono);">Standard a Enterprise</span>
            </div>

            <ul style="font-size: 0.85rem; color: var(--steel-light); list-style: none; padding: 0; margin-bottom: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; gap: 0.5rem;">
              <li>Análisis profundo de deuda técnica</li>
              <li>Inspección de dependencias y vulnerabilidades</li>
              <li>Matriz de riesgos priorizados P0 a P3</li>
              <li>Hoja de ruta técnica de remediación</li>
            </ul>

            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: auto;">
              <a class="btn btn-outline" href="/servicios/audit.html" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Modalidades de Audit →</a>
              <a class="btn btn-primary" href="/contacto.html?necesidad=auditar" style="width: 100%; text-align: center; font-size: 0.82rem;">Cotizar Castle Audit</a>
            </div>
          </div>

          <!-- 3. CASTLE RESCUE -->
          <div class="card glass-panel" style="padding: 2.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--cyan); font-weight: 700;">SERVICIO 03 • INTERVENCIÓN</span>
              <span class="badge badge-cyan" style="font-size: 0.65rem; padding: 2px 6px;">EN CÓDIGO</span>
            </div>
            <h3 style="font-size: 1.35rem; margin: 0.25rem 0 0.5rem 0;">Castle Rescue</h3>
            <p style="font-size: 0.85rem; color: var(--steel-light); min-height: 2.8rem; margin: 0;">Ingeniería directa en el repositorio para sanear secretos y reparar fallas.</p>
            
            <div style="margin: 1.25rem 0; padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border);">
              <div style="font-size: 1.85rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper);">Desde $6,900 MXN</div>
              <span style="font-size: 0.8rem; color: var(--steel-soft); font-family: var(--f-mono);">Bolsas Express / Standard</span>
            </div>

            <ul style="font-size: 0.85rem; color: var(--steel-light); list-style: none; padding: 0; margin-bottom: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; gap: 0.5rem;">
              <li>Remediación directa en Pull Requests</li>
              <li>Rotación y blindaje de secretos expuestos</li>
              <li>Desbloqueo de CI/CD y fallas de compilación</li>
              <li>Validación estricta post-intervención</li>
            </ul>

            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: auto;">
              <a class="btn btn-outline" href="/servicios/rescue.html" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Alcance Rescue →</a>
              <a class="btn btn-primary" href="/contacto.html?necesidad=mejorar" style="width: 100%; text-align: center; font-size: 0.82rem;">Solicitar Rescue</a>
            </div>
          </div>

          <!-- 4. CASTLE EMERGENCY -->
          <div class="card glass-panel" style="padding: 2.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--cyan); font-weight: 700;">SERVICIO 04 • URGENCIAS</span>
              <span class="badge badge-cyan" style="font-size: 0.65rem; padding: 2px 6px;">PRIORITARIO</span>
            </div>
            <h3 style="font-size: 1.35rem; margin: 0.25rem 0 0.5rem 0;">Castle Emergency</h3>
            <p style="font-size: 0.85rem; color: var(--steel-light); min-height: 2.8rem; margin: 0;">Respuesta técnica prioritaria para contención de incidentes críticos.</p>
            
            <div style="margin: 1.25rem 0; padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border);">
              <div style="font-size: 1.85rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper);">Desde $5,900 MXN</div>
              <span style="font-size: 0.8rem; color: var(--steel-soft); font-family: var(--f-mono);">Contención Inicial Prioritaria</span>
            </div>

            <ul style="font-size: 0.85rem; color: var(--steel-light); list-style: none; padding: 0; margin-bottom: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; gap: 0.5rem;">
              <li>Asignación prioritaria de ingeniería</li>
              <li>Diagnóstico de causa raíz en contingencia</li>
              <li>Mitigación inmediata de brechas y caídas</li>
              <li>Reporte forense post-incidente</li>
            </ul>

            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: auto;">
              <a class="btn btn-outline" href="/servicios/emergency.html" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Protocolo Emergency →</a>
              <a class="btn btn-primary" href="/contacto.html?necesidad=urgencia" style="width: 100%; text-align: center; font-size: 0.82rem;">Activar Emergency</a>
            </div>
          </div>

          <!-- 5. CASTLE CARE -->
          <div class="card glass-panel" style="padding: 2.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--cyan); font-weight: 700;">SERVICIO 05 • RECURRENTE</span>
              <span class="badge badge-cyan" style="font-size: 0.65rem; padding: 2px 6px;">CONTINUIDAD</span>
            </div>
            <h3 style="font-size: 1.35rem; margin: 0.25rem 0 0.5rem 0;">Castle Care</h3>
            <p style="font-size: 0.85rem; color: var(--steel-light); min-height: 2.8rem; margin: 0;">Suscripción mensual de supervisión, parches de seguridad y horas Rescue.</p>
            
            <div style="margin: 1.25rem 0; padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border);">
              <div style="font-size: 1.85rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper);">Desde $3,500 MXN <span style="font-size: 0.8rem; color: var(--steel-soft); font-weight: normal;">/ mes</span></div>
              <span style="font-size: 0.8rem; color: var(--steel-soft); font-family: var(--f-mono);">$3,500 a $17,900 MXN / mes</span>
            </div>

            <ul style="font-size: 0.85rem; color: var(--steel-light); list-style: none; padding: 0; margin-bottom: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; gap: 0.5rem;">
              <li>Supervisión mensual activa de uptime</li>
              <li>Horas Rescue directas incluidas (Pro/Ent)</li>
              <li>Parches de seguridad y dependencias</li>
              <li>Sesiones mensuales de arquitectura</li>
            </ul>

            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: auto;">
              <a class="btn btn-outline" href="/servicios/care.html" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Planes Castle Care →</a>
              <a class="btn btn-primary" href="/contacto.html?necesidad=cuidado" style="width: 100%; text-align: center; font-size: 0.82rem;">Suscribirme a Care</a>
            </div>
          </div>

          <!-- 6. SOFTWARE A MEDIDA -->
          <div class="card glass-panel" style="padding: 2.25rem; border-color: rgba(0, 210, 255, 0.25);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--cyan); font-weight: 700;">SERVICIO 06 • ARQUITECTURA</span>
              <span class="badge badge-cyan" style="font-size: 0.65rem; padding: 2px 6px;">A MEDIDA</span>
            </div>
            <h3 style="font-size: 1.35rem; margin: 0.25rem 0 0.5rem 0;">Software a la Medida</h3>
            <p style="font-size: 0.85rem; color: var(--steel-light); min-height: 2.8rem; margin: 0;">Portales de clientes, módulos de gestión, ERP, CRM y sistemas a medida.</p>
            
            <div style="margin: 1.25rem 0; padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border);">
              <div style="font-size: 1.85rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper);">Desde $40,000 MXN</div>
              <span style="font-size: 0.8rem; color: var(--steel-soft); font-family: var(--f-mono);">Castle Diamond / Sprints de Ingeniería</span>
            </div>

            <ul style="font-size: 0.85rem; color: var(--steel-light); list-style: none; padding: 0; margin-bottom: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; gap: 0.5rem;">
              <li>Arquitectura de software y base de datos propia</li>
              <li>Roles y permisos RBAC seguros</li>
              <li>Integración con ERPs o plataformas existentes</li>
              <li>100% Titularidad del código fuente</li>
            </ul>

            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: auto;">
              <a class="btn btn-outline" href="/paquetes/diamond.html" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Ficha Software a Medida →</a>
              <a class="btn btn-primary" href="/contacto.html?necesidad=software-medida" style="width: 100%; text-align: center; font-size: 0.82rem;">Cotizar Software a Medida</a>
            </div>
          </div>

        </div>

        <!-- SECCIÓN DE CONSULTORÍA DIGITAL Y ROADMAP TECNOLÓGICO -->
        <div class="glass-panel reveal" style="padding: 2.5rem; border-color: rgba(0, 210, 255, 0.25); background: rgba(14, 18, 27, 0.85); margin-bottom: 3rem;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1.5rem;">
            <div style="max-width: 680px;">
              <span class="badge badge-cyan" style="font-size: 0.7rem; margin-bottom: 0.5rem;">ASESORÍA ESTRATÉGICA INDEPENDIENTE</span>
              <h3 style="font-size: 1.45rem; color: var(--paper); margin: 0.25rem 0 0.5rem 0;">Consultoría Digital &amp; Roadmap Tecnológico</h3>
              <p style="font-size: 0.92rem; color: var(--steel-light); line-height: 1.6; margin-bottom: 1rem;">
                Acompañamos a directores y líderes de negocio en la toma de decisiones tecnológicas críticas: evaluación independiente de propuestas técnicas de terceros, planificación de migraciones complejas, auditoría de continuidad operativa y definición de arquitectura para evitar vendor lock-in.
              </p>
              <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.86rem; color: var(--steel-light); display: flex; flex-direction: column; gap: 0.4rem;">
                <li>• Dictámenes técnicos y Due Diligence de proveedores de software.</li>
                <li>• Planes de mitigación y contingencia ante dependencias tecnológicas críticas.</li>
                <li>• Diseño de arquitectura de sistemas y selección de infraestructura sin sobrecostos.</li>
              </ul>
            </div>
            <div style="text-align: right; min-width: 220px;">
              <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-soft); display: block; margin-bottom: 0.25rem;">Modalidad</span>
              <div style="font-size: 1.4rem; font-family: var(--f-mono); font-weight: 700; color: var(--paper); margin-bottom: 1rem;">Sujeto a Cotización</div>
              <a href="/contacto.html?necesidad=consultoria" class="btn btn-primary" style="width: 100%; text-align: center; font-size: 0.85rem;">Solicitar Consultoría</a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="section section-dim" id="faq">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Preguntas Frecuentes sobre Servicios de Ingeniería</p>
          <h2>Todo claro antes de iniciar</h2>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Por dónde empezar si no conozco el estado de mi código?" answer="El punto de entrada recomendado es Castle Checkup ($8,900 MXN / 72h hábiles). Te entrega una radiografía completa y el 100% se acredita hacia la contratación de cualquier desarrollo o servicio posterior." />
              <FAQItem question="¿Puedo contratar Castle Rescue sin haber hecho un Checkup?" answer="Sí. Si ya identificaste un problema puntual (por ejemplo una clave expuesta o un pipeline roto), puedes solicitar directamente un paquete Rescue Express o Standard." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Qué diferencia hay entre Rescue y Emergency?" answer="Rescue es una intervención programada para sanear repositorios y pipelines. Emergency es una activación de prioridad inmediata para contener incidentes críticos activos." />
              <FAQItem question="¿Cómo se resguarda la confidencialidad de nuestro software?" answer="Firmamos un acuerdo mutuo de confidencialidad (NDA) antes de recibir acceso y ejecutamos todas las pruebas en entornos aislados y privados." />
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTABand
      title="¿Necesitas apoyo técnico para tu software?"
      description="Cuéntanos la situación de tu proyecto o utiliza nuestro diagnóstico comercial guiado."
      ctaLabel="Iniciar Diagnóstico Castillo"
      ctaHref="/diagnostico.html"
    />

  </main>
</BaseLayout>
