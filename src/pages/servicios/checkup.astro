---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQItem from '../../components/FAQItem.astro';
import CTABand from '../../components/CTABand.astro';
import InnerHeroVisual from '../../components/InnerHeroVisual.astro';
---

<BaseLayout
  title="Castle Checkup — Diagnóstico Técnico Ágil de Repositorios en 72 Horas | Grupo Castillo"
  description="Servicio Castle Checkup ($8,900 MXN / ~$525 USD): Radiografía estática de 65 controles CQS v1.1 en 72h con 100% de crédito aplicado hacia tu contratación de Gate."
  canonical="https://grupocastillo.lat/servicios/checkup"
  ogUrl="https://grupocastillo.lat/servicios/checkup"
>
  <main id="main">

    <section class="page-hero">
      <InnerHeroVisual type="checkup" />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="/">Inicio</a> / <a href="/servicios">Servicios de Ingeniería</a> / Castle Checkup</p>
        <div class="badge badge-cyan">DIAGNÓSTICO ÁGIL • 72H OBJETIVO • 100% ACREDITABLE</div>
        <h1>Castle Checkup: Radiografía Técnica en 72 Horas</h1>
        <p>La forma más rápida y sin compromisos de largo plazo para conocer el estado real de seguridad, calidad y rendimiento de tu software o repositorio.</p>
      </div>
    </section>

    <!-- RESUMEN DEL SERVICIO Y FICHA TÉCNICA -->
    <section class="section">
      <div class="container two-col" style="align-items: flex-start; gap: 3.5rem;">
        
        <!-- DETALLE DEL SERVICIO -->
        <div class="reveal">
          <p class="eyebrow" style="color: var(--cyan);">Definición del Servicio</p>
          <h2>¿Qué es Castle Checkup y qué problema resuelve?</h2>
          <p style="font-size: 0.95rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.25rem;">
            Castle Checkup es un diagnóstico técnico estático de entrada. Responde a la pregunta fundamental: <em>"¿Dónde está parado mi software hoy?"</em>. Identifica si existen claves secretas expuestas, dependencias vulnerables o fallas de arquitectura que pongan en riesgo tu operación.
          </p>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Para quién es y cuándo contratarlo?</h3>
          <p style="font-size: 0.95rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.5rem;">
            Para fundadores, directores generales, CTOs y líderes de producto que van a recibir una entrega de software de un tercero, están por lanzar un nuevo producto a producción o quieren evaluar la salud técnica de un repositorio existente antes de comprometer mayor presupuesto.
          </p>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué incluye exactamente?</h3>
          <ul class="check-list" style="list-style: none; padding: 0; margin-bottom: 2rem;">
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Evaluación Estática de 65 Controles CQS v1.1:</strong> Mapeo en 7 dominios técnicos independientes ejecutado en memoria local.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Detección de Gate Breakers (P0):</strong> Claves de AWS, Stripe, GitHub PAT o certificados expuestos en código.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Dictamen de Gate Readiness:</strong> Evaluación preliminar de compatibilidad con políticas C1 y C2.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Reporte HTML Interactivo de Cumplimiento:</strong> Documento navegable con desglose de archivo y línea de cada hallazgo.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Sesión de Devolución de 1 Hora:</strong> Videollamada ejecutiva directamente con el Ingeniero Líder de Grupo Castillo.</li>
          </ul>

          <div style="padding: 1.25rem; background: rgba(0, 229, 153, 0.08); border-left: 3px solid var(--success); border-radius: var(--radius-sm); font-size: 0.9rem; color: var(--paper); margin-bottom: 2rem;">
            <strong>Mecánica de Acreditación 100%:</strong> El valor total pagado ($8,900 MXN) se acredita íntegramente hacia la contratación de cualquier paquete de desarrollo o servicio de ingeniería que se formalice dentro de los 30 días naturales posteriores.
          </div>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué NO incluye?</h3>
          <ul style="list-style: none; padding: 0; color: var(--steel-soft); font-size: 0.9rem; margin-bottom: 2rem;">
            <li style="padding: 6px 0; border-top: 1px dashed var(--line-dark);">Corrección directa de código o Pull Requests (disponible a través de Castle Rescue).</li>
            <li style="padding: 6px 0; border-top: 1px dashed var(--line-dark);">Múltiples repositorios (el Checkup cubre 1 repositorio individual; repositorios adicionales se cotizan por separado o vía Castle Audit).</li>
          </ul>
        </div>

        <!-- TARJETA LATERAL DE INVERSIÓN Y PROCESO -->
        <div class="glass-panel reveal" style="padding: 2.5rem; background: rgba(14, 18, 27, 0.85); border-color: rgba(0, 210, 255, 0.35); position: sticky; top: 2rem;">
          <span class="badge badge-cyan" style="margin-bottom: 0.75rem;">DIAGNÓSTICO ÁGIL</span>
          <div style="font-size: 2.25rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper); line-height: 1.1;">
            $8,900 MXN
          </div>
          <span style="display: block; font-family: var(--f-mono); font-size: 0.88rem; color: var(--steel-soft); margin-top: 0.25rem; margin-bottom: 1.5rem;">
            Pago Único • Facturación en MXN
          </span>

          <div style="padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border); margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span>Plazo de entrega:</span>
              <strong style="color: var(--paper);">72h objetivo</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span>Alcance:</span>
              <strong style="color: var(--paper);">1 Repositorio</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span>Acreditación:</span>
              <strong style="color: var(--success);">100% (30 días)</strong>
            </div>
          </div>

          <a href="/contacto?necesidad=checkup" class="btn btn-primary" style="width: 100%; text-align: center; margin-bottom: 0.75rem;">Solicitar Castle Checkup</a>
          <a href="/servicios/audit" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver servicio profundo: Castle Audit →</a>

          <p class="currency-disclaimer" style="margin-top: 1.25rem; font-size: 0.75rem;">
            * El conteo de las 72 horas inicia a partir de la recepción formal y completa de los accesos al repositorio.
          </p>
        </div>

      </div>
    </section>

    <!-- PREGUNTAS FRECUENTES -->
    <section class="section section-dim">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Preguntas Frecuentes sobre Castle Checkup</p>
          <h2>Dudas Comunes</h2>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Cómo les entregamos el código para el Checkup?" answer="Puedes otorgar acceso de lectura temporal a tu repositorio de GitHub, GitLab o Bitbucket, o enviarnos un archivo ZIP protegido con contraseña." />
              <FAQItem question="¿El análisis compromete la privacidad de nuestro código?" answer="No. Nuestro análisis se realiza de forma estática en memoria local sin enviar código hacia servidores externos de terceros y bajo estricto acuerdo de confidencialidad." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Qué pasa si encontramos fallas críticas durante el Checkup?" answer="En el reporte y la sesión de devolución te explicamos la gravedad de cada hallazgo y te entregamos la ruta recomendada para su corrección interna o mediante nuestro servicio Castle Rescue." />
              <FAQItem question="¿Cómo aplico el 100% de crédito hacia Castle Gate?" answer="Si dentro de los 30 días posteriores al dictamen decides contratar una licencia anual de Castle Gate (C1 a C6), se descuentan los $8,900 MXN de la factura anual." />
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTABand
      title="Conoce la salud real de tu software en 72 horas."
      description="Inicia hoy tu diagnóstico técnico con Grupo Castillo."
      ctaLabel="Solicitar Castle Checkup ($8,900 MXN)"
      ctaHref="/contacto?necesidad=checkup"
    />

  </main>
</BaseLayout>
