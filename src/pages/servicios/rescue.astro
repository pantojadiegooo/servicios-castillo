---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQItem from '../../components/FAQItem.astro';
import CTABand from '../../components/CTABand.astro';
import HeroEngineVisual from '../../components/HeroEngineVisual.astro';
---

<BaseLayout
  title="Castle Rescue — Remediación y Saneamiento Quirúrgico de Repositorios | Grupo Castillo"
  description="Servicio Castle Rescue (Desde $6,900 MXN / ~$405 USD): Intervención directa en código para sanear secretos expuestos, desbloquear pipelines rotos y reparar fallas críticas."
  canonical="https://grupocastillo.lat/servicios/rescue"
  ogUrl="https://grupocastillo.lat/servicios/rescue"
>
  <main id="main">

    <section class="page-hero">
      <HeroEngineVisual />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="/">Inicio</a> / <a href="/servicios">Servicios de Ingeniería</a> / Castle Rescue</p>
        <div class="badge badge-cyan">INTERVENCIÓN DIRECTA EN CÓDIGO • SANEAMIENTO</div>
        <h1>Castle Rescue: Saneamiento y Reparación en Repositorio</h1>
        <p>Ingeniería quirúrgica aplicada directamente en tus ramas de desarrollo para corregir secretos expuestos, reparar compilaciones rotas y resolver deuda técnica acumulada.</p>
      </div>
    </section>

    <!-- RESUMEN DEL SERVICIO Y FICHA TÉCNICA -->
    <section class="section">
      <div class="container two-col" style="align-items: flex-start; gap: 3.5rem;">
        
        <!-- DETALLE DEL SERVICIO -->
        <div class="reveal">
          <p class="eyebrow" style="color: var(--cyan);">Definición del Servicio</p>
          <h2>¿Qué es Castle Rescue y qué problema resuelve?</h2>
          <p style="font-size: 0.95rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.25rem;">
            Castle Rescue es nuestra capacidad de intervención técnica directa. Responde a la necesidad: <em>"¿Puedes ayudarme a corregir el código ahora mismo?"</em>. Trabajamos directamente en tu repositorio, abriendo ramas de trabajo aisladas y entregando Pull Requests limpios, verificados y documentados.
          </p>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">Modalidades y Bolsas de Horas</h3>
          <div class="grid" style="gap: 1rem; margin-bottom: 1.5rem;">
            <div style="padding: 1rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-sm);">
              <strong style="color: var(--cyan); font-family: var(--f-mono);">01. Rescue Express ($6,900 MXN):</strong>
              <p style="font-size: 0.85rem; color: var(--steel-light); margin: 0.25rem 0 0 0;">Hasta 6 horas de ingeniería directa. Ideal para saneamiento de claves expuestas en git, parches puntuales de dependencias o corrección de cabeceras.</p>
            </div>
            <div style="padding: 1rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-sm);">
              <strong style="color: var(--paper); font-family: var(--f-mono);">02. Rescue Standard ($12,900 MXN):</strong>
              <p style="font-size: 0.85rem; color: var(--steel-light); margin: 0.25rem 0 0 0;">Hasta 14 horas de ingeniería directa. Remediación de múltiples vulnerabilidades, estabilización de pipelines de CI/CD rotos y refactorización de módulos.</p>
            </div>
            <div style="padding: 1rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-sm);">
              <strong style="color: var(--paper); font-family: var(--f-mono);">03. Proyecto avanzado sujeto a cotización:</strong>
              <p style="font-size: 0.85rem; color: var(--steel-light); margin: 0.25rem 0 0 0;">Intervenciones de mayor envergadura, remediación integral tras auditoría profunda, migración de dependencias principales o saneamiento estructural de repositorios heredados complejos.</p>
            </div>
          </div>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">Metodología de Intervención</h3>
          <ul class="check-list" style="list-style: none; padding: 0; margin-bottom: 2rem;">
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Rama de Trabajo Aislada:</strong> Nunca intervenimos directamente en la rama principal de producción (main/master).</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Pull Requests Atómicos:</strong> Cada cambio se entrega documentado con explicación de causa raíz y solución.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Validación con Castle Gate:</strong> Todo Pull Request entregado pasa las pruebas de calidad previas al merge.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Transferencia y Sesión Técnica:</strong> Revisión conjunta del código remediado con tu equipo.</li>
          </ul>
        </div>

        <!-- TARJETA LATERAL DE INVERSIÓN Y PROCESO -->
        <div class="glass-panel reveal" style="padding: 2.5rem; background: rgba(14, 18, 27, 0.85); border-color: rgba(52, 107, 241, 0.35); position: sticky; top: 2rem;">
          <span class="badge badge-cyan" style="margin-bottom: 0.75rem;">INTERVENCIÓN DIRECTA</span>
          <div style="font-size: 2.25rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper); line-height: 1.1;">
            Desde $6,900 MXN
          </div>
          <span style="display: block; font-family: var(--f-mono); font-size: 0.88rem; color: var(--steel-soft); margin-top: 0.25rem; margin-bottom: 1.5rem;">
            Pago Único al Ordenar
          </span>

          <div style="padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border); margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span>Entregable:</span>
              <strong style="color: var(--paper);">Pull Requests Validados</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span>Tiempo de arranque:</span>
              <strong style="color: var(--paper);">24 a 48h</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span>Validación:</span>
              <strong style="color: var(--success);">Controles CQS Validados</strong>
            </div>
          </div>

          <a href="/contacto?necesidad=mejorar" class="btn btn-primary" style="width: 100%; text-align: center; margin-bottom: 0.75rem;">Solicitar Castle Rescue</a>
          <a href="/servicios/care" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver continuidad mensual: Castle Care →</a>

          <p class="currency-disclaimer" style="margin-top: 1.25rem; font-size: 0.75rem;">
            * Los paquetes Rescue se programan tras recibir acceso de colaborador al repositorio y delimitación del alcance. Los precios se expresan en pesos mexicanos. Las condiciones de pago y los datos comerciales aplicables se confirman antes de formalizar cada contratación.
          </p>
        </div>

      </div>
    </section>

    <!-- PREGUNTAS FRECUENTES -->
    <section class="section section-dim">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Preguntas Frecuentes sobre Castle Rescue</p>
          <h2>Dudas Comunes</h2>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Cómo trabajan dentro de nuestro repositorio?" answer="Creamos una rama aislada de rescate (ej. 'rescue/hotfix-security') y entregamos Pull Requests con pruebas automatizadas para que tu equipo interno los revise y apruebe antes del merge." />
              <FAQItem question="¿Qué ocurre si las horas estimadas no son suficientes?" answer="Si durante el saneamiento se detecta complejidad imprevista, te notificamos de inmediato con un reporte técnico de estado antes de consumir horas adicionales." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Pueden sanear el historial de Git si se subió un secreto en commits antiguos?" answer="Sí. Utilizamos herramientas especializadas de reescritura de árbol de Git (git-filter-repo) para purgar de forma segura el secreto del historial sin romper las referencias de ramas." />
              <FAQItem question="¿Castle Care incluye trabajos de Castle Rescue?" answer="No. Castle Care incluye hasta 30 o 60 minutos mensuales de ajustes correctivos menores sobre el alcance existente según el plan. Las intervenciones de rescate estructural, saneamiento profundo de repositorios o refactorizaciones complejas corresponden al servicio independiente Castle Rescue (desde $6,900 MXN)." />
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTABand
      title="Desbloquea tu repositorio con ingeniería especializada."
      description="Inicia tu intervención técnica directamente con el Ingeniero Líder de Grupo Castillo."
      ctaLabel="Solicitar Intervención Rescue"
      ctaHref="/contacto?necesidad=mejorar"
    />

  </main>
</BaseLayout>
