---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQItem from '../../components/FAQItem.astro';
import CTABand from '../../components/CTABand.astro';
import InnerHeroVisual from '../../components/InnerHeroVisual.astro';
---

<BaseLayout
  title="Castle Care — Suscripción Mensual de Continuidad y Gobernanza Técnica | Grupo Castillo"
  description="Planes Castle Care (Desde $3,500 MXN / mes): Supervisión continua de uptime, actualización de dependencias, parches de seguridad y horas Rescue mensuales incluidas."
  canonical="https://servicios-castillo.vercel.app/servicios/care.html"
  ogUrl="https://servicios-castillo.vercel.app/servicios/care.html"
>
  <main id="main">

    <section class="page-hero">
      <InnerHeroVisual type="care" />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="/index.html">Inicio</a> / <a href="/servicios.html">Servicios</a> / Castle Care</p>
        <div class="badge badge-cyan">CONTINUIDAD MENSUAL • GOBERNANZA &amp; RESCUE</div>
        <h1>Castle Care: Acompañamiento Técnico Continuo</h1>
        <p>Mantén tu software seguro, veloz y actualizado mes a mes sin necesidad de contratar un equipo de ingeniería de planta de tiempo completo.</p>
      </div>
    </section>

    <!-- RESUMEN DEL SERVICIO Y COMPARATIVA DE PLANES -->
    <section class="section">
      <div class="container">
        
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Niveles de Suscripción Mensual</p>
          <h2>Elige el plan adecuado para tu operación</h2>
          <p>Mantenimiento preventivo, supervisión de uptime y horas de ingeniería quirúrgica directa (Rescue) incluidas.</p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem; margin-bottom: 3rem;">
          
          <!-- 1. CARE ESSENTIAL -->
          <div class="card glass-panel" style="padding: 2.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-light); font-weight: 700;">NIVEL 01 • ESENCIAL</span>
            </div>
            <h3 style="font-size: 1.4rem; margin: 0.25rem 0;">Care Essential</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); margin-bottom: 1.25rem; min-height: 2.8rem;">
              Supervisión de disponibilidad y parches de seguridad para sitios web institucionales.
            </p>
            <div class="package-price-wrap" style="margin-bottom: 1.25rem;">
              <div class="package-price" style="font-size: 1.4rem; font-family: var(--f-mono); font-weight: 700; color: var(--paper);">$3,500 MXN <span style="font-size: 0.8rem; color: var(--steel-soft); font-weight: normal;">/ mes</span></div>
              <span class="price-sub-usd" style="display: block; font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-soft); margin-top: 0.25rem;">~$205 USD / mes</span>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
              <li>1 Repositorio / Sitio supervisado</li>
              <li>Supervisión de disponibilidad y parches</li>
              <li>Actualización mensual de dependencias</li>
              <li>Parches menores de seguridad</li>
              <li>No incluye horas de rescate directo</li>
            </ul>
            <a class="btn btn-primary" href="/contacto.html?necesidad=cuidado" style="width: 100%; text-align: center; font-size: 0.82rem;">Contratar Essential</a>
          </div>

          <!-- 2. CARE PRO (POPULAR) -->
          <div class="card glass-panel" style="padding: 2.25rem; border-color: rgba(0, 210, 255, 0.35); background: linear-gradient(180deg, rgba(0, 210, 255, 0.05) 0%, var(--glass-surface) 100%);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span class="badge badge-cyan" style="font-size: 0.65rem; padding: 2px 7px;">RECOMENDADO</span>
              <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--cyan); font-weight: 700;">NIVEL 02</span>
            </div>
            <h3 style="font-size: 1.4rem; margin: 0.25rem 0;">Care Pro</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); margin-bottom: 1.25rem; min-height: 2.8rem;">
              La combinación ideal de supervisión y 4 horas mensuales de intervención técnica directa.
            </p>
            <div class="package-price-wrap" style="margin-bottom: 1.25rem;">
              <div class="package-price" style="font-size: 1.4rem; font-family: var(--f-mono); font-weight: 700; color: var(--paper);">$7,900 MXN <span style="font-size: 0.8rem; color: var(--steel-soft); font-weight: normal;">/ mes</span></div>
              <span class="price-sub-usd" style="display: block; font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-soft); margin-top: 0.25rem;">~$465 USD / mes</span>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
              <li>Hasta 3 Repositorios supervisados</li>
              <li><strong>4 Horas Rescue directas incluidas/mes</strong></li>
              <li>Actualización preventiva de librerías</li>
              <li>Canal de soporte técnico prioritario</li>
              <li>Reporte mensual ejecutivo de salud técnica</li>
            </ul>
            <a class="btn btn-primary" href="/contacto.html?necesidad=cuidado" style="width: 100%; text-align: center; font-size: 0.82rem;">Contratar Care Pro</a>
          </div>

          <!-- 3. CARE ENTERPRISE -->
          <div class="card glass-panel" style="padding: 2.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--cyan); font-weight: 700;">NIVEL 03 • ALTA DISPONIBILIDAD</span>
            </div>
            <h3 style="font-size: 1.4rem; margin: 0.25rem 0;">Care Enterprise</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); margin-bottom: 1.25rem; min-height: 2.8rem;">
              Mesa de ayuda dedicada, hasta 10 repositorios y 10 horas de ingeniería mensual.
            </p>
            <div class="package-price-wrap" style="margin-bottom: 1.25rem;">
              <div class="package-price" style="font-size: 1.4rem; font-family: var(--f-mono); font-weight: 700; color: var(--paper);">$17,900 MXN <span style="font-size: 0.8rem; color: var(--steel-soft); font-weight: normal;">/ mes</span></div>
              <span class="price-sub-usd" style="display: block; font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-soft); margin-top: 0.25rem;">~$1,050 USD / mes</span>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
              <li>Hasta 10 Repositorios supervisados</li>
              <li><strong>10 Horas Rescue directas incluidas/mes</strong></li>
              <li>Sesión mensual de revisión de arquitectura</li>
              <li>Compromiso de respuesta definido por contrato</li>
              <li>Soporte multicanal dedicado</li>
            </ul>
            <a class="btn btn-primary" href="/contacto.html?necesidad=cuidado" style="width: 100%; text-align: center; font-size: 0.82rem;">Contratar Enterprise</a>
          </div>

        </div>

        <div style="padding: 1.25rem; background: rgba(0, 210, 255, 0.05); border-left: 3px solid var(--cyan); border-radius: var(--radius-sm); font-size: 0.85rem; color: var(--steel-light); max-width: 800px; margin: 0 auto 3rem auto; text-align: center;">
          ℹ <em>Condición operativa:</em> Las horas de rescate técnico (Rescue) incluidas en los planes Care Pro y Care Enterprise se ejecutan durante el mes corriente y no son acumulables para meses posteriores.
        </div>

      </div>
    </section>

    <!-- PREGUNTAS FRECUENTES -->
    <section class="section section-dim">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Preguntas Frecuentes sobre Castle Care</p>
          <h2>Dudas Comunes</h2>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Existe plazo forzoso de permanencia?" answer="No. Las suscripciones Castle Care son mensuales y se pueden cancelar en cualquier momento avisando con 15 días de anticipación al siguiente corte de facturación." />
              <FAQItem question="¿Para qué puedo usar las horas Rescue incluidas en Care Pro?" answer="Puedes usarlas para implementar nuevas secciones, reparar errores en librerías, optimizar imágenes, actualizar textos o sanear credenciales." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Qué pasa si en un mes requiero más horas de las incluidas?" answer="Si excedes tus horas incluidas, las horas adicionales de ingeniería se facturan con una tarifa preferencial con descuento de cliente suscriptor." />
              <FAQItem question="¿Cómo se monitorea la disponibilidad?" answer="Configuramos sondas automatizadas que verifican el tiempo de respuesta HTTP y la validez de los certificados SSL cada 60 segundos." />
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTABand
      title="Asegura la salud y continuidad de tu software hoy."
      description="Suscríbete a Castle Care y delega la supervisión técnica en los expertos de Grupo Castillo."
      ctaLabel="Suscribirme a Castle Care"
      ctaHref="/contacto.html?necesidad=cuidado"
    />

  </main>
</BaseLayout>
