---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQItem from '../../components/FAQItem.astro';
import CTABand from '../../components/CTABand.astro';
import HeroEngineVisual from '../../components/HeroEngineVisual.astro';
---

<BaseLayout
  title="Castle Care — Suscripción Mensual de Continuidad y Gobernanza Técnica | Grupo Castillo"
  description="Planes Castle Care (Desde $590 MXN / mes): Supervisión continua de uptime, actualización de dependencias, parches de seguridad y mantenimiento técnico preventivo."
  canonical="https://grupocastillo.lat/servicios/care"
  ogUrl="https://grupocastillo.lat/servicios/care"
>
  <main id="main">

    <section class="page-hero">
      <HeroEngineVisual />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="/">Inicio</a> / <a href="/servicios">Servicios de Ingeniería</a> / Castle Care</p>
        <div class="badge badge-cyan">CONTINUIDAD MENSUAL • GOBERNANZA &amp; RESCUE</div>
        <h1>Castle Care: Acompañamiento Técnico Continuo</h1>
        <p>Mantén tu software seguro, veloz y actualizado mes a mes sin necesidad de contratar un equipo de ingeniería de planta de tiempo completo.</p>
      </div>
    </section>

    <!-- RESUMEN DEL SERVICIO Y COMPARATIVA DE PLANES -->
    <section class="section">
      <div class="container">
        
        <div class="section-head reveal">
          <p class="eyebrow" style="color: var(--cyan);">Niveles de Suscripción Mensual</p>
          <h2>Elige el plan adecuado para tu operación</h2>
          <p>Mantenimiento preventivo, supervisión de disponibilidad y gobernanza técnica continua.</p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem; margin-bottom: 3rem;">
          
          <!-- 1. CARE BASIC -->
          <div class="card glass-panel" style="padding: 2.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--steel-light); font-weight: 700;">NIVEL 01 • BÁSICO</span>
            </div>
            <h3 style="font-size: 1.4rem; margin: 0.25rem 0;">Care Basic</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); margin-bottom: 1.25rem; min-height: 2.8rem;">
              Supervisión esencial de disponibilidad y parches de seguridad para sitios web corporativos.
            </p>
            <div class="package-price-wrap" style="margin-bottom: 1.25rem;">
              <div class="package-price" style="font-size: 1.4rem; font-family: var(--f-mono); font-weight: 700; color: var(--paper);">$590 MXN <span style="font-size: 0.8rem; color: var(--steel-soft); font-weight: normal;">/ mes</span></div>
              <span style="display: block; font-family: var(--f-mono); font-size: 0.78rem; color: var(--steel-soft); margin-top: 0.25rem;">Suscripción mensual • Facturación en MXN</span>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
              <li>1 Repositorio / Sitio supervisado</li>
              <li>Supervisión de disponibilidad 24/7</li>
              <li>Monitoreo de certificados SSL</li>
              <li>Parches preventivos de seguridad</li>
              <li>Soporte técnico vía ticket estándar</li>
            </ul>
            <a class="btn btn-primary" href="/contacto?necesidad=cuidado" style="width: 100%; text-align: center; font-size: 0.82rem; margin-top: auto;">Contratar Basic</a>
          </div>

          <!-- 2. CARE PRO (POPULAR) -->
          <div class="card glass-panel" style="padding: 2.25rem; border-color: rgba(52, 107, 241, 0.35); background: linear-gradient(180deg, rgba(52, 107, 241, 0.05) 0%, var(--glass-surface) 100%);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span class="badge badge-cyan" style="font-size: 0.65rem; padding: 2px 7px;">RECOMENDADO</span>
              <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--cyan); font-weight: 700;">NIVEL 02</span>
            </div>
            <h3 style="font-size: 1.4rem; margin: 0.25rem 0;">Care Pro</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); margin-bottom: 1.25rem; min-height: 2.8rem;">
              Supervisión integral, actualización periódica de dependencias y soporte técnico prioritario.
            </p>
            <div class="package-price-wrap" style="margin-bottom: 1.25rem;">
              <div class="package-price" style="font-size: 1.4rem; font-family: var(--f-mono); font-weight: 700; color: var(--paper);">$990 MXN <span style="font-size: 0.8rem; color: var(--steel-soft); font-weight: normal;">/ mes</span></div>
              <span style="display: block; font-family: var(--f-mono); font-size: 0.78rem; color: var(--steel-soft); margin-top: 0.25rem;">Suscripción mensual • Facturación en MXN</span>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
              <li>Hasta 3 Repositorios / Sitios supervisados</li>
              <li>Supervisión de disponibilidad y salud técnica</li>
              <li>Actualización preventiva de dependencias</li>
              <li>Canal de soporte técnico prioritario</li>
              <li>Reporte mensual de métricas y rendimiento</li>
            </ul>
            <a class="btn btn-primary" href="/contacto?necesidad=cuidado" style="width: 100%; text-align: center; font-size: 0.82rem; margin-top: auto;">Contratar Care Pro</a>
          </div>

          <!-- 3. CARE ENTERPRISE -->
          <div class="card glass-panel" style="padding: 2.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span style="font-family: var(--f-mono); font-size: 0.8rem; color: var(--cyan); font-weight: 700;">NIVEL 03 • ALTA DISPONIBILIDAD</span>
            </div>
            <h3 style="font-size: 1.4rem; margin: 0.25rem 0;">Care Enterprise</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); margin-bottom: 1.25rem; min-height: 2.8rem;">
              Gobernanza completa, supervisión multi-proyecto y asesoría de ingeniería directa.
            </p>
            <div class="package-price-wrap" style="margin-bottom: 1.25rem;">
              <div class="package-price" style="font-size: 1.4rem; font-family: var(--f-mono); font-weight: 700; color: var(--paper);">$2,490 MXN <span style="font-size: 0.8rem; color: var(--steel-soft); font-weight: normal;">/ mes</span></div>
              <span style="display: block; font-family: var(--f-mono); font-size: 0.78rem; color: var(--steel-soft); margin-top: 0.25rem;">Suscripción mensual • Facturación en MXN</span>
            </div>
            <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
              <li>Hasta 10 Repositorios supervisados</li>
              <li>Supervisión continua de disponibilidad y seguridad</li>
              <li>Sesión periódica de revisión de arquitectura</li>
              <li>Atención prioritaria y soporte multi-canal</li>
              <li>Auditorías continuas con Castle Gate CLI</li>
            </ul>
            <a class="btn btn-primary" href="/contacto?necesidad=cuidado" style="width: 100%; text-align: center; font-size: 0.82rem; margin-top: auto;">Contratar Enterprise</a>
          </div>

        </div>

        <div style="padding: 1.25rem; background: rgba(52, 107, 241, 0.05); border-left: 3px solid var(--cyan); border-radius: var(--radius-sm); font-size: 0.85rem; color: var(--steel-light); max-width: 800px; margin: 0 auto 3rem auto; text-align: center;">
          ℹ <em>Condición operativa:</em> Las suscripciones Castle Care se renuevan mes a mes y pueden cancelarse en cualquier momento con notificación previa antes de la fecha de corte.
        </div>

      </div>
    </section>

    <!-- PREGUNTAS FRECUENTES -->
    <section class="section section-dim">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Preguntas Frecuentes sobre Castle Care</p>
          <h2>Dudas Comunes</h2>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Existe plazo forzoso de permanencia?" answer="No. Las suscripciones Castle Care son mensuales y se pueden cancelar en cualquier momento avisando con 15 días de anticipación al siguiente corte de facturación." />
              <FAQItem question="¿Para qué puedo usar las horas Rescue incluidas en Care Pro?" answer="Puedes usarlas para implementar nuevas secciones, reparar errores en librerías, optimizar imágenes, actualizar textos o sanear credenciales." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Qué pasa si en un mes requiero más horas de las incluidas?" answer="Si excedes tus horas incluidas, las horas adicionales de ingeniería se facturan con una tarifa preferencial con descuento de cliente suscriptor." />
              <FAQItem question="¿Cómo se monitorea la disponibilidad?" answer="Configuramos sondas automatizadas que verifican el tiempo de respuesta HTTP y la validez de los certificados SSL cada 60 segundos." />
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTABand
      title="Asegura la salud y continuidad de tu software hoy."
      description="Suscríbete a Castle Care y delega la supervisión técnica en los expertos de Grupo Castillo."
      ctaLabel="Suscribirme a Castle Care"
      ctaHref="/contacto?necesidad=cuidado"
    />

  </main>
</BaseLayout>
