---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQItem from '../../components/FAQItem.astro';
import CTABand from '../../components/CTABand.astro';
import HeroEngineVisual from '../../components/HeroEngineVisual.astro';
---

<BaseLayout
  title="Castle Audit — Auditoría Técnica Profunda y Due Diligence de Código | Grupo Castillo"
  description="Servicio Castle Audit (Desde $19,900 MXN / ~$1,170 USD): Auditoría exhaustiva de arquitectura, dependencias, deuda técnica y cumplimiento para Due Diligence o modernización."
  canonical="https://grupocastillo.lat/servicios/audit"
  ogUrl="https://grupocastillo.lat/servicios/audit"
>
  <main id="main">

    <section class="page-hero">
      <HeroEngineVisual />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="/">Inicio</a> / <a href="/servicios">Servicios de Ingeniería</a> / Castle Audit</p>
        <div class="badge badge-cyan">AUDITORÍA PROFUNDA • DUE DILIGENCE TÉCNICO</div>
        <h1>Castle Audit: Auditoría Exhaustiva de Software</h1>
        <p>Evaluación técnica integral de bases de código complejas, arquitecturas monolíticas o microservicios para procesos de inversión, fusiones o modernización tecnológica.</p>
      </div>
    </section>

    <!-- RESUMEN DEL SERVICIO Y FICHA TÉCNICA -->
    <section class="section">
      <div class="container two-col" style="align-items: flex-start; gap: 3.5rem;">
        
        <!-- DETALLE DEL SERVICIO -->
        <div class="reveal">
          <p class="eyebrow" style="color: var(--cyan);">Definición del Servicio</p>
          <h2>¿Qué es Castle Audit y qué problema resuelve?</h2>
          <p style="font-size: 0.95rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.25rem;">
            Castle Audit es una auditoría técnica estructural profunda. Responde a la pregunta: <em>"¿Qué tan profundo es el problema y cuánto costará resolverlo?"</em>. Mapea la arquitectura completa, dependencias obsoletas, licencias de terceros en riesgo y deudas ocultas.
          </p>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">Modalidades y Niveles de Cobertura</h3>
          <div class="grid" style="gap: 1rem; margin-bottom: 1.5rem;">
            <div style="padding: 1rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-sm);">
              <strong style="color: var(--cyan); font-family: var(--f-mono);">01. Standard Audit ($19,900 MXN):</strong>
              <p style="font-size: 0.85rem; color: var(--steel-light); margin: 0.25rem 0 0 0;">Hasta 2 repositorios o 50k líneas de código. Diagnóstico de arquitectura, dependencias y riesgos P0-P2 en 5 a 7 días.</p>
            </div>
            <div style="padding: 1rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-sm);">
              <strong style="color: var(--paper); font-family: var(--f-mono);">02. Advanced Audit ($39,900 MXN):</strong>
              <p style="font-size: 0.85rem; color: var(--steel-light); margin: 0.25rem 0 0 0;">Hasta 5 repositorios o 150k líneas de código. Incluye análisis de flujo de datos, modelo de amenazas y plan de mitigación en 10 días.</p>
            </div>
            <div style="padding: 1rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-sm);">
              <strong style="color: var(--paper); font-family: var(--f-mono);">03. Proyecto avanzado sujeto a cotización:</strong>
              <p style="font-size: 0.85rem; color: var(--steel-light); margin: 0.25rem 0 0 0;">Alcance a medida para fondos de inversión, Due Diligence, M&amp;A o corporativos con múltiples repositorios. Dictamen formal de riesgo tecnológico y estimación de costos de reescritura.</p>
            </div>
          </div>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué entregables recibirás?</h3>
          <ul class="check-list" style="list-style: none; padding: 0; margin-bottom: 2rem;">
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Dictamen Ejecutivo de Salud Técnica:</strong> Resumen para toma de decisiones e inversionistas.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Matriz de Riesgos y Deuda Técnica (P0 a P3):</strong> Clasificación por severidad, impacto y esfuerzo.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Reporte de Dependencias y Licenciamiento:</strong> Detección de paquetes abandonados o licencias restrictivas.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Hoja de Ruta de Remediación (Roadmap):</strong> Plan paso a paso con prioridades de intervención.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Sesión Técnica de Presentación (2 horas):</strong> Explicación a fondo directamente con el Ingeniero Líder y directivos.</li>
          </ul>
        </div>

        <!-- TARJETA LATERAL DE INVERSIÓN Y PROCESO -->
        <div class="glass-panel reveal" style="padding: 2.5rem; background: rgba(14, 18, 27, 0.85); border-color: rgba(52, 107, 241, 0.35); position: sticky; top: 2rem;">
          <span class="badge badge-cyan" style="margin-bottom: 0.75rem;">AUDITORÍA MULTICAPA</span>
          <div style="font-size: 2.25rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper); line-height: 1.1;">
            Desde $19,900 MXN
          </div>
          <span style="display: block; font-family: var(--f-mono); font-size: 0.88rem; color: var(--steel-soft); margin-top: 0.25rem; margin-bottom: 1.5rem;">
            Pago Único • Facturación en MXN
          </span>

          <div style="padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border); margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span>Plazo de entrega:</span>
              <strong style="color: var(--paper);">5 a 10 días</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span>Cobertura:</span>
              <strong style="color: var(--paper);">Código, Infra y Datos</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span>Confidencialidad:</span>
              <strong style="color: var(--success);">NDA Formal previo</strong>
            </div>
          </div>

          <a href="/contacto?necesidad=auditar" class="btn btn-primary" style="width: 100%; text-align: center; margin-bottom: 0.75rem;">Solicitar Castle Audit</a>
          <a href="/servicios/rescue" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver servicio de corrección: Castle Rescue →</a>

          <p class="currency-disclaimer" style="margin-top: 1.25rem; font-size: 0.75rem;">
            * Cotización final ajustada al volumen de repositorios, número de lenguajes y alcance de infraestructura.
          </p>
        </div>

      </div>
    </section>

    <!-- PREGUNTAS FRECUENTES -->
    <section class="section section-dim">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Preguntas Frecuentes sobre Castle Audit</p>
          <h2>Dudas Comunes</h2>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿En qué se diferencia Audit de Checkup?" answer="Checkup es un escaneo estático automatizado de 72 horas para un repositorio. Audit es una investigación exhaustiva humana y automatizada con revisión de arquitectura, modelo de amenazas y hoja de ruta de remediación." />
              <FAQItem question="¿El dictamen sirve para procesos de inversión o Due Diligence?" answer="Sí. El reporte ejecutivo y técnico de Castle Audit Enterprise está estructurado con el rigor requerido por fondos de capital de riesgo y adquirentes tecnológicos." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Pueden auditar sistemas heredados o monolitos antiguos?" answer="Sí. Nos especializamos en evaluar código heredado en Node.js, Python, PHP, Ruby, Java o Go para determinar si es viable refactorizar o reconstruir." />
              <FAQItem question="¿Ustedes pueden ejecutar la remediación posterior?" answer="Sí, a través de Castle Rescue o un desarrollo a la medida en Castle Diamond podemos ejecutar las correcciones de acuerdo a las prioridades del Roadmap." />
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTABand
      title="Toma decisiones con evidencia técnica transparente."
      description="Coordina una llamada confidencial directamente con el Ingeniero Líder de Grupo Castillo."
      ctaLabel="Cotizar Castle Audit"
      ctaHref="/contacto?necesidad=auditar"
    />

  </main>
</BaseLayout>
