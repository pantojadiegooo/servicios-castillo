---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQItem from '../../components/FAQItem.astro';
import CTABand from '../../components/CTABand.astro';
import HeroEngineVisual from '../../components/HeroEngineVisual.astro';
---

<BaseLayout
  title="Castle Emergency — Respuesta Técnica Prioritaria a Incidentes Críticos | Grupo Castillo"
  description="Servicio Castle Emergency ($5,900 MXN / ~$345 USD): Activación prioritaria para contingencias activas, caídas de producción, brechas de seguridad y bloqueos críticos."
  canonical="https://grupocastillo.lat/servicios/emergency"
  ogUrl="https://grupocastillo.lat/servicios/emergency"
>
  <main id="main">

    <section class="page-hero">
      <HeroEngineVisual />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="/">Inicio</a> / <a href="/servicios">Servicios de Ingeniería</a> / Castle Emergency</p>
        <div class="badge badge-cyan">RESPUESTA PRIORITARIA • CONTENCIÓN DE CRISIS</div>
        <h1>Castle Emergency: Auxilio y Contención de Incidentes</h1>
        <p>Protocolo de activación prioritaria cuando tu sistema está caído, tus credenciales han sido vulneradas o tu operación está completamente detenida.</p>
      </div>
    </section>

    <!-- RESUMEN DEL SERVICIO Y FICHA TÉCNICA -->
    <section class="section">
      <div class="container two-col" style="align-items: flex-start; gap: 3.5rem;">
        
        <!-- DETALLE DEL SERVICIO -->
        <div class="reveal">
          <p class="eyebrow" style="color: var(--cyan);">Definición del Servicio</p>
          <h2>¿Qué es Castle Emergency y cuándo activarlo?</h2>
          <p style="font-size: 0.95rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.25rem;">
            Castle Emergency es nuestro protocolo de choque para contingencias activas. A diferencia de intervenciones programadas (Rescue), Emergency moviliza ingeniería con prioridad inmediata para diagnosticar, aislar y contener la falla crítica que afecta a tus usuarios.
          </p>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">Escenarios de Activación Típicos</h3>
          <ul class="check-list" style="list-style: none; padding: 0; margin-bottom: 1.5rem;">
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Caída Total de Producción (Outage):</strong> Servidor no responde, errores 500 generalizados o bucles de compilación.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Fuga Activa de Claves o Secretos:</strong> Exposición de claves maestras en repositorios públicos que requieren revocación y rotación urgente.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Fallas Críticas de Despliegue en Release:</strong> Pipeline bloqueado en momento de lanzamiento comercial clave.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Abandono Repentino de Proveedor:</strong> Acceso bloqueado o infraestructura desconfigurada sin documentación.</li>
          </ul>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">Protocolo de 3 Fases</h3>
          <div class="grid" style="gap: 1rem; margin-bottom: 2rem;">
            <div style="padding: 1rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-sm);">
              <strong style="color: var(--cyan); font-family: var(--f-mono);">Fase 1: Triage y Aislamiento</strong>
              <p style="font-size: 0.85rem; color: var(--steel-light); margin: 0.25rem 0 0 0;">Identificación de causa raíz, revocación de accesos en riesgo y contención del daño inmediato.</p>
            </div>
            <div style="padding: 1rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-sm);">
              <strong style="color: var(--paper); font-family: var(--f-mono);">Fase 2: Remediación en Caliente</strong>
              <p style="font-size: 0.85rem; color: var(--steel-light); margin: 0.25rem 0 0 0;">Aplicación de hotfix o rollback controlado para restablecer el servicio a los usuarios finales.</p>
            </div>
            <div style="padding: 1rem; background: #07090E; border: 1px solid var(--line-dark); border-radius: var(--radius-sm);">
              <strong style="color: var(--paper); font-family: var(--f-mono);">Fase 3: Post-Mortem y Blindaje</strong>
              <p style="font-size: 0.85rem; color: var(--steel-light); margin: 0.25rem 0 0 0;">Reporte técnico detallando qué ocurrió, por qué ocurrió y qué controles permanentes se configuraron.</p>
            </div>
          </div>
        </div>

        <!-- TARJETA LATERAL DE INVERSIÓN Y PROCESO -->
        <div class="glass-panel reveal" style="padding: 2.5rem; background: rgba(14, 18, 27, 0.85); border-color: rgba(52, 107, 241, 0.35); position: sticky; top: 2rem;">
          <span class="badge badge-cyan" style="margin-bottom: 0.75rem;">ACTIVACIÓN PRIORITARIA</span>
          <div style="font-size: 2.25rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper); line-height: 1.1;">
            $5,900 MXN
          </div>
          <span style="display: block; font-family: var(--f-mono); font-size: 0.88rem; color: var(--steel-soft); margin-top: 0.25rem; margin-bottom: 1.5rem;">
            Pago Único al Ordenar
          </span>

          <div style="padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border); margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span>Prioridad:</span>
              <strong style="color: var(--cyan);">Inmediata / Máxima</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span>Enfoque:</span>
              <strong style="color: var(--paper);">Contención y Hotfix</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span>Reporte:</span>
              <strong style="color: var(--success);">Post-Mortem Técnico</strong>
            </div>
          </div>

          <a href="/contacto?necesidad=urgencia" class="btn btn-primary" style="width: 100%; text-align: center; margin-bottom: 0.75rem; background: #E11D48; border-color: #E11D48;">Activar Castle Emergency</a>
          <a href="/servicios/rescue" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver intervención programada: Castle Rescue →</a>

          <p class="currency-disclaimer" style="margin-top: 1.25rem; font-size: 0.75rem;">
            * La activación inicial cubre diagnóstico urgente y contención primaria de hasta 4 horas de guardia técnica. Los precios se expresan en pesos mexicanos. Las condiciones de pago y los datos comerciales aplicables se confirman antes de formalizar cada contratación.
          </p>
        </div>

      </div>
    </section>

    <!-- PREGUNTAS FRECUENTES -->
    <section class="section section-dim">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Preguntas Frecuentes sobre Castle Emergency</p>
          <h2>Dudas Comunes</h2>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Cómo reportar una urgencia de forma inmediata?" answer="Completa el formulario marcando la opción 'Intervención prioritaria urgente' o escríbenos directamente indicando la URL afectada y el comportamiento de la falla." />
              <FAQItem question="¿Qué accesos necesitarán para intervenir?" answer="Dependiendo del incidente, requeriremos acceso de lectura/escritura al repositorio, acceso al panel de hosting (Vercel, Netlify, AWS, etc.) o variables de entorno." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Qué pasa si el servidor está hackeado o comprometido?" answer="El primer paso es aislar el entorno para prevenir mayor exfiltración, revocar credenciales comprometidas y desplegar una versión limpia desde un commit validado." />
              <FAQItem question="¿Cómo evito que vuelva a ocurrir?" answer="Una vez estabilizada la crisis, recomendamos integrar Castle Gate C1 en CI/CD y suscribir un plan Castle Care para supervisión preventiva continua." />
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTABand
      title="¿Tienes un incidente activo en producción?"
      description="Activa el protocolo de emergencia de Grupo Castillo para restablecer la continuidad de tu negocio."
      ctaLabel="Activar Respuesta de Emergencia"
      ctaHref="/contacto?necesidad=urgencia"
    />

  </main>
</BaseLayout>
