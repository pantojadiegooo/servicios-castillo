---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQItem from '../components/FAQItem.astro';
import CTABand from '../components/CTABand.astro';
import CastleTerminalSimulator from '../components/CastleTerminalSimulator.astro';
import HeroEngineVisual from '../components/HeroEngineVisual.astro';
import CastleGateBadge from '../components/CastleGateBadge.astro';
---

<BaseLayout
  title="Castle Gate — Motor de Gobernanza y Validación Determinista de Releases | Grupo Castillo"
  description="Tecnología propietaria de Grupo Castillo: Motor de validación técnica determinista basado en CQS v1.1. 65 controles, 7 dominios, evaluación local en memoria y certificados SHA-256."
  canonical="https://grupocastillo.lat/castle-gate"
  ogUrl="https://grupocastillo.lat/castle-gate"
>
  <main id="main">

    <!-- HERO SECTION (ORBE HOLOGRÁFICO DE CÓDIGO Y ENERGÍA) -->
    <section class="page-hero">
      <HeroEngineVisual />
      <div class="container page-hero-inner">
        <p class="eyebrow" style="margin-bottom: 1.25rem; justify-content: center; color: var(--cyan);">
          MOTOR DE GOBERNANZA &amp; EVALUACIÓN DETERMINISTA
        </p>
        <h1>Gobernanza de Código <span style="color: var(--cyan);">Castle Gate</span></h1>
        <p>Motor de gobernanza de software y validación determinista de releases. Diseñado para evaluar y vetar entregas que incumplan los controles de seguridad y calidad CQS v1.1 configurados en tu pipeline.</p>
        <div style="margin-top: 1.5rem;">
          <a href="/diagnostico" class="btn btn-cta-crystal" style="font-size: 1.05rem; padding: 0.95rem 2.5rem;">Iniciar Diagnóstico →</a>
        </div>
      </div>
    </section>

    <!-- CAPA 1: EXPLICACIÓN EJECUTIVA PARA DIRECTORES Y FUNDADORES -->
    <section class="section" style="padding-top: 1rem; padding-bottom: 4.5rem;">
      <div class="container">
        <div class="section-head reveal" style="text-align: center; max-width: 820px; margin: 0 auto 3rem auto;">
          <p class="eyebrow" style="color: var(--cyan); justify-content: center;">Capa Ejecutiva de Negocio</p>
          <h2>¿Por qué tu empresa necesita gobernanza en sus entregas?</h2>
          <p>La seguridad y calidad del software no deben depender de la memoria de un programador o de revisiones manuales aisladas.</p>
        </div>

        <div class="grid grid-3 reveal" style="gap: 1.5rem;">
          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid var(--cyan); display: flex; flex-direction: column;">
            <div style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--cyan); margin-bottom: 0.75rem; font-weight: 700; letter-spacing: 0.05em;">RIESGO 01 • FUGAS DE DATOS</div>
            <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem; color: var(--paper);">Prevención de Exposición de Secretos</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              Una clave de AWS o Stripe quemada en código puede costar miles de dólares en minutos. Castle Gate actúa como un árbitro que veta automáticamente el release antes de que el código salga de tu control.
            </p>
          </div>

          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid var(--cyan); display: flex; flex-direction: column;">
            <div style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--cyan); margin-bottom: 0.75rem; font-weight: 700; letter-spacing: 0.05em;">RIESGO 02 • DEGRADACIÓN</div>
            <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem; color: var(--paper);">Control Determinista de Calidad</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              Establece umbrales mínimos de rendimiento, accesibilidad WCAG y calidad de código. Si una entrega no cumple la política ratificada por tu empresa, el despliegue no se autoriza.
            </p>
          </div>

          <div class="card glass-panel" style="padding: 2.25rem; border-top: 3px solid var(--cyan); display: flex; flex-direction: column;">
            <div style="font-family: var(--f-mono); font-size: 0.78rem; color: var(--cyan); margin-bottom: 0.75rem; font-weight: 700; letter-spacing: 0.05em;">CERTEZA • AUDITORÍA</div>
            <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem; color: var(--paper);">Certificado de Release SHA-256</h3>
            <p style="font-size: 0.88rem; color: var(--steel-light); line-height: 1.6; margin: 0;">
              Cada entrega autorizada genera un Release Certificate con sello criptográfico SHA-256 verificable, proporcionando evidencia auditable para auditorías internas y clientes corporativos.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CAPA 2: DETALLE TÉCNICO PARA CTOS, DEVOPS E INGENIEROS (CON TERMINAL EN VIVO) -->
    <section class="section section-dim" id="detalle-tecnico" style="padding-top: 4.5rem; padding-bottom: 4.5rem; border-top: 1px solid var(--line-dark);">
      <div class="container">
        
        <div class="section-head reveal" style="text-align: center; max-width: 820px; margin: 0 auto 3.5rem auto;">
          <p class="eyebrow" style="color: var(--cyan); justify-content: center;">Capa de Ingeniería Técnica</p>
          <h2>Especificación Técnica y Ejecución en Memoria</h2>
          <p>Castle Gate ejecuta su evaluación estática en la memoria del runner local sin enviar código ni telemetría a servidores externos.</p>
        </div>

        <div class="two-col reveal" style="align-items: center; gap: 3.5rem; margin-bottom: 4.5rem;">
          <div>
            <h3 style="font-size: 1.4rem; margin-bottom: 1rem; color: var(--paper);">Flujo Determinista de Decisión:</h3>
            <ol style="font-size: 0.92rem; color: var(--steel-light); padding-left: 1.25rem; line-height: 1.7; margin-bottom: 1.75rem;">
              <li style="margin-bottom: 0.5rem;">
                <strong style="color: var(--paper);">Native Probes:</strong> Escaneo estático en memoria de patrones de credenciales privadas (AWS, Stripe, SSH, GitHub PAT).
              </li>
              <li style="margin-bottom: 0.5rem;">
                <strong style="color: var(--paper);">Gate Breaker Check:</strong> Veto inmediato con <code style="color: var(--danger); font-family: var(--f-mono);">Exit Code 1</code> ante cualquier hallazgo bloqueante (P0).
              </li>
              <li style="margin-bottom: 0.5rem;">
                <strong style="color: var(--paper);">Evaluación CQS v1.1:</strong> Ponderación nominal sobre 100.00 puntos en 7 dominios técnicos independientes.
              </li>
              <li>
                <strong style="color: var(--paper);">Release Certificate SHA-256:</strong> Emisión de sello criptográfico con <code style="color: var(--success); font-family: var(--f-mono);">Exit Code 0</code> autorizando el despliegue.
              </li>
            </ol>

            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
              <a href="#licenciamiento" class="btn btn-primary" style="font-size: 0.85rem;">Ver Tarifas de Licenciamiento</a>
              <a href="/servicios/checkup" class="btn btn-outline" style="font-size: 0.85rem;">Solicitar Checkup Inicial ($8,900 MXN)</a>
            </div>
          </div>

          <!-- TERMINAL CLI DEMO -->
          <div>
            <CastleTerminalSimulator />
          </div>
        </div>

        <!-- 7 DOMINIOS TÉCNICOS CQS V1.1 -->
        <div class="reveal">
          <div style="text-align: center; max-width: 820px; margin: 0 auto 2.5rem auto;">
            <p class="eyebrow" style="color: var(--cyan); justify-content: center; margin-bottom: 0.75rem;">Arquitectura de Controles</p>
            <h3 style="font-size: 1.65rem; color: var(--paper); margin-bottom: 0.5rem;">7 Dominios Técnicos • 65 Controles Nominales</h3>
            <p style="font-size: 0.95rem; color: var(--steel-light); margin: 0;">
              La metodología CQS v1.1 audita exhaustivamente cada dimensión crítica del ciclo de vida del software.
            </p>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem;">
            <!-- DOM-01 -->
            <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid rgba(52, 107, 241, 0.4);">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.75rem;">
                <span style="font-family:var(--f-mono); font-size:0.75rem; color:var(--cyan); font-weight:700;">DOM-01</span>
                <div style="display:flex; gap:6px; align-items:center;">
                  <span class="badge" style="font-size:0.6rem; padding:1px 5px; background:rgba(255,77,77,0.15); color:#FF4D4D; border:1px solid rgba(255,77,77,0.3);">GATE BREAKER</span>
                  <span style="font-family:var(--f-mono); font-size:0.75rem; color:var(--steel-soft);">25.00 PTS</span>
                </div>
              </div>
              <h4 style="font-size: 1.05rem; color: var(--paper); margin-bottom: 0.5rem;">Detección de Secretos y Credenciales</h4>
              <p style="font-size: 0.82rem; color: var(--steel-light); line-height: 1.55;">
                Detección estática de claves privadas RSA/EC, AWS Access Keys, PATs de GitHub/GitLab, Stripe live keys, URIs de bases de datos con contraseñas y archivos <code>.env</code> comprometidos.
              </p>
            </div>

            <!-- DOM-02 -->
            <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid rgba(52, 107, 241, 0.4);">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.75rem;">
                <span style="font-family:var(--f-mono); font-size:0.75rem; color:var(--cyan); font-weight:700;">DOM-02</span>
                <div style="display:flex; gap:6px; align-items:center;">
                  <span class="badge" style="font-size:0.6rem; padding:1px 5px; background:rgba(255,77,77,0.15); color:#FF4D4D; border:1px solid rgba(255,77,77,0.3);">GATE BREAKER</span>
                  <span style="font-family:var(--f-mono); font-size:0.75rem; color:var(--steel-soft);">20.00 PTS</span>
                </div>
              </div>
              <h4 style="font-size: 1.05rem; color: var(--paper); margin-bottom: 0.5rem;">Dependencias y Cadena de Suministro</h4>
              <p style="font-size: 0.82rem; color: var(--steel-light); line-height: 1.55;">
                Sintaxis y presencia de <code>package.json</code>, integridad de lockfiles (npm/pnpm/yarn), escaneo de CVEs críticas vía <code>npm audit</code> y dependencias git desancladas.
              </p>
            </div>

            <!-- DOM-03 -->
            <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid rgba(52, 107, 241, 0.4);">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.75rem;">
                <span style="font-family:var(--f-mono); font-size:0.75rem; color:var(--cyan); font-weight:700;">DOM-03</span>
                <div style="display:flex; gap:6px; align-items:center;">
                  <span class="badge" style="font-size:0.6rem; padding:1px 5px; background:rgba(255,77,77,0.15); color:#FF4D4D; border:1px solid rgba(255,77,77,0.3);">GATE BREAKER</span>
                  <span style="font-family:var(--f-mono); font-size:0.75rem; color:var(--steel-soft);">15.00 PTS</span>
                </div>
              </div>
              <h4 style="font-size: 1.05rem; color: var(--paper); margin-bottom: 0.5rem;">Calidad de Código Estático</h4>
              <p style="font-size: 0.82rem; color: var(--steel-light); line-height: 1.55;">
                Integridad sintáctica de JavaScript, ausencia de sentencias de depuración activa <code>debugger</code> y control de presupuestos para assets multimedia no comprimidos (&lt; 5MB).
              </p>
            </div>

            <!-- DOM-04 -->
            <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid rgba(52, 107, 241, 0.4);">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.75rem;">
                <span style="font-family:var(--f-mono); font-size:0.75rem; color:var(--cyan); font-weight:700;">DOM-04</span>
                <span style="font-family:var(--f-mono); font-size:0.75rem; color:var(--steel-soft);">15.00 PTS</span>
              </div>
              <h4 style="font-size: 1.05rem; color: var(--paper); margin-bottom: 0.5rem;">Accesibilidad (WCAG AA)</h4>
              <p style="font-size: 0.82rem; color: var(--steel-light); line-height: 1.55;">
                Estructura semántica (<code>&lt;main&gt;</code>, <code>&lt;nav&gt;</code>), jerarquía y unicidad de <code>&lt;h1&gt;</code>, atributos <code>alt</code> en imágenes y soporte para <code>prefers-reduced-motion</code>.
              </p>
            </div>

            <!-- DOM-05 -->
            <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid rgba(52, 107, 241, 0.4);">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.75rem;">
                <span style="font-family:var(--f-mono); font-size:0.75rem; color:var(--cyan); font-weight:700;">DOM-05</span>
                <span style="font-family:var(--f-mono); font-size:0.75rem; color:var(--steel-soft);">10.00 PTS</span>
              </div>
              <h4 style="font-size: 1.05rem; color: var(--paper); margin-bottom: 0.5rem;">Rendimiento y Web Vitals</h4>
              <p style="font-size: 0.82rem; color: var(--steel-light); line-height: 1.55;">
                Etiqueta meta viewport responsiva, presupuesto de JavaScript del cliente (&lt; 300KB) y ciclo de vida seguro de <code>cancelAnimationFrame</code> para evitar fugas de memoria.
              </p>
            </div>

            <!-- DOM-06 -->
            <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid rgba(52, 107, 241, 0.4);">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.75rem;">
                <span style="font-family:var(--f-mono); font-size:0.75rem; color:var(--cyan); font-weight:700;">DOM-06</span>
                <span style="font-family:var(--f-mono); font-size:0.75rem; color:var(--steel-soft);">10.00 PTS</span>
              </div>
              <h4 style="font-size: 1.05rem; color: var(--paper); margin-bottom: 0.5rem;">Higiene de Producción</h4>
              <p style="font-size: 0.82rem; color: var(--steel-light); line-height: 1.55;">
                Manejador de error 404 personalizado, cabeceras HTTP de seguridad (CSP, X-Frame-Options, nosniff, Referrer-Policy) y ausencia de URLs hardcodeadas a localhost/127.0.0.1.
              </p>
            </div>

            <!-- DOM-07 -->
            <div class="card glass-panel" style="padding: 1.75rem; border-top: 3px solid rgba(52, 107, 241, 0.4);">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.75rem;">
                <span style="font-family:var(--f-mono); font-size:0.75rem; color:var(--cyan); font-weight:700;">DOM-07</span>
                <span style="font-family:var(--f-mono); font-size:0.75rem; color:var(--steel-soft);">5.00 PTS</span>
              </div>
              <h4 style="font-size: 1.05rem; color: var(--paper); margin-bottom: 0.5rem;">SEO y Metadatos de Gobernanza</h4>
              <p style="font-size: 0.82rem; color: var(--steel-light); line-height: 1.55;">
                Declaración de URLs canónicas (<code>rel="canonical"</code>), etiquetas OpenGraph (<code>og:title</code>, <code>og:description</code>), <code>sitemap.xml</code> y <code>robots.txt</code>.
              </p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- MATRIZ DE POLÍTICAS C1 A C6 Y LICENCIAMIENTO ANUAL -->
    <section class="section" id="licenciamiento" style="padding-top: 4.5rem; padding-bottom: 4.5rem; border-top: 1px solid var(--line-dark);">
      <div class="container">
        <div class="section-head reveal" style="text-align: center; max-width: 820px; margin: 0 auto 3rem auto;">
          <p class="eyebrow" style="color: var(--cyan); justify-content: center;">Licenciamiento de Software</p>
          <h2>Matriz de Políticas C1 a C6 y Tarifas Anuales</h2>
          <p>Licenciamiento inicial de mercado para integración en runners privados de CI/CD.</p>
        </div>

        <div class="matrix-stepper reveal" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 2rem;">
          
          <!-- C1 -->
          <div class="step-card glass-panel" style="padding: 2rem; border-top: 3px solid var(--cyan); display: flex; flex-direction: column;">
            <div class="step-num" style="font-size: 1.5rem; font-family: var(--f-mono); color: var(--cyan); font-weight: bold;">C1</div>
            <div class="step-name" style="font-size: 1.15rem; font-weight: 700; color: var(--paper); margin: 0.25rem 0;">Foundation</div>
            <div style="font-family: var(--f-mono); font-size: 1.1rem; font-weight: 700; color: var(--paper); margin-bottom: 0.25rem;">$9,900 MXN <span style="font-size: 0.75rem; color: var(--steel-soft); font-weight: normal;">/ año</span></div>
            <span style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--steel-soft); display: block; margin-bottom: 0.75rem;">~$580 USD / año</span>
            <div class="step-threshold" style="font-size: 0.82rem; color: var(--steel-light); line-height: 1.45;">Score &ge; 60.00 • 0 Secretos expuestos • Lockfiles requeridos</div>
          </div>

          <!-- C2 -->
          <div class="step-card glass-panel" style="padding: 2rem; border-top: 3px solid var(--cyan); display: flex; flex-direction: column;">
            <div class="step-num" style="font-size: 1.5rem; font-family: var(--f-mono); color: var(--cyan); font-weight: bold;">C2</div>
            <div class="step-name" style="font-size: 1.15rem; font-weight: 700; color: var(--paper); margin: 0.25rem 0;">Standard</div>
            <div style="font-family: var(--f-mono); font-size: 1.1rem; font-weight: 700; color: var(--paper); margin-bottom: 0.25rem;">$16,900 MXN <span style="font-size: 0.75rem; color: var(--steel-soft); font-weight: normal;">/ año</span></div>
            <span style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--steel-soft); display: block; margin-bottom: 0.75rem;">~$990 USD / año</span>
            <div class="step-threshold" style="font-size: 0.82rem; color: var(--steel-light); line-height: 1.45;">Score &ge; 70.00 • Dependencias auditadas sin CVEs críticas • Viewport responsivo</div>
          </div>

          <!-- C3 -->
          <div class="step-card glass-panel" style="padding: 2rem; border-top: 3px solid var(--cyan); display: flex; flex-direction: column;">
            <div class="step-num" style="font-size: 1.5rem; font-family: var(--f-mono); color: var(--cyan); font-weight: bold;">C3</div>
            <div class="step-name" style="font-size: 1.15rem; font-weight: 700; color: var(--paper); margin: 0.25rem 0;">Professional</div>
            <div style="font-family: var(--f-mono); font-size: 1.1rem; font-weight: 700; color: var(--paper); margin-bottom: 0.25rem;">$26,900 MXN <span style="font-size: 0.75rem; color: var(--steel-soft); font-weight: normal;">/ año</span></div>
            <span style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--steel-soft); display: block; margin-bottom: 0.75rem;">~$1,580 USD / año</span>
            <div class="step-threshold" style="font-size: 0.82rem; color: var(--steel-light); line-height: 1.45;">Score &ge; 80.00 • Estructura semántica HTML5 • URLs canónicas</div>
          </div>

          <!-- C4 -->
          <div class="step-card glass-panel" style="padding: 2rem; border-top: 3px solid var(--cyan); display: flex; flex-direction: column;">
            <div class="step-num" style="font-size: 1.5rem; font-family: var(--f-mono); color: var(--cyan); font-weight: bold;">C4</div>
            <div class="step-name" style="font-size: 1.15rem; font-weight: 700; color: var(--paper); margin: 0.25rem 0;">Advanced</div>
            <div style="font-family: var(--f-mono); font-size: 1.1rem; font-weight: 700; color: var(--paper); margin-bottom: 0.25rem;">$39,900 MXN <span style="font-size: 0.75rem; color: var(--steel-soft); font-weight: normal;">/ año</span></div>
            <span style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--steel-soft); display: block; margin-bottom: 0.75rem;">~$2,345 USD / año</span>
            <div class="step-threshold" style="font-size: 0.82rem; color: var(--steel-light); line-height: 1.45;">Score &ge; 90.00 • Accesibilidad WCAG AA completa • Ciclo de vida rAF</div>
          </div>

          <!-- C5 -->
          <div class="step-card glass-panel" style="padding: 2rem; border-top: 3px solid var(--cyan); display: flex; flex-direction: column;">
            <div class="step-num" style="font-size: 1.5rem; font-family: var(--f-mono); color: var(--cyan); font-weight: bold;">C5</div>
            <div class="step-name" style="font-size: 1.15rem; font-weight: 700; color: var(--paper); margin: 0.25rem 0;">Enterprise</div>
            <div style="font-family: var(--f-mono); font-size: 1.1rem; font-weight: 700; color: var(--paper); margin-bottom: 0.25rem;">$54,900 MXN <span style="font-size: 0.75rem; color: var(--steel-soft); font-weight: normal;">/ año</span></div>
            <span style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--steel-soft); display: block; margin-bottom: 0.75rem;">~$3,225 USD / año</span>
            <div class="step-threshold" style="font-size: 0.82rem; color: var(--steel-light); line-height: 1.45;">Score &ge; 95.00 • Cabeceras CSP estrictas • Cero advertencias críticas</div>
          </div>

          <!-- C6 -->
          <div class="step-card glass-panel" style="padding: 2rem; border-top: 3px solid var(--cyan); display: flex; flex-direction: column;">
            <div class="step-num" style="font-size: 1.5rem; font-family: var(--f-mono); color: var(--cyan); font-weight: bold;">C6</div>
            <div class="step-name" style="font-size: 1.15rem; font-weight: 700; color: var(--paper); margin: 0.25rem 0;">Ultimate</div>
            <div style="font-family: var(--f-mono); font-size: 1.1rem; font-weight: 700; color: var(--paper); margin-bottom: 0.25rem;">$74,900 MXN <span style="font-size: 0.75rem; color: var(--steel-soft); font-weight: normal;">/ año</span></div>
            <span style="font-family: var(--f-mono); font-size: 0.75rem; color: var(--steel-soft); display: block; margin-bottom: 0.75rem;">~$4,400 USD / año</span>
            <div class="step-threshold" style="font-size: 0.82rem; color: var(--steel-light); line-height: 1.45;">Score &ge; 98.00 • 100% de controles nominales CQS aprobados</div>
          </div>

        </div>

        <p class="currency-disclaimer" style="text-align: center; font-size: 0.8rem; color: var(--steel-soft);">
          * Tarifas anuales de lanzamiento expresadas en pesos mexicanos (MXN). Equivalente USD aproximado para fines informativos.
        </p>
      </div>
