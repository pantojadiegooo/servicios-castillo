---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQItem from '../../components/FAQItem.astro';
import CTABand from '../../components/CTABand.astro';
import InnerHeroVisual from '../../components/InnerHeroVisual.astro';
---

<BaseLayout
  title="Castle Bronze — Landing Page Comercial de Alta Conversión | Grupo Castillo"
  description="Paquete Castle Bronze ($4,500 MXN / ~$265 USD): Landing comercial de hasta 5 secciones estructuradas para captar clientes potenciales con formulario y analítica."
  canonical="https://servicios-castillo.vercel.app/paquetes/bronze.html"
  ogUrl="https://servicios-castillo.vercel.app/paquetes/bronze.html"
>
  <main id="main">

    <section class="page-hero">
      <InnerHeroVisual type="paquetes" />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="/index.html">Inicio</a> / <a href="/paquetes.html">Paquetes</a> / Castle Bronze</p>
        <div class="badge badge-cyan" style="margin-bottom: 1rem;">LANDING COMERCIAL • ALTA CONVERSIÓN</div>
        <h1 style="font-size: clamp(2.2rem, 3.5vw, 3.2rem);">Castle Bronze: Captación de Clientes y Oferta Clara</h1>
        <p style="max-width: 68ch; font-size: 1.1rem; color: var(--steel-light);">
          Estructura de aterrizaje optimizada para convertir visitantes en prospectos calificados mediante secciones estratégicas de venta y formulario directo.
        </p>
      </div>
    </section>

    <!-- RESUMEN COMERCIAL Y FICHA TÉCNICA -->
    <section class="section">
      <div class="container two-col" style="align-items: flex-start; gap: 3.5rem;">
        
        <!-- DETALLE DEL PAQUETE -->
        <div class="reveal">
          <p class="eyebrow" style="color: var(--cyan);">Definición del Servicio</p>
          <h2>¿Para quién es Castle Bronze?</h2>
          <p style="font-size: 0.95rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.25rem;">
            Ideal para negocios locales, empresas de servicios, despachos y proyectos que están invirtiendo en publicidad digital (Google Ads, Meta Ads) y necesitan una página de destino que convierta el tráfico en prospectos reales.
          </p>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué problema resuelve?</h3>
          <p style="font-size: 0.95rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.5rem;">
            Evita el desperdicio de presupuesto publicitario enviando a los usuarios a sitios lentos, desordenados o sin llamados a la acción claros. Organiza tu propuesta de valor en una narrativa persuasiva y enfocada.
          </p>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué incluye exactamente?</h3>
          <ul class="check-list" style="list-style: none; padding: 0; margin-bottom: 2rem;">
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);">✔ <strong>Hasta 5 Secciones Estructuradas:</strong> Hero con propuesta de valor, beneficios, prueba social/testimonios, desglose de oferta y formulario final.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);">✔ <strong>Formulario de Cotización Funcional:</strong> Conectado a correo electrónico con protección contra spam.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);">✔ <strong>Optimización de Carga Veloz:</strong> Código ligero con tiempo de despliegue inferior a 1.5 segundos.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);">✔ <strong>Configuración de Analítica:</strong> Instalación de Google Analytics / Meta Pixel para medición de conversiones.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);">✔ <strong>Protocolo de Calidad CQS:</strong> Validación de contraste cromático, semántica HTML y rendimiento móvil.</li>
          </ul>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué NO incluye?</h3>
          <ul style="list-style: none; padding: 0; color: var(--steel-soft); font-size: 0.9rem; margin-bottom: 2rem;">
            <li style="padding: 6px 0; border-top: 1px dashed var(--line-dark);">✖ Navegación multi-página con menús complejos (disponible en Castle Silver).</li>
            <li style="padding: 6px 0; border-top: 1px dashed var(--line-dark);">✖ Módulo de Blog o artículos autogestionables (disponible en Castle Gold).</li>
            <li style="padding: 6px 0; border-top: 1px dashed var(--line-dark);">✖ Integración directa con pasarelas de pago (disponible en Castle Platinum).</li>
          </ul>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué necesitamos del cliente?</h3>
          <p style="font-size: 0.9rem; color: var(--steel-light); line-height: 1.6;">
            Propuesta de valor clara, oferta principal a promocionar, testimonios o evidencias de clientes anteriores y los campos requeridos para el formulario de contacto.
          </p>
        </div>

        <!-- TARJETA LATERAL DE INVERSIÓN Y PROCESO -->
        <div class="glass-panel reveal" style="padding: 2.5rem; background: rgba(14, 18, 27, 0.85); border-color: rgba(0, 210, 255, 0.35); position: sticky; top: 2rem;">
          <span class="badge badge-cyan" style="margin-bottom: 0.75rem;">PROPUESTA DE LANZAMIENTO</span>
          <div style="font-size: 2.25rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper); line-height: 1.1;">
            $4,500 MXN
          </div>
          <span style="display: block; font-family: var(--f-mono); font-size: 0.88rem; color: var(--steel-soft); margin-top: 0.25rem; margin-bottom: 1.5rem;">
            ~$265 USD (Pago Único)
          </span>

          <div style="padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border); margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span>Revisiones incluidas:</span>
              <strong style="color: var(--paper);">2 rondas formales</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span>Plazo estimado:</span>
              <strong style="color: var(--paper);">5 a 7 días hábiles</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span>Titularidad del código:</span>
              <strong style="color: var(--success);">100% del cliente</strong>
            </div>
          </div>

          <a href="/contacto.html?paquete=Castle%20Bronze" class="btn btn-primary" style="width: 100%; text-align: center; margin-bottom: 0.75rem;">Solicitar Castle Bronze</a>
          <a href="/paquetes/silver.html" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver siguiente nivel: Castle Silver →</a>

          <p class="currency-disclaimer" style="margin-top: 1.25rem; font-size: 0.75rem;">
            * Equivalente USD aproximado; la cotización y facturación contractual se realiza en MXN.
          </p>
        </div>

      </div>
    </section>

    <!-- PREGUNTAS FRECUENTES -->
    <section class="section section-dim">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Preguntas Frecuentes sobre Castle Bronze</p>
          <h2>Dudas Comunes</h2>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Puedo usar esta landing para campañas de anuncios?" answer="Sí, está diseñada específicamente para ese propósito. Incluye etiquetas de seguimiento y formulario para registrar las conversiones de tus campañas." />
              <FAQItem question="¿A dónde llegan los mensajes del formulario?" answer="Los mensajes se envían de forma instantánea y segura a la dirección de correo electrónico corporativo que tú designes." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Qué diferencia hay entre Iron y Bronze?" answer="Castle Iron es una presencia básica esencial en una sola vista con WhatsApp. Castle Bronze incluye hasta 5 secciones estructuradas de ventas, formulario completo y analítica para captación." />
              <FAQItem question="¿Puedo convertirla en un sitio corporativo multi-página después?" answer="Sí, la arquitectura permite agregar más páginas posteriormente migrando a Castle Silver." />
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTABand
      title="Convierte el tráfico de tu negocio en prospectos reales."
      description="Comencemos a estructurar tu landing page comercial con Grupo Castillo."
      ctaLabel="Comenzar con Castle Bronze"
      ctaHref="/contacto.html?paquete=Castle%20Bronze"
    />

  </main>
</BaseLayout>
