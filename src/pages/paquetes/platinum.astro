---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQItem from '../../components/FAQItem.astro';
import CTABand from '../../components/CTABand.astro';
import InnerHeroVisual from '../../components/InnerHeroVisual.astro';
---

<BaseLayout
  title="Castle Platinum — Plataforma Web Integrada con Pagos y CRM | Grupo Castillo"
  description="Paquete Castle Platinum ($24,500 MXN / ~$1,440 USD): hasta 15 páginas, integración de pasarelas de pago, conexión con CRM, hardening de seguridad y gobernanza C3/C4."
  canonical="https://servicios-castillo.vercel.app/paquetes/platinum.html"
  ogUrl="https://servicios-castillo.vercel.app/paquetes/platinum.html"
>
  <main id="main">

    <section class="page-hero">
      <InnerHeroVisual type="platinum" />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="/index.html">Inicio</a> / <a href="/paquetes.html">Paquetes</a> / Castle Platinum</p>
        <div class="badge badge-cyan">NIVEL AVANZADO • INTEGRACIONES &amp; PAGOS</div>
        <h1>Castle Platinum: Plataforma Integrada de Alto Rendimiento</h1>
        <p>La infraestructura web ideal para empresas consolidadas que requieren transacciones en línea seguras, automatizaciones con CRM y validación técnica rigurosa.</p>
      </div>
    </section>

    <!-- RESUMEN COMERCIAL Y FICHA TÉCNICA -->
    <section class="section">
      <div class="container two-col" style="align-items: flex-start; gap: 3.5rem;">
        
        <!-- DETALLE DEL PAQUETE -->
        <div class="reveal">
          <p class="eyebrow" style="color: var(--cyan);">Definición del Servicio</p>
          <h2>¿Para quién es Castle Platinum?</h2>
          <p style="font-size: 0.95rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.25rem;">
            Diseñado para empresas medianas, academias en línea, servicios de suscripción, consultoras especializadas y negocios digitales que necesitan procesar cobros y sincronizar leads con herramientas externas.
          </p>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué problema resuelve?</h3>
          <p style="font-size: 0.95rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.5rem;">
            Resuelve la desconexión entre tu sitio web y tus herramientas de negocio. Automatiza el registro de clientes en tu CRM y habilita pagos digitales con estándares PCI-DSS sin intermediarios que retengan tus fondos.
          </p>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué incluye exactamente?</h3>
          <ul class="check-list" style="list-style: none; padding: 0; margin-bottom: 2rem;">
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06); color: var(--steel-light);"><strong>Hasta 15 Páginas Completas:</strong> Arquitectura extendida con catálogos dinámicos y landings específicas.</li>
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06); color: var(--steel-light);"><strong>Integración de Pasarela de Pagos:</strong> Configuración de Stripe / Mercado Pago tokenizado y seguro.</li>
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06); color: var(--steel-light);"><strong>Conexión con CRM y Automatización:</strong> Sincronización mediante Webhooks / APIs hacia HubSpot, Mailchimp o bases de datos.</li>
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06); color: var(--steel-light);"><strong>Hardening de Seguridad:</strong> Cabeceras de seguridad estrictas (CSP, HSTS, X-Content-Type-Options) y blindaje contra XSS.</li>
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06); color: var(--steel-light);"><strong>Validación Castle Gate C1:</strong> Verificación de integridad SHA-256 de assets, hardening y ausencia de secretos en pipeline.</li>
          </ul>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué NO incluye?</h3>
          <ul style="list-style: none; padding: 0; color: var(--steel-soft); font-size: 0.9rem; margin-bottom: 2rem;">
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06);">Desarrollo de software a la medida con roles de usuario complejos o lógica ERP (disponible en Software a Medida).</li>
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06);">Comisiones bancarias porcentuales por transacción cobradas por Stripe o Mercado Pago.</li>
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06); color: var(--paper);"><strong>Redacción de Contenidos:</strong> La redacción de contenidos desde cero NO está incluida en los $24,500 MXN. El cliente provee o valida los contenidos y catálogos base; la redacción desde cero está disponible como servicio adicional, sujeto a cotización.</li>
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06); color: var(--steel-light);"><strong>Módulo Adicional:</strong> Estrategia de contenido y conversión disponible como servicio adicional, sujeto a cotización.</li>
          </ul>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué necesitamos del cliente?</h3>
          <p style="font-size: 0.9rem; color: var(--steel-light); line-height: 1.6;">
            Cuentas verificadas en las pasarelas de pago a integrar, acceso de API al CRM o herramientas externas y especificación de flujos transaccionales.
          </p>
        </div>

        <!-- TARJETA LATERAL DE INVERSIÓN Y PROCESO -->
        <div class="glass-panel reveal" style="padding: 2.5rem; background: rgba(14, 18, 27, 0.85); border-color: rgba(0, 210, 255, 0.35); position: sticky; top: 2rem;">
          <span class="badge badge-cyan" style="margin-bottom: 0.75rem;">PROPUESTA OFICIAL</span>
          <div style="font-size: 2.25rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper); line-height: 1.1;">
            $24,500 MXN
          </div>
          <span style="display: block; font-family: var(--f-mono); font-size: 0.88rem; color: var(--steel-soft); margin-top: 0.25rem; margin-bottom: 1.5rem;">
            Pago Único • Facturación en MXN
          </span>

          <div style="padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border); margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span>Revisiones incluidas:</span>
              <strong style="color: var(--paper);">5 rondas formales</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span>Plazo objetivo:</span>
              <strong style="color: var(--paper);">15 a 20 días hábiles *</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span>Titularidad del código:</span>
              <strong style="color: var(--success);">100% del cliente</strong>
            </div>
          </div>

          <a href="/contacto.html?paquete=Castle%20Platinum" class="btn btn-primary" style="width: 100%; text-align: center; margin-bottom: 0.75rem;">Solicitar Castle Platinum</a>
          <a href="/paquetes/diamond.html" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver Software a Medida: Castle Diamond →</a>

          <p class="currency-disclaimer" style="margin-top: 1.25rem; font-size: 0.75rem;">
            * Plazo estimado computable tras la recepción completa de contenidos y validación de arquitectura. Facturación formal en MXN.
          </p>
        </div>

      </div>
    </section>

    <!-- PREGUNTAS FRECUENTES -->
    <section class="section section-dim">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Preguntas Frecuentes sobre Castle Platinum</p>
          <h2>Dudas Comunes</h2>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Cómo se garantiza la seguridad de las transacciones?" answer="No almacenamos datos de tarjetas en el servidor. Todas las operaciones se realizan mediante tokens cifrados directamente con proveedores certificados PCI-DSS como Stripe o Mercado Pago." />
              <FAQItem question="¿Podemos conectar nuestro sistema de facturación electrónica?" answer="Sí, podemos vincular Webhooks para disparar timbrado automático con PACs autorizados en México." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Qué nivel de Castle Gate se incluye?" answer="Incluye configuración y validación en pipeline bajo políticas C3/C4 Professional, asegurando que ningún release introduzca fallas de seguridad." />
              <FAQItem question="¿Qué plan de mantenimiento se recomienda?" answer="Recomendamos Castle Care Pro ($7,900 MXN/mes) para supervisión técnica constante, soporte de pasarelas y 4 horas mensuales de ingeniería directa." />
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTABand
      title="Automatiza tus cobros y sincroniza tu operación digital."
      description="Construyamos una plataforma integrada de alto impacto con Grupo Castillo."
      ctaLabel="Comenzar con Castle Platinum"
      ctaHref="/contacto.html?paquete=Castle%20Platinum"
    />

  </main>
</BaseLayout>
