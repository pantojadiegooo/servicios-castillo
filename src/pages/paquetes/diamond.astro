---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABand from '../../components/CTABand.astro';
import InnerHeroVisual from '../../components/InnerHeroVisual.astro';
---

<BaseLayout
  title="Proyectos Avanzados — Grupo Castillo"
  description="Los proyectos de software a la medida, portales y arquitecturas complejas de Grupo Castillo ahora forman parte de Proyectos Avanzados (Desde $40,000 MXN)."
  canonical="https://servicios-castillo.vercel.app/paquetes.html#proyectos-avanzados"
  ogUrl="https://servicios-castillo.vercel.app/paquetes.html#proyectos-avanzados"
>
  <head slot="head">
    <meta http-equiv="refresh" content="2; url=/paquetes.html#proyectos-avanzados" />
  </head>

  <main id="main">
    <section class="page-hero">
      <InnerHeroVisual type="proyectos" />
      <div class="container page-hero-inner" style="text-align: center; max-width: 780px;">
        <p class="breadcrumb"><a href="/index.html">Inicio</a> / <a href="/paquetes.html">Sitios Web</a> / Proyectos Avanzados</p>
        <div class="badge badge-cyan">REDIRECCIÓN COMERCIAL • ARQUITECTURA VIGENTE</div>
        <h1>Proyectos Avanzados de Ingeniería</h1>
        <p style="font-size: 1.05rem; color: var(--steel-light); margin-top: 1rem; line-height: 1.6;">
          Los desarrollos de software personalizado, portales privados e integraciones a la medida ahora se gestionan bajo la sección <strong>Proyectos Avanzados</strong> (referencia: desde $40,000 MXN).
        </p>
        <div style="margin-top: 2rem; display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
          <a href="/paquetes.html#proyectos-avanzados" class="btn btn-primary">Ir a Proyectos Avanzados en Catálogo →</a>
          <a href="/contacto.html?necesidad=proyecto-avanzado" class="btn btn-outline">Cotizar Proyecto Directamente</a>
        </div>
        <p style="font-size: 0.8rem; color: var(--steel-soft); margin-top: 1.5rem;">
          Redirigiendo automáticamente en unos segundos...
        </p>
      </div>
    </section>

    <CTABand
      title="¿Tienes un proyecto con lógica propia o requerimientos complejos?"
      description="Cuéntanos tus necesidades de arquitectura para coordinar una evaluación técnica."
      ctaLabel="Hablar con un Ingeniero"
      ctaHref="/contacto.html?necesidad=proyecto-avanzado"
    />
  </main>
</BaseLayout>
