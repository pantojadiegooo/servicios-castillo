---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQItem from '../../components/FAQItem.astro';
import CTABand from '../../components/CTABand.astro';
import InnerHeroVisual from '../../components/InnerHeroVisual.astro';
---

<BaseLayout
  title="Castle Silver — Sitio Web Corporativo Multi-página | Grupo Castillo"
  description="Paquete Castle Silver ($7,500 MXN / ~$440 USD): Sitio corporativo multi-página (hasta 5 vistas) con navegación estructurada, SEO on-page y gobernanza C1."
  canonical="https://grupocastillo.lat/paquetes/silver"
  ogUrl="https://grupocastillo.lat/paquetes/silver"
>
  <main id="main">

    <section class="page-hero">
      <InnerHeroVisual type="silver" />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="/">Inicio</a> / <a href="/paquetes">Paquetes</a> / Castle Silver</p>
        <div class="badge badge-cyan">SITIO CORPORATIVO • HASTA 5 PÁGINAS</div>
        <h1>Castle Silver: Presencia Institucional Completa</h1>
        <p>Estructura web multi-página para empresas y consultorías que requieren presentar formalmente sus servicios, trayectoria y casos de éxito.</p>
      </div>
    </section>

    <!-- RESUMEN COMERCIAL Y FICHA TÉCNICA -->
    <section class="section">
      <div class="container two-col" style="align-items: flex-start; gap: 3.5rem;">
        
        <!-- DETALLE DEL PAQUETE -->
        <div class="reveal">
          <p class="eyebrow" style="color: var(--cyan);">Definición del Servicio</p>
          <h2>¿Para quién es Castle Silver?</h2>
          <p style="font-size: 0.95rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.25rem;">
            Diseñado para pequeñas y medianas empresas, despachos profesionales, clínicas, firmas legales y organizaciones que necesitan una presencia corporativa completa con arquitectura de información formal.
          </p>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué problema resuelve?</h3>
          <p style="font-size: 0.95rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.5rem;">
            Resuelve la limitación de espacio de las landings sencillas. Permite desglosar cada línea de servicio en páginas independientes, mejorando el posicionamiento orgánico en Google y la confianza de clientes corporativos.
          </p>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué incluye exactamente?</h3>
          <ul class="check-list" style="list-style: none; padding: 0; margin-bottom: 2rem;">
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06); color: var(--steel-light);"><strong>Hasta 5 Páginas Completas:</strong> Inicio, Nosotros/Empresa, Servicios/Soluciones, Proyectos/Casos y Contacto.</li>
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06); color: var(--steel-light);"><strong>Navegación y Menú Interactivo:</strong> Encabezado global y pie de página estructurado.</li>
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06); color: var(--steel-light);"><strong>SEO On-Page Avanzado:</strong> Etiquetas OpenGraph, Twitter Cards y jerarquía semántica H1-H3 por página.</li>
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06); color: var(--steel-light);"><strong>Formulario con Validación en Tiempo Real:</strong> Enrutamiento de leads directo a tu bandeja de correo.</li>
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06); color: var(--steel-light);"><strong>Validación Castle Gate C1:</strong> Inspección automatizada contra claves expuestas y validación estática de markup.</li>
          </ul>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué NO incluye?</h3>
          <ul style="list-style: none; padding: 0; color: var(--steel-soft); font-size: 0.9rem; margin-bottom: 2rem;">
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06);">Gestor de contenidos (CMS) para blog o artículos frecuentes (incluido en Castle Gold).</li>
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06);">Pasarelas de pago o cobro electrónico automatizado (disponible en Castle Platinum).</li>
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06);">Redacción desde cero de textos (el cliente provee o valida contenidos base).</li>
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06); color: var(--steel-light);"><strong>Módulo Adicional:</strong> CMS ligero de autoedición para modificación de textos e imágenes disponible sujeto a cotización.</li>
          </ul>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué necesitamos del cliente?</h3>
          <p style="font-size: 0.9rem; color: var(--steel-light); line-height: 1.6;">
            Contenidos y textos por cada sección, fotografías institucionales en buena resolución y especificación de datos de contacto de la empresa.
          </p>
        </div>

        <!-- TARJETA LATERAL DE INVERSIÓN Y PROCESO -->
        <div class="glass-panel reveal" style="padding: 2.5rem; background: rgba(14, 18, 27, 0.85); border-color: rgba(52, 107, 241, 0.35); position: sticky; top: 2rem;">
          <span class="badge badge-cyan" style="margin-bottom: 0.75rem;">PROPUESTA OFICIAL</span>
          <div style="font-size: 2.25rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper); line-height: 1.1;">
            $7,500 MXN
          </div>
          <span style="display: block; font-family: var(--f-mono); font-size: 0.88rem; color: var(--steel-soft); margin-top: 0.25rem; margin-bottom: 1.5rem;">
            Pago Único • Facturación en MXN
          </span>

          <div style="padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border); margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span>Revisiones incluidas:</span>
              <strong style="color: var(--paper);">3 rondas formales</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span>Plazo objetivo:</span>
              <strong style="color: var(--paper);">7 a 10 días *</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span>Titularidad del código:</span>
              <strong style="color: var(--success);">100% del cliente</strong>
            </div>
          </div>

          <a href="/contacto?paquete=Castle%20Silver" class="btn btn-primary" style="width: 100%; text-align: center; margin-bottom: 0.75rem;">Solicitar Castle Silver</a>
          <a href="/paquetes/gold" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver siguiente nivel: Castle Gold (Con Blog) →</a>

          <p class="currency-disclaimer" style="margin-top: 1.25rem; font-size: 0.75rem;">
            * Plazo estimado computable tras la recepción completa de contenidos y validación del diseño. Facturación formal en MXN.
          </p>
        </div>

      </div>
    </section>

    <!-- PREGUNTAS FRECUENTES -->
    <section class="section section-dim">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Preguntas Frecuentes sobre Castle Silver</p>
          <h2>Dudas Comunes</h2>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Puedo agregar páginas adicionales más adelante?" answer="Sí. Castle Silver está desarrollado con una estructura estática modular que permite anexar nuevas páginas de servicios o casos de estudio cuando tu empresa crezca." />
              <FAQItem question="¿El sitio incluye optimización para buscadores (SEO)?" answer="Sí. Implementamos meta tags descriptivos, OpenGraph para redes sociales y una arquitectura de encabezados optimizada para los estándares de Google." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Qué ocurre si ya tengo un dominio propio?" answer="Conectamos tu nuevo sitio al dominio que ya posees sin costo adicional ni pérdida de configuración de tus correos actuales." />
              <FAQItem question="¿Ofrecen plan de mantenimiento para actualizaciones?" answer="Sí, puedes complementar con el plan Castle Care (desde $590 MXN/mes) para actualizaciones de texto, imágenes y supervisión continua de disponibilidad." />
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTABand
      title="Proyecta la solidez corporativa que tu empresa merece."
      description="Estructura tu portal multi-página con la ingeniería limpia de Grupo Castillo."
      ctaLabel="Comenzar con Castle Silver"
      ctaHref="/contacto?paquete=Castle%20Silver"
    />

  </main>
</BaseLayout>
