---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQItem from '../../components/FAQItem.astro';
import CTABand from '../../components/CTABand.astro';
import InnerHeroVisual from '../../components/InnerHeroVisual.astro';
---

<BaseLayout
  title="Castle Gold — Plataforma Web de Alto Rendimiento y Conversión | Grupo Castillo"
  description="Paquete Castle Gold ($12,500 MXN / ~$735 USD — Más Popular): 8 a 10 páginas, Blog / CMS autogestionable, Core Web Vitals < 1s y SEO avanzado para empresas en crecimiento."
  canonical="https://servicios-castillo.vercel.app/paquetes/gold.html"
  ogUrl="https://servicios-castillo.vercel.app/paquetes/gold.html"
>
  <main id="main">

    <section class="page-hero">
      <InnerHeroVisual type="paquetes" />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="../index.html">Inicio</a> / <a href="../paquetes.html">Paquetes</a> / Castle Gold</p>
        <div class="badge badge-cyan" style="margin-bottom: 1rem;">MÁS POPULAR • PLATAFORMA DE CRECIMIENTO</div>
        <h1 style="font-size: clamp(2.2rem, 3.5vw, 3.2rem);">Castle Gold: Conversión, Contenido y Alto Rendimiento</h1>
        <p style="max-width: 68ch; font-size: 1.1rem; color: var(--steel-light);">
          La opción más completa para empresas que buscan captar prospectos continuos, publicar contenido orgánico y posicionarse con autoridad en su sector.
        </p>
      </div>
    </section>

    <!-- RESUMEN COMERCIAL Y FICHA TÉCNICA -->
    <section class="section">
      <div class="container two-col" style="align-items: flex-start; gap: 3.5rem;">
        
        <!-- DETALLE DEL PAQUETE -->
        <div class="reveal">
          <p class="eyebrow" style="color: var(--cyan);">Definición del Servicio</p>
          <h2>¿Para quién es Castle Gold?</h2>
          <p style="font-size: 0.95rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.25rem;">
            Diseñado para empresas consolidadas, agencias de servicios, fabricantes, distribuidores y marcas con estrategias activas de marketing digital que necesitan una plataforma robusta y escalable.
          </p>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué problema resuelve?</h3>
          <p style="font-size: 0.95rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.5rem;">
            Elimina la frustración de plataformas lentas que no posicionan en Google ni permiten actualizar contenidos con facilidad. Otorga independencia editorial mediante un gestor de contenidos seguro y un rendimiento técnico de nivel empresarial.
          </p>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué incluye exactamente?</h3>
          <ul class="check-list" style="list-style: none; padding: 0; margin-bottom: 2rem;">
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);">✔ <strong>De 8 a 10 Páginas Completas:</strong> Arquitectura extendida para cubrir servicios especializados, casos de estudio, recursos y testimonios.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);">✔ <strong>Módulo de Blog / Noticias Autogestionable (CMS):</strong> Panel intuitivo para publicar artículos y noticias sin tocar código.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);">✔ <strong>Rendimiento Core Web Vitals (&lt; 1s):</strong> Optimización avanzada de Largest Contentful Paint (LCP) y Cumulative Layout Shift (CLS).</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);">✔ <strong>SEO Semántico Avanzado:</strong> Marcado Schema.org (JSON-LD), datos estructurados para Google y metadatos dinámicos.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);">✔ <strong>Formularios Segmentados:</strong> Múltiples puntos de contacto configurados por tipo de servicio.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);">✔ <strong>Evaluación CQS Completa:</strong> Validación estricta con reporte de cumplimiento técnico emitido.</li>
          </ul>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué NO incluye?</h3>
          <ul style="list-style: none; padding: 0; color: var(--steel-soft); font-size: 0.9rem; margin-bottom: 2rem;">
            <li style="padding: 6px 0; border-top: 1px dashed var(--line-dark);">✖ Integración personalizada con sistemas ERP o CRM complejos (disponible en Castle Platinum).</li>
            <li style="padding: 6px 0; border-top: 1px dashed var(--line-dark);">✖ Desarrollo de software a la medida o portales privados de usuarios (disponible en Castle Diamond).</li>
          </ul>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué necesitamos del cliente?</h3>
          <p style="font-size: 0.9rem; color: var(--steel-light); line-height: 1.6;">
            Contenidos completos de las páginas y categorías de servicios, recursos gráficos en alta resolución y definición de autores o categorías para el blog.
          </p>
        </div>

        <!-- TARJETA LATERAL DE INVERSIÓN Y PROCESO -->
        <div class="glass-panel reveal" style="padding: 2.5rem; background: linear-gradient(180deg, rgba(0, 210, 255, 0.08) 0%, rgba(14, 18, 27, 0.95) 100%); border-color: rgba(0, 210, 255, 0.45); position: sticky; top: 2rem;">
          <span class="badge badge-cyan" style="margin-bottom: 0.75rem;">MÁS ELEGIDO POR EMPRESAS</span>
          <div style="font-size: 2.25rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper); line-height: 1.1;">
            $12,500 MXN
          </div>
          <span style="display: block; font-family: var(--f-mono); font-size: 0.88rem; color: var(--steel-soft); margin-top: 0.25rem; margin-bottom: 1.5rem;">
            ~$735 USD (Pago Único)
          </span>

          <div style="padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border); margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span>Revisiones incluidas:</span>
              <strong style="color: var(--paper);">4 rondas formales</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span>Plazo estimado:</span>
              <strong style="color: var(--paper);">10 a 15 días hábiles</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span>Propiedad del código:</span>
              <strong style="color: var(--success);">100% del cliente</strong>
            </div>
          </div>

          <a href="../contacto.html?paquete=Castle%20Gold" class="btn btn-primary" style="width: 100%; text-align: center; margin-bottom: 0.75rem;">Solicitar Castle Gold</a>
          <a href="../paquetes/platinum.html" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver siguiente nivel: Castle Platinum →</a>

          <p class="currency-disclaimer" style="margin-top: 1.25rem; font-size: 0.75rem;">
            * Equivalente USD aproximado; la cotización y facturación contractual se realiza en MXN.
          </p>
        </div>

      </div>
    </section>

    <!-- PREGUNTAS FRECUENTES -->
    <section class="section section-dim">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Preguntas Frecuentes sobre Castle Gold</p>
          <h2>Dudas Comunes</h2>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Cómo administro el blog o los artículos?" answer="Te configuramos un gestor de contenidos seguro donde puedes redactar, editar imágenes y publicar entradas en minutos sin requerir conocimientos técnicos." />
              <FAQItem question="¿El sitio requiere mantenimiento técnico mensual?" answer="Recomendamos acompañar tu plataforma con Castle Care Pro ($7,900 MXN/mes) para respaldos continuos, parches de seguridad y horas de soporte incluidas." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Por qué es el paquete más popular?" answer="Ofrece el equilibrio perfecto entre amplitud de páginas, autogestión de contenidos y velocidad extrema para posicionamiento en Google sin el costo de software a medida." />
              <FAQItem question="¿Puedo añadir más autores o colaboradores al blog?" answer="Sí, el sistema permite definir roles para que varios miembros de tu equipo redacten o revisen borradores antes de su publicación." />
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTABand
      title="Impulsa el crecimiento y posicionamiento de tu marca."
      description="Construyamos una plataforma web de alto rendimiento y conversión con Grupo Castillo."
      ctaLabel="Comenzar con Castle Gold"
      ctaHref="../contacto.html?paquete=Castle%20Gold"
    />

  </main>
</BaseLayout>
