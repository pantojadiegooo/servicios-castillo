---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQItem from '../../components/FAQItem.astro';
import CTABand from '../../components/CTABand.astro';
import InnerHeroVisual from '../../components/InnerHeroVisual.astro';
---

<BaseLayout
  title="Castle Gold — Plataforma Web con Blog y CMS Autogestionable | Grupo Castillo"
  description="Paquete Castle Gold ($12,500 MXN / ~$735 USD): 8-10 páginas corporativas con Blog integrado, CMS autogestionable, optimización Core Web Vitals y validación C2."
  canonical="https://servicios-castillo.vercel.app/paquetes/gold.html"
  ogUrl="https://servicios-castillo.vercel.app/paquetes/gold.html"
>
  <main id="main">

    <section class="page-hero">
      <InnerHeroVisual type="gold" />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="/index.html">Inicio</a> / <a href="/paquetes.html">Paquetes</a> / Castle Gold</p>
        <div class="badge badge-cyan">MÁS POPULAR • 8-10 PÁGINAS + BLOG / CMS</div>
        <h1>Castle Gold: Crecimiento Corporativo y Contenido</h1>
        <p>Nuestra solución insignia para PyMEs en expansión: portal institucional ampliado con gestor de contenidos autogestionable y rendimiento web de alto nivel.</p>
      </div>
    </section>

    <!-- RESUMEN COMERCIAL Y FICHA TÉCNICA -->
    <section class="section">
      <div class="container two-col" style="align-items: flex-start; gap: 3.5rem;">
        
        <!-- DETALLE DEL PAQUETE -->
        <div class="reveal">
          <p class="eyebrow" style="color: var(--cyan);">Definición del Servicio</p>
          <h2>¿Para quién es Castle Gold?</h2>
          <p style="font-size: 0.95rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.25rem;">
            Diseñado para empresas consolidadas, consultoras y marcas que ejecutan estrategias de marketing de contenidos, educación a clientes o actualización constante de noticias y casos de éxito.
          </p>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué problema resuelve?</h3>
          <p style="font-size: 0.95rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.5rem;">
            Elimina la dependencia de desarrolladores para publicar artículos o modificar contenidos. Te entrega un panel de administración visual y seguro sin la lentitud ni las vulnerabilidades de los gestores tradicionales mal optimizados.
          </p>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué incluye exactamente?</h3>
          <ul class="check-list" style="list-style: none; padding: 0; margin-bottom: 2rem;">
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06); color: var(--steel-light);"><strong>8 a 10 Páginas Institucionales:</strong> Estructura completa de arquitectura para desglosar productos, servicios y recursos.</li>
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06); color: var(--steel-light);"><strong>Módulo de Blog / Artículos Autogestionable:</strong> Panel intuitivo para redactar, categorizar y publicar entradas con imágenes.</li>
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06); color: var(--steel-light);"><strong>Optimización de Core Web Vitals:</strong> Tiempos de carga ultra veloces orientados a los umbrales de Google.</li>
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06); color: var(--steel-light);"><strong>Datos Estructurados Schema.org:</strong> Marcado JSON-LD para artículos, organización y productos en Google.</li>
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06); color: var(--steel-light);"><strong>Gobernanza Castle Gate C2 Standard:</strong> Verificación de integridad de dependencias y secretos en pipeline.</li>
          </ul>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué NO incluye?</h3>
          <ul style="list-style: none; padding: 0; color: var(--steel-soft); font-size: 0.9rem; margin-bottom: 2rem;">
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06);">Pasarelas de cobro complejas y comercio electrónico masivo (disponible en Castle Platinum y Proyectos Avanzados).</li>
            <li style="padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06);">Redacción o redacción editorial de los artículos del blog (se entregan 3 artículos muestra de arranque).</li>
          </ul>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué necesitamos del cliente?</h3>
          <p style="font-size: 0.9rem; color: var(--steel-light); line-height: 1.6;">
            Contenidos estructurados por página, categorías de blog planificadas, activos gráficos institucionales y asignación de los colaboradores que administrarán el CMS.
          </p>
        </div>

        <!-- TARJETA LATERAL DE INVERSIÓN Y PROCESO -->
        <div class="glass-panel reveal" style="padding: 2.5rem; background: rgba(14, 18, 27, 0.85); border-color: rgba(0, 210, 255, 0.35); position: sticky; top: 2rem;">
          <span class="badge badge-cyan" style="margin-bottom: 0.75rem;">MÁS ELEGIDO</span>
          <div style="font-size: 2.25rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper); line-height: 1.1;">
            $12,500 MXN
          </div>
          <span style="display: block; font-family: var(--f-mono); font-size: 0.88rem; color: var(--steel-soft); margin-top: 0.25rem; margin-bottom: 1.5rem;">
            ~$735 USD (Pago Único)
          </span>

          <div style="padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border); margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span>Revisiones incluidas:</span>
              <strong style="color: var(--paper);">4 rondas formales</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span>Plazo estimado:</span>
              <strong style="color: var(--paper);">10 a 14 días hábiles</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span>Titularidad del código:</span>
              <strong style="color: var(--success);">100% del cliente</strong>
            </div>
          </div>

          <a href="/contacto.html?paquete=Castle%20Gold" class="btn btn-primary" style="width: 100%; text-align: center; margin-bottom: 0.75rem;">Solicitar Castle Gold</a>
          <a href="/paquetes/platinum.html" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver siguiente nivel: Castle Platinum →</a>

          <p class="currency-disclaimer" style="margin-top: 1.25rem; font-size: 0.75rem;">
            * Equivalente USD aproximado; la cotización y facturación contractual se realiza en MXN.
          </p>
        </div>

      </div>
    </section>

    <!-- PREGUNTAS FRECUENTES -->
    <section class="section section-dim">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Preguntas Frecuentes sobre Castle Gold</p>
          <h2>Dudas Comunes</h2>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Es fácil administrar el blog?" answer="Sí. Integramos un panel de administración visual y seguro (CMS desacoplado o Markdown headless) donde cualquier miembro de tu equipo puede redactar y publicar sin tocar código." />
              <FAQItem question="¿El blog ralentizará la velocidad del sitio web?" answer="No. A diferencia de CMS tradicionales monolíticos, utilizamos arquitectura estática con regeneración selectiva, manteniendo velocidades de carga ultra rápidas." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Incluye capacitación para usar el CMS?" answer="Sí, incluye una sesión de capacitación en video y manual técnico de uso para tu equipo de contenidos." />
              <FAQItem question="¿Ofrecen soporte mensual para publicaciones?" answer="A través de Castle Care Pro ($7,900 MXN/mes) podemos apoyar a tu equipo con optimizaciones técnicas continuas y supervisión mensual." />
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTABand
      title="Potencia el posicionamiento de tu empresa con contenidos de calidad."
      description="Inicia hoy con Castle Gold y obtén una plataforma moderna con blog autogestionable."
      ctaLabel="Comenzar con Castle Gold"
      ctaHref="/contacto.html?paquete=Castle%20Gold"
    />

  </main>
</BaseLayout>
