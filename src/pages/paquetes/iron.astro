---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQItem from '../../components/FAQItem.astro';
import CTABand from '../../components/CTABand.astro';
import InnerHeroVisual from '../../components/InnerHeroVisual.astro';
---

<BaseLayout
  title="Castle Iron — Presencia Digital Esencial para Profesionales y Micronegocios | Grupo Castillo"
  description="Paquete de entrada Castle Iron ($2,800 MXN / ~$165 USD): estructura One-Page optimizada y ágil, enlace directo a WhatsApp y validación de calidad técnica."
  canonical="https://servicios-castillo.vercel.app/paquetes/iron.html"
  ogUrl="https://servicios-castillo.vercel.app/paquetes/iron.html"
>
  <main id="main">

    <section class="page-hero">
      <InnerHeroVisual type="iron" />
      <div class="container page-hero-inner">
        <p class="breadcrumb"><a href="/index.html">Inicio</a> / <a href="/paquetes.html">Paquetes</a> / Castle Iron</p>
        <div class="badge badge-cyan">NIVEL DE ENTRADA • MICRONEGOCIOS &amp; INDEPENDIENTES</div>
        <h1>Castle Iron: Presencia Digital Esencial y Profesional</h1>
        <p>La solución más ágil y económica para tener presencia formal en internet con carga optimizada, botón a WhatsApp y titularidad propia del código.</p>
      </div>
    </section>

    <!-- RESUMEN COMERCIAL Y FICHA TÉCNICA -->
    <section class="section">
      <div class="container two-col" style="align-items: flex-start; gap: 3.5rem;">
        
        <!-- DETALLE DEL PAQUETE -->
        <div class="reveal">
          <p class="eyebrow" style="color: var(--cyan);">Definición del Servicio</p>
          <h2>¿Para quién es Castle Iron?</h2>
          <p style="font-size: 0.95rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.25rem;">
            Diseñado específicamente para profesionales independientes, consultores, terapeutas, médicos, artesanos y comercios locales que requieren una presencia digital formal, rápida y sin complejidades innecesarias.
          </p>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué problema resuelve?</h3>
          <p style="font-size: 0.95rem; color: var(--steel-light); line-height: 1.65; margin-bottom: 1.5rem;">
            Elimina la barrera de costos altos para tener un sitio web formal. Permite que tus prospectos encuentren tu información de contacto, servicios y ubicación de forma directa en su teléfono sin tiempos de carga lentos ni plataformas de baja calidad.
          </p>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué incluye exactamente?</h3>
          <ul class="check-list" style="list-style: none; padding: 0; margin-bottom: 2rem;">
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Estructura One-Page:</strong> Portada, presentación de servicios, información de contacto y llamada a la acción.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Diseño Responsivo:</strong> Adaptación visual completa para teléfonos móviles y computadoras.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Acceso Directo a WhatsApp:</strong> Botón flotante optimizado para iniciar conversaciones de venta.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Configuración de Dominio y SSL:</strong> Conexión segura HTTPS sin costo adicional de configuración.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>SEO Técnico Base:</strong> Metadatos esenciales para indexación en motores de búsqueda.</li>
            <li style="padding: 8px 0; border-top: 1px dashed var(--line-dark); color: var(--steel-light);"><strong>Castillo Quality Gate Base:</strong> Verificación de velocidad y accesibilidad antes de publicar.</li>
          </ul>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué NO incluye?</h3>
          <ul style="list-style: none; padding: 0; color: var(--steel-soft); font-size: 0.9rem; margin-bottom: 2rem;">
            <li style="padding: 6px 0; border-top: 1px dashed var(--line-dark);">Múltiples páginas internas separadas (disponible desde Castle Silver).</li>
            <li style="padding: 6px 0; border-top: 1px dashed var(--line-dark);">Blog o gestor de contenidos autogestionable (disponible en Castle Gold).</li>
            <li style="padding: 6px 0; border-top: 1px dashed var(--line-dark);">Pasarelas de pago o cobro en línea (disponible en Castle Platinum y Proyectos Avanzados).</li>
            <li style="padding: 6px 0; border-top: 1px dashed var(--line-dark);">Redacción o fotografía profesional de contenido (el cliente provee textos y fotos base).</li>
          </ul>

          <h3 style="font-size: 1.2rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--paper);">¿Qué necesitamos del cliente?</h3>
          <p style="font-size: 0.9rem; color: var(--steel-light); line-height: 1.6;">
            Logotipo (si cuenta con él), textos descriptivos básicos del negocio, datos de contacto (número de WhatsApp, correo, dirección) e imágenes o fotografías representativas.
          </p>
        </div>

        <!-- TARJETA LATERAL DE INVERSIÓN Y PROCESO -->
        <div class="glass-panel reveal" style="padding: 2.5rem; background: rgba(14, 18, 27, 0.85); border-color: rgba(0, 210, 255, 0.35); position: sticky; top: 2rem;">
          <span class="badge badge-cyan" style="margin-bottom: 0.75rem;">PROPUESTA DE LANZAMIENTO</span>
          <div style="font-size: 2.25rem; font-family: var(--f-mono); font-weight: 800; color: var(--paper); line-height: 1.1;">
            $2,800 MXN
          </div>
          <span style="display: block; font-family: var(--f-mono); font-size: 0.88rem; color: var(--steel-soft); margin-top: 0.25rem; margin-bottom: 1.5rem;">
            ~$165 USD (Pago Único)
          </span>

          <div style="padding: 1rem 0; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border); margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--steel-light);">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span>Revisiones incluidas:</span>
              <strong style="color: var(--paper);">1 ronda formal</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <span>Plazo estimado:</span>
              <strong style="color: var(--paper);">3 a 5 días hábiles</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span>Titularidad del código:</span>
              <strong style="color: var(--success);">100% del cliente</strong>
            </div>
          </div>

          <a href="/contacto.html?paquete=Castle%20Iron" class="btn btn-primary" style="width: 100%; text-align: center; margin-bottom: 0.75rem;">Solicitar Castle Iron</a>
          <a href="/paquetes/bronze.html" class="btn btn-outline" style="width: 100%; text-align: center; font-size: 0.82rem;">Ver siguiente nivel: Castle Bronze →</a>

          <p class="currency-disclaimer" style="margin-top: 1.25rem; font-size: 0.75rem;">
            * Equivalente USD aproximado; la cotización y facturación contractual se realiza en MXN. El costo de hosting y dominio es cubierto directamente por el cliente a su propio nombre.
          </p>
        </div>

      </div>
    </section>

    <!-- PREGUNTAS FRECUENTES -->
    <section class="section section-dim">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Preguntas Frecuentes sobre Castle Iron</p>
          <h2>Dudas Comunes</h2>
        </div>
        <div class="two-col">
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Puedo agregar más secciones en el futuro?" answer="Sí. Castle Iron está construido con una arquitectura modular limpia que permite escalar posteriormente a Castle Bronze o Castle Silver sin perder tu estructura inicial." />
              <FAQItem question="¿El dominio y hosting están incluidos en los $2,800 MXN?" answer="El desarrollo técnico está incluido. Te asesoramos para que contrates tu dominio y hosting a tu propio nombre (aproximadamente $300 a $600 MXN anuales) para garantizar que seas el titular de tu infraestructura." />
            </div>
          </div>
          <div class="reveal">
            <div class="faq">
              <FAQItem open={true} question="¿Cómo funciona la ronda de revisión?" answer="Una vez terminado el borrador funcional, revisamos juntos el sitio y realizas los ajustes de textos, colores o imágenes dentro del alcance acordado antes de publicar." />
              <FAQItem question="¿Qué pasa si necesito mantenimiento posterior?" answer="Puedes contratar nuestro esquema mensual Castle Care Essential ($3,500 MXN/mes) o solicitar intervenciones puntuales cuando requieras cambios." />
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTABand
      title="¿Listo para lanzar tu presencia digital formal?"
      description="Inicia tu proyecto hoy con Grupo Castillo y ten tu sitio en línea en menos de 5 días hábiles."
      ctaLabel="Comenzar con Castle Iron"
      ctaHref="/contacto.html?paquete=Castle%20Iron"
    />

  </main>
</BaseLayout>
