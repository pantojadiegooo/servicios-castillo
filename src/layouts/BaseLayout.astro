---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/index.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogUrl: string;
}

const { title, description, canonical, ogUrl } = Astro.props;
const publicApiUrl = import.meta.env.PUBLIC_API_URL || '';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Grupo Castillo",
  "parentOrganization": {
    "@type": "Organization",
    "name": "Grupo Castillo"
  },
  "url": "https://grupocastillo.lat/",
  "logo": "https://grupocastillo.lat/og-default.png",
  "description": description,
  "priceRange": "$2,800 MXN - $40,000+ MXN",
  "areaServed": "MX",
  "sameAs": [
    "https://www.instagram.com/grupocastillooo/",
    "https://www.facebook.com/profile.php?id=61593987536435"
  ]
};
---

<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Grupo Castillo">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={ogUrl}>
<meta property="og:image" content="https://grupocastillo.lat/og-default.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content="https://grupocastillo.lat/og-default.png">
<meta name="theme-color" content="#0B0E12">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<script is:inline define:vars={{ publicApiUrl }}>
  window.__CASTILLO_API_URL__ = publicApiUrl;
</script>
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
<a class="skip-link" href="#main">Saltar al contenido</a>

<Nav />

<slot />

<Footer />

<script is:inline src="/assets/js/main.js" defer></script>
</body>
</html>
