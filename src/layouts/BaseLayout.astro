---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import '../styles/index.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogUrl: string;
  noindex?: boolean;
}

const { title, description, canonical, ogUrl, noindex = false } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Grupo Castillo",
  "parentOrganization": {
    "@type": "Organization",
    "name": "Grupo Castillo"
  },
  "url": "https://grupocastillo.lat/",
  "logo": "https://grupocastillo.lat/android-chrome-512x512.png",
  "image": "https://grupocastillo.lat/og-image.png",
  "description": description,
  "priceRange": "$2,800–$40,000+ MXN",
  "areaServed": "MX",
  "sameAs": [
    "https://www.instagram.com/grupocastillooo/",
    "https://www.facebook.com/profile.php?id=61593987536435"
  ]
};

// JSON-LD requires raw script content. Escape characters that could terminate
// the script element if metadata ever stops being fully static.
const serializedJsonLd = JSON.stringify(jsonLd)
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/&/g, '\\u0026');
---

<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex, nofollow">}
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Grupo Castillo">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={ogUrl}>
<meta property="og:image" content="https://grupocastillo.lat/og-image.png">
<meta property="og:image:secure_url" content="https://grupocastillo.lat/og-image.png">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Grupo Castillo — Firma de Ingeniería Digital & Desarrollo Web">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content="https://grupocastillo.lat/og-image.png">
<meta name="twitter:image:alt" content="Grupo Castillo — Firma de Ingeniería Digital & Desarrollo Web">
<meta name="theme-color" content="#0A0C0F">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png">
<link rel="shortcut icon" href="/favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<script is:inline type="application/ld+json" set:html={serializedJsonLd} />
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}

  // 1. Google Consent Mode v2 — Estado default configurado antes de inicializar la etiqueta
  var storedConsent = null;
  try {
    storedConsent = localStorage.getItem('gc_consent_state');
  } catch(e) {}

  if (storedConsent === 'granted') {
    gtag('consent', 'default', {
      'analytics_storage': 'granted',
      'ad_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied'
    });
  } else {
    gtag('consent', 'default', {
      'analytics_storage': 'denied',
      'ad_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied'
    });
  }
</script>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-3Y5WFB6FCJ"></script>
<script is:inline>
  gtag('js', new Date());

  gtag('config', 'G-3Y5WFB6FCJ', {
    send_page_view: true
  });

  // Global click event tracking via delegation
  document.addEventListener('DOMContentLoaded', function() {
    document.body.addEventListener('click', function(e) {
      var anchor = e.target.closest('a');
      if (!anchor) return;

      var href = anchor.getAttribute('href') || '';
      var text = (anchor.innerText || '').trim().substring(0, 50);

      // WhatsApp tracking
      if (href.indexOf('wa.me') !== -1 || href.indexOf('whatsapp.com') !== -1) {
        gtag('event', 'whatsapp_click', {
          contact_method: 'whatsapp',
          cta_location: window.location.pathname,
          cta_text: text
        });
      }
      // Mailto tracking
      else if (href.indexOf('mailto:') === 0) {
        var email = href.substring(7);
        gtag('event', 'email_click', {
          contact_method: 'email',
          email_address: email,
          cta_location: window.location.pathname,
          cta_text: text
        });
      }
      // Phone tracking
      else if (href.indexOf('tel:') === 0) {
        var phone = href.substring(4);
        gtag('event', 'phone_click', {
          contact_method: 'phone',
          phone_number: phone,
          cta_location: window.location.pathname,
          cta_text: text
        });
      }
      // Quote CTA click tracking (packages, diagnostics, gate, contacto)
      else if (href.indexOf('/contacto') !== -1 || href.indexOf('/paquetes') !== -1 || href.indexOf('/diagnostico') !== -1 || href.indexOf('/castle-gate') !== -1) {
        gtag('event', 'quote_cta_click', {
          cta_location: window.location.pathname,
          cta_destination: href,
          cta_text: text
        });
      }
    });
  });
</script>
</head>
<body>
<a class="skip-link" href="#main">Saltar al contenido</a>

<Nav />

<slot />

<Footer />

<ConsentBanner />

<script is:inline src="/assets/js/main.js" defer></script>
</body>
</html>
